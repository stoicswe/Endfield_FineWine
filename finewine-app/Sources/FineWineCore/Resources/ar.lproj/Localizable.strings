"config.fullscreen_label" = "ملء الشاشة";
"config.fullscreen_detail" = "طريقة عرض نافذة اللعبة في وضع ملء الشاشة. مع مساحتها الخاصة، يظهر شريط القوائم عند الحافة العلوية، والتمرير يعود إلى سطح المكتب، وتظهر الإشعارات فوق اللعبة.";
"config.rounded_windows_title" = "زوايا النوافذ المستديرة";
"config.rounded_windows_desc" = "النوافذ التي ترسم شريط العنوان الخاص بها، كما تفعل المشغلات والعديد من الألعاب، تحصل على زوايا مستديرة تشبه نافذة Mac. تُترك نوافذ ملء الشاشة والقوائم والنوافذ ذات الأشكال الخاصة كما هي.";
"config.game_mode_title" = "نمط اللعب (Game Mode)";
"config.game_mode_desc" = "يتم بدء البرامج التي تستخدم Direct3D أو Vulkan أو OpenGL كألعاب، بحيث يقوم macOS بتفعيل نمط اللعب أثناء وجودها في وضع ملء الشاشة. يتم التعرف على البرنامج الذي يبدأ بواسطة مشغل بدءاً من تشغيله الثاني.";
"config.hoyoverse_steam_title" = "بدء ألعاب HoYoverse كما يفعل Steam";
"config.hoyoverse_steam_desc" = "يتم تشغيل Genshin Impact و Zenless Zone Zero و Honkai Impact 3rd ومشغل HoYoPlay من خلال بديل لعميل Steam، بالطريقة التي تعمل بها على Linux. يتم إخبار اللعبة بأنها بدأت بواسطة Steam، وهي ليست منصة تدعمها HoYoverse على Mac؛ استخدمها على مسؤولية حسابك الخاصة.";
"config.metal_hud_title" = "البدء مع ظهور طبقة أداء Metal";
