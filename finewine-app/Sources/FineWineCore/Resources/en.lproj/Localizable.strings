"config.build_number_detail" = "Leave empty for Wine's own. Some games want a specific build, such as 26100.";
"config.nonunicode_label" = "Language for non-Unicode programs";
"config.nonunicode_detail" = "The code page older programs and installers that are not Unicode read and write text in (Shift-JIS, GBK, Big5, Korean). Unicode programs show every language either way.";
