"config.direct3d_label" = "Direct3D";
"config.retina_title" = "High-resolution mode";
"config.retina_desc" = "Programs draw at the display's real pixel resolution, so they are as sharp as Mac apps. Turn it off if a program runs too slowly at full resolution.";
"config.metalfx_upscale_title" = "Sharpen lower resolutions with MetalFX";
"config.metalfx_upscale_desc" = "When a Direct3D 10 or 11 game draws fewer pixels than its window has (a lower resolution chosen in the game, or high-resolution mode off), the picture is upscaled to the display's pixels with MetalFX instead of being stretched. Games using their own upscaler are left alone.";
"config.auto_dpi_title" = "Scale automatically";
"config.auto_dpi_desc_retina" = "Sets the Windows DPI from the display (%@ on this Mac), so text and controls keep their normal size.";
"config.auto_dpi_desc_normal" = "Keeps the Windows DPI at 96, which matches macOS when high-resolution mode is off.";
"config.screen_dpi_label" = "Screen DPI";
"config.screen_dpi_detail" = "96 is 100% scaling; 192 suits high-resolution mode on a Retina display.";
"config.virtual_desktop_title" = "Virtual desktop";
"config.virtual_desktop_desc" = "Keeps the prefix's windows inside one window. Helps programs that misbehave in full screen.";
"config.width_label" = "Width";
"config.height_label" = "Height";
"config.dlss_metalfx_title" = "DLSS through MetalFX";
"config.dlss_metalfx_dxmt_desc" = "Games that offer NVIDIA DLSS use Apple's MetalFX instead, for upscaling and for frame generation. FSR is unaffected: it runs as the game ships it.";
"config.dlss_metalfx_general_desc" = "Direct3D 12 and Vulkan games that offer NVIDIA DLSS use Apple's MetalFX instead. Direct3D 11 games need DXMT as the Direct3D layer. FSR is unaffected.";
"config.report_nvidia_title" = "Report an NVIDIA GPU";
"config.report_nvidia_desc" = "Tells Windows programs the GPU is an %@, by name and by id. Most games only show DLSS options on an NVIDIA GPU. Leave it off for games with NVIDIA-specific code paths you do not want.";
"config.fullscreen_label" = "Full screen";
"config.fullscreen_detail" = "How a game's full-screen window is shown. With its own Space the menu bar appears at the top edge, a swipe goes back to the desktop, and notifications show over the game.";
"config.rounded_windows_title" = "Round window corners";
"config.rounded_windows_desc" = "Windows that draw their own title bar, as launchers and many games do, get the round corners of a Mac window. Full-screen windows, menus and windows with a shape of their own are left as they are.";
"config.game_mode_title" = "Game Mode";
"config.game_mode_desc" = "Programs that use Direct3D, Vulkan or OpenGL are started as games, so macOS turns Game Mode on while one is full screen. A program started by a launcher is recognised from its second run on.";
"config.hoyoverse_steam_title" = "Start HoYoverse games as Steam does";
"config.hoyoverse_steam_desc" = "Genshin Impact, Zenless Zone Zero, Honkai Impact 3rd and the HoYoPlay launcher are started through a stand-in for the Steam client, the way they are run on Linux. The game is told it was started by Steam, which is not a platform HoYoverse supports on a Mac; use it at your own account's risk.";
"config.metal_hud_title" = "Start with the Metal performance overlay shown";
"config.metal_hud_desc" = "Frame rate and GPU statistics over the game. Either way it can be shown and hidden while a game runs: View > Metal HUD in the menu bar, or Option-F12.";
"config.perf_card" = "Performance and compatibility";
"config.sync_label" = "Synchronisation";
"config.sync_detail" = "How Windows events, mutexes and semaphores are handled.";
"config.hide_hypervisor_title" = "Hide the hypervisor flag";
"config.hide_hypervisor_desc" = "The x64 emulator announces itself to programs through the CPU flag a virtual machine sets. Games that refuse to run in a virtual machine then refuse to start, though the Mac is not one. On by default; turn it off for a program that needs to know it is emulated.";
"config.zero_pages_title" = "Don't charge for reading unused memory";
"config.zero_pages_desc" = "macOS counts memory against a program as soon as it is read, even if nothing was ever written to it. Games that read through their own memory, as anti-cheat does, then use many gigabytes more than they need. With this on, such reads cost nothing; the first write to each piece of memory is slightly slower. On by default; turn it off if a program misbehaves.";
"config.compact_records_title" = "Compact emulator records";
"config.compact_records_desc" = "The x64 emulator notes, for every thread, each piece of game code that thread has run. In a large game with many threads these notes take gigabytes. With this on they are kept in a form that takes about half the space or less. On by default; turn it off if a game stutters more or misbehaves.";
"config.appearance_card" = "Appearance";
"config.appearance_footnote" = "Applies to anything in this prefix that uses standard Windows controls, including the Wine tools. Window frames and title bars are always drawn by macOS. Games that draw their own interface are not affected.";
"config.mac_appearance_title" = "Match macOS";
"config.mac_appearance_desc" = "Windows controls take the Mac's light or dark colours, its accent colour and a Mac font. It is refreshed when a Wine tool is opened after the Mac's appearance changes.";
"config.mac_icons_title" = "Mac-style app icons";
"config.mac_icons_desc" = "Programs show in the Dock with their icon on a Mac app icon's rounded square, at the largest size the program has. Shortcut apps made from now on match.";
"config.keyboard_card" = "Keyboard";
"config.left_opt_alt" = "Left Option key acts as Alt";
"config.right_opt_alt" = "Right Option key acts as Alt";
"config.dll_overrides_card" = "DLL overrides";
"config.dll_overrides_footnote" = "Chooses between a DLL that came with a program (native) and Wine's own (built in).";
"config.order_label" = "Order";
"config.remove_override" = "Remove this override";
"config.add_override" = "Add Override";
"config.env_card" = "Environment variables";
"config.env_footnote" = "Set for every program in this prefix.";
"config.debug_card" = "Debugging";
"config.debug_footnote" = "Wine debug channels (WINEDEBUG). “-all” is silent and fastest; “err+all” logs errors. Output goes to the prefix's logs.";
"config.msync_note" = "MSync needs a runtime built with it; FineWine's own runtime is. Every program in a prefix must use the same setting, so stop running programs before changing it.";
"config.graphics_note" = "“%@” doesn't include %@, so programs will use WineD3D until a runtime that has it is chosen.";
"config.changes_running" = "Changes apply to programs started after this. Running ones keep their old settings.";
