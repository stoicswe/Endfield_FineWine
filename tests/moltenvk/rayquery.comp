#version 460
#extension GL_EXT_ray_query : require

// Traces two rays against the scene: one aimed at the triangle, one aimed away from it.
layout(local_size_x = 1) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1) buffer Result { uint hit; float hitT; uint miss; uint customIndex; } result;

uint trace(vec3 origin, vec3 dir, out float t, out uint id)
{
    rayQueryEXT q;
    rayQueryInitializeEXT(q, scene, gl_RayFlagsOpaqueEXT, 0xFF, origin, 0.001, dir, 100.0);
    while (rayQueryProceedEXT(q)) {}
    t = 0.0; id = 0;
    if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        t = rayQueryGetIntersectionTEXT(q, true);
        id = rayQueryGetIntersectionInstanceCustomIndexEXT(q, true);
        return 1u;
    }
    return 0u;
}

void main()
{
    float t; uint id; float t2; uint id2;
    result.hit = trace(vec3(0.0, 0.0, -5.0), vec3(0.0, 0.0, 1.0), t, id);
    result.hitT = t;
    result.customIndex = id;
    result.miss = trace(vec3(10.0, 10.0, -5.0), vec3(0.0, 0.0, 1.0), t2, id2);
}
