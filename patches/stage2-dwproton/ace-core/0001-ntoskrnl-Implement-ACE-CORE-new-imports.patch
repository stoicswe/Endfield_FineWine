diff --git a/dlls/ntoskrnl.exe/sync.c b/dlls/ntoskrnl.exe/sync.c
index 4674a3a..abbbc44 100644
--- a/dlls/ntoskrnl.exe/sync.c
+++ b/dlls/ntoskrnl.exe/sync.c
@@ -461,6 +461,24 @@ void WINAPI KeAcquireGuardedMutex(PKGUARDED_MUTEX mutex)
     KeAcquireGuardedMutexUnsafe(mutex);
 }
 
+/***********************************************************************
+ *           KeTryToAcquireGuardedMutex   (NTOSKRNL.EXE.@)
+ */
+BOOLEAN WINAPI KeTryToAcquireGuardedMutex(PKGUARDED_MUTEX mutex)
+{
+    LONG count;
+
+    TRACE("mutex %p.\n", mutex);
+
+    count = InterlockedDecrement( &mutex->Count );
+    if (count >= 0)
+        return TRUE;
+
+    /* couldn't acquire, restore the count and report failure */
+    InterlockedIncrement( &mutex->Count );
+    return FALSE;
+}
+
 /***********************************************************************
  *           KeReleaseGuardedMutexUnsafe   (NTOSKRNL.EXE.@)
  */
