ntdll, winemac: start each program from a bundle of its own name

The Dock labels a running program with the name of the app bundle its executable is in, and
nothing a process says about itself afterwards changes that (the display name LaunchServices
holds, which the menu bar and Activity Monitor follow, does not reach the Dock). Every Wine
program is the same loader, so each one was labelled "wine", or "FineWine Game" when it ran
under the loader that turns Game Mode on.

A program is now started through a bundle of its own: a folder in the prefix,
.finewine-apps/<game or program>/<name>.app, holding a link to the loader and the loader's
Info.plist under the new name. The loader already resolves its own path, so it finds the
runtime through the link. The bundles are made when first needed and made again if the
runtime has moved.

The name is worked out before the program starts, where its file is at hand: the one FineWine
lists the program under, else the product name or description in its version information,
else its file name. The program is told it in FINEWINE_PROCESS_NAME and the Mac driver names
the process after that, so the Dock and the menu bar agree. Windows' own programs keep the
plain loader. FINEWINE_DOCK_NAMES=0 turns this off.

diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -461,8 +461,290 @@
         asprintf( &ret, "%s%s/wine", dll_dir, get_so_dir( machine ));
     else if (alt_build_dir)
         asprintf( &ret, "%s/loader/wine", alt_build_dir );
+
+    return ret;
+}
+
+
+/* FineWine: the Dock labels a running program with the name of the app bundle its executable
+ * is in, and nothing a process says about itself afterwards changes that. Every Wine program
+ * is the same loader, so each would be labelled "wine", or with the name of the loader's
+ * bundle. A program is therefore started through a bundle of its own name: a folder in the
+ * prefix, ".finewine-apps/<kind of loader>/<name>.app", holding a link to the loader and the loader's
+ * Info.plist under the new name. The loader finds the runtime through the link.
+ *
+ * The name is, in order: the one FineWine lists the program under (FINEWINE_APP_NAME, when
+ * FINEWINE_APP_EXE is this program's file name), the product name or description in its
+ * version information, its file name without the extension. The started program is told it
+ * in FINEWINE_PROCESS_NAME, which is what the Mac driver names the process after.
+ * Windows' own programs keep the plain loader. FINEWINE_DOCK_NAMES=0 turns this off. */
+static char *finewine_process_name;
+
+static UINT finewine_u16( const BYTE *p ) { return p[0] | p[1] << 8; }
+static UINT finewine_u32( const BYTE *p ) { return p[0] | p[1] << 8 | p[2] << 16 | (UINT)p[3] << 24; }
+
+static BOOL finewine_read_file( int fd, UINT64 offset, void *buffer, size_t size )
+{
+    return pread( fd, buffer, size, offset ) == (ssize_t)size;
+}
+
+/* One string of a version resource: { length, value length in characters, type 1, key,
+ * padding, value }, as UTF-8. */
+static BOOL finewine_version_string( const BYTE *data, UINT size, const char *key, char *out, UINT out_len )
+{
+    UINT key_len = strlen( key ), key_bytes = (key_len + 1) * 2, i, k, n, value, len, pos = 0;
+
+    for (i = 6; i + key_bytes < size; i += 2)
+    {
+        for (k = 0; k <= key_len; k++)
+            if (finewine_u16( data + i + k * 2 ) != (k < key_len ? (unsigned char)key[k] : 0)) break;
+        if (k <= key_len) continue;
+        len = finewine_u16( data + i - 4 );
+        if (finewine_u16( data + i - 2 ) != 1 || len < 2 || len > 200) continue;
+        value = i + key_bytes;
+        if ((value - (i - 6)) % 4) value += 2;
+        for (n = 0; n < len - 1 && value + n * 2 + 2 <= size && pos + 4 < out_len; n++)
+        {
+            UINT ch = finewine_u16( data + value + n * 2 );
+            if (!ch) break;
+            if (ch >= 0xd800 && ch < 0xe000) ch = '-';  /* names outside the basic plane are not worth the code */
+            if (ch < 0x80) out[pos++] = ch;
+            else if (ch < 0x800) { out[pos++] = 0xc0 | ch >> 6; out[pos++] = 0x80 | (ch & 0x3f); }
+            else { out[pos++] = 0xe0 | ch >> 12; out[pos++] = 0x80 | ((ch >> 6) & 0x3f); out[pos++] = 0x80 | (ch & 0x3f); }
+        }
+        while (pos && out[pos - 1] == ' ') pos--;
+        out[pos] = 0;
+        if (pos) return TRUE;
+    }
+    return FALSE;
+}
+
+/* The program's own version resource, found through its resource table. */
+static BOOL finewine_product_name( int fd, char *out, UINT out_len )
+{
+    BYTE dos[64], head[24], optional[240 + 96 * 40], dir[16], entry[8], leaf[8], *version;
+    UINT pe, sections, optional_size, dirs, rva, root = 0, level, offset = 0, count, i, size, pos = 0;
+    BOOL ret;
+
+    if (!finewine_read_file( fd, 0, dos, sizeof(dos) ) || dos[0] != 'M' || dos[1] != 'Z') return FALSE;
+    pe = finewine_u32( dos + 0x3c );
+    if (!finewine_read_file( fd, pe, head, sizeof(head) ) || finewine_u32( head ) != 0x4550) return FALSE;
+    sections = finewine_u16( head + 6 );
+    optional_size = finewine_u16( head + 20 );
+    if (sections > 96 || optional_size > 240 || optional_size < 128) return FALSE;
+    if (!finewine_read_file( fd, pe + 24, optional, optional_size + sections * 40 )) return FALSE;
+    if (finewine_u16( optional ) == 0x10b) dirs = 96;
+    else if (finewine_u16( optional ) == 0x20b) dirs = 112;
+    else return FALSE;
+    if (dirs + 3 * 8 > optional_size || !(rva = finewine_u32( optional + dirs + 2 * 8 ))) return FALSE;
+
+#define FILE_OFFSET(r, result) do { \
+        UINT s_; (result) = 0; \
+        for (s_ = 0; s_ < sections; s_++) { \
+            const BYTE *sec_ = optional + optional_size + s_ * 40; \
+            UINT va_ = finewine_u32( sec_ + 12 ), vs_ = finewine_u32( sec_ + 8 ), rs_ = finewine_u32( sec_ + 16 ); \
+            if ((r) >= va_ && (r) < va_ + max( vs_, rs_ )) { (result) = finewine_u32( sec_ + 20 ) + ((r) - va_); break; } \
+        } } while (0)
+
+    FILE_OFFSET( rva, root );
+    if (!root) return FALSE;
+    /* type 16 (version information), then the first name, then the first language */
+    for (level = 0; level < 3; level++)
+    {
+        if (!finewine_read_file( fd, root + offset, dir, sizeof(dir) )) return FALSE;
+        count = finewine_u16( dir + 12 ) + finewine_u16( dir + 14 );
+        for (i = 0; i < count && i < 4096; i++)
+        {
+            if (!finewine_read_file( fd, root + offset + 16 + i * 8, entry, sizeof(entry) )) return FALSE;
+            if (level || finewine_u32( entry ) == 16) break;
+        }
+        if (i == count || i == 4096) return FALSE;
+        offset = finewine_u32( entry + 4 );
+        if (level < 2) { if (!(offset & 0x80000000)) return FALSE; }
+        else if (offset & 0x80000000) return FALSE;
+        offset &= 0x7fffffff;
+    }
+    if (!finewine_read_file( fd, root + offset, leaf, sizeof(leaf) )) return FALSE;
+    size = finewine_u32( leaf + 4 );
+    FILE_OFFSET( finewine_u32( leaf ), pos );
+#undef FILE_OFFSET
+    if (!pos || !size || size > 0x40000 || !(version = malloc( size ))) return FALSE;
+    ret = finewine_read_file( fd, pos, version, size ) &&
+          (finewine_version_string( version, size, "ProductName", out, out_len ) ||
+           finewine_version_string( version, size, "FileDescription", out, out_len ));
+    free( version );
+    return ret;
+}
+
+/* Works out the name of the program about to be started, from its file: a Unix path, or for
+ * the first program of a session whatever was typed, which may be a Windows path. */
+void finewine_set_program_name( const char *path )
+{
+    const char *given = getenv( "FINEWINE_APP_NAME" ), *given_exe = getenv( "FINEWINE_APP_EXE" );
+    const char *off = getenv( "FINEWINE_DOCK_NAMES" ), *base = path, *p, *dot;
+    char name[512];
+    int fd;
+
+    free( finewine_process_name );
+    finewine_process_name = NULL;
+    unsetenv( "FINEWINE_PROCESS_NAME" );
+    if (off && !strcmp( off, "0" )) return;
+    if (!path || !*path || path[0] == '-') return;
+
+    for (p = path; *p; p++) if (*p == '/' || *p == '\\') base = p + 1;
+    if (base == path) return;  /* a bare name is one of Wine's own programs */
+    for (p = path; *p; p++)    /* and so is anything in the Windows folder or in the runtime */
+        if ((*p == '/' || *p == '\\') && !strncasecmp( p + 1, "windows", 7 ) && (p[8] == '/' || p[8] == '\\')) return;
+    if (dll_dir && !strncmp( path, dll_dir, strlen( dll_dir ) )) return;
+
+    name[0] = 0;
+    if (given && *given && given_exe && !strcasecmp( given_exe, base ))
+        snprintf( name, sizeof(name), "%s", given );
+    if (!name[0] && (fd = open( path, O_RDONLY | O_CLOEXEC )) != -1)
+    {
+        if (!finewine_product_name( fd, name, sizeof(name) )) name[0] = 0;
+        close( fd );
+    }
+    if (!name[0])
+    {
+        dot = strrchr( base, '.' );
+        snprintf( name, sizeof(name), "%.*s", dot && dot > base ? (int)(dot - base) : (int)strlen( base ), base );
+    }
+    if (!name[0]) return;
+    finewine_process_name = strdup( name );
+    setenv( "FINEWINE_PROCESS_NAME", name, 1 );
+}
 
+/* The app description for a named bundle: the loader's own with the name replaced, or a
+ * plain one for a loader that is not in a bundle. */
+static char *finewine_named_plist( const char *loader, const char *exe, const char *name )
+{
+    static const char key[] = "<key>CFBundleName</key>", open_tag[] = "<string>", close_tag[] = "</string>";
+    char escaped[1024], *source = NULL, *text = NULL, *ret = NULL, *start, *end;
+    const char *tail = strstr( loader, ".app/Contents/MacOS/" );
+    UINT pos = 0;
+    struct stat st;
+    int fd;
+
+    for (; *name && pos + 8 < sizeof(escaped); name++)
+    {
+        if (*name == '&') pos += snprintf( escaped + pos, 8, "&amp;" );
+        else if (*name == '<') pos += snprintf( escaped + pos, 8, "&lt;" );
+        else if (*name == '>') pos += snprintf( escaped + pos, 8, "&gt;" );
+        else escaped[pos++] = *name;
+    }
+    escaped[pos] = 0;
+
+    if (tail)
+    {
+        asprintf( &source, "%.*s.app/Contents/Info.plist", (int)(tail - loader), loader );
+        if ((fd = open( source, O_RDONLY | O_CLOEXEC )) != -1)
+        {
+            if (!fstat( fd, &st ) && st.st_size > 0 && st.st_size < 0x10000 && (text = malloc( st.st_size + 1 )))
+            {
+                if (read( fd, text, st.st_size ) == st.st_size) text[st.st_size] = 0;
+                else { free( text ); text = NULL; }
+            }
+            close( fd );
+        }
+        free( source );
+        if (text && (start = strstr( text, key )) && (start = strstr( start, open_tag )) &&
+            (end = strstr( start, close_tag )))
+        {
+            start += strlen( open_tag );
+            asprintf( &ret, "%.*s%s%s", (int)(start - text), text, escaped, end );
+        }
+        free( text );
+        return ret;
+    }
+    asprintf( &ret,
+              "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+              "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+              "<plist version=\"1.0\">\n<dict>\n"
+              "    <key>CFBundleDevelopmentRegion</key>\n    <string>English</string>\n"
+              "    <key>CFBundleExecutable</key>\n    <string>%s</string>\n"
+              "    <key>CFBundleIdentifier</key>\n    <string>org.finewine.program</string>\n"
+              "    <key>CFBundleInfoDictionaryVersion</key>\n    <string>6.0</string>\n"
+              "    <key>CFBundleName</key>\n    <string>%s</string>\n"
+              "    <key>CFBundlePackageType</key>\n    <string>APPL</string>\n"
+              "    <key>CFBundleShortVersionString</key>\n    <string>1.0</string>\n"
+              "    <key>CFBundleVersion</key>\n    <string>1</string>\n"
+              "    <key>NSPrincipalClass</key>\n    <string>WineApplication</string>\n"
+              "    <key>NSHighResolutionCapable</key>\n    <true/>\n"
+              "    <key>LSUIElement</key>\n    <string>1</string>\n"
+              "</dict>\n</plist>\n", exe, escaped );
     return ret;
+}
+
+/* The loader to start the named program with: the link in its bundle, made if it is not
+ * there or points at another runtime. NULL when the plain loader has to do. */
+static char *finewine_named_loader( const char *loader )
+{
+    char clean[128], current[PATH_MAX], *app = NULL, *dir = NULL, *link = NULL, *plist = NULL, *tmp = NULL, *text;
+    const char *exe = strrchr( loader, '/' ), *name = finewine_process_name;
+    UINT pos = 0;
+    ssize_t len;
+    int fd;
+
+    if (!name || !config_dir || !exe) return NULL;
+    exe++;
+    while (*name == '.' || *name == ' ') name++;
+    for (; *name && pos < 96; name++)  /* a folder name: no separators, nothing unprintable */
+        clean[pos++] = (*name == '/' || *name == ':' || (unsigned char)*name < 0x20) ? '-' : *name;
+    while (pos && (clean[pos - 1] & 0xc0) == 0x80 && *name) pos--;  /* not half a character */
+    if (pos && *name && ((unsigned char)clean[pos - 1] & 0xc0) == 0xc0) pos--;
+    while (pos && clean[pos - 1] == ' ') pos--;
+    clean[pos] = 0;
+    if (!pos) return NULL;
+
+    /* one folder for each kind of loader: their app descriptions differ */
+    asprintf( &tmp, "%s/.finewine-apps", config_dir );
+    asprintf( &dir, "%s/%s", tmp, strstr( loader, ".app/Contents/MacOS/" ) ? "game" : "program" );
+    mkdir( tmp, 0755 );
+    free( tmp );
+    asprintf( &app, "%s/%s.app", dir, clean );
+    asprintf( &plist, "%s/Contents/Info.plist", app );
+    asprintf( &link, "%s/Contents/MacOS/%s", app, exe );
+
+    len = readlink( link, current, sizeof(current) - 1 );
+    if (len > 0) current[len] = 0;
+    if (len <= 0 || strcmp( current, loader ) || access( plist, R_OK ))
+    {
+        mkdir( dir, 0755 );
+        mkdir( app, 0755 );
+        asprintf( &tmp, "%s/Contents", app );
+        mkdir( tmp, 0755 );
+        free( tmp );
+        asprintf( &tmp, "%s/Contents/MacOS", app );
+        mkdir( tmp, 0755 );
+        free( tmp );
+        if ((text = finewine_named_plist( loader, exe, finewine_process_name )))
+        {
+            asprintf( &tmp, "%s.%u", plist, (unsigned int)getpid() );
+            if ((fd = open( tmp, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644 )) != -1)
+            {
+                BOOL ok = write( fd, text, strlen( text ) ) == (ssize_t)strlen( text );
+                close( fd );
+                if (ok) rename( tmp, plist );
+                else unlink( tmp );
+            }
+            free( tmp );
+            free( text );
+        }
+        unlink( link );
+        symlink( loader, link );
+    }
+    len = readlink( link, current, sizeof(current) - 1 );
+    if (len > 0) current[len] = 0;
+    if (len <= 0 || strcmp( current, loader ) || access( plist, R_OK ) || access( link, X_OK ))
+    {
+        free( link );
+        link = NULL;
+    }
+    free( dir );
+    free( app );
+    free( plist );
+    return link;
 }
 
 
