-    argv[1] = strdup( wineloader );
+    /* FineWine: through the program's own bundle, so the Dock shows its name */
+    if (!(argv[1] = finewine_named_loader( wineloader ))) argv[1] = strdup( wineloader );
     preloader_exec( argv );
     return STATUS_INVALID_IMAGE_FORMAT;
 }
