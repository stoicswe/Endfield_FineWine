kernelbase: keep Chromium-based programs' drawing in their main process, in software

Launchers built on CEF or Electron draw from a GPU process into the main process's window.
DXMT cannot present into another process's window, and the Mac driver cannot paint one with
GDI from another process either, so the window stays blank. Programs with Chromium's files
beside them get --in-process-gpu --disable-gpu --disable-gpu-compositing added to their command
line. FINEWINE_CHROMIUM_FLAGS names other switches, or "none".

diff --git a/dlls/kernelbase/process.c b/dlls/kernelbase/process.c
index c58e977..c321c90 100644
--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -520,6 +520,51 @@ done:
     return ret;
 }
 
+/* FineWine: launchers built on Chromium (CEF, Electron) draw their window from a separate
+ * "GPU process", into a window that belongs to the main process. That cannot work here in
+ * either of Chromium's modes:
+ *   - with Direct3D, DXMT cannot present into another process's window ("cross-process
+ *     swapchain not supported"), nor attach to the child window Chromium makes for it;
+ *   - in software, the GPU process paints the main process's window with GDI, and the Mac
+ *     driver cannot paint a window from a process that does not own it.
+ * The window stays blank. So Chromium is asked for both things that avoid it: to do that work
+ * inside the main process (--in-process-gpu) and to draw in software (--disable-gpu,
+ * --disable-gpu-compositing). A launcher's pages do not need more. The main process passes
+ * what is needed on to the processes it starts.
+ *
+ * A program that has Chromium's files beside it, and is not one of Chromium's own child
+ * processes (those are started with --type=), gets the switches added. FINEWINE_CHROMIUM_FLAGS
+ * names other switches to add, or "none". Returns a new command line, or NULL to leave it. */
+static WCHAR *finewine_chromium_cmdline( const WCHAR *app_name, const WCHAR *cmdline )
+{
+    static const WCHAR * const markers[] = { L"libcef.dll", L"chrome_100_percent.pak" };
+    WCHAR flags[256], path[MAX_PATH], *end, *ret;
+    DWORD len, i;
+
+    if (!app_name || !cmdline) return NULL;
+    if (wcsstr( cmdline, L"--type=" )) return NULL;
+    len = GetEnvironmentVariableW( L"FINEWINE_CHROMIUM_FLAGS", flags, ARRAY_SIZE(flags) );
+    if (!len || len >= ARRAY_SIZE(flags)) wcscpy( flags, L"--in-process-gpu --disable-gpu --disable-gpu-compositing" );
+    if (!wcsicmp( flags, L"none" ) || wcsstr( cmdline, L"--disable-gpu-compositing" ) || wcsstr( cmdline, flags )) return NULL;
+
+    if (wcslen( app_name ) + 32 >= ARRAY_SIZE(path)) return NULL;
+    wcscpy( path, app_name );
+    if (!(end = wcsrchr( path, '\\' ))) return NULL;
+    for (i = 0; i < ARRAY_SIZE(markers); i++)
+    {
+        wcscpy( end + 1, markers[i] );
+        if (GetFileAttributesW( path ) != INVALID_FILE_ATTRIBUTES) break;
+    }
+    if (i == ARRAY_SIZE(markers)) return NULL;
+
+    len = wcslen( cmdline ) + wcslen( flags ) + 2;
+    if (!(ret = RtlAllocateHeap( GetProcessHeap(), 0, len * sizeof(WCHAR) ))) return NULL;
+    swprintf( ret, len, L"%s %s", cmdline, flags );
+    TRACE( "Chromium program %s: command line is now %s\n", debugstr_w(app_name), debugstr_w(ret) );
+    return ret;
+}
+
+
