+/* FineWine: launchers built on Chromium (CEF, Electron) draw their window from a separate
+ * "GPU process", into a window that belongs to the main process. That cannot work here in
+ * either of Chromium's modes:
+ *   - with Direct3D, DXMT cannot present into another process's window ("cross-process
+ *     swapchain not supported"), nor attach to the child window Chromium makes for it;
+ *   - in software, the GPU process paints the main process's window with GDI, and the Mac
+ *     driver cannot paint a window from a process that does not own it.
+ * The window stays blank. So Chromium is asked for both things that avoid it: to do that work
+ * inside the main process (--in-process-gpu) and to draw in software (--disable-gpu,
+ * --disable-gpu-compositing). A launcher's pages do not need more. The main process passes
+ * what is needed on to the processes it starts.
+ *
+ * The switches are added to this process's own command line, once Chromium is in it: when
+ * libcef.dll has been loaded, or for Electron when the program imports ffmpeg.dll and has
+ * Chromium's resources beside it. Chromium reads the command line when it is initialised,
+ * which is later. Chromium's own child processes (started with --type=) are left alone.
+ * It must be done here and not by whoever starts the program: other programs live in the same
+ * folder (the launcher's 7z.exe, updaters, crash reporters) and choke on the switches.
+ * FINEWINE_CHROMIUM_FLAGS names other switches to add, or "none". */
+void finewine_check_chromium(void)
+{
+    static LONG done;
+    RTL_USER_PROCESS_PARAMETERS *params = NtCurrentTeb()->Peb->ProcessParameters;
+    WCHAR flags[256], path[MAX_PATH], *end, *line;
+    ANSI_STRING ansi;
+    DWORD len;
+
+    if (done || !command_lineW) return;
+    /* Only a CEF under its own name. Games also embed renamed builds that draw off screen
+     * into the game's own picture (zf_cef.dll in Zenless Zone Zero: its login window, inside
+     * the game process). Those work as they are, and the switches made that login window
+     * disappear, so chrome_elf.dll, which would catch them, is deliberately not looked for. */
+    if (!GetModuleHandleW( L"libcef.dll" ))
+    {
+        if (!GetModuleHandleW( L"ffmpeg.dll" )) return;
+        len = GetModuleFileNameW( NULL, path, ARRAY_SIZE(path) );
+        if (!len || len + 32 >= ARRAY_SIZE(path) || !(end = wcsrchr( path, '\\' ))) return;
+        wcscpy( end + 1, L"chrome_100_percent.pak" );
+        if (GetFileAttributesW( path ) == INVALID_FILE_ATTRIBUTES) return;
+    }
+    if (InterlockedExchange( &done, 1 )) return;
+
+    if (wcsstr( command_lineW, L"--type=" ) || wcsstr( command_lineW, L"--disable-gpu-compositing" )) return;
+    len = GetEnvironmentVariableW( L"FINEWINE_CHROMIUM_FLAGS", flags, ARRAY_SIZE(flags) );
+    if (!len || len >= ARRAY_SIZE(flags)) wcscpy( flags, L"--in-process-gpu --disable-gpu --disable-gpu-compositing" );
+    if (!wcsicmp( flags, L"none" )) return;
+
+    len = wcslen( command_lineW ) + wcslen( flags ) + 2;
+    if (!(line = RtlAllocateHeap( GetProcessHeap(), 0, len * sizeof(WCHAR) ))) return;
+    swprintf( line, len, L"%s %s", command_lineW, flags );
+    TRACE( "Chromium in this process: command line is now %s\n", debugstr_w(line) );
+
+    /* the old buffers are left alone: something may still be reading them */
+    params->CommandLine.Buffer = line;
+    params->CommandLine.Length = wcslen( line ) * sizeof(WCHAR);
+    params->CommandLine.MaximumLength = len * sizeof(WCHAR);
+    command_lineW = line;
+    if (!RtlUnicodeStringToAnsiString( &ansi, &params->CommandLine, TRUE )) command_lineA = ansi.Buffer;
+}
+
+
