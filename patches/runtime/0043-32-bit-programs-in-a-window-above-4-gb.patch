+/* check whether a given message type includes pointers */
+static inline BOOL is_pointer_message( UINT message, WPARAM wparam )
+{
+    if (message >= 8*sizeof(message_pointer_flags)) return FALSE;
+    if (message == WM_DEVICECHANGE && !(wparam & 0x8000)) return FALSE;
+    return (message_pointer_flags[message / 32] & SET(message)) != 0;
+}
+
+#undef SET
+
+static LPARAM message_lparam_32to64( UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    if (is_pointer_message( msg, wparam )) return (LPARAM)ULongToPtr( lparam );
+    return lparam;
+}
+
+/* the few whose wparam is a pointer too */
+static WPARAM message_wparam_32to64( UINT msg, WPARAM wparam )
+{
+    switch (msg)
+    {
+    case EM_GETSEL:
+    case SBM_GETRANGE:
+    case CB_GETEDITSEL:
+        return (WPARAM)ULongToPtr( wparam );
+    }
+    return wparam;
+}
