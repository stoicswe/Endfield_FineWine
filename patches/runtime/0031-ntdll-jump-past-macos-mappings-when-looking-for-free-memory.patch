ntdll: jump past macOS's own mappings when looking for free memory

Wine looks for free memory between its own views by trying one aligned step after another, one
mach_vm_map call each. Between its views macOS has mappings Wine does not know about: the
program image, the shared cache of system libraries, Metal's and the emulator's memory,
malloc's zones, many gigabytes of them right above 4 GB. Every thread of an x64 program gets
an emulator stack "above 4 GB", so each new thread stepped over all of that in 64K steps, and
further each time, with virtual_mutex held: page faults and every memory call of every other
thread waited meanwhile. Creating 300 threads took 420 seconds (tests/runtime/threads.c), and
a game's loading screen sat mostly idle (Arknights: Endfield, 11 of 12 samples taken while it
loaded had a thread in this search, most of them for the whole 3 seconds).

When a step is taken, the kernel now says where the mapping in the way ends (mach_vm_region),
and the search goes on at the first aligned address past it: the same address stepping would
reach, so the memory found is the same. The 300 threads now take 0.2 seconds.

--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -1285,7 +1285,47 @@
     *end_ptr = end;
     return first;
 }
+
+
+#ifdef __APPLE__
+/* FineWine: the next place worth trying after start was found taken. Wine only knows its own
+ * views; between them, macOS has mappings of its own (the program image, the shared cache of
+ * system libraries, Metal's and the emulator's memory, malloc's zones), many gigabytes of them
+ * right above 4 GB, where the search for a thread's emulator stack begins. Stepping over those
+ * one 64K step and one mach_vm_map call at a time took seconds for every new thread, all of it
+ * with virtual_mutex held, so page faults and every other memory call of every thread waited
+ * too (a game's loading screen sat mostly idle). The kernel says where the mapping in the way
+ * ends: the next step that can succeed is the first aligned address past it, which is where
+ * stepping would get to as well, only later. Steps down go to just below where it starts. */
+static void *next_unmapped_candidate( void *start, size_t size, ptrdiff_t step )
+{
+    mach_vm_address_t address = (mach_vm_address_t)start, next;
+    mach_vm_size_t region_size = 0;
+    vm_region_basic_info_data_64_t info;
+    mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+    mach_port_t dummy_object_name = MACH_PORT_NULL;
+    size_t align_mask = (step > 0 ? step : -step) - 1;
+
+    /* the mapping at start, or the first one above it */
+    if (mach_vm_region( mach_task_self(), &address, &region_size, VM_REGION_BASIC_INFO_64,
+                        (vm_region_info_t)&info, &count, &dummy_object_name ) != KERN_SUCCESS ||
+        address >= (mach_vm_address_t)start + size)
+        return (char *)start + step;  /* nothing mapped in the way: the plain step */
 
+    if (step > 0)
+    {
+        next = (address + region_size + align_mask) & ~(mach_vm_address_t)align_mask;
+        if (next <= (mach_vm_address_t)start) return (char *)start + step;
+    }
+    else
+    {
+        if (address < size) return NULL;
+        next = (address - size) & ~(mach_vm_address_t)align_mask;
+        if (next >= (mach_vm_address_t)start) return (char *)start + step;
+    }
+    return (void *)next;
+}
+#endif
 
 /***********************************************************************
  *           try_map_free_area
@@ -1310,7 +1350,11 @@
             (step < 0 && (char *)start - (char *)base < -step) ||
             step == 0)
             break;
+#ifdef __APPLE__
+        start = next_unmapped_candidate( start, size, step );
+#else
         start = (char *)start + step;
+#endif
     }
 
     return NULL;
