+    /* macOS adds a "Metal HUD" menu of its own to a program started with MTL_HUD_ENABLED=1,
+     * with an item that says Hide HUD or Show HUD. By itself that item does nothing once a
+     * layer's own HUD setting has been made (measured, in both directions), and making that
+     * setting is the only way to hide the overlay at all. So the two are tied together: the
+     * system's item is the switch, and the layers are set to whatever it says. View >
+     * Show/Hide Metal HUD and the keyboard shortcuts press the system's item. Where there is
+     * no such menu, the layers' setting is switched directly. */
+    - (NSMenuItem*) systemMetalHUDItem
+    {
+        SEL toggle = NSSelectorFromString(@"toggleEnabled:");
+        for (NSMenuItem* top in [[NSApp mainMenu] itemArray])
+            for (NSMenuItem* item in [[top submenu] itemArray])
+                if ([item action] == toggle && [item target] != self && [[item target] respondsToSelector:toggle])
+                {
+                    /* The title says what the item would do now, but it is only brought up to
+                     * date when the menu is about to open: ask for that. */
+                    NSMenu* menu = [top submenu];
+                    if ([[menu delegate] respondsToSelector:@selector(menuNeedsUpdate:)])
+                        [[menu delegate] menuNeedsUpdate:menu];
+                    else if ([[item target] respondsToSelector:@selector(menuNeedsUpdate:)])
+                        [(id)[item target] menuNeedsUpdate:menu];
+                    return item;
+                }
+        return nil;
+    }
+
     - (void) applyMetalHUD
     {
+        static BOOL initialStateApplied;
+        NSMenuItem* system;
         BOOL show = [self isMetalHUDShown];
+
         if (!metalHUDAvailable) return;
+        if ((system = [self systemMetalHUDItem]))
+        {
+            NSString* title = [system title];
+            BOOL known = [title hasPrefix:@"Hide"] || [title hasPrefix:@"Show"];
+            BOOL systemShown = [title hasPrefix:@"Hide"];
+
+            if (known && !initialStateApplied)
+            {
+                /* the first time it is there: put it the way the prefix asked for */
+                initialStateApplied = TRUE;
+                if (systemShown != show) [NSApp sendAction:[system action] to:[system target] from:system];
+            }
+            else if (known) show = metalHUDShown = systemShown;
+        }
         for (NSWindow *window in [NSApp windows])
             apply_metal_hud([[window contentView] layer], show);
     }
