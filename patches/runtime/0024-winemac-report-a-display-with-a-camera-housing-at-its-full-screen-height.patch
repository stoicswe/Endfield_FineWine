+/* FineWine: the points to take off the height of a display mode: those the camera housing
+ * costs a full-screen Space (macdrv_finewine_display_top_inset), for modes of the size the
+ * display has now. Other modes are left alone. */
+static int finewine_mode_height_inset(CGDirectDisplayID display_id, CGDisplayModeRef display_mode)
+{
+    int inset = macdrv_finewine_display_top_inset(display_id);
+    CGDisplayModeRef current;
+    BOOL same;
+
+    if (inset <= 0 || !(current = CGDisplayCopyDisplayMode(display_id))) return 0;
+    same = CGDisplayModeGetWidth(current) == CGDisplayModeGetWidth(display_mode) &&
+           CGDisplayModeGetHeight(current) == CGDisplayModeGetHeight(display_mode);
+    CFRelease(current);
+    return (same && inset < CGDisplayModeGetHeight(display_mode) / 2) ? inset : 0;
+}
