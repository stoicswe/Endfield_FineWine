winemac: report a display with a camera housing at its full-screen height

A full-screen Space on a display with a camera housing ends below it: 1512x949 points of
1512x982 on a 14-inch MacBook Pro. A game told the display is 1512x982 renders that, the
picture is squeezed into the Space, and a rescaled picture is never handed to the display
directly (the Metal HUD says "Composited"). When full-screen windows get a Space of their own
(FINEWINE_FULLSCREEN=space), such a display and its display modes of the current size are
reported at the height a full-screen window on it really has: 3024x1898 pixels there. The
other full-screen modes report the whole display. FINEWINE_KEEP_CAMERA_ROWS=1 turns it off.

diff --git a/dlls/winemac.drv/cocoa_display.m b/dlls/winemac.drv/cocoa_display.m
--- a/dlls/winemac.drv/cocoa_display.m
+++ b/dlls/winemac.drv/cocoa_display.m
@@ -865,6 +865,50 @@
 }
 
 /***********************************************************************
+ *              macdrv_finewine_display_top_inset
+ *
+ * FineWine: how many points the top of a display loses to its camera housing, when
+ * full-screen windows get a Space of their own; 0 otherwise.
+ *
+ * A full-screen Space on such a display ends below the housing: 1512x949 points of 1512x982.
+ * A game told the display is 1512x982 renders that, the picture is squeezed into the Space,
+ * and a rescaled picture is never handed to the display directly ("Composited" in the Metal
+ * HUD, and slower). So in that mode the display, and its display modes of that size, are
+ * reported at the height a full-screen window on it really has.
+ */
+extern int macdrv_finewine_fullscreen_mode(void);   /* cocoa_window.m; 2 is "a Space of its own" */
+
+int macdrv_finewine_display_top_inset(CGDirectDisplayID display_id)
+{
+    int inset = 0;
+
+    if (macdrv_finewine_fullscreen_mode() != 2) return 0;
+    if (getenv("FINEWINE_KEEP_CAMERA_ROWS")) return 0;
+@autoreleasepool
+{
+    for (NSScreen* screen in [NSScreen screens])
+    {
+        if ([[screen deviceDescription][@"NSScreenNumber"] unsignedIntValue] != display_id) continue;
+        if (@available(macOS 12.0, *))
+        {
+            CGFloat housing = screen.safeAreaInsets.top;
+            if (housing > 0)
+            {
+                /* A full-screen Space starts where the menu bar ends, which on these displays
+                 * is a point below the housing (33 against 32 on a 14-inch MacBook Pro). The
+                 * menu bar's height is read off the screen when the bar is shown; when it is
+                 * hidden, the housing plus that point is used. */
+                CGFloat bar = NSMaxY(screen.frame) - NSMaxY(screen.visibleFrame);
+                inset = (int)ceil(bar > housing ? bar : housing + 1);
+            }
+        }
+        break;
+    }
+}
+    return inset;
+}
+
+/***********************************************************************
  *              macdrv_get_monitors
  *
  * Get a list of monitors under adapter_id. The first monitor is primary if adapter is primary.
@@ -937,8 +981,21 @@
                     primary_index = monitor_count;
 
                 monitors[monitor_count].id = display_ids[i];
-                monitors[monitor_count].rc_monitor = cgrect_win_from_mac(convert_display_rect(screen.frame, primary_frame));
-                monitors[monitor_count].rc_work = cgrect_win_from_mac(convert_display_rect(screen.visibleFrame, primary_frame));
+                {
+                    /* FineWine: see macdrv_finewine_display_top_inset(). The display is
+                     * reported as tall as a full-screen Space on it is; the rows left out are
+                     * the bottom ones, so that the top-left corner stays where it is. */
+                    NSRect frame = screen.frame, visible = screen.visibleFrame;
+                    int inset = macdrv_finewine_display_top_inset(display_ids[i]);
+                    if (inset > 0 && inset < NSHeight(frame) / 2)
+                    {
+                        frame.origin.y += inset;
+                        frame.size.height -= inset;
+                        visible = NSIntersectionRect(visible, frame);
+                    }
+                    monitors[monitor_count].rc_monitor = cgrect_win_from_mac(convert_display_rect(frame, primary_frame));
+                    monitors[monitor_count].rc_work = cgrect_win_from_mac(convert_display_rect(visible, primary_frame));
+                }
 
                 vendor_number = CGDisplayVendorNumber(monitors[monitor_count].id);
                 model_number = CGDisplayModelNumber(monitors[monitor_count].id);
