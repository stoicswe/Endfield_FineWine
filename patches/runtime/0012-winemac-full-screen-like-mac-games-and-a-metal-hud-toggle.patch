 static BOOL frame_intersects_screens(NSRect frame, NSArray* screens)
 {
     NSScreen* screen;
@@ -849,6 +862,13 @@ - (CALayer*) makeBackingLayer
         layer.magnificationFilter = kCAFilterNearest;
         layer.backgroundColor = CGColorGetConstantColor(kCGColorBlack);
         layer.contentsScale = retina_on ? 2.0 : 1.0;
+        /* FineWine: a new layer starts with Metal's overlay as the user last left it. */
+        if (@available(macOS 13.0, *))
+        {
+            WineApplicationController* controller = [WineApplicationController sharedController];
+            if ([controller isMetalHUDAvailable])
+                layer.developerHUDProperties = [controller isMetalHUDShown] ? @{ @"mode": @"default" } : @{ @"mode": @"off" };
+        }
         return layer;
     }
 
