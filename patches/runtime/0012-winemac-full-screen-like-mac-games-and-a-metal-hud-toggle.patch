             {
                 if (captured)
                     level = CGShieldingWindowLevel() + 1; /* Need +1 or we don't get mouse moves */
@@ -1679,6 +1702,11 @@ - (void) orderBelow:(WineWindow*)prev orAbove:(WineWindow*)next activate:(BOOL)a
                 [controller adjustWindowLevels];
             }
 
+            /* FineWine: a window is only given a Space once it is on screen; if it already
+             * covered the screen when it was shown, this is the moment. */
+            if (!wasVisible && macdrv_finewine_fullscreen_mode() == FINEWINE_FULLSCREEN_SPACE)
+                [self updateFullscreen];
+
             if (pendingMinimize)
             {
                 [self setStyleMask:([self styleMask] | NSWindowStyleMaskMiniaturizable)];
@@ -1761,6 +1789,21 @@ - (void) updateFullscreen
         NSRect contentRect = [self contentRectForFrameRect:self.wine_fractionalFrame];
         BOOL nowFullscreen = !([self styleMask] & NSWindowStyleMaskFullScreen) && screen_covered_by_rect(contentRect, [NSScreen screens]);
 
+        /* FineWine: in "space" mode a window that covers the screen is given a full-screen
+         * Space instead. It is then not full screen in Wine's sense: nothing is raised or hidden. */
+        if (macdrv_finewine_fullscreen_mode() == FINEWINE_FULLSCREEN_SPACE)
+        {
+            BOOL covers = screen_covered_by_rect(contentRect, [NSScreen screens]) != nil;
+            if (!covers) autoFullScreenSuppressed = FALSE;
+            if ([self wine_wantsFullScreenSpace:covers])
+            {
+                nowFullscreen = FALSE;
+                [self wine_enterFullScreenSpace];
+            }
+            else if (autoFullScreen || autoFullScreenSuppressed)
+                nowFullscreen = FALSE;
+        }
+
         if (nowFullscreen != fullscreen)
         {
             WineApplicationController* controller = [WineApplicationController sharedController];
@@ -1773,6 +1816,35 @@ - (void) updateFullscreen
         }
     }
 
+    /* FineWine: whether this window should be moved into a full-screen Space now. Only a
+     * top-level window that is on screen, and only one per program: a second window covering
+     * the screen (a backdrop behind the game, say) stays where it is. */
+    - (BOOL) wine_wantsFullScreenSpace:(BOOL)covers
+    {
+        static NSInteger spaceWindowNumber;
+        WineWindow* other = spaceWindowNumber ? (WineWindow*)[NSApp windowWithWindowNumber:spaceWindowNumber] : nil;
+
+        if (!covers || autoFullScreen || autoFullScreenSuppressed) return FALSE;
+        if ([self styleMask] & NSWindowStyleMaskFullScreen) return FALSE;
+        if (enteringFullScreen || exitingFullScreen) return FALSE;
+        if (![self isVisible] || [self parentWindow] || self.latentParentWindow || self.disabled) return FALSE;
+        if (other && other != self && [other isKindOfClass:[WineWindow class]] && other->autoFullScreen) return FALSE;
+        spaceWindowNumber = [self windowNumber];
+        return TRUE;
+    }
+
+    - (void) wine_enterFullScreenSpace
+    {
+        NSWindowCollectionBehavior behavior = [self collectionBehavior];
+
+        autoFullScreen = TRUE;
+        autoFullScreenExitPending = FALSE;
+        behavior |= NSWindowCollectionBehaviorFullScreenPrimary;
+        behavior &= ~NSWindowCollectionBehaviorFullScreenAuxiliary;
+        [self setCollectionBehavior:behavior];
+        [super toggleFullScreen:nil];
+    }
+
     - (void) setFrameAndWineFrame:(NSRect)frame
     {
         [self setFrame:frame display:YES];
@@ -1811,6 +1883,25 @@ - (void) setFrameFromWine:(NSRect)contentRect
         [queue discardEventsMatchingMask:event_mask_for_type(WINDOW_FRAME_CHANGED)
                                forWindow:self];
 
+        /* FineWine: a window we put in a full-screen Space comes out of it when the program
+         * makes it smaller than the screen again. The new frame is applied once it is out. */
+        if (autoFullScreen && !NSIsEmptyRect(contentRect) &&
+            !screen_covered_by_rect(contentRect, [NSScreen screens]))
+        {
+            nonFullscreenFrame = [self frameRectForContentRect:contentRect];
+            if (enteringFullScreen)
+                autoFullScreenExitPending = TRUE;
+            else if ([self styleMask] & NSWindowStyleMaskFullScreen)
+            {
+                autoFullScreen = FALSE;
+                [super toggleFullScreen:nil];
+            }
+            else
+                autoFullScreen = FALSE;
+            if (enteringFullScreen || exitingFullScreen || ([self styleMask] & NSWindowStyleMaskFullScreen))
+                return;
+        }
+
         if (!NSIsEmptyRect(contentRect))
         {
             NSRect frame, oldFrame;
@@ -2722,6 +2813,12 @@ - (void) windowDidEnterFullScreen:(NSNotification*)notification
         enteredFullScreenTime = [[NSProcessInfo processInfo] systemUptime];
         if (pendingOrderOut)
             [self doOrderOut];
+        else if (autoFullScreen && autoFullScreenExitPending)
+        {
+            /* FineWine: the program made the window smaller while it was on its way in. */
+            autoFullScreen = autoFullScreenExitPending = FALSE;
+            [super toggleFullScreen:nil];
+        }
     }
 
     - (void) windowDidExitFullScreen:(NSNotification*)notification
@@ -2737,6 +2834,8 @@ - (void) windowDidFailToEnterFullScreen:(NSWindow*)window
     {
         enteringFullScreen = FALSE;
         enteredFullScreenTime = 0;
+        autoFullScreen = autoFullScreenExitPending = FALSE;
+        autoFullScreenSuppressed = TRUE;   /* FineWine: do not keep trying */
         if (pendingOrderOut)
             [self doOrderOut];
     }
@@ -2868,6 +2967,13 @@ - (void) windowWillEnterFullScreen:(NSNotification*)notification
     - (void) windowWillExitFullScreen:(NSNotification*)notification
     {
         exitingFullScreen = TRUE;
+        if (autoFullScreen)
+        {
+            /* FineWine: not us, so the user: the green button, or the menu. Leave the window
+             * out of a Space until the program resizes it. */
+            autoFullScreen = FALSE;
+            autoFullScreenSuppressed = TRUE;
+        }
         [self postWindowFrameChanged:nonFullscreenFrame fullscreen:FALSE resizing:FALSE skipSizeMove:FALSE];
     }
 
