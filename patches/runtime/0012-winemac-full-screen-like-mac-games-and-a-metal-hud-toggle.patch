+    /* FineWine: Metal's performance overlay ("HUD"), shown and hidden while the program runs.
+     *
+     * Metal only has the overlay in a process that was started with MTL_HUD_ENABLED=1; in
+     * such a process each Metal layer's developerHUDProperties then decide whether it is
+     * drawn ("mode" "default" or "off"). So FineWine starts programs with the overlay
+     * available, and FINEWINE_METAL_HUD says whether it starts out shown (1) or hidden (0).
+     * Without FINEWINE_METAL_HUD the overlay is simply as MTL_HUD_ENABLED left it. */
+    static BOOL metalHUDStateKnown, metalHUDShown, metalHUDAvailable;
+
+    - (BOOL) isMetalHUDAvailable
+    {
+        [self isMetalHUDShown];
+        return metalHUDAvailable;
+    }
+
+    - (BOOL) isMetalHUDShown
+    {
+        if (!metalHUDStateKnown)
+        {
+            const char *enabled = getenv("MTL_HUD_ENABLED");
+            const char *shown = getenv("FINEWINE_METAL_HUD");
+            metalHUDAvailable = enabled && atoi(enabled) != 0;
+            metalHUDShown = metalHUDAvailable && (!shown || atoi(shown) != 0);
+            metalHUDStateKnown = TRUE;
+            /* Layers that do not come from Wine's own Metal view (a Direct3D layer may make
+             * its own) are found by looking again now and then. */
+            if (metalHUDAvailable && shown)
+                [NSTimer scheduledTimerWithTimeInterval:3.0 target:self selector:@selector(applyMetalHUD)
+                                               userInfo:nil repeats:YES];
+        }
+        return metalHUDShown;
+    }
+
+    static void apply_metal_hud(CALayer *layer, BOOL show)
+    {
+        if ([layer isKindOfClass:[CAMetalLayer class]])
+        {
+            if (@available(macOS 13.0, *))
+                ((CAMetalLayer *)layer).developerHUDProperties = show ? @{ @"mode": @"default" } : @{ @"mode": @"off" };
+        }
+        for (CALayer *sub in [[layer.sublayers copy] autorelease])
+            apply_metal_hud(sub, show);
+    }
+
+    - (void) applyMetalHUD
+    {
+        BOOL show = [self isMetalHUDShown];
+        if (!metalHUDAvailable) return;
+        for (NSWindow *window in [NSApp windows])
+            apply_metal_hud([[window contentView] layer], show);
+    }
+
+    - (void) toggleMetalHUD:(id)sender
+    {
+        if (![self isMetalHUDAvailable]) return;
+        metalHUDShown = !metalHUDShown;
+        [self applyMetalHUD];
+        /* A layer the program is about to make, or has in a view that is not attached yet,
+         * is caught by going round again shortly. */
+        [self performSelector:@selector(applyMetalHUD) withObject:nil afterDelay:1.0];
+        [self performSelector:@selector(applyMetalHUD) withObject:nil afterDelay:4.0];
+    }
+
+    - (BOOL) validateMenuItem:(NSMenuItem *)menuItem
+    {
+        if ([menuItem action] == @selector(toggleMetalHUD:))
+        {
+            [menuItem setTitle:[self isMetalHUDShown] ? @"Hide Metal HUD" : @"Show Metal HUD"];
+            return [self isMetalHUDAvailable];
+        }
+        return TRUE;
+    }
+
     - (void) updateFullscreenWindows
     {
+        /* FineWine: in "borderless" mode a full-screen window is an ordinary window, so the
+         * menu bar and the Dock are asked to keep out of its way until the pointer reaches
+         * them. The options only apply while this app is the active one. */
+        if (macdrv_finewine_fullscreen_mode() == FINEWINE_FULLSCREEN_BORDERLESS)
+        {
+            BOOL anyFullscreen = FALSE;
+            NSNumber* windowNumber;
+            for (windowNumber in [NSWindow windowNumbersWithOptions:0])
+            {
+                WineWindow* window = (WineWindow*)[NSApp windowWithWindowNumber:[windowNumber integerValue]];
+                if ([window isKindOfClass:[WineWindow class]] && window.fullscreen)
+                {
+                    anyFullscreen = TRUE;
+                    break;
+                }
+            }
+            [NSApp setPresentationOptions:anyFullscreen ? (NSApplicationPresentationAutoHideMenuBar | NSApplicationPresentationAutoHideDock)
+                                                        : NSApplicationPresentationDefault];
+        }
+
         if (capture_displays_for_fullscreen && [NSApp isActive])
         {
             BOOL anyFullscreen = FALSE;
@@ -1803,6 +1909,16 @@ - (BOOL) handleEvent:(NSEvent*)anEvent
             [self handleScrollWheel:anEvent];
             ret = mouseCaptureWindow != nil;
         }
+        else if (type == NSEventTypeKeyDown &&
+                 [anEvent keyCode] == kVK_F12 && ![anEvent isARepeat] &&
+                 ([anEvent modifierFlags] & (NSEventModifierFlagOption | NSEventModifierFlagCommand |
+                                             NSEventModifierFlagControl | NSEventModifierFlagShift)) == NSEventModifierFlagOption)
+        {
+            /* FineWine: Option-F12 shows and hides Metal's performance overlay. Handled here,
+             * ahead of the program, because a key without Command never reaches the menu. */
+            [self toggleMetalHUD:nil];
+            ret = TRUE;
+        }
         else if (type == NSEventTypeKeyDown)
         {
             // -[NSApplication sendEvent:] seems to consume presses of the Help
diff --git a/dlls/winemac.drv/cocoa_window.h b/dlls/winemac.drv/cocoa_window.h
index a5ee46d..e77177a 100644
--- a/dlls/winemac.drv/cocoa_window.h
+++ b/dlls/winemac.drv/cocoa_window.h
@@ -25,6 +25,17 @@
 @class WineEventQueue;
 
 
+/* FineWine: how a window that covers the screen (a Windows program's full-screen window) is
+ * presented. FINEWINE_FULLSCREEN in the environment picks one:
+ *   unset, "exclusive"  Wine's own way: the window is raised above the menu bar and the Dock.
+ *   "borderless"        The window stays an ordinary window on the desktop; the menu bar and
+ *                       the Dock hide and come back when the pointer reaches the screen's edge.
+ *   "space"             The window gets a full-screen Space of its own, as a Mac game's does:
+ *                       the menu bar appears at the top edge, swiping goes back to the desktop,
+ *                       notifications are shown over it, Mission Control shows it as an app. */
+enum { FINEWINE_FULLSCREEN_EXCLUSIVE, FINEWINE_FULLSCREEN_BORDERLESS, FINEWINE_FULLSCREEN_SPACE };
+int macdrv_finewine_fullscreen_mode(void);
+
 @interface WineWindow : NSPanel <NSWindowDelegate>
 {
     BOOL disabled;
@@ -68,6 +79,11 @@ @interface WineWindow : NSPanel <NSWindowDelegate>
     NSRect nonFullscreenFrame;
     NSTimeInterval enteredFullScreenTime;
 
+    /* FineWine: full-screen windows the way a Mac game has them. See macdrv_finewine_fullscreen_mode(). */
+    BOOL autoFullScreen;            /* we put this window in a full-screen Space ourselves */
+    BOOL autoFullScreenSuppressed;  /* the user took it out again; leave it out until it stops covering the screen */
+    BOOL autoFullScreenExitPending; /* it stopped covering the screen while it was still on its way in */
+
     int draggingPhase;
     NSPoint dragStartPosition;
     NSPoint dragWindowStartPosition;
diff --git a/dlls/winemac.drv/cocoa_window.m b/dlls/winemac.drv/cocoa_window.m
index 1ec3729..f45efcb 100644
--- a/dlls/winemac.drv/cocoa_window.m
+++ b/dlls/winemac.drv/cocoa_window.m
@@ -85,6 +85,19 @@ static NSUInteger style_mask_for_features(const struct macdrv_window_features* w
 }
 
 
+int macdrv_finewine_fullscreen_mode(void)
+{
+    static int mode = -1;
+    if (mode < 0)
+    {
+        const char *value = getenv("FINEWINE_FULLSCREEN");
+        if (value && !strcmp(value, "space")) mode = FINEWINE_FULLSCREEN_SPACE;
+        else if (value && !strcmp(value, "borderless")) mode = FINEWINE_FULLSCREEN_BORDERLESS;
+        else mode = FINEWINE_FULLSCREEN_EXCLUSIVE;
+    }
+    return mode;
+}
