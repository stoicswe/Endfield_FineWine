--- a/dlls/winemac.drv/cocoa_display.m
+++ b/dlls/winemac.drv/cocoa_display.m
@@ -862,8 +862,89 @@
 
     data = CFDataCreate(NULL, edid, 128);
     return data;
+}
+
+/***********************************************************************
+ *              macdrv_finewine_display_top_inset
+ *
+ * FineWine: how many points the top of a display loses to its camera housing, when
+ * full-screen windows get a Space of their own; 0 otherwise.
+ *
+ * A full-screen Space on such a display ends below the housing: 1512x949 points of 1512x982.
+ * A game told the display is 1512x982 sizes its window to that, macOS keeps the window at
+ * 1512x949, and the bottom of the picture is cut off and clicks land 33 points low. So in
+ * that mode the display is, for Windows programs, the part below the housing: it is reported
+ * at that height, its display modes of the current size likewise, and Windows' screen
+ * coordinates start there (macdrv_finewine_primary_top_inset). A window covering "the
+ * display" then is exactly the size of its Space: nothing is cut off or rescaled, and
+ * positions agree. The rows beside the housing only ever hold the menu bar.
+ * FINEWINE_KEEP_CAMERA_ROWS=1 turns this off.
+ */
+extern int macdrv_finewine_fullscreen_mode(void);   /* cocoa_window.m; 2 is "a Space of its own" */
+
+static int finewine_screen_top_inset(NSScreen* screen)
+{
+    int inset = 0;
+
+    if (macdrv_finewine_fullscreen_mode() != 2) return 0;
+    if (getenv("FINEWINE_KEEP_CAMERA_ROWS")) return 0;
+    if (@available(macOS 12.0, *))
+    {
+        CGFloat housing = screen.safeAreaInsets.top;
+        if (housing > 0)
+        {
+            /* A full-screen Space starts where the menu bar ends, which on these displays
+             * is a point below the housing (33 against 32 on a 14-inch MacBook Pro). The
+             * menu bar's height is read off the screen when the bar is shown; when it is
+             * hidden, the housing plus that point is used. */
+            CGFloat bar = NSMaxY(screen.frame) - NSMaxY(screen.visibleFrame);
+            inset = (int)ceil(bar > housing ? bar : housing + 1);
+            if (inset >= NSHeight(screen.frame) / 2) inset = 0;
+        }
+    }
+    return inset;
+}
+
+int macdrv_finewine_display_top_inset(CGDirectDisplayID display_id)
+{
+    int inset = 0;
+@autoreleasepool
+{
+    for (NSScreen* screen in [NSScreen screens])
+    {
+        if ([[screen deviceDescription][@"NSScreenNumber"] unsignedIntValue] != display_id) continue;
+        inset = finewine_screen_top_inset(screen);
+        break;
+    }
 }
+    return inset;
+}
 
+/* The same for the primary display, which is where Windows' screen coordinates start: they
+ * begin this many points below the top of the Mac's. Asked for with every mouse event, so
+ * the answer is kept until the displays change. */
+static int finewine_primary_inset = -1;
+
+int macdrv_finewine_primary_top_inset(void)
+{
+    int inset = finewine_primary_inset;
+    if (inset < 0)
+    {
+@autoreleasepool
+{
+        NSArray<NSScreen*>* screens = [NSScreen screens];
+        inset = [screens count] ? finewine_screen_top_inset(screens[0]) : 0;
+        finewine_primary_inset = inset;
+}
+    }
+    return inset;
+}
+
+void macdrv_finewine_displays_changed(void)
+{
+    finewine_primary_inset = -1;
+}
+
 /***********************************************************************
  *              macdrv_get_monitors
  *
@@ -937,8 +1018,17 @@
                     primary_index = monitor_count;
 
                 monitors[monitor_count].id = display_ids[i];
-                monitors[monitor_count].rc_monitor = cgrect_win_from_mac(convert_display_rect(screen.frame, primary_frame));
-                monitors[monitor_count].rc_work = cgrect_win_from_mac(convert_display_rect(screen.visibleFrame, primary_frame));
+                {
+                    /* FineWine: see macdrv_finewine_display_top_inset(). The display is
+                     * reported without the rows its camera housing is in, and everything
+                     * is measured from below the primary display's. */
+                    NSRect frame = screen.frame, visible = screen.visibleFrame, primary = primary_frame;
+                    frame.size.height -= macdrv_finewine_display_top_inset(display_ids[i]);
+                    primary.size.height -= macdrv_finewine_primary_top_inset();
+                    visible = NSIntersectionRect(visible, frame);
+                    monitors[monitor_count].rc_monitor = cgrect_win_from_mac(convert_display_rect(frame, primary));
+                    monitors[monitor_count].rc_work = cgrect_win_from_mac(convert_display_rect(visible, primary));
+                }
 
                 vendor_number = CGDisplayVendorNumber(monitors[monitor_count].id);
                 model_number = CGDisplayModelNumber(monitors[monitor_count].id);
