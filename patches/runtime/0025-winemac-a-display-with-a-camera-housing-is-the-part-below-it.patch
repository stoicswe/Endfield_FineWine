diff --git a/dlls/winemac.drv/cocoa_app.h b/dlls/winemac.drv/cocoa_app.h
--- a/dlls/winemac.drv/cocoa_app.h
+++ b/dlls/winemac.drv/cocoa_app.h
@@ -154,3 +154,30 @@
 
 
 void OnMainThreadAsync(dispatch_block_t block);
+
+/* FineWine: Windows' screen coordinates start below the primary display's camera housing
+ * when full-screen windows get a Space of their own (macdrv_finewine_display_top_inset in
+ * cocoa_display.m). Quartz measures from the very top, so every position that passes
+ * between the two is moved by that much, here, in one place. */
+static inline CGPoint finewine_CGEventGetLocation(CGEventRef event)
+{
+    CGPoint point = CGEventGetLocation(event);
+    point.y -= macdrv_finewine_primary_top_inset();
+    return point;
+}
+
+static inline void finewine_CGEventSetLocation(CGEventRef event, CGPoint point)
+{
+    point.y += macdrv_finewine_primary_top_inset();
+    CGEventSetLocation(event, point);
+}
+
+static inline CGError finewine_CGWarpMouseCursorPosition(CGPoint point)
+{
+    point.y += macdrv_finewine_primary_top_inset();
+    return CGWarpMouseCursorPosition(point);
+}
+
+#define CGEventGetLocation finewine_CGEventGetLocation
+#define CGEventSetLocation finewine_CGEventSetLocation
+#define CGWarpMouseCursorPosition finewine_CGWarpMouseCursorPosition
