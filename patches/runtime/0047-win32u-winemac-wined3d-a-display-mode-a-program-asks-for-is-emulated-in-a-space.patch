+        if (context) SetThreadDpiAwarenessContext(context);
+    }
+    else
+        SetWindowPos(s->window, s->window_pos_after, s->x, s->y, s->width, s->height, s->flags);
 
     wined3d_filter_messages(s->window, filter);
 
@@ -2396,6 +2408,7 @@
     s->y = y;
     s->width = width;
     s->height = height;
+    s->physical_pixels = true;
 
     if (state->style || state->exstyle)
     {
@@ -2438,6 +2451,7 @@
 
     if (!(s = malloc(sizeof(*s))))
         return;
+    s->physical_pixels = false;
 
     s->window = window;
     s->window_pos_after = NULL;
@@ -2581,8 +2595,13 @@
 
             /* Fullscreen -> fullscreen mode change */
             filter = wined3d_filter_messages(window, TRUE);
-            MoveWindow(window, output_desc.desktop_rect.left, output_desc.desktop_rect.top, width,
-                    height, TRUE);
+            {
+                /* FineWine: a mode's size is in real pixels, see struct wined3d_window_state */
+                DPI_AWARENESS_CONTEXT context = SetThreadDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE);
+                MoveWindow(window, output_desc.desktop_rect.left, output_desc.desktop_rect.top, width,
+                        height, TRUE);
+                if (context) SetThreadDpiAwarenessContext(context);
+            }
             ShowWindow(window, SW_SHOW);
             wined3d_filter_messages(window, filter);
         }
