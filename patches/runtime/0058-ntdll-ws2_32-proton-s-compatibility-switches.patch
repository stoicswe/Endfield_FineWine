+/* FineWine: WINE_BLOCK_HOSTS, Proton's list of host names that are not to be found: names
+ * separated by commas or semicolons, each matching itself and its subdomains. Up to 16. */
+static BOOL should_block_host( const char *name )
+{
+    static char list[16][256];
+    static LONG loaded;
+    unsigned int i;
+
+    if (!name || !*name) return FALSE;
+    if (!InterlockedExchange( &loaded, 1 ))
+    {
+        char value[16 * 256], *host, *next = NULL;
+        unsigned int count = 0;
+
+        if (GetEnvironmentVariableA( "WINE_BLOCK_HOSTS", value, sizeof(value) ) - 1 < sizeof(value) - 1)
+            for (host = strtok_s( value, ",;", &next ); host && count < ARRAY_SIZE(list); host = strtok_s( NULL, ",;", &next ))
+                if (*host && strlen( host ) < sizeof(list[0])) strcpy( list[count++], host );
+    }
+    for (i = 0; i < ARRAY_SIZE(list) && list[i][0]; i++)
+    {
+        size_t len = strlen( name ), host_len = strlen( list[i] );
+        if (len < host_len || _stricmp( name + len - host_len, list[i] )) continue;
+        if (len == host_len || name[len - host_len - 1] == '.')
+        {
+            WARN( "blocking host %s, listed as %s\n", debugstr_a(name), debugstr_a(list[i]) );
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
