+/* FineWine: for programs that depend on how Windows' heap happens to behave; the names and
+ * meanings are Proton's.
+ *  WINE_HEAP_DELAY_FREE=1   freed blocks are kept for a while before they are reused, for
+ *                           programs that read memory they have just freed
+ *  WINE_HEAP_ZERO_MEMORY=1  every heap hands out zeroed memory, for programs that read memory
+ *                           they never wrote
+ *  WINE_HEAP_TOP_DOWN=1     heaps are placed from the top of the address space down */
+BOOL delay_heap_free = FALSE;
+BOOL heap_zero_hack = FALSE;
+BOOL heap_top_down_hack = FALSE;
+
 static void *allocate_region( struct heap *heap, ULONG flags, SIZE_T *region_size, SIZE_T *commit_size )
 {
     const SIZE_T align = 0x400 * sizeof(void*);  /* minimum alignment for virtual allocations */
@@ -984,7 +995,8 @@
     *commit_size = ROUND_SIZE( *commit_size, align - 1 );
 
     /* allocate the memory block */
-    if ((status = NtAllocateVirtualMemory( NtCurrentProcess(), &addr, 0, region_size, MEM_RESERVE,
+    if ((status = NtAllocateVirtualMemory( NtCurrentProcess(), &addr, 0, region_size,
+                                           heap_top_down_hack ? MEM_RESERVE | MEM_TOP_DOWN : MEM_RESERVE,
                                            get_protection_type( flags ) )))
     {
         WARN( "Could not allocate %#Ix bytes, status %#lx\n", *region_size, status );
@@ -1483,8 +1495,8 @@
         }
     }
 
-    if ((heap->flags & HEAP_GROWABLE) && !heap->pending_free &&
-        ((flags & HEAP_FREE_CHECKING_ENABLED) || RUNNING_ON_VALGRIND))
+    if (delay_heap_free || ((heap->flags & HEAP_GROWABLE) && !heap->pending_free &&
+        ((flags & HEAP_FREE_CHECKING_ENABLED) || RUNNING_ON_VALGRIND)))
     {
         heap->pending_free = RtlAllocateHeap( handle, HEAP_ZERO_MEMORY,
                                               MAX_FREE_PENDING * sizeof(*heap->pending_free) );
@@ -1508,6 +1520,8 @@
     TRACE( "flags %#lx, addr %p, total_size %#Ix, commit_size %#Ix, lock %p, params %p\n",
            flags, addr, total_size, commit_size, lock, params );
 
+    if (heap_zero_hack) flags |= HEAP_ZERO_MEMORY;
+
     flags &= ~(HEAP_TAIL_CHECKING_ENABLED|HEAP_FREE_CHECKING_ENABLED);
     if (process_heap) flags |= HEAP_PRIVATE;
     if (!process_heap || !total_size || (flags & HEAP_SHARED)) flags |= HEAP_GROWABLE;
@@ -2614,7 +2628,8 @@
             FIXME( "HeapCompatibilityInformation %lu not implemented!\n", compat_info );
             return STATUS_UNSUCCESSFUL;
         }
-        if (InterlockedCompareExchange( &heap->compat_info, compat_info, HEAP_STD ) != HEAP_STD)
+        /* FineWine: the low-fragmentation front end has no delay; with the switch it stays off */
+        if (!delay_heap_free && InterlockedCompareExchange( &heap->compat_info, compat_info, HEAP_STD ) != HEAP_STD)
             return STATUS_UNSUCCESSFUL;
         return STATUS_SUCCESS;
     }
diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -2057,9 +2057,47 @@
         RtlLeaveCriticalSection( &loader_section );
     }
     return STATUS_SUCCESS;
+}
+
+
+/* FineWine: switches that are read once, before the process heap exists. */
+static BOOL hide_wine_exports;
+
+static BOOL finewine_env_is_one( const WCHAR *var )
+{
+    WCHAR buffer[8];
+    UNICODE_STRING name, value;
+
+    RtlInitUnicodeString( &name, var );
+    value.Length = 0;
+    value.MaximumLength = sizeof(buffer);
+    value.Buffer = buffer;
+    return !RtlQueryEnvironmentVariable_U( NULL, &name, &value ) && value.Length == sizeof(WCHAR) && buffer[0] == '1';
+}
+
+static void finewine_compat_init(void)
+{
+    delay_heap_free = finewine_env_is_one( L"WINE_HEAP_DELAY_FREE" );
+    heap_zero_hack = finewine_env_is_one( L"WINE_HEAP_ZERO_MEMORY" );
+    heap_top_down_hack = finewine_env_is_one( L"WINE_HEAP_TOP_DOWN" );
+    /* Some programs refuse to run when ntdll has Wine's own exports. With this they are not
+     * found by name. The runtime's own parts (the x64 emulator) ask for them under the names
+     * __finewine_get_version and __finewine_get_host_version, which stay. */
+    hide_wine_exports = finewine_env_is_one( L"FINEWINE_HIDE_WINE_EXPORTS" );
 }
 
+static BOOL is_hidden_export( const ANSI_STRING *name )
+{
+    static const char * const hidden[] = { "wine_get_version", "wine_get_build_id", "wine_get_host_version" };
+    unsigned int i;
 
+    if (!hide_wine_exports || !name || !name->Buffer) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(hidden); i++)
+        if (name->Length == strlen( hidden[i] ) && !memcmp( name->Buffer, hidden[i], name->Length )) return TRUE;
+    return FALSE;
+}
+
+
