+++ b/dlls/ntdll/unix/loader.c
@@ -2138,9 +2138,37 @@
 /***********************************************************************
  *           start_main_thread
  */
+/* FineWine: compatibility switches for programs that depend on a detail of Windows or of the
+ * machine. The names and meanings are Proton's, so that what is known to help a game there
+ * can be used as it is; the app sets them for games it knows (GameFixes.swift).
+ *  WINE_DISABLE_SFN=1          files have no 8.3 short names
+ *  WINE_RAM_REPORTING_BIAS=n   n megabytes less memory is reported than there is
+ *  WINE_CPU_TOPOLOGY=n[:...]   no more than n processors are reported. Proton also pins the
+ *                              program to the processors listed after the colon; macOS has no
+ *                              way to do that, so only the count is used. */
+BOOL disable_sfn;
+long long ram_reporting_bias;
+unsigned int cpu_count_limit;
+
+static void finewine_compat_init(void)
+{
+    const char *env;
+
+    if ((env = getenv( "WINE_DISABLE_SFN" ))) disable_sfn = !!atoi( env );
+    if ((env = getenv( "WINE_RAM_REPORTING_BIAS" ))) ram_reporting_bias = atoll( env ) * 1024 * 1024;
+    if (ram_reporting_bias < 0) ram_reporting_bias = 0;
+    if ((env = getenv( "WINE_CPU_TOPOLOGY" )))
+    {
+        int count = atoi( env );
+        if (count > 0) cpu_count_limit = count;
+    }
+}
+
 static void start_main_thread(void)
 {
     struct thread_data *data = virtual_alloc_first_thread_data();
+
+    finewine_compat_init();
 
     server_init_process( data );
     msync_init();
