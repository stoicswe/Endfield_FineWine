                           : find_ordinal_export( module, exports, exp_size, ord - exports->Base, NULL, wm, TRUE );
+        if (proc && is_hidden_export( name ) && !wcsicmp( wm->ldr.BaseDllName.Buffer, L"ntdll.dll" )) proc = NULL;
         if (proc)
         {
             *address = proc;
