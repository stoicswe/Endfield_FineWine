 }
 
+/* FineWine 32-bit: ULongToPtr() adds the base of a 32-bit program's memory window (see
+ * include/basetsd.h), which is right for an address and wrong for a number. */
+
+/* An array of offsets or sizes. */
+static inline void *copy_wow64_intptrs( UINT_PTR address, ULONG count )
+{
+    ULONG *values = ULongToPtr( address );
+    UINT_PTR *tmp;
+
+    if (!values || !(tmp = calloc( count, sizeof(*tmp) ))) return NULL;
+    while (count--) tmp[count] = values[count];
+    return tmp;
+}
+
+/* An argument that is an address in the program's memory, or, while a buffer object is bound
+ * to the binding point it is read through, an offset into that buffer. */
+static inline BOOL wow64_gl_buffer_bound( TEB *teb, GLenum binding )
+{
+    const struct opengl_funcs *funcs = teb->glTable;
+    GLint name = 0;
+
+    if (funcs && funcs->p_glGetIntegerv) funcs->p_glGetIntegerv( binding, &name );
+    return name != 0;
+}
+
+static inline void *wow64_gl_ptr( TEB *teb, GLenum binding, ULONG value )
+{
+    if (value >= 0x10000 && wow64_gl_buffer_bound( teb, binding )) return (void *)(UINT_PTR)value;
+    return ULongToPtr( value );
+}
+
+static inline void *copy_wow64_gl_ptrs( TEB *teb, GLenum binding, UINT_PTR address, ULONG count )
+{
+    if (wow64_gl_buffer_bound( teb, binding )) return copy_wow64_intptrs( address, count );
+    return copy_wow64_ptr32s( address, count );
+}
+
 static inline TEB *get_teb64( ULONG teb32 )
 {
     TEB32 *teb32_ptr = ULongToPtr( teb32 );
