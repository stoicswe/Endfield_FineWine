 // FineWine: the program's own name, and making macOS use it.
 static NSString* finewineApplicationName;
+
+// FineWine: the program's Windows file with its folder ("Arknights Endfield/Endfield.exe").
+static NSString* finewineProgramFile;
+
+// FineWine: Discord recognises a game on the Mac by the file name of a running app, and
+// only looks at processes that macOS lists as apps, are not inside an app bundle, and have a
+// window (found by trying; see runtime-extras/presence-helper/presence.m). This process runs
+// from a bundle of the program's name, for the Dock and Game Mode, so its Windows file name
+// is not seen. A small program is therefore started next to it under that file name:
+// <prefix>/.finewine-apps/presence/<folder>/<file>, a copy of the runtime's finewine-presence.
+// It has no Dock icon and ends when this process does. FINEWINE_GAME_PRESENCE=0 turns it off.
+static void finewine_start_presence(void)
+{
+    static BOOL started;
+    const char *off = getenv("FINEWINE_GAME_PRESENCE"), *prefix = getenv("WINEPREFIX");
+    NSFileManager* fm = [NSFileManager defaultManager];
+    NSString *source, *dest;
+    NSDictionary *have, *want;
+    const char *path;
+    char game[16];
+    Dl_info info;
+    pid_t child;
+    int status, fd;
+
+    if (started || ![finewineProgramFile length]) return;
+    started = TRUE;
+    if ((off && off[0] == '0') || !prefix || prefix[0] != '/') return;
+    if ([finewineProgramFile hasPrefix:@"."] || [finewineProgramFile rangeOfString:@"/."].length) return;
+    if (!dladdr((void*)finewine_start_presence, &info) || !info.dli_fname) return;
+
+    source = [[[NSString stringWithUTF8String:info.dli_fname] stringByDeletingLastPathComponent]
+                 stringByAppendingPathComponent:@"finewine-presence"];
+    dest = [[[NSString stringWithUTF8String:prefix] stringByAppendingPathComponent:@".finewine-apps/presence"]
+               stringByAppendingPathComponent:finewineProgramFile];
+    if (!(want = [fm attributesOfItemAtPath:source error:NULL])) return;
+
+    // The copy is made again when the runtime's program has changed.
+    have = [fm attributesOfItemAtPath:dest error:NULL];
+    if (!have || ![[have fileModificationDate] isEqual:[want fileModificationDate]] || [have fileSize] != [want fileSize])
+    {
+        NSString* temp = [dest stringByAppendingFormat:@".%d", getpid()];
+        [fm createDirectoryAtPath:[dest stringByDeletingLastPathComponent] withIntermediateDirectories:YES attributes:nil error:NULL];
+        [fm removeItemAtPath:temp error:NULL];
+        if (![fm copyItemAtPath:source toPath:temp error:NULL]) return;
+        if (rename([temp fileSystemRepresentation], [dest fileSystemRepresentation]))
+        {
+            [fm removeItemAtPath:temp error:NULL];
+            return;
+        }
+    }
+
+    // Started through a process that ends at once, so that nothing is left for this one to
+    // wait for. Only calls that are safe after fork() are made in the new processes.
+    path = [dest fileSystemRepresentation];
+    snprintf(game, sizeof(game), "%d", getpid());
+    if ((child = fork()) == -1) return;
+    if (!child)
+    {
+        if (!fork())
+        {
+            char* const argv[] = { (char*)path, game, NULL };
+            for (fd = 3; fd < 1024; fd++) close(fd);
+            execv(path, argv);
+        }
+        _exit(0);
+    }
+    while (waitpid(child, &status, 0) == -1 && errno == EINTR) ;
+}
 
