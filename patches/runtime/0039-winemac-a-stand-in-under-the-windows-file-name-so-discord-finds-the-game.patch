+/* FineWine: the program's file as an app that looks for running games by file name knows it:
+ * the file name with the folder it is in ("Arknights Endfield/Endfield.exe"). Windows' own
+ * programs are left out. See finewine_start_presence() in cocoa_app.m. */
+static void finewine_note_program_file(void)
+{
+    static const WCHAR windows[] = {'c',':','\\','w','i','n','d','o','w','s','\\'};
+    UNICODE_STRING *image = &NtCurrentTeb()->Peb->ProcessParameters->ImagePathName;
+    const WCHAR *path = image->Buffer, *end = path + image->Length / sizeof(WCHAR), *base, *folder, *p;
+    WCHAR file[520];
+    CFStringRef string;
+    UINT i, len;
+
+    if (!path || path == end) return;
+    if (end - path > ARRAY_SIZE(windows))
+    {
+        for (i = 0; i < ARRAY_SIZE(windows); i++)
+            if ((path[i] < 0x80 ? tolower( path[i] ) : path[i]) != windows[i]) break;
+        if (i == ARRAY_SIZE(windows)) return;
+    }
+    for (base = path, p = path; p < end; p++) if (*p == '\\' || *p == '/') base = p + 1;
+    if (base == end) return;
+    for (folder = path, p = path; p + 1 < base; p++) if (*p == '\\' || *p == '/') folder = p + 1;
+    /* a program in the root of a drive has no folder to go with it */
+    if (folder == path || base - folder < 2) folder = base;
+    len = end - folder;
+    if (len >= ARRAY_SIZE(file)) return;
+    for (i = 0; i < len; i++) file[i] = (folder[i] == '\\') ? '/' : folder[i];
+    if ((string = CFStringCreateWithCharacters( NULL, (const UniChar *)file, len )))
+    {
+        macdrv_set_program_file( string );
         CFRelease( string );
     }
 }
