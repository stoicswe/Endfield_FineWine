+    /* FineWine: Windows programs that draw their own title bar (launchers, most games' windows)
+     * get a borderless Mac window, which has square corners where every Mac window's are round.
+     * Such a window is given round corners, unless it is not really an app window:
+     *   - one with a Mac title bar is rounded by macOS already;
+     *   - a full-screen one, or one covering its screen, has no corners to round;
+     *   - a small one is a menu, a tooltip or a splash image;
+     *   - one with a shape or per-pixel transparency of its own already looks as its program
+     *     wants.
+     * FINEWINE_ROUNDED_WINDOWS=0 turns it off. */
+    - (BOOL) wine_wantsRoundedCorners
+    {
+        static int enabled = -1;
+        WineContentView* view = self.contentView;
+        NSRect frame = self.frame;
+        NSScreen* screen = self.screen;
+
+        if (enabled < 0)
+        {
+            const char* setting = getenv("FINEWINE_ROUNDED_WINDOWS");
+            enabled = !(setting && setting[0] == '0');
         }
+        if (!enabled) return NO;
+        if ([self styleMask] & (NSWindowStyleMaskTitled | NSWindowStyleMaskFullScreen)) return NO;
+        if (fullscreen || autoFullScreen) return NO;
+        if (NSWidth(frame) < 280 || NSHeight(frame) < 180) return NO;
+        if (screen && NSWidth(frame) >= NSWidth(screen.frame) && NSHeight(frame) >= NSHeight(screen.frame) - 40) return NO;
+        if ([self level] > NSFloatingWindowLevel) return NO;
+        if (view.layer.mask || [view hasShapeImage] || self.usePerPixelAlpha) return NO;
+        return YES;
+    }
+
+    - (void) wine_updateRoundedCorners
+    {
+        CALayer* layer = [[self contentView] layer];
+        BOOL want = [self wine_wantsRoundedCorners];
+
+        if (!layer || want == roundedCorners) return;
+        roundedCorners = want;
+        layer.cornerRadius = want ? 12 : 0;
+        layer.cornerCurve = kCACornerCurveContinuous;
+        layer.masksToBounds = want;
+        [self checkTransparency];
+        [self invalidateShadow];
     }
 
     - (BOOL) needsTransparency
     {
         WineContentView *view = self.contentView;
-        return self.contentView.layer.mask || [view hasShapeImage] || self.usePerPixelAlpha ||
+        return roundedCorners || self.contentView.layer.mask || [view hasShapeImage] || self.usePerPixelAlpha ||
                 (gl_surface_mode == GL_SURFACE_BEHIND && [view hasGLDescendant]);
     }
 
