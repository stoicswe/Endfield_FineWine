@@ -552,6 +556,8 @@ static struct fallback_locale * font_fallback_get_locale(const struct list *loca
         const WCHAR *locale_name, bool use_neutral)
 {
     struct fallback_locale *locale, *neutral = NULL;
+    WCHAR parent[LOCALE_NAME_MAX_LENGTH];
+    const WCHAR *dash;
 
     LIST_FOR_EACH_ENTRY(locale, locales, struct fallback_locale, entry)
     {
@@ -559,6 +565,30 @@ static struct fallback_locale * font_fallback_get_locale(const struct list *loca
         if (use_neutral && !*locale->name) neutral = locale;
     }
 
+    /* FineWine: programs pass a region locale ("zh-CN", "ja-JP", "ko-KR") where the mappings are
+     * made for a script or a language ("zh-Hans", "ja", "ko"); with only exact names matching,
+     * Chinese and Korean text fell back as if it had no locale and shared Han characters took
+     * their Japanese forms. Try the script (Chinese) or the language, as Windows does. */
+    parent[0] = 0;
+    if (!wcsnicmp(locale_name, L"zh", 2) && (!locale_name[2] || locale_name[2] == '-'))
+    {
+        if (wcsstr(locale_name, L"Hant") || wcsstr(locale_name, L"hant") ||
+            !wcsicmp(locale_name, L"zh-TW") || !wcsicmp(locale_name, L"zh-HK") || !wcsicmp(locale_name, L"zh-MO"))
+            wcscpy(parent, L"zh-Hant");
+        else
+            wcscpy(parent, L"zh-Hans");
+    }
+    else if ((dash = wcschr(locale_name, '-')) && dash - locale_name < ARRAY_SIZE(parent))
+    {
+        memcpy(parent, locale_name, (dash - locale_name) * sizeof(WCHAR));
+        parent[dash - locale_name] = 0;
+    }
+    if (parent[0] && wcsicmp(parent, locale_name))
+    {
+        LIST_FOR_EACH_ENTRY(locale, locales, struct fallback_locale, entry)
+            if (!wcsicmp(locale->name, parent)) return locale;
+    }
+
     return neutral;
 }
 
diff --git a/dlls/win32u/font.c b/dlls/win32u/font.c
index 97936e9..9842a31 100644
--- a/dlls/win32u/font.c
+++ b/dlls/win32u/font.c
@@ -2074,6 +2074,8 @@ static void load_system_links(void)
 
     if ((shelldlg_name = get_gdi_font_subst( ms_shell_dlgW, -1, NULL )))
     {
+        BOOL matched = FALSE;
+
         for (i = 0; i < ARRAY_SIZE(font_links_defaults_list); i++)
         {
             const WCHAR *subst = get_gdi_font_subst( font_links_defaults_list[i].shelldlg, -1, NULL );
@@ -2081,12 +2083,35 @@ static void load_system_links(void)
             if ((!facename_compare( font_links_defaults_list[i].shelldlg, shelldlg_name, -1 ) ||
                  (subst && !facename_compare( subst, shelldlg_name, -1 ))))
             {
+                matched = TRUE;
                 for (j = 0; j < ARRAY_SIZE(font_links_list); j++)
                     populate_system_links( font_links_list[j], font_links_defaults_list[i].substitutes );
                 if (!facename_compare(shelldlg_name, font_links_defaults_list[i].substitutes[0], -1))
                     populate_system_links( shelldlg_name, font_links_defaults_list[i].substitutes );
             }
         }
+
+        /* FineWine: when MS Shell Dlg is set to a font of the user's choosing (FineWine sets it
+         * to the Mac's dialog font), none of the lists above matched and no font had anything to
+         * fall back to for characters it lacks: Chinese, Japanese and Korean text drew as empty
+         * boxes. Pick the list by the ANSI code page instead, as Windows orders its own links by
+         * the system locale (the order decides how Han characters shared by the languages look). */
+        if (!matched)
+        {
+            switch (ansi_cp.CodePage)
+            {
+            case 932: i = 1; break;
+            case 936: i = 2; break;
+            case 949: i = 3; break;
+            case 950: i = 4; break;
+            default:  i = 0; break;
+            }
+            TRACE( "MS Shell Dlg is %s, using the links for code page %u\n",
+                   debugstr_w(shelldlg_name), ansi_cp.CodePage );
+            for (j = 0; j < ARRAY_SIZE(font_links_list); j++)
+                populate_system_links( font_links_list[j], font_links_defaults_list[i].substitutes );
+            populate_system_links( shelldlg_name, font_links_defaults_list[i].substitutes );
+        }
     }
     else WARN( "could not find FontSubstitute for MS Shell Dlg\n" );
 
@@ -2099,7 +2124,10 @@ static void load_system_links(void)
         add_gdi_font_link_entry( system_font_link, face->family->family_name, face->fs );
         TRACE("Found Tahoma in %s index %u\n", debugstr_w(face->file), face->face_index);
     }
-    if ((font_link = find_gdi_font_link( tahomaW )))
+    /* FineWine: Tahoma has no links of its own when it is substituted (FineWine sets it to the
+     * Mac's dialog font); take Microsoft Sans Serif's then, which every other font falls back to. */
+    if ((font_link = find_gdi_font_link( tahomaW )) ||
+        (font_link = find_gdi_font_link( microsoft_sans_serifW )))
     {
         struct gdi_font_link_entry *entry;
         LIST_FOR_EACH_ENTRY( entry, &font_link->links, struct gdi_font_link_entry, entry )
