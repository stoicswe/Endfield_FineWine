+// FineWine: the program's own name, and making macOS use it.
+static NSString* finewineApplicationName;
+
+static void finewine_apply_application_name(void)
+{
+    // LaunchServices keeps the name the Dock, the app switcher, Force Quit and Activity
+    // Monitor show. There is no public call to change it for a running process; these are
+    // the ones browsers use to name their helper processes. Looked up at run time, so a
+    // macOS without them only loses the renaming.
+    typedef CFTypeRef (*GetASN)(void);
+    typedef OSStatus (*SetItem)(int, CFTypeRef, CFStringRef, CFTypeRef, CFDictionaryRef*);
+    static GetASN getASN;
+    static SetItem setItem;
+    static CFStringRef* displayNameKey;
+    static dispatch_once_t once;
+
+    if (![finewineApplicationName length]) return;
+
+    // The application menu's title in the menu bar comes from the process name.
+    [[NSProcessInfo processInfo] setProcessName:finewineApplicationName];
+
+    dispatch_once(&once, ^{
+        getASN = (GetASN)dlsym(RTLD_DEFAULT, "_LSGetCurrentApplicationASN");
+        setItem = (SetItem)dlsym(RTLD_DEFAULT, "_LSSetApplicationInformationItem");
+        displayNameKey = (CFStringRef*)dlsym(RTLD_DEFAULT, "_kLSDisplayNameKey");
+    });
+    if (getASN && setItem && displayNameKey && *displayNameKey)
+    {
+        CFTypeRef asn = getASN();
+        if (asn) setItem(-2 /* kLSDefaultSessionID */, asn, *displayNameKey, (CFStringRef)finewineApplicationName, NULL);
+    }
+}
 
