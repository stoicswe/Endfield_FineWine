+/* FineWine: what macOS calls this process. Every Wine program is the same Mac executable, so
+ * the menu bar, the Dock, the app switcher and Activity Monitor would all say "wine" (or the
+ * name of the loader's bundle). The program is given its own name instead:
+ *   - the name FineWine lists it under (FINEWINE_APP_NAME), if this is the program FineWine
+ *     started (FINEWINE_APP_EXE is its file name; programs it starts in turn inherit both);
+ *   - else the product name or description in the program's version information;
+ *   - else its file name without the extension. */
+static BOOL finewine_read_file( HANDLE file, UINT64 offset, void *buffer, ULONG size )
+{
+    IO_STATUS_BLOCK io;
+    LARGE_INTEGER pos;
+
+    pos.QuadPart = offset;
+    return !NtReadFile( file, 0, NULL, NULL, &io, buffer, size, &pos, NULL ) && io.Information == size;
+}
+
+static UINT finewine_u16( const BYTE *p ) { return p[0] | p[1] << 8; }
+static UINT finewine_u32( const BYTE *p ) { return p[0] | p[1] << 8 | p[2] << 16 | (UINT)p[3] << 24; }
+
+/* One string of a version resource: { length, value length in characters, type 1, key, padding, value }. */
+static BOOL finewine_version_string( const BYTE *data, UINT size, const WCHAR *key, WCHAR *out, UINT out_len )
+{
+    UINT key_bytes = (wcslen( key ) + 1) * sizeof(WCHAR), i, n, value, len;
+
+    for (i = 6; i + key_bytes < size; i += 2)
+    {
+        if (memcmp( data + i, key, key_bytes )) continue;
+        len = finewine_u16( data + i - 4 );
+        if (finewine_u16( data + i - 2 ) != 1 || len < 2 || len > 200) continue;
+        value = i + key_bytes;
+        if ((value - (i - 6)) % 4) value += 2;
+        for (n = 0; n < len - 1 && n < out_len - 1 && value + n * 2 + 2 <= size; n++)
+            if (!(out[n] = finewine_u16( data + value + n * 2 ))) break;
+        out[n] = 0;
+        while (n && out[n - 1] == ' ') out[--n] = 0;
+        if (n) return TRUE;
+    }
+    return FALSE;
 }
 
+/* The program's own version resource, found through its resource table. */
+static BOOL finewine_product_name( HANDLE file, WCHAR *out, UINT out_len )
+{
+    static const WCHAR product[] = {'P','r','o','d','u','c','t','N','a','m','e',0};
+    static const WCHAR description[] = {'F','i','l','e','D','e','s','c','r','i','p','t','i','o','n',0};
+    BYTE dos[64], head[24], optional[240 + 96 * 40], dir[16], entry[8], leaf[8], *version;
+    UINT pe, sections, optional_size, dirs, rva, root = 0, level, offset = 0, count, i, size, pos = 0;
+    BOOL ret;
 
+    if (!finewine_read_file( file, 0, dos, sizeof(dos) ) || dos[0] != 'M' || dos[1] != 'Z') return FALSE;
+    pe = finewine_u32( dos + 0x3c );
+    if (!finewine_read_file( file, pe, head, sizeof(head) ) || finewine_u32( head ) != 0x4550) return FALSE;
+    sections = finewine_u16( head + 6 );
+    optional_size = finewine_u16( head + 20 );
+    if (sections > 96 || optional_size > 240 || optional_size < 128) return FALSE;
+    if (!finewine_read_file( file, pe + 24, optional, optional_size + sections * 40 )) return FALSE;
+    if (finewine_u16( optional ) == 0x10b) dirs = 96;
+    else if (finewine_u16( optional ) == 0x20b) dirs = 112;
+    else return FALSE;
+    if (dirs + 3 * 8 > optional_size || !(rva = finewine_u32( optional + dirs + 2 * 8 ))) return FALSE;
+
+#define FILE_OFFSET(r, result) do { \
+        UINT s_; (result) = 0; \
+        for (s_ = 0; s_ < sections; s_++) { \
+            const BYTE *sec_ = optional + optional_size + s_ * 40; \
+            UINT va_ = finewine_u32( sec_ + 12 ), vs_ = finewine_u32( sec_ + 8 ), rs_ = finewine_u32( sec_ + 16 ); \
+            if ((r) >= va_ && (r) < va_ + max( vs_, rs_ )) { (result) = finewine_u32( sec_ + 20 ) + ((r) - va_); break; } \
+        } } while (0)
+
+    FILE_OFFSET( rva, root );
+    if (!root) return FALSE;
+    /* type 16 (version information), then the first name, then the first language */
+    for (level = 0; level < 3; level++)
+    {
+        if (!finewine_read_file( file, root + offset, dir, sizeof(dir) )) return FALSE;
+        count = finewine_u16( dir + 12 ) + finewine_u16( dir + 14 );
+        for (i = 0; i < count && i < 4096; i++)
+        {
+            if (!finewine_read_file( file, root + offset + 16 + i * 8, entry, sizeof(entry) )) return FALSE;
+            if (level || finewine_u32( entry ) == 16) break;
+        }
+        if (i == count || i == 4096) return FALSE;
+        offset = finewine_u32( entry + 4 );
+        if (level < 2) { if (!(offset & 0x80000000)) return FALSE; }
+        else if (offset & 0x80000000) return FALSE;
+        offset &= 0x7fffffff;
+    }
+    if (!finewine_read_file( file, root + offset, leaf, sizeof(leaf) )) return FALSE;
+    size = finewine_u32( leaf + 4 );
+    FILE_OFFSET( finewine_u32( leaf ), pos );
+#undef FILE_OFFSET
+    if (!pos || !size || size > 0x40000 || !(version = malloc( size ))) return FALSE;
+    ret = finewine_read_file( file, pos, version, size ) &&
+          (finewine_version_string( version, size, product, out, out_len ) ||
+           finewine_version_string( version, size, description, out, out_len ));
+    free( version );
+    return ret;
+}
+
+static void finewine_name_application(void)
+{
+    UNICODE_STRING *image = &NtCurrentTeb()->Peb->ProcessParameters->ImagePathName;
+    const WCHAR *path = image->Buffer, *end = path + image->Length / sizeof(WCHAR), *base = path, *p;
+    const char *given = getenv( "FINEWINE_APP_NAME" ), *given_exe = getenv( "FINEWINE_APP_EXE" );
+    WCHAR name[128];
+    CFStringRef string = NULL;
+    UINT len, i;
+
+    if (!path || path == end) return;
+    for (p = path; p < end; p++) if (*p == '\\' || *p == '/') base = p + 1;
+    len = end - base;
+
+    if (given && *given && given_exe && strlen( given_exe ) == len)
+    {
+        for (i = 0; i < len; i++)
+            if (base[i] >= 0x80 || tolower( (unsigned char)given_exe[i] ) != tolower( base[i] )) break;
+        if (i == len) string = CFStringCreateWithCString( NULL, given, kCFStringEncodingUTF8 );
+    }
+    if (!string)
+    {
+        static const WCHAR prefix[] = {'\\','?','?','\\'};
+        WCHAR nt_path[1024];
+        UNICODE_STRING nt_name;
+        OBJECT_ATTRIBUTES attr;
+        IO_STATUS_BLOCK io;
+        HANDLE file;
+
+        if (image->Length + sizeof(prefix) < sizeof(nt_path))
+        {
+            memcpy( nt_path, prefix, sizeof(prefix) );
+            memcpy( nt_path + ARRAY_SIZE(prefix), path, image->Length );
+            nt_name.Buffer = nt_path;
+            nt_name.Length = nt_name.MaximumLength = sizeof(prefix) + image->Length;
+            InitializeObjectAttributes( &attr, &nt_name, OBJ_CASE_INSENSITIVE, 0, NULL );
+            if (!NtOpenFile( &file, GENERIC_READ | SYNCHRONIZE, &attr, &io, FILE_SHARE_READ | FILE_SHARE_DELETE,
+                             FILE_SYNCHRONOUS_IO_NONALERT | FILE_NON_DIRECTORY_FILE ))
+            {
+                if (finewine_product_name( file, name, ARRAY_SIZE(name) ))
+                    string = CFStringCreateWithCharacters( NULL, (const UniChar *)name, wcslen( name ) );
+                NtClose( file );
+            }
+        }
+    }
+    if (!string)
+    {
+        for (p = end; p > base; p--) if (p[-1] == '.') { len = p - 1 - base; break; }
+        if (len) string = CFStringCreateWithCharacters( NULL, (const UniChar *)base, len );
+    }
+    if (string)
+    {
+        macdrv_set_application_name( string );
+        CFRelease( string );
+    }
+}
