+    // FineWine: the window the application menu's window commands act on: the key window,
+    // else the front one, else a minimized one (so that Restore has something to restore).
+    - (WineWindow*) finewineMenuWindow
+    {
+        // Wine's windows are panels, which -[NSApplication orderedWindows] leaves out; the
+        // controller's own notion of the front window is used.
+        NSWindow* window = [NSApp keyWindow];
+        if (![window isKindOfClass:[WineWindow class]]) window = [self frontWineWindow];
+        if (!window)
+            for (NSWindow* w in [NSApp windows])
+                if ([w isKindOfClass:[WineWindow class]] && ([w isVisible] || [w isMiniaturized])) { window = w; break; }
+        return (WineWindow*)window;
+    }
+
+    - (void) finewineRestoreWindow:(id)sender
+    {
+        WineWindow* window = [self finewineMenuWindow];
+        if ([window isMiniaturized]) [window deminiaturize:sender];
+        else [window finewineRequestMaximize:NO];
+    }
+
+    - (void) finewineMinimizeWindow:(id)sender
+    {
+        [[self finewineMenuWindow] finewineRequestMinimize];
+    }
+
+    - (void) finewineMaximizeWindow:(id)sender
+    {
+        [[self finewineMenuWindow] finewineRequestMaximize:YES];
+    }
+
+    - (void) finewineCloseWindow:(id)sender
+    {
+        // As clicking the window's close button: the program is asked, and may ask to save.
+        [[self finewineMenuWindow] finewineRequestClose];
+    }
