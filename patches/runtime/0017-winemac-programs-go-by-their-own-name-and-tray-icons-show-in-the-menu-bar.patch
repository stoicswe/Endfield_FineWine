+/***********************************************************************
+ *              macdrv_set_application_name
+ *
+ * FineWine: the name macOS shows for this process, in place of the loader's.
+ */
+void macdrv_set_application_name(CFStringRef name)
+{
+    // Called once, before the Cocoa side of the process is started, so nothing reads the name
+    // yet. It must stay that simple: handing this to the main thread (OnMainThreadAsync) from
+    // here creates the application controller on this thread, ahead of Cocoa's own start-up
+    // on the main one, and then no menu in the menu bar opens: the program hangs in the menu's
+    // event loop.
+    if (!finewineApplicationName)
+        finewineApplicationName = [(NSString*)name copy];
 }
 
