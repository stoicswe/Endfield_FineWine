wined3d: whole-number vertex elements reach Direct3D 9 shaders as floats on Vulkan

dlls/wined3d/context_vk.c
- A Direct3D 9 vertex shader, and the fixed-function pipeline, read every vertex element as
  floats; UBYTE4 and SHORT2/SHORT4 elements (bone indices of skinned models, packed
  coordinates) arrive as 64.0 for a stored 64. The Vulkan renderer described those elements
  with integer formats, which Vulkan pairs with integer shader inputs only. MoltenVK then
  cannot build the pipeline ("Vertex attribute type mismatch between host and shader") and
  the draw is dropped: Portal 2 logged 43,000 failed pipelines in one run and its world was
  garbage. For shaders older than model 4 the elements are described with the SCALED formats,
  which are the same bytes converted to float.

tests/runtime/d3d9-draw.c draws with such a shader.

diff --git a/dlls/wined3d/context_vk.c b/dlls/wined3d/context_vk.c
index 704d755..b920d74 100644
--- a/dlls/wined3d/context_vk.c
+++ b/dlls/wined3d/context_vk.c
@@ -2718,6 +2718,32 @@ static VkFormat vk_format_from_component_type(enum wined3d_component_type compon
     return VK_FORMAT_UNDEFINED;
 }
 
+/* FineWine: a Direct3D 9 vertex shader (and the fixed-function pipeline) reads every vertex
+ * element as floats: a UBYTE4 or SHORT4 element holding 64 arrives as 64.0. The formats of
+ * those elements are integer ones here, and Vulkan wants an integer attribute to go to an
+ * integer shader input. On MoltenVK the pipeline then fails to compile ("Vertex attribute type
+ * mismatch between host and shader") and the draw is lost: Portal 2's world was garbage
+ * (2026-11-21). The SCALED formats are the same bytes, converted to float on the way in. */
+static VkFormat vk_scaled_format_from_integer(VkFormat format)
+{
+    switch (format)
+    {
+        case VK_FORMAT_R8_UINT:             return VK_FORMAT_R8_USCALED;
+        case VK_FORMAT_R8_SINT:             return VK_FORMAT_R8_SSCALED;
+        case VK_FORMAT_R8G8_UINT:           return VK_FORMAT_R8G8_USCALED;
+        case VK_FORMAT_R8G8_SINT:           return VK_FORMAT_R8G8_SSCALED;
+        case VK_FORMAT_R8G8B8A8_UINT:       return VK_FORMAT_R8G8B8A8_USCALED;
+        case VK_FORMAT_R8G8B8A8_SINT:       return VK_FORMAT_R8G8B8A8_SSCALED;
+        case VK_FORMAT_R16_UINT:            return VK_FORMAT_R16_USCALED;
+        case VK_FORMAT_R16_SINT:            return VK_FORMAT_R16_SSCALED;
+        case VK_FORMAT_R16G16_UINT:         return VK_FORMAT_R16G16_USCALED;
+        case VK_FORMAT_R16G16_SINT:         return VK_FORMAT_R16G16_SSCALED;
+        case VK_FORMAT_R16G16B16A16_UINT:   return VK_FORMAT_R16G16B16A16_USCALED;
+        case VK_FORMAT_R16G16B16A16_SINT:   return VK_FORMAT_R16G16B16A16_SSCALED;
+        default:                            return format;
+    }
+}
+
