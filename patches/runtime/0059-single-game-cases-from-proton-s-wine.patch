single-game cases from Proton's Wine

Proton's Wine has about forty places that do something different for one game, told by the
Steam app id in SteamGameId or SteamAppId. These are the ones that do not depend on Linux's
window system, on Proton's full-screen hack or on code this Wine does not have:

  ntdll      438100 VRChat: send() on a UDP socket succeeds when the network is unreachable,
             as on Windows; the game showed an internal error after the machine woke
  xinput1_3  298110 Far Cry 4, 292030 The Witcher 3: no new search for controllers on every
             call that asks about one that is not there
  gdiplus    882710, 1031480 TouHou Makuka Sai: a lone line break measures as a space
  d2d1       1416260: SetTextRenderingParams is ignored
  user32     489830 Skyrim Special Edition: the game and its launcher start DPI aware
  rsaenh     1364780: key containers are not kept between runs
  ieframe    2767030: queued messages are dispatched before a navigation starts
  ddraw      3600700: SetGammaRamp does nothing
  d3d8       32350 STAR WARS Starfighter: multisampling is reported unavailable
  win32u     348550 Guilty Gear XX Accent Core Plus R: WM_ACTIVATEAPP names the new thread
             when there was no old one; 563560: fonts are not hinted
  mshtml     39210: the newest document mode

Each is a few lines beside the code it changes, with Proton's reason. Not taken over: the
cases for gamescope, X11, Wayland and the full-screen hack; the OpenGL ones (extension
strings and context attributes of Linux's drivers); the ones in Proton's own additions
(amd_ags, gameinput, tabtip, winegstreamer); and a few that reach deeper than a line or two
(xaudio2's buffer copies for Darksiders, mscoree's assembly search, the fake network
adapter for Forza Horizon 4).

Checked by tests/runtime/game-cases.c (the GDI+ one, with the id and without).

diff --git a/dlls/ntdll/unix/socket.c b/dlls/ntdll/unix/socket.c
--- a/dlls/ntdll/unix/socket.c
+++ b/dlls/ntdll/unix/socket.c
@@ -1129,6 +1129,20 @@
         return STATUS_DEVICE_NOT_READY;
     }
     return STATUS_SUCCESS;
+}
+
+/* FineWine, from Proton: VRChat (438100) relies on send() on a UDP socket succeeding when the
+ * network is gone but the adapters are still up, as it does on Windows. Without it the game
+ * shows an internal error when the Mac wakes from sleep. */
+static void hack_update_status( int fd, unsigned int *status )
+{
+    const char *appid;
+    int type = 0;
+    socklen_t len = sizeof(type);
+
+    if (*status == STATUS_NETWORK_UNREACHABLE && (appid = getenv( "SteamAppId" )) && !strcmp( appid, "438100" )
+        && !getsockopt( fd, SOL_SOCKET, SO_TYPE, &type, &len ) && type == SOCK_DGRAM)
+        *status = STATUS_SUCCESS;
 }
 
 static BOOL async_send_proc( void *user, ULONG_PTR *info, unsigned int *status )
@@ -1146,6 +1160,7 @@
 
         *status = try_send( fd, async );
         TRACE( "got status %#x\n", *status );
+        hack_update_status( fd, status );
 
         if (needs_close) close( fd );
 
@@ -1211,6 +1226,7 @@
     if (status == STATUS_ALERTED)
     {
         status = try_send( fd, async );
+        hack_update_status( fd, &status );
         if (status == STATUS_DEVICE_NOT_READY && ((server_flags & SERVER_SOCKET_IO_FORCE_ASYNC) || !nonblocking))
             status = STATUS_PENDING;
 
diff --git a/dlls/xinput1_3/main.c b/dlls/xinput1_3/main.c
--- a/dlls/xinput1_3/main.c
+++ b/dlls/xinput1_3/main.c
@@ -896,6 +896,15 @@
     if (index >= XUSER_MAX_COUNT) return ERROR_BAD_ARGUMENTS;
     if (get_current_state(index, state)) return ERROR_SUCCESS;
 
+    {
+        /* FineWine, from Proton: Far Cry 4 (298110) and The Witcher 3 (292030) ask for the state of
+         * controllers that are not there so often that looking for them again each time stalls them. */
+        static int no_rescan = -1;
+        const char *sgi;
+        if (no_rescan == -1) no_rescan = (sgi = getenv("SteamGameId")) && (!strcmp(sgi, "298110") || !strcmp(sgi, "292030"));
+        if (no_rescan) return ERROR_DEVICE_NOT_CONNECTED;
+    }
+
     EnterCriticalSection(&xinput_cs);
     update_controller_list();
     ret = get_current_state(index, state) ? ERROR_SUCCESS : ERROR_DEVICE_NOT_CONNECTED;
