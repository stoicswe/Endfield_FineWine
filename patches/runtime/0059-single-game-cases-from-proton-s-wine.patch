diff --git a/dlls/user32/sysparams.c b/dlls/user32/sysparams.c
--- a/dlls/user32/sysparams.c
+++ b/dlls/user32/sysparams.c
@@ -208,6 +208,18 @@
             SetProcessDpiAwarenessContext( DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE );
         else
             SetProcessDpiAwarenessContext( DPI_AWARENESS_CONTEXT_UNAWARE );
+    }
+
+    {
+        /* FineWine, from Proton: The Elder Scrolls V: Skyrim Special Edition (489830). Windows 11
+         * starts it DPI aware; started unaware, it sizes its window to the monitor, resizes it
+         * later and never resizes its swap chain, so parts of the picture are drawn shrunk. */
+        const char *sgi = getenv( "SteamGameId" );
+        const WCHAR *name;
+        if (sgi && !strcmp( sgi, "489830" ) && GetModuleFileNameW( NULL, buffer, ARRAY_SIZE(buffer) )
+            && (name = wcsrchr( buffer, '\\' ))
+            && (!wcsicmp( name + 1, L"SkyrimSE.exe" ) || !wcsicmp( name + 1, L"SkyrimSELauncher.exe" )))
+            SetProcessDpiAwarenessContext( DPI_AWARENESS_CONTEXT_SYSTEM_AWARE );
     }
 }
 
diff --git a/dlls/rsaenh/rsaenh.c b/dlls/rsaenh/rsaenh.c
--- a/dlls/rsaenh/rsaenh.c
+++ b/dlls/rsaenh/rsaenh.c
@@ -1199,6 +1199,18 @@
  *  sam           [I] Desired registry access
  *  phKey         [O] Returned key
  */
+/* FineWine, from Proton: 1364780 leaves key containers behind that stop it starting the next
+ * time; for it they are not kept between runs. */
+static DWORD finewine_key_options(void)
+{
+    static DWORD options = ~0u;
+    const char *sgi;
+
+    if (options == ~0u)
+        options = ((sgi = getenv("SteamGameId")) && !strcmp(sgi, "1364780")) ? REG_OPTION_VOLATILE : REG_OPTION_NON_VOLATILE;
+    return options;
+}
+
 static BOOL create_container_key(KEYCONTAINER *pKeyContainer, REGSAM sam, HKEY *phKey)
 {
     CHAR szRSABase[sizeof(RSAENH_REGKEY) + MAX_PATH];
@@ -1214,7 +1226,7 @@
     /* @@ Wine registry key: HKLM\Software\Wine\Crypto\RSA */
     /* @@ Wine registry key: HKCU\Software\Wine\Crypto\RSA */
     return RegCreateKeyExA(hRootKey, szRSABase, 0, NULL,
-                           REG_OPTION_NON_VOLATILE, sam, NULL, phKey, NULL)
+                           finewine_key_options(), sam, NULL, phKey, NULL)
                            == ERROR_SUCCESS;
 }
 
diff --git a/dlls/ieframe/navigate.c b/dlls/ieframe/navigate.c
--- a/dlls/ieframe/navigate.c
+++ b/dlls/ieframe/navigate.c
@@ -851,7 +851,23 @@
         WARN("Could not get IHTMLPrivateWindow iface: %08lx\n", hres);
     }
 }
+
+/* FineWine, from Proton: 2767030's launcher page waits for messages that are still queued when
+ * the next navigation starts. */
+static void hack_pump_messages(void)
+{
+    static int enabled = -1;
+    MSG msg;
 
+    if (enabled == -1)
+    {
+        const char *sgi = getenv("SteamGameId");
+        enabled = sgi && !strcmp(sgi, "2767030");
+    }
+    if (!enabled) return;
+    while (PeekMessageW(&msg, NULL, 0, 0, PM_REMOVE)) DispatchMessageW(&msg);
+}
+
 static HRESULT async_doc_navigate(DocHost *This, LPCWSTR url, LPCWSTR headers, PBYTE post_data, ULONG post_data_size,
         BOOL async_notif)
 {
@@ -900,6 +916,7 @@
 
     task->async_notif = async_notif;
     abort_dochost_tasks(This, doc_navigate_proc);
+    hack_pump_messages();
     push_dochost_task(This, &task->header, doc_navigate_proc, doc_navigate_task_destr, FALSE);
     return S_OK;
 }
