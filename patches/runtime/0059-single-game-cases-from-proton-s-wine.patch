+}
+
+/* FineWine, from Proton: Guilty Gear XX Accent Core Plus R (348550) takes a WM_ACTIVATEAPP that
+ * names no other thread for a deactivation. */
+static int finewine_activateapp_lparam_hack(void)
+{
+    static int cached = -1;
+    const char *env;
+
+    if (cached == -1) cached = (env = getenv( "SteamGameId" )) && !strcmp( env, "348550" );
+    return cached;
 }
 
 /*******************************************************************
@@ -2190,7 +2201,8 @@
                 for (phwnd = list; *phwnd; phwnd++)
                 {
                     if (get_window_thread( *phwnd, NULL ) == new_thread)
-                        send_message( *phwnd, WM_ACTIVATEAPP, 1, old_thread );
+                        send_message( *phwnd, WM_ACTIVATEAPP, 1,
+                                      (finewine_activateapp_lparam_hack() && !old_thread) ? new_thread : old_thread );
                 }
             }
             free( list );
