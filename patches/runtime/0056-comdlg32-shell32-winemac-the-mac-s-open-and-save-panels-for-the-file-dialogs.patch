+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#import "config.h"
+#import "macdrv.h"
+
+#import <Cocoa/Cocoa.h>
+#import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
+#include <fnmatch.h>
+
+#import "cocoa_app.h"
+#import "cocoa_event.h"
+#import "cocoa_window.h"
+#import "filepanel.h"
+
+#pragma GCC diagnostic ignored "-Wdeclaration-after-statement"
+
+
+@interface WineFilePanel : NSObject <NSOpenSavePanelDelegate>
+{
+    unsigned int flags;
+    NSString* title;
+    NSString* okLabel;
+    NSString* message;
+    NSString* directory;
+    NSString* filename;
+    NSString* defaultExtension;
+    NSArray<NSString*>* filterNames;
+    NSArray<NSArray<NSString*>*>* filterPatterns;   /* per file type, lower case */
+    NSUInteger filterIndex;
+    NSRect ownerFrame;                              /* empty when there is no owner */
+
+    NSSavePanel* panel;
+    NSMenuItem* editMenuItem;
+    NSArray<NSString*>* forcedAnswer;               /* what a test said the answer is */
+    BOOL forced;
+
+    /* the result; read from other threads under @synchronized(self) */
+    int status;
+    NSArray<NSString*>* paths;
+    unsigned int resultFilter;
+    BOOL ended;
+}
+
+    - (id) initWithRequest:(const struct macdrv_file_panel_request*)request ownerFrame:(NSRect)frame;
+    - (BOOL) start;
+    - (void) end;
+    - (int) status:(NSArray<NSString*>**)outPaths filter:(unsigned int*)outFilter;
+
+@end
+
+
+/* The panels that are open or whose result has not been fetched yet, by the number
+ * comdlg32 was given for them. */
+static NSMutableDictionary<NSNumber*, WineFilePanel*>* panels;
+static unsigned long long next_panel = 1;
+
+
+static NSString* request_string(const struct macdrv_file_panel_request* request, unsigned int offset)
+{
+    const unichar* chars;
+    NSUInteger max, len = 0;
+
+    if (!offset || offset >= request->size) return nil;
+    chars = (const unichar*)((const char*)request + offset);
+    max = (request->size - offset) / sizeof(unichar);
+    while (len < max && chars[len]) len++;
+    if (!len) return nil;
+    return [NSString stringWithCharacters:chars length:len];
+}
+
+/* "*.txt;*.log" as its patterns, lower case. */
+static NSArray<NSString*>* patterns_from_spec(NSString* spec)
+{
+    NSMutableArray<NSString*>* patterns = [NSMutableArray array];
+
+    for (NSString* part in [spec componentsSeparatedByString:@";"])
+    {
+        NSString* pattern = [[part stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceCharacterSet]] lowercaseString];
+        if ([pattern length]) [patterns addObject:[pattern precomposedStringWithCanonicalMapping]];
+    }
+    return patterns;
+}
+
+/* The extension a pattern stands for when it is "*.ext" and nothing more, or nil. */
+static NSString* extension_of_pattern(NSString* pattern)
+{
+    NSString* ext;
+
+    if (![pattern hasPrefix:@"*."]) return nil;
+    ext = [pattern substringFromIndex:2];
+    if (![ext length] || [ext rangeOfCharacterFromSet:[NSCharacterSet characterSetWithCharactersInString:@"*?."]].location != NSNotFound)
+        return nil;
+    return ext;
+}
+
+static BOOL patterns_match_everything(NSArray<NSString*>* patterns)
+{
+    if (![patterns count]) return YES;
+    for (NSString* pattern in patterns)
+        if ([pattern isEqualToString:@"*.*"] || [pattern isEqualToString:@"*"]) return YES;
+    return NO;
+}
+
+
+@implementation WineFilePanel
+
+    - (id) initWithRequest:(const struct macdrv_file_panel_request*)request ownerFrame:(NSRect)frame
+    {
+        self = [super init];
+        if (self)
+        {
+            NSMutableArray<NSString*>* names = [NSMutableArray array];
+            NSMutableArray<NSArray<NSString*>*>* specs = [NSMutableArray array];
+            const char* answer = getenv("FINEWINE_FILE_PANEL_ANSWER");
+
+            flags = request->flags;
+            ownerFrame = frame;
+            title = [request_string(request, request->title) copy];
+            okLabel = [request_string(request, request->ok_label) copy];
+            message = [request_string(request, request->message) copy];
+            directory = [request_string(request, request->directory) copy];
+            filename = [request_string(request, request->filename) copy];
+            defaultExtension = [request_string(request, request->default_ext) copy];
+
+            if (request->filter_count && request->filters &&
+                request->filters + (unsigned long long)request->filter_count * sizeof(struct macdrv_file_panel_filter) <= request->size)
+            {
+                const struct macdrv_file_panel_filter* filters = (const void*)((const char*)request + request->filters);
+                unsigned int i;
+
+                for (i = 0; i < request->filter_count; i++)
+                {
+                    NSString* spec = request_string(request, filters[i].spec) ?: @"*.*";
+                    [names addObject:request_string(request, filters[i].name) ?: spec];
+                    [specs addObject:patterns_from_spec(spec)];
+                }
+            }
+            filterNames = [names copy];
+            filterPatterns = [specs copy];
+            filterIndex = request->filter_index < [filterPatterns count] ? request->filter_index : 0;
+            resultFilter = (unsigned int)filterIndex;
+
+            /* For the tests, and for trying a program without a person at the Mac: the answer
+             * is given ahead. "cancel", or the Unix paths, one a line. With
+             * FINEWINE_FILE_PANEL_ANSWER_DELAY the panel is really shown for that many
+             * milliseconds first; without it no panel appears at all. */
+            if (answer && answer[0])
+            {
+                NSString* text = [NSString stringWithUTF8String:answer];
+                NSMutableArray<NSString*>* list = [NSMutableArray array];
+                const char* filter = getenv("FINEWINE_FILE_PANEL_ANSWER_FILTER");
+
+                if (![text isEqualToString:@"cancel"])
+                    for (NSString* line in [text componentsSeparatedByString:@"\n"])
+                        if ([line length]) [list addObject:line];
+                forcedAnswer = [list copy];
+                if (filter && [filterPatterns count])
+                {
+                    unsigned int index = (unsigned int)atoi(filter);
+                    if (index < [filterPatterns count]) resultFilter = index;
+                }
+            }
+        }
+        return self;
+    }
+
+    - (void) dealloc
+    {
+        [title release];
+        [okLabel release];
+        [message release];
+        [directory release];
+        [filename release];
+        [defaultExtension release];
+        [filterNames release];
+        [filterPatterns release];
+        [panel release];
+        [editMenuItem release];
+        [forcedAnswer release];
+        [paths release];
+        [super dealloc];
+    }
+
+    - (NSArray<NSString*>*) currentPatterns
+    {
+        return filterIndex < [filterPatterns count] ? filterPatterns[filterIndex] : @[];
+    }
+
+    /* Save panel: the extensions the selected file type stands for, which the panel adds to
+     * a name typed without one and checks a typed one against. */
+    - (void) applyContentTypes
+    {
+        NSMutableArray<UTType*>* types = [NSMutableArray array];
+        NSArray<NSString*>* patterns = [self currentPatterns];
+
+        if (!(flags & MACDRV_FILE_PANEL_SAVE)) return;
+
+        for (NSString* pattern in patterns)
+        {
+            NSString* ext = extension_of_pattern(pattern);
+            UTType* type = ext ? [UTType typeWithFilenameExtension:ext] : nil;
+            if (type && ![types containsObject:type]) [types addObject:type];
+        }
+        if (![types count] && [defaultExtension length])
+        {
+            UTType* type = [UTType typeWithFilenameExtension:defaultExtension];
+            if (type) [types addObject:type];
+        }
+        panel.allowedContentTypes = types;
+        /* A type for every file ("*.*") beside others leaves any name be. */
+        panel.allowsOtherFileTypes = !(flags & MACDRV_FILE_PANEL_STRICT_TYPES) || patterns_match_everything(patterns);
+    }
+
+    - (void) filterChosen:(NSPopUpButton*)sender
+    {
+        filterIndex = (NSUInteger)[sender indexOfSelectedItem];
+        [self applyContentTypes];
+        [panel validateVisibleColumns];
+    }
+
+    /* The file types as a pop-up below the browser, as the Windows dialog has them. */
+    - (NSView*) accessoryView
+    {
+        NSPopUpButton* popup;
+        NSView* view;
+        NSSize size;
+
+        if ([filterNames count] < 2) return nil;
+
+        popup = [[[NSPopUpButton alloc] initWithFrame:NSZeroRect pullsDown:NO] autorelease];
+        for (NSString* name in filterNames)
+        {
+            /* -addItemWithTitle: drops an item whose title is there already */
+            [[popup menu] addItemWithTitle:name action:NULL keyEquivalent:@""];
+        }
+        [popup selectItemAtIndex:(NSInteger)filterIndex];
+        [popup setTarget:self];
+        [popup setAction:@selector(filterChosen:)];
+        [popup sizeToFit];
+
+        size = [popup frame].size;
+        if (size.width > 420) size.width = 420;
+        view = [[[NSView alloc] initWithFrame:NSMakeRect(0, 0, size.width + 40, size.height + 16)] autorelease];
+        [popup setFrame:NSMakeRect(20, 8, size.width, size.height)];
+        [popup setAutoresizingMask:NSViewMinXMargin | NSViewMaxXMargin];
+        [view addSubview:popup];
+        return view;
+    }
+
+    - (void) createPanel
+    {
+        NSView* accessory;
+
+        if (flags & MACDRV_FILE_PANEL_SAVE)
+            panel = [[NSSavePanel savePanel] retain];
+        else
+        {
+            NSOpenPanel* open = [NSOpenPanel openPanel];
+
+            open.canChooseFiles = (flags & MACDRV_FILE_PANEL_FILES) != 0;
+            open.canChooseDirectories = (flags & MACDRV_FILE_PANEL_FOLDERS) != 0;
+            open.allowsMultipleSelection = (flags & MACDRV_FILE_PANEL_MULTIPLE) != 0;
+            open.resolvesAliases = !(flags & MACDRV_FILE_PANEL_KEEP_ALIASES);
+            panel = [open retain];
+        }
+
+        panel.delegate = self;
+        panel.canCreateDirectories = !(flags & MACDRV_FILE_PANEL_NO_NEW_FOLDER);
+        panel.showsHiddenFiles = (flags & MACDRV_FILE_PANEL_HIDDEN) != 0;
+        panel.extensionHidden = NO;
+        /* An open panel has no title bar: what the program calls the dialog goes where the
+         * panel has room for a line of text, unless the program has such a line itself. */
+        if ([title length]) panel.title = title;
+        if ([message length]) panel.message = message;
+        else if ([title length] && !(flags & MACDRV_FILE_PANEL_SAVE)) panel.message = title;
+        if ([okLabel length]) panel.prompt = [okLabel stringByReplacingOccurrencesOfString:@"&" withString:@""];
+        if ([directory length]) panel.directoryURL = [NSURL fileURLWithPath:directory isDirectory:YES];
+        if ((flags & MACDRV_FILE_PANEL_SAVE) && [filename length]) panel.nameFieldStringValue = filename;
+        [self applyContentTypes];
+
+        if ((accessory = [self accessoryView]))
+        {
+            panel.accessoryView = accessory;
+            if (!(flags & MACDRV_FILE_PANEL_SAVE)) ((NSOpenPanel*)panel).accessoryViewDisclosed = YES;
+        }
+
+        /* Over a window of the program in a full-screen Space, and on whichever Space the
+         * program is being used. */
+        panel.collectionBehavior |= NSWindowCollectionBehaviorFullScreenAuxiliary | NSWindowCollectionBehaviorMoveToActiveSpace;
+    }
+
+    /* Wine's menu bar has no Edit menu, and without one the panel's text fields get no
+     * Command-V. A hidden one is there for as long as the panel is. */
+    - (void) addEditMenu
+    {
+        NSMenu* mainMenu = [NSApp mainMenu];
+        NSMenu* menu;
+        struct { NSString* title; SEL action; NSString* key; NSEventModifierFlags flags; } items[] =
+        {
+            { @"Undo",       @selector(undo:),      @"z", NSEventModifierFlagCommand },
+            { @"Redo",       @selector(redo:),      @"z", NSEventModifierFlagCommand | NSEventModifierFlagShift },
+            { @"Cut",        @selector(cut:),       @"x", NSEventModifierFlagCommand },
+            { @"Copy",       @selector(copy:),      @"c", NSEventModifierFlagCommand },
+            { @"Paste",      @selector(paste:),     @"v", NSEventModifierFlagCommand },
+            { @"Select All", @selector(selectAll:), @"a", NSEventModifierFlagCommand },
+        };
+        unsigned int i;
+
+        if (!mainMenu || editMenuItem) return;
+
+        menu = [[[NSMenu alloc] initWithTitle:@"Edit"] autorelease];
+        for (i = 0; i < sizeof(items) / sizeof(items[0]); i++)
+        {
+            NSMenuItem* item = [menu addItemWithTitle:items[i].title action:items[i].action keyEquivalent:items[i].key];
+            item.keyEquivalentModifierMask = items[i].flags;
+        }
+        editMenuItem = [[NSMenuItem alloc] initWithTitle:@"Edit" action:NULL keyEquivalent:@""];
+        editMenuItem.submenu = menu;
+        editMenuItem.hidden = YES;
+        editMenuItem.allowsKeyEquivalentWhenHidden = YES;
+        for (NSMenuItem* item in [menu itemArray]) item.allowsKeyEquivalentWhenHidden = YES;
+        [mainMenu addItem:editMenuItem];
+    }
+
+    - (void) removeEditMenu
+    {
+        if (editMenuItem)
+        {
+            [[NSApp mainMenu] removeItem:editMenuItem];
+            [editMenuItem release];
+            editMenuItem = nil;
+        }
+    }
+
+    - (void) finishWithResponse:(NSModalResponse)response
+    {
+        NSMutableArray<NSString*>* chosen = [NSMutableArray array];
+        int result = MACDRV_FILE_PANEL_CANCELLED;
+
+        if (forced)
+        {
+            [chosen addObjectsFromArray:forcedAnswer];
+            if ([chosen count]) result = MACDRV_FILE_PANEL_CHOSEN;
+        }
+        else if (response == NSModalResponseOK && panel)
+        {
+            NSArray<NSURL*>* urls = (flags & MACDRV_FILE_PANEL_SAVE) ? (panel.URL ? @[panel.URL] : @[])
+                                                                    : ((NSOpenPanel*)panel).URLs;
+            for (NSURL* url in urls)
+                if ([url isFileURL] && [[url path] length]) [chosen addObject:[url path]];
+            if ([chosen count]) result = MACDRV_FILE_PANEL_CHOSEN;
+        }
+
+        @synchronized(self)
+        {
+            if (status == MACDRV_FILE_PANEL_PENDING)
+            {
+                paths = [chosen copy];
+                if (!forced) resultFilter = (unsigned int)filterIndex;
+                status = result;
+            }
+        }
+    }
+
+    /* A full-screen window of the program can be above the level a modal panel is at (the
+     * "exclusive" full-screen mode puts it over the menu bar): the panel goes above the
+     * highest of the program's windows. Again when the program comes to the front, which is
+     * when the driver sets its windows' levels anew. */
+    - (void) raiseAboveWineWindows
+    {
+        NSInteger level = [panel level];
+
+        if (!panel) return;
+        for (NSWindow* window in [NSApp windows])
+        {
+            if ([window isKindOfClass:[WineWindow class]] && [window isVisible] && [window level] >= level)
+                level = [window level] + 1;
+        }
+        if (level != [panel level]) [panel setLevel:level];
+    }
+
+    - (void) applicationDidBecomeActive:(NSNotification*)notification
+    {
+        [self performSelector:@selector(raiseAboveWineWindows) withObject:nil afterDelay:0.1
+                      inModes:@[NSRunLoopCommonModes]];
+    }
+
+    /* On the main thread, from the run loop and not from one of the driver's requests, which
+     * would be held up for as long as the panel is open. */
+    - (void) run
+    {
+        NSModalResponse response;
+        const char* delay = getenv("FINEWINE_FILE_PANEL_ANSWER_DELAY");
+        BOOL closed;
+
+        @synchronized(self) { closed = ended; }
+        if (closed)
+        {
+            [self finishWithResponse:NSModalResponseCancel];
+            return;
+        }
+
+        [self createPanel];
+        [self addEditMenu];
+
+        if (!NSIsEmptyRect(ownerFrame))
+        {
+            NSRect frame = [panel frame];
+            [panel setFrameOrigin:NSMakePoint(NSMidX(ownerFrame) - frame.size.width / 2,
+                                              NSMidY(ownerFrame) - frame.size.height / 2)];
+        }
+
+        if (forcedAnswer)
+        {
+            int64_t ms = delay ? atoll(delay) : 0;
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, ms * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+                forced = YES;
+                [panel cancel:nil];
+            });
+        }
+
+        [[NSNotificationCenter defaultCenter] addObserver:self
+                                                 selector:@selector(applicationDidBecomeActive:)
+                                                     name:NSApplicationDidBecomeActiveNotification
+                                                   object:NSApp];
+        [self raiseAboveWineWindows];
+        /* and once it is on screen, as showing it modally sets its level */
+        [self performSelector:@selector(raiseAboveWineWindows) withObject:nil afterDelay:0.1
+                      inModes:@[NSRunLoopCommonModes]];
+
+        [[WineApplicationController sharedController] tryToActivateIgnoringOtherApps:YES];
+        response = [panel runModal];
+
+        [[NSNotificationCenter defaultCenter] removeObserver:self
+                                                        name:NSApplicationDidBecomeActiveNotification
+                                                      object:NSApp];
+        [NSObject cancelPreviousPerformRequestsWithTarget:self selector:@selector(raiseAboveWineWindows) object:nil];
+        [self removeEditMenu];
+        [self finishWithResponse:response];
+        panel.delegate = nil;
+    }
+
+    /* On the main thread. NO when no panel can be shown now, and comdlg32 shows Wine's. */
+    - (BOOL) start
+    {
+        WineApplicationController* controller = [WineApplicationController sharedController];
+
+        /* A test's answer with no delay: no panel. */
+        if (forcedAnswer && !getenv("FINEWINE_FILE_PANEL_ANSWER_DELAY"))
+        {
+            forced = YES;
+            [self finishWithResponse:NSModalResponseCancel];
+            return YES;
+        }
+
+        /* A game that has taken the displays for itself draws over everything else. */
+        if ([controller areDisplaysCaptured]) return NO;
+
+        [controller transformProcessToForeground:YES];
+        [self performSelector:@selector(run) withObject:nil afterDelay:0 inModes:@[NSRunLoopCommonModes]];
+        return YES;
+    }
+
+    - (void) end
+    {
+        @synchronized(self) { ended = YES; }
+        OnMainThreadAsync(^{
+            if (panel && [panel isVisible]) [panel cancel:nil];
+        });
+    }
+
+    - (int) status:(NSArray<NSString*>**)outPaths filter:(unsigned int*)outFilter
+    {
+        @synchronized(self)
+        {
+            *outPaths = [[paths retain] autorelease];
+            *outFilter = resultFilter;
+            return status;
+        }
+    }
+
+
+    /*
+     * ---------- NSOpenSavePanelDelegate methods ----------
+     */
+
+    /* Which files of an open panel can be chosen: those the selected file type's patterns
+     * match, as in the Windows dialog. Folders always can be gone into. */
+    - (BOOL) panel:(id)sender shouldEnableURL:(NSURL*)url
+    {
+        NSArray<NSString*>* patterns = [self currentPatterns];
+        NSNumber* isDirectory = nil;
+        const char* name;
+
+        if (flags & MACDRV_FILE_PANEL_SAVE) return YES;
+        if (patterns_match_everything(patterns)) return YES;
+        if ([url getResourceValue:&isDirectory forKey:NSURLIsDirectoryKey error:NULL] && [isDirectory boolValue])
+            return YES;
+
+        name = [[[[url lastPathComponent] lowercaseString] precomposedStringWithCanonicalMapping] UTF8String];
+        if (!name) return YES;
+        for (NSString* pattern in patterns)
+            if (!fnmatch([pattern UTF8String], name, 0)) return YES;
+        return NO;
+    }
+
+@end
+
+
+/***********************************************************************
+ *              macdrv_file_panel_begin
+ *
+ * Shows the panel a request describes. Returns the number to ask for its result with, or 0
+ * when no panel can be shown.
+ */
+unsigned long long macdrv_file_panel_begin(const struct macdrv_file_panel_request* request, WineWindow* owner)
+{
+@autoreleasepool
+{
+    WineWindow* window = owner;
+    __block WineFilePanel* filePanel = nil;
+    __block unsigned long long handle = 0;
+
+    if (request->size < sizeof(*request)) return 0;
+
+    OnMainThread(^{
+        NSRect frame = NSZeroRect;
+
+        if (window && [window isKindOfClass:[WineWindow class]] && [window isVisible] && ![window isMiniaturized])
+            frame = [window frame];
+
+        filePanel = [[WineFilePanel alloc] initWithRequest:request ownerFrame:frame];
+        if (![filePanel start])
+        {
+            [filePanel release];
+            filePanel = nil;
+            return;
+        }
+
+        @synchronized([WineFilePanel class])
+        {
+            if (!panels) panels = [[NSMutableDictionary alloc] init];
+            handle = next_panel++;
+            panels[@(handle)] = filePanel;
+        }
+        [filePanel release];
+    });
+
+    return handle;
+}
+}
+
+/***********************************************************************
+ *              macdrv_file_panel_poll
+ *
+ * The state of a panel: still open, or closed with what was chosen. The paths go into
+ * buffer if it is large enough; *needed is the size they take either way.
+ */
+int macdrv_file_panel_poll(unsigned long long handle, char* buffer, unsigned int size,
+                           unsigned int* needed, unsigned int* count, unsigned int* filter)
+{
+@autoreleasepool
+{
+    WineFilePanel* filePanel;
+    NSArray<NSString*>* paths = nil;
+    unsigned int total = 1, pos = 0;
+    int status;
+
+    *needed = *count = *filter = 0;
+
+    @synchronized([WineFilePanel class])
+    {
+        filePanel = [[panels[@(handle)] retain] autorelease];
+    }
+    if (!filePanel) return MACDRV_FILE_PANEL_CANCELLED;
+
+    status = [filePanel status:&paths filter:filter];
+    if (status != MACDRV_FILE_PANEL_CHOSEN) return status;
+
+    for (NSString* path in paths)
+        total += strlen([path fileSystemRepresentation]) + 1;
+    *needed = total;
+    *count = (unsigned int)[paths count];
+    if (!buffer || size < total) return status;
+
+    for (NSString* path in paths)
+    {
+        const char* utf8 = [path fileSystemRepresentation];
+        size_t len = strlen(utf8) + 1;
+        memcpy(buffer + pos, utf8, len);
+        pos += len;
+    }
+    buffer[pos] = 0;
+    return status;
+}
+}
+
+/***********************************************************************
+ *              macdrv_file_panel_end
+ *
+ * Forgets a panel, closing it first if it is still open.
+ */
+void macdrv_file_panel_end(unsigned long long handle)
+{
+@autoreleasepool
+{
+    WineFilePanel* filePanel;
+
+    @synchronized([WineFilePanel class])
+    {
+        filePanel = [[panels[@(handle)] retain] autorelease];
+        [panels removeObjectForKey:@(handle)];
+    }
+    [filePanel end];
+}
+}
diff --git a/dlls/winemac.drv/filepanel.h b/dlls/winemac.drv/filepanel.h
new file mode 100644
index 0000000..8498034
--- /dev/null
+++ b/dlls/winemac.drv/filepanel.h
@@ -0,0 +1,98 @@
+/*
+ * FineWine: the Mac's own open and save panels for the Windows file dialogs.
+ *
+ * What comdlg32 hands to winemac.so to have a panel shown, and what comes back. This header
+ * is shared by the Windows side (comdlg32, 32-bit and 64-bit), the Unix side of the driver
+ * and its Objective-C part, so it uses nothing but plain C types, pointers travel as 64-bit
+ * integers, and every struct is laid out the same for all three.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_MACDRV_FILEPANEL_H
+#define __WINE_MACDRV_FILEPANEL_H
+
+/* The numbers of the calls in winemac.so's table (enum macdrv_funcs in unixlib.h). */
+#define MACDRV_UNIX_FILE_PANEL_BEGIN 2
+#define MACDRV_UNIX_FILE_PANEL_POLL  3
+#define MACDRV_UNIX_FILE_PANEL_END   4
+
+/* macdrv_file_panel_request.flags */
+#define MACDRV_FILE_PANEL_SAVE            0x0001  /* a save panel; an open panel otherwise */
+#define MACDRV_FILE_PANEL_FILES           0x0002  /* open: files can be chosen */
+#define MACDRV_FILE_PANEL_FOLDERS         0x0004  /* open: folders can be chosen */
+#define MACDRV_FILE_PANEL_MULTIPLE        0x0008  /* open: more than one item */
+#define MACDRV_FILE_PANEL_HIDDEN          0x0010  /* show hidden files */
+#define MACDRV_FILE_PANEL_NO_NEW_FOLDER   0x0020  /* no "New Folder" button */
+#define MACDRV_FILE_PANEL_KEEP_ALIASES    0x0040  /* open: an alias is returned as itself */
+#define MACDRV_FILE_PANEL_STRICT_TYPES    0x0080  /* save: only the extensions of the file type */
+
+/* macdrv_file_panel_poll_params.status */
+#define MACDRV_FILE_PANEL_PENDING   0
+#define MACDRV_FILE_PANEL_CHOSEN    1
+#define MACDRV_FILE_PANEL_CANCELLED 2
+
+/* One file type of the panel's pop-up: both are offsets of strings, as below. */
+struct macdrv_file_panel_filter
+{
+    unsigned int name;      /* what the pop-up shows, "Text files (*.txt)" */
+    unsigned int spec;      /* the patterns, "*.txt;*.log" */
+};
+
+/* What to show. One block of memory: the strings and the filters follow the header, and each
+ * string member is the offset in bytes from the start of the block of a UTF-16 string that
+ * ends in a zero, or 0 for none. */
+struct macdrv_file_panel_request
+{
+    unsigned int size;          /* of the whole block */
+    unsigned int flags;
+    unsigned int owner;         /* the HWND the dialog belongs to, or 0 */
+    unsigned int title;
+    unsigned int ok_label;      /* the text of the button that accepts */
+    unsigned int message;       /* a line of text shown in the panel */
+    unsigned int directory;     /* the folder to start in, as a Unix path */
+    unsigned int filename;      /* save: the name to suggest */
+    unsigned int default_ext;   /* save: the extension for a name typed without one, no dot */
+    unsigned int filter_count;
+    unsigned int filter_index;  /* the file type selected at first, counted from 0 */
+    unsigned int filters;       /* offset of filter_count macdrv_file_panel_filter */
+};
+
+struct macdrv_file_panel_begin_params
+{
+    unsigned long long request; /* in: struct macdrv_file_panel_request * */
+    unsigned long long handle;  /* out: the panel, for the other two calls; 0 if none is shown */
+};
+
+struct macdrv_file_panel_poll_params
+{
+    unsigned long long handle;
+    unsigned long long buffer;  /* in: char *, receives the chosen Unix paths (UTF-8), each ending
+                                 * in a zero, with one more zero after the last */
+    unsigned int size;          /* in: of the buffer in bytes */
+    unsigned int needed;        /* out: the size the paths take; nothing is copied if it is more
+                                 * than size */
+    unsigned int count;         /* out: how many paths */
+    unsigned int filter;        /* out: the file type selected when the panel closed */
+    int status;                 /* out: MACDRV_FILE_PANEL_* */
+    int pad;
+};
+
+struct macdrv_file_panel_end_params
+{
+    unsigned long long handle;  /* closes the panel if it is still open, and forgets it */
+};
+
+#endif /* __WINE_MACDRV_FILEPANEL_H */
