+/***********************************************************************
+ *      FineWine: the Mac's own panel in place of the dialog.
+ *
+ * GetOpenFileName and GetSaveFileName as an NSOpenPanel or NSSavePanel: the title, the file
+ * types, the folder and the name to start with go to the panel, and what was chosen is
+ * written into the program's OPENFILENAME the way the dialog writes it, with the offsets,
+ * the file type's number and the buffer-too-small answer.
+ *
+ * Returns FALSE when the dialog has to be Wine's: when the program hooks the dialog or gives
+ * it a template of its own (there is no dialog to hook or to lay out), or when no panel can
+ * be shown. Otherwise TRUE, with *ret what the function returns to the program.
+ */
+static void mac_panel_write_string(FileOpenDlgInfos *info, WCHAR *dest, DWORD max, const WCHAR *src, int src_len)
+{
+    if (!dest || !max) return;
+    if (info->unicode)
+    {
+        int len = min(src_len, (int)max - 1);
+        memcpy(dest, src, len * sizeof(WCHAR));
+        dest[len] = 0;
+    }
+    else
+    {
+        int len = WideCharToMultiByte(CP_ACP, 0, src, src_len, (char *)dest, max - 1, NULL, NULL);
+        ((char *)dest)[len] = 0;
+    }
+}
+
+/* The length a string takes in the program's buffer: characters or ANSI bytes. */
+static int mac_panel_string_length(FileOpenDlgInfos *info, const WCHAR *src, int src_len)
+{
+    if (info->unicode) return src_len;
+    return WideCharToMultiByte(CP_ACP, 0, src, src_len, NULL, 0, NULL, NULL);
+}
+
+static BOOL mac_panel_get_file_name(FileOpenDlgInfos *info, UINT dlg_type, BOOL *ret)
+{
+    OPENFILENAMEW *ofn = info->ofnInfos;
+    struct mac_file_panel panel = { 0 };
+    struct mac_file_panel_filter *filters = NULL;
+    WCHAR directory[MAX_PATH], filename[MAX_PATH], *paths = NULL, *list = NULL;
+    const WCHAR *p, *name, *ext;
+    UINT count, filter, filter_count = 0, custom = 0, i;
+    int list_len, needed;
+    HRESULT hr;
+
+    if (ofn->Flags & (OFN_ENABLEHOOK | OFN_ENABLETEMPLATE | OFN_ENABLETEMPLATEHANDLE)) return FALSE;
+    if (!__wine_mac_file_panel_enabled()) return FALSE;
+
+    if (dlg_type == SAVE_DIALOG)
+        panel.flags |= MACDRV_FILE_PANEL_SAVE;
+    else
+    {
+        panel.flags |= MACDRV_FILE_PANEL_FILES;
+        if (ofn->Flags & OFN_ALLOWMULTISELECT) panel.flags |= MACDRV_FILE_PANEL_MULTIPLE;
+        if (ofn->Flags & OFN_NODEREFERENCELINKS) panel.flags |= MACDRV_FILE_PANEL_KEEP_ALIASES;
+    }
+    if (ofn->Flags & OFN_FORCESHOWHIDDEN) panel.flags |= MACDRV_FILE_PANEL_HIDDEN;
+
+    panel.owner = ofn->hwndOwner;
+    panel.title = info->title;
+    panel.default_ext = info->defext;
+
+    /* The file types: the program's own pair first when it has one, then the list, each a
+     * name and its patterns. nFilterIndex counts the list from 1 and is 0 for the pair. */
+    if (info->customfilter && info->customfilter[0]) custom = 1;
+    if (info->filter)
+        for (p = info->filter; *p; p += lstrlenW(p) + 1, filter_count++)
+        {
+            p += lstrlenW(p) + 1;
+            if (!*p) break;     /* a name without patterns ends the list */
+        }
+    if ((custom + filter_count) && (filters = calloc(custom + filter_count, sizeof(*filters))))
+    {
+        if (custom)
+        {
+            filters[0].name = info->customfilter;
+            filters[0].spec = info->customfilter + lstrlenW(info->customfilter) + 1;
+        }
+        for (i = 0, p = info->filter; i < filter_count; i++)
+        {
+            filters[custom + i].name = p;
+            p += lstrlenW(p) + 1;
+            filters[custom + i].spec = p;
+            p += lstrlenW(p) + 1;
+        }
+        panel.filters = filters;
+        panel.filter_count = custom + filter_count;
+        if (!ofn->nFilterIndex) panel.filter_index = 0;
+        else panel.filter_index = min(custom + ofn->nFilterIndex - 1, panel.filter_count - 1);
+    }
+
+    /* Where to start and with which name: a path in the file name says both; otherwise the
+     * folder is lpstrInitialDir, and without that the panel opens where it last was. */
+    directory[0] = filename[0] = 0;
+    if (info->filename && info->filename[0])
+    {
+        WCHAR full[MAX_PATH];
+        DWORD attrs;
+
+        if (PathFindFileNameW(info->filename) == info->filename)
+            lstrcpynW(filename, info->filename, ARRAY_SIZE(filename));
+        else if (GetFullPathNameW(info->filename, ARRAY_SIZE(full), full, NULL) < ARRAY_SIZE(full))
+        {
+            attrs = GetFileAttributesW(full);
+            if (attrs != INVALID_FILE_ATTRIBUTES && (attrs & FILE_ATTRIBUTE_DIRECTORY))
+                lstrcpyW(directory, full);
+            else
+            {
+                lstrcpynW(filename, PathFindFileNameW(full), ARRAY_SIZE(filename));
+                PathRemoveFileSpecW(full);
+                lstrcpyW(directory, full);
+            }
+        }
+        /* "*.txt" in the name is a filter typed into the edit box, not a name */
+        if (wcspbrk(filename, L"*?")) filename[0] = 0;
+    }
+    if (!directory[0] && info->initdir && info->initdir[0])
+        lstrcpynW(directory, info->initdir, ARRAY_SIZE(directory));
+    panel.directory = directory[0] ? directory : NULL;
+    panel.filename = filename[0] ? filename : NULL;
+
+    hr = __wine_mac_file_panel(&panel, &paths, &count, &filter);
+    free(filters);
+    if (hr == E_NOTIMPL) return FALSE;
+
+    *ret = FALSE;
+    if (hr != S_OK) return TRUE;    /* cancelled: FALSE with no extended error */
+
+    /* One file is its full path. Several are their folder and then each name, all of one
+     * folder: a file from elsewhere (the panel can search) is left out. */
+    lstrcpynW(directory, paths, ARRAY_SIZE(directory));
+    PathRemoveFileSpecW(directory);
+    if (count > 1)
+    {
+        int dir_len = lstrlenW(directory), pos;
+
+        list_len = dir_len + 1;
+        for (i = 0, p = paths; i < count; i++, p += lstrlenW(p) + 1)
+            list_len += lstrlenW(PathFindFileNameW(p)) + 1;
+        if ((list = malloc((list_len + 1) * sizeof(WCHAR))))
+        {
+            UINT kept = 0;
+
+            memcpy(list, directory, (dir_len + 1) * sizeof(WCHAR));
+            pos = dir_len + 1;
+            for (i = 0, p = paths; i < count; i++, p += lstrlenW(p) + 1)
+            {
+                WCHAR parent[MAX_PATH];
+
+                lstrcpynW(parent, p, ARRAY_SIZE(parent));
+                PathRemoveFileSpecW(parent);
+                if (lstrcmpiW(parent, directory)) continue;
+                name = PathFindFileNameW(p);
+                memcpy(list + pos, name, (lstrlenW(name) + 1) * sizeof(WCHAR));
+                pos += lstrlenW(name) + 1;
+                kept++;
+            }
+            list[pos] = 0;
+            list_len = pos;
+            if (kept < 2)
+            {
+                free(list);
+                list = NULL;
+            }
+        }
+    }
+
+    name = PathFindFileNameW(paths);
+    if (list) needed = mac_panel_string_length(info, list, list_len) + 1;
+    else needed = mac_panel_string_length(info, paths, lstrlenW(paths)) + 1;
+
+    if (ofn->lpstrFile && ofn->nMaxFile < (DWORD)needed)
+    {
+        /* As the dialog does: the size that is needed in the buffer's first bytes. */
+        if (info->unicode)
+        {
+            if (ofn->nMaxFile >= 1) ofn->lpstrFile[0] = (WCHAR)needed;
+        }
+        else if (ofn->nMaxFile >= 2) *(WORD *)ofn->lpstrFile = (WORD)needed;
+        COMDLG32_SetCommDlgExtendedError(FNERR_BUFFERTOOSMALL);
+        free(list);
+        HeapFree(GetProcessHeap(), 0, paths);
+        return TRUE;
+    }
+
+    if (ofn->lpstrFile)
+    {
+        if (list)
+        {
+            if (info->unicode)
+                memcpy(ofn->lpstrFile, list, (list_len + 1) * sizeof(WCHAR));
+            else
+            {
+                int len = WideCharToMultiByte(CP_ACP, 0, list, list_len, (char *)ofn->lpstrFile, ofn->nMaxFile - 1, NULL, NULL);
+                ((char *)ofn->lpstrFile)[len] = 0;
+            }
+        }
+        else mac_panel_write_string(info, ofn->lpstrFile, ofn->nMaxFile, paths, lstrlenW(paths));
+    }
+
+    if (list)
+    {
+        ofn->nFileOffset = mac_panel_string_length(info, directory, lstrlenW(directory)) + 1;
+        ofn->nFileExtension = 0;
+    }
+    else
+    {
+        ofn->nFileOffset = mac_panel_string_length(info, paths, name - paths);
+        ext = wcsrchr(name, '.');
+        ofn->nFileExtension = ext ? mac_panel_string_length(info, paths, ext + 1 - paths) : 0;
+        if (ofn->lpstrFileTitle)
+            mac_panel_write_string(info, ofn->lpstrFileTitle, ofn->nMaxFileTitle, name, lstrlenW(name));
+
+        ofn->Flags &= ~OFN_EXTENSIONDIFFERENT;
+        if (info->defext && info->defext[0] && (!ext || lstrcmpiW(ext + 1, info->defext)))
+            ofn->Flags |= OFN_EXTENSIONDIFFERENT;
+    }
+
+    if (panel.filter_count)
+        ofn->nFilterIndex = (custom && !filter) ? 0 : filter - custom + 1;
+    ofn->Flags &= ~OFN_READONLY;    /* there is no "open as read-only" box to tick */
+
+    /* The dialog leaves the program in the folder of the choice, unless it was told not to. */
+    if (!(ofn->Flags & OFN_NOCHANGEDIR)) SetCurrentDirectoryW(directory);
+
+    free(list);
+    HeapFree(GetProcessHeap(), 0, paths);
+    *ret = TRUE;
+    return TRUE;
+}
+
