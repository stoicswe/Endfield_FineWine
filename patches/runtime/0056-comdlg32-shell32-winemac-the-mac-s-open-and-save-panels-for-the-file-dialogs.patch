 #include <Security/AuthSession.h>
 #include <IOKit/pwr_mgt/IOPMLib.h>
@@ -797,10 +798,63 @@ static NTSTATUS macdrv_quit_result(void *arg)
 }
 
 
+/* FineWine: the Mac's open and save panels for comdlg32 (cocoa_filepanel.m). The three
+ * calls take structs that are the same in a 32-bit and a 64-bit program, with pointers as
+ * 64-bit numbers, so one function serves both tables. */
+
+C_ASSERT( unix_file_panel_begin == MACDRV_UNIX_FILE_PANEL_BEGIN );
+C_ASSERT( unix_file_panel_poll == MACDRV_UNIX_FILE_PANEL_POLL );
+C_ASSERT( unix_file_panel_end == MACDRV_UNIX_FILE_PANEL_END );
+
+static NTSTATUS macdrv_unix_file_panel_begin(void *arg)
+{
+    struct macdrv_file_panel_begin_params *params = arg;
+    const struct macdrv_file_panel_request *request = param_ptr(params->request);
+    WineWindow *owner = NULL;
+
+    params->handle = 0;
+    if (!request) return STATUS_INVALID_PARAMETER;
+
+    if (request->owner)
+    {
+        HWND hwnd = NtUserGetAncestor(UlongToHandle(request->owner), GA_ROOT);
+        struct macdrv_win_data *data = hwnd ? get_win_data(hwnd) : NULL;
+        if (data)
+        {
+            owner = data->cocoa_window;
+            release_win_data(data);
+        }
+    }
+
+    params->handle = macdrv_file_panel_begin(request, owner);
+    return params->handle ? STATUS_SUCCESS : STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS macdrv_unix_file_panel_poll(void *arg)
+{
+    struct macdrv_file_panel_poll_params *params = arg;
+
+    params->status = macdrv_file_panel_poll(params->handle, param_ptr(params->buffer), params->size,
+                                            &params->needed, &params->count, &params->filter);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS macdrv_unix_file_panel_end(void *arg)
+{
+    struct macdrv_file_panel_end_params *params = arg;
+
+    macdrv_file_panel_end(params->handle);
+    return STATUS_SUCCESS;
+}
+
+
 const unixlib_entry_t __wine_unix_call_funcs[] =
 {
     macdrv_init,
     macdrv_quit_result,
+    macdrv_unix_file_panel_begin,
+    macdrv_unix_file_panel_poll,
+    macdrv_unix_file_panel_end,
 };
 
 C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
@@ -827,6 +881,9 @@ const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
 {
     wow64_init,
     macdrv_quit_result,
+    macdrv_unix_file_panel_begin,
+    macdrv_unix_file_panel_poll,
+    macdrv_unix_file_panel_end,
 };
 
 C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
