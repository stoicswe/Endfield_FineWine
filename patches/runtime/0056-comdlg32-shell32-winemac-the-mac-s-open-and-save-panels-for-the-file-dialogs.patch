+/**************************************************************************
+ * FineWine: the Mac's own panel in place of the dialog.
+ *
+ * Whatever the program has set on the dialog that a Mac panel can show is handed to it: the
+ * title and the button's text, the file types, the folder to start in, the name to suggest,
+ * and whether files or folders, one or several, are to be chosen. What was chosen comes back
+ * as the dialog's results, and the program's OnFileOk is asked as it is by the dialog; a
+ * program that refuses the choice gets the panel again.
+ *
+ * Returns E_NOTIMPL when the dialog has to be Wine's: when the program has put controls of
+ * its own into it, which a Mac panel has no place for, or when no panel can be shown.
+ */
+static WCHAR *mac_panel_folder_path(IShellItem *psi)
+{
+    WCHAR *path = NULL;
+
+    if (psi && FAILED(IShellItem_GetDisplayName(psi, SIGDN_FILESYSPATH, &path))) path = NULL;
+    return path;
+}
+
+static HRESULT mac_panel_set_results(FileDialogImpl *This, const WCHAR *paths, UINT count)
+{
+    LPITEMIDLIST *pidls;
+    IShellFolder *desktop;
+    WCHAR folder[MAX_PATH];
+    const WCHAR *path;
+    HRESULT hr;
+    UINT i;
+
+    if (!(pidls = calloc(count, sizeof(*pidls)))) return E_OUTOFMEMORY;
+    for (i = 0, path = paths; i < count; i++, path += lstrlenW(path) + 1)
+    {
+        /* A file to save to need not exist yet. */
+        if (!(pidls[i] = ILCreateFromPathW(path))) pidls[i] = SHSimpleIDListFromPath(path);
+    }
+
+    if (This->psia_results)
+    {
+        IShellItemArray_Release(This->psia_results);
+        This->psia_results = NULL;
+    }
+
+    hr = SHGetDesktopFolder(&desktop);
+    if (SUCCEEDED(hr))
+    {
+        hr = SHCreateShellItemArray(NULL, desktop, count, (PCUITEMID_CHILD_ARRAY)pidls, &This->psia_results);
+        IShellFolder_Release(desktop);
+    }
+    for (i = 0; i < count; i++) ILFree(pidls[i]);
+    free(pidls);
+    if (FAILED(hr)) return hr;
+
+    /* What is chosen is also what was selected last (GetCurrentSelection, GetSelectedItems). */
+    if (This->psia_selection) IShellItemArray_Release(This->psia_selection);
+    This->psia_selection = This->psia_results;
+    IShellItemArray_AddRef(This->psia_selection);
+
+    /* The folder the dialog was in when it closed, and the name in its edit box. */
+    lstrcpynW(folder, paths, ARRAY_SIZE(folder));
+    if (!(This->options & FOS_PICKFOLDERS)) PathRemoveFileSpecW(folder);
+    if (This->psi_folder)
+    {
+        IShellItem_Release(This->psi_folder);
+        This->psi_folder = NULL;
+    }
+    SHCreateItemFromParsingName(folder, NULL, &IID_IShellItem, (void **)&This->psi_folder);
+    if (count == 1) set_file_name(This, PathFindFileNameW(paths));
+    return S_OK;
+}
+
+static HRESULT show_mac_panel(FileDialogImpl *This, HWND owner)
+{
+    struct mac_file_panel panel = { 0 };
+    struct mac_file_panel_filter *filters = NULL;
+    WCHAR *directory = NULL, *paths = NULL;
+    WCHAR name_folder[MAX_PATH], filename[MAX_PATH];
+    UINT count, filter, i;
+    HRESULT hr;
+
+    if (!__wine_mac_file_panel_enabled()) return E_NOTIMPL;
+    if (!list_empty(&This->cctrls) || This->hmenu_opendropdown)
+    {
+        TRACE("the dialog has controls of the program; Wine's dialog it is\n");
+        return E_NOTIMPL;
+    }
+
+    if (This->dlg_type == ITEMDLG_TYPE_SAVE)
+    {
+        panel.flags |= MACDRV_FILE_PANEL_SAVE;
+        if (This->options & FOS_STRICTFILETYPES) panel.flags |= MACDRV_FILE_PANEL_STRICT_TYPES;
+    }
+    else
+    {
+        panel.flags |= (This->options & FOS_PICKFOLDERS) ? MACDRV_FILE_PANEL_FOLDERS : MACDRV_FILE_PANEL_FILES;
+        if (This->options & FOS_ALLOWMULTISELECT) panel.flags |= MACDRV_FILE_PANEL_MULTIPLE;
+        if (This->options & FOS_NODEREFERENCELINKS) panel.flags |= MACDRV_FILE_PANEL_KEEP_ALIASES;
+    }
+    if (This->options & FOS_FORCESHOWHIDDEN) panel.flags |= MACDRV_FILE_PANEL_HIDDEN;
+
+    panel.owner = owner;
+    panel.title = This->custom_title;
+    panel.ok_label = This->custom_okbutton;
+    panel.default_ext = This->default_ext;
+    panel.abort = &This->mac_panel_abort;
+
+    if (This->filterspec_count && (filters = calloc(This->filterspec_count, sizeof(*filters))))
+    {
+        for (i = 0; i < This->filterspec_count; i++)
+        {
+            filters[i].name = This->filterspecs[i].pszName;
+            filters[i].spec = This->filterspecs[i].pszSpec;
+        }
+        panel.filters = filters;
+        panel.filter_count = This->filterspec_count;
+        panel.filter_index = This->filetypeindex;
+    }
+
+    /* The folder: the one the program set, or failing that its default. A name set with a
+     * folder in front of it says where as well. */
+    directory = mac_panel_folder_path(This->psi_setfolder);
+    if (!directory) directory = mac_panel_folder_path(This->psi_defaultfolder);
+    filename[0] = 0;
+    if (This->set_filename && This->set_filename[0])
+    {
+        /* a copy: the name is set anew from what is chosen */
+        lstrcpynW(filename, PathFindFileNameW(This->set_filename), ARRAY_SIZE(filename));
+        if (PathFindFileNameW(This->set_filename) != This->set_filename && !PathIsRelativeW(This->set_filename) &&
+            lstrlenW(This->set_filename) < ARRAY_SIZE(name_folder))
+        {
+            lstrcpyW(name_folder, This->set_filename);
+            PathRemoveFileSpecW(name_folder);
+            panel.directory = name_folder;
+        }
+    }
+    if (!panel.directory) panel.directory = directory;
+    panel.filename = filename;
+
+    This->mac_panel_abort = 0;
+    This->mac_panel_close_hr = HRESULT_FROM_WIN32(ERROR_CANCELLED);
+    This->mac_panel_showing = TRUE;
+
+    for (;;)
+    {
+        hr = __wine_mac_file_panel(&panel, &paths, &count, &filter);
+        if (hr != S_OK) break;
+
+        if (This->filterspec_count && filter < This->filterspec_count && filter != This->filetypeindex)
+        {
+            This->filetypeindex = filter;
+            set_current_filter(This, This->filterspecs[filter].pszSpec);
+            events_OnTypeChange(This);
+        }
+
+        hr = mac_panel_set_results(This, paths, count);
+        if (FAILED(hr)) break;
+        events_OnFolderChange(This);
+
+        if (events_OnFileOk(This) == S_OK)
+        {
+            hr = S_OK;
+            break;
+        }
+
+        /* The program does not take this choice (it has usually said why in a message box of
+         * its own): the panel again, where it was. */
+        TRACE("the program refused %s\n", debugstr_w(paths));
+        lstrcpynW(name_folder, paths, ARRAY_SIZE(name_folder));
+        if (!(This->options & FOS_PICKFOLDERS))
+        {
+            lstrcpynW(filename, PathFindFileNameW(paths), ARRAY_SIZE(filename));
+            PathRemoveFileSpecW(name_folder);
+        }
+        panel.directory = name_folder;
+        panel.filter_index = This->filetypeindex;
+        if (This->psia_results)
+        {
+            IShellItemArray_Release(This->psia_results);
+            This->psia_results = NULL;
+        }
+        HeapFree(GetProcessHeap(), 0, paths);
+        paths = NULL;
+        if (This->mac_panel_abort)
+        {
+            hr = HRESULT_FROM_WIN32(ERROR_CANCELLED);
+            break;
+        }
+    }
+
+    This->mac_panel_showing = FALSE;
+    /* IFileDialog::Close during the panel: what it was closed with is what Show returns. */
+    if (This->mac_panel_abort && hr != E_NOTIMPL) hr = This->mac_panel_close_hr;
+
+    HeapFree(GetProcessHeap(), 0, paths);
+    CoTaskMemFree(directory);
+    free(filters);
+    return hr;
+}
+
 static HRESULT WINAPI IFileDialog2_fnShow(IFileDialog2 *iface, HWND hwndOwner)
 {
     FileDialogImpl *This = impl_from_IFileDialog2(iface);
+    HRESULT hr;
     TRACE("%p (%p)\n", iface, hwndOwner);
 
     This->opendropdown_has_selection = FALSE;
 
+    if (This->dlg_hwnd || This->mac_panel_showing)
+        return E_UNEXPECTED;
+
+    hr = show_mac_panel(This, hwndOwner);
+    if (hr != E_NOTIMPL) return hr;
+
     return create_dialog(This, hwndOwner);
 }
 
@@ -2893,6 +3104,11 @@ static HRESULT WINAPI IFileDialog2_fnClose(IFileDialog2 *iface, HRESULT hr)
 
     if(This->dlg_hwnd)
         EndDialog(This->dlg_hwnd, hr);
+    else if(This->mac_panel_showing)
+    {
+        This->mac_panel_close_hr = hr;
+        InterlockedExchange(&This->mac_panel_abort, 1);
+    }
 
     return S_OK;
 }
diff --git a/dlls/comdlg32/macpanel.c b/dlls/comdlg32/macpanel.c
new file mode 100644
index 0000000..c5b1165
--- /dev/null
+++ b/dlls/comdlg32/macpanel.c
@@ -0,0 +1,307 @@
+/*
+ * FineWine: the Mac's own open and save panels for the Windows file dialogs.
+ *
+ * The three ways a Windows program asks for a file or a folder (the item dialog, IFileDialog;
+ * GetOpenFileName and GetSaveFileName; and shell32's SHBrowseForFolder) come here before they
+ * show Wine's own dialog. What they ask for is handed to the Mac driver, which shows an
+ * NSOpenPanel or NSSavePanel (dlls/winemac.drv/cocoa_filepanel.m), and the Unix paths that
+ * come back are turned into Windows paths: through a drive letter that reaches the folder
+ * when the prefix has one, through Z: otherwise.
+ *
+ * The driver's Unix library is called directly, by the handle of winemac.drv, so that the
+ * driver's Windows side needs no export for it. Nothing here runs when the driver is another
+ * one, when FINEWINE_NATIVE_FILE_DIALOGS is 0, or when the driver cannot show a panel (a game
+ * that has taken the displays for itself): the caller then shows Wine's dialog as before.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "winuser.h"
+#include "winnls.h"
+#include "winerror.h"
+#include "wine/unixlib.h"
+#include "wine/debug.h"
+
+#include "macpanel.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(commdlg);
+
+/* How often the panel is asked whether it has closed, when no message arrives. */
+#define POLL_INTERVAL 40
+
+static unixlib_handle_t macdrv_handle;
+
+static BOOL WINAPI init_macdrv_handle( INIT_ONCE *once, void *param, void **context )
+{
+    HMODULE module = GetModuleHandleW( L"winemac.drv" );
+    unixlib_handle_t handle = 0;
+
+    if (module && !NtQueryVirtualMemory( GetCurrentProcess(), module, MemoryWineLoadUnixLib,
+                                         &handle, sizeof(handle), NULL ))
+        macdrv_handle = handle;
+    return TRUE;
+}
+
+static unixlib_handle_t get_macdrv_handle(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+
+    /* The driver is loaded with the first window; a program that shows a file dialog before
+     * it has one gets the driver through the desktop window here. */
+    if (!GetModuleHandleW( L"winemac.drv" )) GetDesktopWindow();
+    if (!GetModuleHandleW( L"winemac.drv" )) return 0;
+    InitOnceExecuteOnce( &once, init_macdrv_handle, NULL, NULL );
+    return macdrv_handle;
+}
+
+BOOL WINAPI __wine_mac_file_panel_enabled(void)
+{
+    WCHAR value[8];
+    DWORD len = GetEnvironmentVariableW( L"FINEWINE_NATIVE_FILE_DIALOGS", value, ARRAY_SIZE(value) );
+
+    if (len == 1 && value[0] == '0') return FALSE;
+    return get_macdrv_handle() != 0;
+}
+
+/* The Unix path of a Windows folder, as UTF-16; NULL if it is not a folder that exists. */
+static WCHAR *unix_directory( const WCHAR *directory )
+{
+    WCHAR full[MAX_PATH], *ret = NULL;
+    char *unix_name;
+    DWORD attrs, len;
+
+    if (!directory || !directory[0]) return NULL;
+    len = GetFullPathNameW( directory, ARRAY_SIZE(full), full, NULL );
+    if (!len || len >= ARRAY_SIZE(full)) return NULL;
+    attrs = GetFileAttributesW( full );
+    if (attrs == INVALID_FILE_ATTRIBUTES || !(attrs & FILE_ATTRIBUTE_DIRECTORY)) return NULL;
+    if (!(unix_name = wine_get_unix_file_name( full ))) return NULL;
+
+    len = MultiByteToWideChar( CP_UNIXCP, 0, unix_name, -1, NULL, 0 );
+    if (len && (ret = HeapAlloc( GetProcessHeap(), 0, len * sizeof(WCHAR) )))
+        MultiByteToWideChar( CP_UNIXCP, 0, unix_name, -1, ret, len );
+    HeapFree( GetProcessHeap(), 0, unix_name );
+    return ret;
+}
+
+static unsigned int string_size( const WCHAR *str )
+{
+    return (str && str[0]) ? (lstrlenW( str ) + 1) * sizeof(WCHAR) : 0;
+}
+
+static unsigned int put_string( struct macdrv_file_panel_request *request, unsigned int *pos, const WCHAR *str )
+{
+    unsigned int size = string_size( str ), offset = *pos;
+
+    if (!size) return 0;
+    memcpy( (char *)request + offset, str, size );
+    *pos += size;
+    return offset;
+}
+
+/* The request as the one block of memory the driver takes. */
+static struct macdrv_file_panel_request *build_request( const struct mac_file_panel *panel, const WCHAR *directory )
+{
+    struct macdrv_file_panel_request *request;
+    struct macdrv_file_panel_filter *filters;
+    unsigned int size, pos, i;
+
+    size = sizeof(*request) + panel->filter_count * sizeof(*filters);
+    size += string_size( panel->title ) + string_size( panel->ok_label ) + string_size( panel->message );
+    size += string_size( directory ) + string_size( panel->filename ) + string_size( panel->default_ext );
+    for (i = 0; i < panel->filter_count; i++)
+        size += string_size( panel->filters[i].name ) + string_size( panel->filters[i].spec );
+
+    if (!(request = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, size ))) return NULL;
+    request->size = size;
+    request->flags = panel->flags;
+    request->owner = HandleToUlong( panel->owner );
+    request->filter_count = panel->filter_count;
+    request->filter_index = panel->filter_index;
+
+    pos = sizeof(*request);
+    if (panel->filter_count)
+    {
+        request->filters = pos;
+        filters = (struct macdrv_file_panel_filter *)((char *)request + pos);
+        pos += panel->filter_count * sizeof(*filters);
+        for (i = 0; i < panel->filter_count; i++)
+        {
+            filters[i].name = put_string( request, &pos, panel->filters[i].name );
+            filters[i].spec = put_string( request, &pos, panel->filters[i].spec );
+        }
+    }
+    request->title = put_string( request, &pos, panel->title );
+    request->ok_label = put_string( request, &pos, panel->ok_label );
+    request->message = put_string( request, &pos, panel->message );
+    request->directory = put_string( request, &pos, directory );
+    request->filename = put_string( request, &pos, panel->filename );
+    request->default_ext = put_string( request, &pos, panel->default_ext );
+    return request;
+}
+
+/* The Unix paths the panel gave, as Windows paths in the same form. */
+static WCHAR *dos_paths( const char *unix_paths, UINT *count )
+{
+    WCHAR *ret = NULL, *dos;
+    unsigned int size = 0, len;
+    const char *path;
+
+    *count = 0;
+    for (path = unix_paths; *path; path += strlen( path ) + 1)
+    {
+        WCHAR *bigger;
+
+        if (!(dos = wine_get_dos_file_name( path )))
+        {
+            WARN( "no Windows path for %s\n", debugstr_a(path) );
+            continue;
+        }
+        len = lstrlenW( dos ) + 1;
+        bigger = ret ? HeapReAlloc( GetProcessHeap(), 0, ret, (size + len + 1) * sizeof(WCHAR) )
+                     : HeapAlloc( GetProcessHeap(), 0, (size + len + 1) * sizeof(WCHAR) );
+        if (!bigger)
+        {
+            HeapFree( GetProcessHeap(), 0, dos );
+            break;
+        }
+        ret = bigger;
+        memcpy( ret + size, dos, len * sizeof(WCHAR) );
+        size += len;
+        ret[size] = 0;
+        (*count)++;
+        HeapFree( GetProcessHeap(), 0, dos );
+    }
+    return ret;
+}
+
+HRESULT WINAPI __wine_mac_file_panel( const struct mac_file_panel *panel, WCHAR **paths, UINT *count, UINT *filter )
+{
+    struct macdrv_file_panel_begin_params begin = { 0 };
+    struct macdrv_file_panel_poll_params poll = { 0 };
+    struct macdrv_file_panel_end_params end = { 0 };
+    struct macdrv_file_panel_request *request;
+    unixlib_handle_t handle;
+    WCHAR *directory;
+    char *buffer = NULL;
+    HWND owner = NULL;
+    BOOL disabled = FALSE, quit = FALSE;
+    WPARAM quit_code = 0;
+    HRESULT hr;
+
+    *paths = NULL;
+    *count = 0;
+    *filter = panel->filter_index;
+
+    if (!__wine_mac_file_panel_enabled()) return E_NOTIMPL;
+    handle = get_macdrv_handle();
+
+    directory = unix_directory( panel->directory );
+    request = build_request( panel, directory );
+    HeapFree( GetProcessHeap(), 0, directory );
+    if (!request) return E_NOTIMPL;
+
+    begin.request = (ULONG_PTR)request;
+    if (__wine_unix_call( handle, MACDRV_UNIX_FILE_PANEL_BEGIN, &begin ) || !begin.handle)
+    {
+        TRACE( "the driver shows no panel\n" );
+        HeapFree( GetProcessHeap(), 0, request );
+        return E_NOTIMPL;
+    }
+    HeapFree( GetProcessHeap(), 0, request );
+    TRACE( "panel %s for owner %p\n", wine_dbgstr_longlong(begin.handle), panel->owner );
+
+    /* As a modal dialog does: the window it belongs to takes no input while it is open. */
+    if (panel->owner && (owner = GetAncestor( panel->owner, GA_ROOT )) && IsWindowEnabled( owner ))
+    {
+        EnableWindow( owner, FALSE );
+        disabled = TRUE;
+    }
+
+    poll.handle = begin.handle;
+    for (;;)
+    {
+        MSG msg;
+
+        if (__wine_unix_call( handle, MACDRV_UNIX_FILE_PANEL_POLL, &poll )) poll.status = MACDRV_FILE_PANEL_CANCELLED;
+        if (poll.status != MACDRV_FILE_PANEL_PENDING) break;
+        if (panel->abort && *panel->abort)
+        {
+            poll.status = MACDRV_FILE_PANEL_CANCELLED;
+            break;
+        }
+
+        MsgWaitForMultipleObjectsEx( 0, NULL, POLL_INTERVAL, QS_ALLINPUT, MWMO_INPUTAVAILABLE );
+        while (PeekMessageW( &msg, NULL, 0, 0, PM_REMOVE ))
+        {
+            if (msg.message == WM_QUIT)
+            {
+                quit = TRUE;
+                quit_code = msg.wParam;
+                break;
+            }
+            TranslateMessage( &msg );
+            DispatchMessageW( &msg );
+        }
+        if (quit)
+        {
+            poll.status = MACDRV_FILE_PANEL_CANCELLED;
+            break;
+        }
+    }
+
+    if (poll.status == MACDRV_FILE_PANEL_CHOSEN && poll.needed &&
+        (buffer = HeapAlloc( GetProcessHeap(), 0, poll.needed )))
+    {
+        poll.buffer = (ULONG_PTR)buffer;
+        poll.size = poll.needed;
+        if (__wine_unix_call( handle, MACDRV_UNIX_FILE_PANEL_POLL, &poll ) || poll.needed > poll.size)
+            poll.status = MACDRV_FILE_PANEL_CANCELLED;
+    }
+
+    end.handle = begin.handle;
+    __wine_unix_call( handle, MACDRV_UNIX_FILE_PANEL_END, &end );
+
+    if (disabled) EnableWindow( owner, TRUE );
+    if (owner && !quit) SetForegroundWindow( owner );
+    if (quit) PostQuitMessage( quit_code );
+
+    hr = HRESULT_FROM_WIN32( ERROR_CANCELLED );
+    if (poll.status == MACDRV_FILE_PANEL_CHOSEN && buffer)
+    {
+        *paths = dos_paths( buffer, count );
+        if (*paths && *count)
+        {
+            *filter = poll.filter;
+            hr = S_OK;
+        }
+        else
+        {
+            HeapFree( GetProcessHeap(), 0, *paths );
+            *paths = NULL;
+            *count = 0;
+        }
+    }
+    HeapFree( GetProcessHeap(), 0, buffer );
+    TRACE( "-> %#lx, %u paths, first %s\n", hr, *count, debugstr_w(*paths) );
+    return hr;
+}
diff --git a/dlls/comdlg32/macpanel.h b/dlls/comdlg32/macpanel.h
new file mode 100644
index 0000000..85321d0
--- /dev/null
+++ b/dlls/comdlg32/macpanel.h
@@ -0,0 +1,61 @@
+/*
+ * FineWine: the Mac's own open and save panels for the Windows file dialogs.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_COMDLG32_MACPANEL_H
+#define __WINE_COMDLG32_MACPANEL_H
+
+#include "../winemac.drv/filepanel.h"
+
+/* One file type of a panel. The same as COMDLG_FILTERSPEC, without its header. */
+struct mac_file_panel_filter
+{
+    const WCHAR *name;          /* "Text files (*.txt)" */
+    const WCHAR *spec;          /* "*.txt;*.log" */
+};
+
+/* What a file dialog asks the Mac to show. */
+struct mac_file_panel
+{
+    DWORD flags;                /* MACDRV_FILE_PANEL_* */
+    HWND owner;
+    const WCHAR *title;
+    const WCHAR *ok_label;
+    const WCHAR *message;
+    const WCHAR *directory;     /* the folder to start in, as a Windows path */
+    const WCHAR *filename;      /* save: the name to suggest */
+    const WCHAR *default_ext;   /* save: the extension for a name typed without one */
+    UINT filter_count;
+    UINT filter_index;          /* counted from 0 */
+    const struct mac_file_panel_filter *filters;
+    volatile LONG *abort;       /* when it becomes non-zero the panel is closed, as if cancelled */
+};
+
+/* Whether file dialogs are the Mac's in this process: the driver is the Mac one and
+ * FINEWINE_NATIVE_FILE_DIALOGS is not 0. */
+extern BOOL WINAPI __wine_mac_file_panel_enabled(void);
+
+/* Shows the panel and waits for it, handling the thread's window messages meanwhile.
+ *   S_OK:          *paths has *count Windows paths, each ending in a zero and one more zero
+ *                  after the last; to be freed with HeapFree( GetProcessHeap() ). *filter is
+ *                  the file type that was selected, counted from 0.
+ *   HRESULT_FROM_WIN32(ERROR_CANCELLED): the user cancelled.
+ *   E_NOTIMPL:     no panel could be shown; the caller shows Wine's own dialog. */
+extern HRESULT WINAPI __wine_mac_file_panel( const struct mac_file_panel *panel, WCHAR **paths,
+                                             UINT *count, UINT *filter );
+
+#endif /* __WINE_COMDLG32_MACPANEL_H */
diff --git a/dlls/shell32/brsfolder.c b/dlls/shell32/brsfolder.c
index 36607ca..4165d5a 100644
--- a/dlls/shell32/brsfolder.c
+++ b/dlls/shell32/brsfolder.c
@@ -31,6 +31,7 @@
 #include "commoncontrols.h"
 #include "shellapi.h"
 #include "shresdef.h"
+#include "../comdlg32/macpanel.h"
 #include "shellfolder.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(shell);
@@ -1197,6 +1198,178 @@ LPITEMIDLIST WINAPI SHBrowseForFolderA (LPBROWSEINFOA lpbi)
 }
 
 
+/*************************************************************************
+ * FineWine: the Mac's own panel in place of the folder dialog.
+ *
+ * The folder is chosen in an NSOpenPanel (dlls/comdlg32/macpanel.c). A program's callback
+ * is served as far as a panel allows, through a window that stands in for the dialog: what
+ * the program sends to it at BFFM_INITIALIZED (the folder to start in, the button's text)
+ * goes to the panel, and the choice is shown to it with BFFM_SELCHANGED; if it then disables
+ * the OK button, the panel comes back, as the dialog would not have let that folder through.
+ *
+ * Returns FALSE when the dialog has to be Wine's: for computers and printers, for a root
+ * that is not a folder on disk, or when no panel can be shown.
+ */
+struct mac_browse_state
+{
+    WCHAR selection[MAX_PATH];  /* BFFM_SETSELECTION */
+    WCHAR ok_text[128];         /* BFFM_SETOKTEXT */
+    BOOL ok_enabled;            /* BFFM_ENABLEOK */
+};
+
+static LRESULT WINAPI mac_browse_stub_proc( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
+{
+    struct mac_browse_state *state = (struct mac_browse_state *)GetWindowLongPtrW( hwnd, GWLP_USERDATA );
+
+    if (state) switch (msg)
+    {
+    case BFFM_SETSELECTIONA:
+        if (!lp) return 0;
+        if (wp) MultiByteToWideChar( CP_ACP, 0, (const char *)lp, -1, state->selection, ARRAY_SIZE(state->selection) );
+        else if (!SHGetPathFromIDListW( (LPCITEMIDLIST)lp, state->selection )) state->selection[0] = 0;
+        state->selection[ARRAY_SIZE(state->selection) - 1] = 0;
+        return 0;
+    case BFFM_SETSELECTIONW:
+        if (!lp) return 0;
+        if (wp) lstrcpynW( state->selection, (const WCHAR *)lp, ARRAY_SIZE(state->selection) );
+        else if (!SHGetPathFromIDListW( (LPCITEMIDLIST)lp, state->selection )) state->selection[0] = 0;
+        return 0;
+    case BFFM_SETOKTEXT:
+        if (lp) lstrcpynW( state->ok_text, (const WCHAR *)lp, ARRAY_SIZE(state->ok_text) );
+        return 0;
+    case BFFM_ENABLEOK:
+        state->ok_enabled = lp != 0;
+        return 0;
+    case BFFM_SETSTATUSTEXTA:
+    case BFFM_SETSTATUSTEXTW:
+    case BFFM_SETEXPANDED:
+        return 0;
+    }
+    return DefWindowProcW( hwnd, msg, wp, lp );
+}
+
+static HWND mac_browse_create_stub( struct mac_browse_state *state )
+{
+    static const WCHAR class_name[] = L"FineWineBrowseForFolder";
+    WNDCLASSW wc = { 0 };
+    HWND hwnd;
+
+    wc.lpfnWndProc = mac_browse_stub_proc;
+    wc.hInstance = shell32_hInstance;
+    wc.lpszClassName = class_name;
+    RegisterClassW( &wc );      /* fails the second time, which is fine */
+
+    hwnd = CreateWindowExW( 0, class_name, NULL, 0, 0, 0, 0, 0, HWND_MESSAGE, NULL, shell32_hInstance, NULL );
+    if (hwnd) SetWindowLongPtrW( hwnd, GWLP_USERDATA, (LONG_PTR)state );
+    return hwnd;
+}
+
+static BOOL mac_browse_for_folder( BROWSEINFOW *bi, LPITEMIDLIST *result )
+{
+    struct mac_browse_state state = { .ok_enabled = TRUE };
+    struct mac_file_panel panel = { 0 };
+    WCHAR root[MAX_PATH], directory[MAX_PATH], *paths = NULL;
+    LPITEMIDLIST root_pidl = NULL, pidl = NULL;
+    HWND stub = NULL;
+    UINT count, filter;
+    HRESULT hr;
+
+    *result = NULL;
+
+    if (bi->ulFlags & (BIF_BROWSEFORCOMPUTER | BIF_BROWSEFORPRINTER)) return FALSE;
+    if (!__wine_mac_file_panel_enabled()) return FALSE;
+
+    /* A root other than the desktop is where the browsing starts and stays below. */
+    root[0] = 0;
+    if (bi->pidlRoot)
+    {
+        if (IS_INTRESOURCE(bi->pidlRoot))
+            SHGetFolderLocation( NULL, LOWORD(bi->pidlRoot), NULL, 0, &root_pidl );
+        else
+            root_pidl = ILClone( bi->pidlRoot );
+        if (root_pidl && !_ILIsDesktop( root_pidl ) && !SHGetPathFromIDListW( root_pidl, root ))
+        {
+            ILFree( root_pidl );
+            return FALSE;       /* My Computer, the network: not a folder a panel can show */
+        }
+        ILFree( root_pidl );
+    }
+
+    panel.flags = MACDRV_FILE_PANEL_FOLDERS;
+    if (bi->ulFlags & BIF_BROWSEINCLUDEFILES) panel.flags |= MACDRV_FILE_PANEL_FILES;
+    if (bi->ulFlags & BIF_NONEWFOLDERBUTTON) panel.flags |= MACDRV_FILE_PANEL_NO_NEW_FOLDER;
+    panel.owner = bi->hwndOwner;
+    panel.message = bi->lpszTitle;      /* the dialog's line of text above the tree */
+
+    if (bi->lpfn)
+    {
+        if (!(stub = mac_browse_create_stub( &state ))) return FALSE;
+        bi->lpfn( stub, BFFM_INITIALIZED, 0, bi->lParam );
+    }
+
+    lstrcpynW( directory, state.selection[0] ? state.selection : root, ARRAY_SIZE(directory) );
+
+    for (;;)
+    {
+        panel.directory = directory[0] ? directory : NULL;
+        panel.ok_label = state.ok_text[0] ? state.ok_text : NULL;
+
+        hr = __wine_mac_file_panel( &panel, &paths, &count, &filter );
+        if (hr != S_OK) break;
+
+        ILFree( pidl );
+        if (!(pidl = ILCreateFromPathW( paths )))
+        {
+            hr = HRESULT_FROM_WIN32( ERROR_CANCELLED );
+            break;
+        }
+
+        if (pidl && root[0] && lstrcmpiW( root, paths ) && !PathIsPrefixW( root, paths ))
+        {
+            /* outside the root: the dialog has no way to get there */
+            MessageBeep( MB_ICONWARNING );
+            lstrcpynW( directory, root, ARRAY_SIZE(directory) );
+        }
+        else if (pidl)
+        {
+            if (!bi->lpfn) break;
+            state.ok_enabled = TRUE;
+            bi->lpfn( stub, BFFM_SELCHANGED, (LPARAM)pidl, bi->lParam );
+            if (state.ok_enabled) break;
+            TRACE( "the program does not take %s\n", debugstr_w(paths) );
+            lstrcpynW( directory, paths, ARRAY_SIZE(directory) );
+        }
+
+        ILFree( pidl );
+        pidl = NULL;
+        HeapFree( GetProcessHeap(), 0, paths );
+        paths = NULL;
+    }
+
+    if (stub) DestroyWindow( stub );
+
+    if (hr == E_NOTIMPL)
+    {
+        ILFree( pidl );
+        return FALSE;
+    }
+
+    if (hr == S_OK && pidl)
+    {
+        SHFILEINFOW sfi = { 0 };
+
+        if (bi->pszDisplayName)
+            lstrcpynW( bi->pszDisplayName, PathFindFileNameW( paths ), MAX_PATH );
+        if (SHGetFileInfoW( (const WCHAR *)pidl, 0, &sfi, sizeof(sfi), SHGFI_PIDL | SHGFI_SYSICONINDEX ))
+            bi->iImage = sfi.iIcon;
+        *result = pidl;
+    }
+    else ILFree( pidl );
+
+    HeapFree( GetProcessHeap(), 0, paths );
+    return TRUE;
+}
