 extern pthread_key_t thread_data_key;
 
+/* FineWine: publish the thread's TEB in thread-specific data slot 6, where NtCurrentTeb() and
+ * the assembly entry points read it (see NtCurrentTeb in winnt.h). */
+static inline void set_current_teb( TEB *teb )
+{
+#if defined(__APPLE__) && defined(__aarch64__)
+    ULONG_PTR tsd;
+    __asm__( "mrs %0, tpidrro_el0" : "=r" (tsd) );
+    ((TEB **)(tsd & ~(ULONG_PTR)7))[6] = teb;
+#endif
+}
+
 static inline struct thread_data *get_thread_data(void)
 {
     return pthread_getspecific( thread_data_key );
