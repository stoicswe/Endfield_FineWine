diff --git a/dlls/winevulkan/vulkan_private.h b/dlls/winevulkan/vulkan_private.h
index bc8fe30..a3ef2be 100644
--- a/dlls/winevulkan/vulkan_private.h
+++ b/dlls/winevulkan/vulkan_private.h
@@ -45,9 +45,20 @@ struct wine_cmd_pool
     VULKAN_OBJECT_HEADER( VkCommandPool, command_pool );
 };
 
+/* FineWine 32-bit: the handle is the address of the program's own structure, which a 32-bit
+ * program stores without the base of its memory window. */
+static inline struct vk_command_pool *client_command_pool_from_handle(VkCommandPool handle)
+{
+#if defined(__APPLE__) && defined(__aarch64__) && defined(_WIN64)
+    return __wine_wow_window_ptr64(handle);
+#else
+    return command_pool_from_handle(handle);
+#endif
+}
+
 static inline struct wine_cmd_pool *wine_cmd_pool_from_handle(VkCommandPool handle)
 {
-    struct vulkan_client_object *client = &command_pool_from_handle(handle)->obj;
+    struct vulkan_client_object *client = &client_command_pool_from_handle(handle)->obj;
     return (struct wine_cmd_pool *)(UINT_PTR)client->unix_handle;
 }
 
