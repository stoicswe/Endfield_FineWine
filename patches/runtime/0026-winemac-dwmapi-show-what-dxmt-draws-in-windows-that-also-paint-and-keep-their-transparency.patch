+/***********************************************************************
+ *              window_composites_alpha
+ *
+ * FineWine: Wine has no DWM to composite the alpha of a window that asked it to blur behind
+ * the window, as a launcher's rounded or translucent Direct3D window does (Qt asks for it for
+ * every translucent window that draws with OpenGL or ANGLE). dwmapi marks those windows, and
+ * the window server composites them instead. Without this the see-through margin of such a
+ * window is drawn black.
+ */
+static BOOL window_composites_alpha(HWND hwnd)
+{
+    static const WCHAR prop[] = {'_','_','w','i','n','e','_','d','w','m','_','b','l','u','r','_','b','e','h','i','n','d',0};
+    return NtUserGetProp(hwnd, prop) != NULL;
 }
 
 
