+/* A window shows one client view at a time, the one last presented, and hides the one before.
+ * Programs make more than one on a window and let some go again: a second swap chain, or an
+ * OpenGL or Vulkan surface made only to see what the graphics card can do (Qt does both when
+ * it starts). The view DXMT is drawing into is hidden when the other appears, and nothing
+ * shows it again when the other goes: the window stays blank while frames are presented into
+ * it. So whenever a client surface leaves a window, the most recent view of DXMT's that is
+ * left on that window is shown.
+ * Called with `detaching` from a surface's detach function, where Wine holds the lock that
+ * guards every surface: nothing can go away meanwhile, and no reference may be taken. */
+static void finewine_dxmt_show_remaining(HWND hwnd, struct client_surface *leaving, BOOL detaching)
+{
+    struct client_surface *remaining = NULL;
+    unsigned int i, order = 0;
 
+    pthread_mutex_lock(&finewine_dxmt_mutex);
+    for (i = 0; i < ARRAY_SIZE(finewine_dxmt_views); i++)
+        if (finewine_dxmt_views[i].surface && finewine_dxmt_views[i].metal_view &&
+            finewine_dxmt_views[i].surface != leaving && finewine_dxmt_views[i].surface->hwnd == hwnd &&
+            finewine_dxmt_views[i].order >= order)
+        {
+            remaining = finewine_dxmt_views[i].surface;
+            order = finewine_dxmt_views[i].order;
+        }
+    if (remaining && !detaching) client_surface_add_ref(remaining);
+    pthread_mutex_unlock(&finewine_dxmt_mutex);
+    if (!remaining) return;
+    macdrv_client_surface_update(remaining);
+    macdrv_client_surface_present(remaining, 0);
+    if (!detaching) client_surface_release(remaining);
+}
+
+/* Whether a client view is one DXMT is presenting into (see macdrv_surface_flush). */
+BOOL macdrv_finewine_is_dxmt_view(WineContentView *view)
+{
+    unsigned int i;
+    BOOL ret = FALSE;
+
+    pthread_mutex_lock(&finewine_dxmt_mutex);
+    for (i = 0; i < ARRAY_SIZE(finewine_dxmt_views) && !ret; i++)
+        ret = finewine_dxmt_views[i].surface && finewine_dxmt_views[i].metal_view &&
+              finewine_dxmt_views[i].client_view == view;
+    pthread_mutex_unlock(&finewine_dxmt_mutex);
+    return ret;
+}
