+    /* FineWine: a program that draws smaller than its window has its picture brought to the
+     * window's size by MetalFX: by DXMT for Direct3D 10 and 11, by MoltenVK for Vulkan and
+     * Direct3D 12. Both look, a few times a second, at one switch: FINEWINE_METALFX_AUTO=0
+     * starts with it off, and the state of the notification "finewine.metalfx.<process id>"
+     * overrides that (1 on, 2 off, 0 not said). The View menu's item sets that state for this
+     * process; the FineWine app sets it from outside in the same way. */
+    static int upscalingToken = NOTIFY_TOKEN_INVALID;
+
+    - (int) upscalingToken
+    {
+        if (upscalingToken == NOTIFY_TOKEN_INVALID)
+        {
+            char name[64];
+            snprintf(name, sizeof(name), "finewine.metalfx.%d", getpid());
+            if (notify_register_check(name, &upscalingToken) != NOTIFY_STATUS_OK)
+                upscalingToken = NOTIFY_TOKEN_INVALID;
+        }
+        return upscalingToken;
+    }
+
+    - (BOOL) isUpscalingWanted
+    {
+        const char* byDefault = getenv("FINEWINE_METALFX_AUTO");
+        int token = [self upscalingToken];
+        uint64_t state = 0;
+
+        if (token != NOTIFY_TOKEN_INVALID && notify_get_state(token, &state) == NOTIFY_STATUS_OK && state)
+            return state == 1;
+        return !(byDefault && byDefault[0] == '0');
+    }
+
+    - (void) toggleUpscaling:(id)sender
+    {
+        int token = [self upscalingToken];
+        if (token != NOTIFY_TOKEN_INVALID)
+            notify_set_state(token, [self isUpscalingWanted] ? 2 : 1);
+    }
+
