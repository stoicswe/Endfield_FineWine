+
+/* FineWine: FINEWINE_RENDER_SCALE=<percent, 25 to 99> makes programs see a screen that many
+ * percent of the real one in each direction: the display mode they find when they start is an
+ * emulated one of that size, as if it had been chosen in a game's settings, and Wine's mode
+ * emulation (EmulateModeset) is on. What they draw is brought to the real size when it is
+ * shown: by MetalFX for Direct3D and Vulkan (DXMT, MoltenVK), by Wine for everything else.
+ * A program can still pick another size, the real one included. */
+static UINT finewine_render_scale(void)
+{
+    static int scale = -1;
+    if (scale < 0)
+    {
+        const char *env = getenv( "FINEWINE_RENDER_SCALE" );
+        int value = env ? atoi( env ) : 0;
+        scale = (value >= 25 && value <= 99) ? value : 0;
+    }
+    return scale;
+}
+
+/* Wine keeps the relation between an emulated mode and the real one as a fraction of two
+ * 16-bit numbers, per direction and multiplied by the DPI (monitor_get_dpi, make_ratio), and
+ * stops with an assertion when a size does not reduce that far. The size nearest to the one
+ * wanted that does, for every DPI a prefix can have, is taken; an even one where possible. */
+static UINT finewine_snap_size( UINT physical, UINT wanted )
+{
+    static const UINT dpis[] = {96, 120, 144, 168, 192, 216, 240, 288, 384, 480};
+    UINT delta, i, k;
+
+    for (delta = 0; delta < 256; delta++)
+    {
+        for (k = 0; k < 2; k++)
+        {
+            UINT size = k ? wanted + delta : wanted - delta;
+            if (!size || size > physical || (k && !delta)) continue;
+            if ((size & 1) && delta < 128) continue;  /* an even size where there is one near */
+            for (i = 0; i < ARRAY_SIZE(dpis); i++)
+            {
+                UINT d = gcd( dpis[i] * physical, size );
+                if (dpis[i] * physical / d >= 65536 || size / d >= 65536) break;
+            }
+            if (i == ARRAY_SIZE(dpis)) return size;
+        }
+    }
+    return physical;
 }
 
