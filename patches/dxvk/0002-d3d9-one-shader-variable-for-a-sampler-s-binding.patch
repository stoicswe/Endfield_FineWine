--- a/src/dxso/dxso_compiler.cpp
+++ b/src/dxso/dxso_compiler.cpp
@@ -826,11 +826,16 @@ namespace dxvk {
 
       DclSampler(idx, binding, samplerType, false, implicit);
 
-      if (samplerType != SamplerTypeTexture3D) {
+      if (samplerType != SamplerTypeTexture3D && !m_moduleInfo.options.singleSamplerVariant) {
         // We could also be depth compared!
         DclSampler(idx, binding, samplerType, true, implicit);
       }
     }
+    else if (m_moduleInfo.options.singleSamplerVariant) {
+      // FineWine: one variable for the binding, see DxsoOptions::singleSamplerVariant.
+      // A shader that does not say what kind of texture it samples gets a 2D one.
+      DclSampler(idx, binding, SamplerTypeTexture2D, false, implicit);
+    }
     else {
       // Could be any of these!
       // We will check with the spec constant at sample time.
