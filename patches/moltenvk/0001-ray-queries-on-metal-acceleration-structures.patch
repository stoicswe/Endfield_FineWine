+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "MVKAccelerationStructure.h"
+#include "MVKBuffer.h"
+#include "MVKFoundation.h"
+#include <atomic>
+#import <objc/runtime.h>
+
+using namespace std;
+
+
+#pragma mark -
+#pragma mark Support functions
+
+static const char _mvkInstancedStructuresKey = 0;
+
+NSArray<id<MTLAccelerationStructure>>* mvkGetInstancedMTLAccelerationStructures(id mtlAccelerationStructure) {
+	return mtlAccelerationStructure ? objc_getAssociatedObject(mtlAccelerationStructure, &_mvkInstancedStructuresKey) : nil;
+}
+
+bool mvkSupportsAccelerationStructures(id<MTLDevice> mtlDevice) {
+	// Vertex formats and the row-major matrix layout used below need macOS 15.
+	if (@available(macOS 15.0, iOS 18.0, *)) {
+		return mtlDevice.supportsRaytracing;
+	}
+	return false;
+}
+
+static MTLAttributeFormat mvkMTLVertexFormat(VkFormat vkFormat) {
+	switch (vkFormat) {
+		case VK_FORMAT_R32G32B32_SFLOAT:    return MTLAttributeFormatFloat3;
+		case VK_FORMAT_R32G32B32A32_SFLOAT: return MTLAttributeFormatFloat4;	// w is ignored
+		case VK_FORMAT_R32G32_SFLOAT:       return MTLAttributeFormatFloat2;
+		case VK_FORMAT_R16G16B16_SFLOAT:    return MTLAttributeFormatHalf3;
+		case VK_FORMAT_R16G16B16A16_SFLOAT: return MTLAttributeFormatHalf4;
+		case VK_FORMAT_R16G16_SFLOAT:       return MTLAttributeFormatHalf2;
+		case VK_FORMAT_R16G16B16_SNORM:     return MTLAttributeFormatShort3Normalized;
+		case VK_FORMAT_R16G16B16A16_SNORM:  return MTLAttributeFormatShort4Normalized;
+		case VK_FORMAT_R16G16_SNORM:        return MTLAttributeFormatShort2Normalized;
+		default:                            return MTLAttributeFormatInvalid;
+	}
+}
+
+static MTLAccelerationStructureUsage mvkMTLAccelerationStructureUsage(VkBuildAccelerationStructureFlagsKHR flags) {
+	MTLAccelerationStructureUsage usage = MTLAccelerationStructureUsageNone;
+	if (flags & VK_BUILD_ACCELERATION_STRUCTURE_ALLOW_UPDATE_BIT_KHR) { usage |= MTLAccelerationStructureUsageRefit; }
+	if (flags & VK_BUILD_ACCELERATION_STRUCTURE_PREFER_FAST_BUILD_BIT_KHR) { usage |= MTLAccelerationStructureUsagePreferFastBuild; }
+	return usage;
+}
+
+// Fills a Metal instance from a Vulkan one. The transform changes from three rows of four to
+// four columns of three; the index of the instanced structure is filled in by the caller.
+static void mvkConvertInstance(const VkAccelerationStructureInstanceKHR& vkInst,
+							   MTLAccelerationStructureUserIDInstanceDescriptor& mtlInst) {
+	for (uint32_t col = 0; col < 4; col++) {
+		for (uint32_t row = 0; row < 3; row++) {
+			mtlInst.transformationMatrix.columns[col].elements[row] = vkInst.transform.matrix[row][col];
+		}
+	}
+	MTLAccelerationStructureInstanceOptions opts = MTLAccelerationStructureInstanceOptionNone;
+	VkGeometryInstanceFlagsKHR flags = vkInst.flags;
+	if (flags & VK_GEOMETRY_INSTANCE_TRIANGLE_FACING_CULL_DISABLE_BIT_KHR) { opts |= MTLAccelerationStructureInstanceOptionDisableTriangleCulling; }
+	if (flags & VK_GEOMETRY_INSTANCE_TRIANGLE_FLIP_FACING_BIT_KHR) { opts |= MTLAccelerationStructureInstanceOptionTriangleFrontFacingWindingCounterClockwise; }
+	if (flags & VK_GEOMETRY_INSTANCE_FORCE_OPAQUE_BIT_KHR) { opts |= MTLAccelerationStructureInstanceOptionOpaque; }
+	if (flags & VK_GEOMETRY_INSTANCE_FORCE_NO_OPAQUE_BIT_KHR) { opts |= MTLAccelerationStructureInstanceOptionNonOpaque; }
+	mtlInst.options = opts;
+	mtlInst.mask = vkInst.mask;
+	mtlInst.intersectionFunctionTableOffset = vkInst.instanceShaderBindingTableRecordOffset;
+	mtlInst.userID = vkInst.instanceCustomIndex;
+	mtlInst.accelerationStructureIndex = 0;
+}
+
+MTLAccelerationStructureDescriptor* mvkNewMTLAccelerationStructureDescriptor(MVKDevice* device,
+																			 const VkAccelerationStructureBuildGeometryInfoKHR* pInfo,
+																			 const VkAccelerationStructureBuildRangeInfoKHR* pRangeInfos,
+																			 const uint32_t* pMaxPrimitiveCounts,
+																			 NSArray<id<MTLAccelerationStructure>>** instancedStructures) {
+	if (instancedStructures) { *instancedStructures = nil; }
+	if ( !mvkSupportsAccelerationStructures(device->getPhysicalDevice()->getMTLDevice()) ) { return nil; }
+
+	bool isBuild = pRangeInfos != nullptr;
+	auto geometryAt = [&](uint32_t i) -> const VkAccelerationStructureGeometryKHR& {
+		return pInfo->pGeometries ? pInfo->pGeometries[i] : *pInfo->ppGeometries[i];
+	};
+	auto primitiveCountAt = [&](uint32_t i) -> uint32_t {
+		return isBuild ? pRangeInfos[i].primitiveCount : (pMaxPrimitiveCounts ? pMaxPrimitiveCounts[i] : 0);
+	};
+
+	if (@available(macOS 15.0, iOS 18.0, *)) {
+		// A top-level structure has exactly one geometry: its instances.
+		if (pInfo->geometryCount > 0 && geometryAt(0).geometryType == VK_GEOMETRY_TYPE_INSTANCES_KHR) {
+			const auto& instances = geometryAt(0).geometry.instances;
+			uint32_t instanceCount = primitiveCountAt(0);
+
+			auto* mtlDesc = [MTLInstanceAccelerationStructureDescriptor descriptor];	// autoreleased
+			mtlDesc.usage = mvkMTLAccelerationStructureUsage(pInfo->flags);
+			mtlDesc.instanceDescriptorType = MTLAccelerationStructureInstanceDescriptorTypeUserID;
+			mtlDesc.instanceDescriptorStride = sizeof(MTLAccelerationStructureUserIDInstanceDescriptor);
+			mtlDesc.instanceCount = instanceCount;
+			if ( !isBuild || instanceCount == 0 ) { return mtlDesc; }
+
+			// The Vulkan and Metal instance layouts differ, so the instances are converted into
+			// a buffer of our own. That means reading the application's instance data here, on
+			// the CPU, which needs it to be in host-visible memory.
+			id<MTLBuffer> srcBuff = nil;
+			NSUInteger srcOffset = 0;
+			if ( !device->getMTLBufferAtAddress(instances.data.deviceAddress, &srcBuff, &srcOffset) || !srcBuff.contents ) {
+				device->reportError(VK_ERROR_FEATURE_NOT_PRESENT, "vkCmdBuildAccelerationStructuresKHR(): The instance data of a top-level"
+									" acceleration structure must be in a host-visible buffer created with VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT.");
+				return nil;
+			}
+			const char* src = (const char*)srcBuff.contents + srcOffset + pRangeInfos[0].primitiveOffset;
+
+			id<MTLBuffer> mtlInstBuff = [[device->getPhysicalDevice()->getMTLDevice() newBufferWithLength: instanceCount * sizeof(MTLAccelerationStructureUserIDInstanceDescriptor)
+																			options: MTLResourceStorageModeShared] autorelease];
+			auto* mtlInsts = (MTLAccelerationStructureUserIDInstanceDescriptor*)mtlInstBuff.contents;
+			NSMutableArray<id<MTLAccelerationStructure>>* blasList = [NSMutableArray array];
+			MVKSmallVector<MVKAccelerationStructure*, 16> blasSeen;
+
+			for (uint32_t i = 0; i < instanceCount; i++) {
+				const VkAccelerationStructureInstanceKHR* vkInst;
+				if (instances.arrayOfPointers) {
+					VkDeviceAddress instAddr = ((const VkDeviceAddress*)src)[i];
+					id<MTLBuffer> instBuff = nil;
+					NSUInteger instOffset = 0;
+					if ( !device->getMTLBufferAtAddress(instAddr, &instBuff, &instOffset) || !instBuff.contents ) {
+						device->reportError(VK_ERROR_FEATURE_NOT_PRESENT, "vkCmdBuildAccelerationStructuresKHR(): An instance is not in a host-visible buffer.");
+						return nil;
+					}
+					vkInst = (const VkAccelerationStructureInstanceKHR*)((const char*)instBuff.contents + instOffset);
+				} else {
+					vkInst = (const VkAccelerationStructureInstanceKHR*)(src + i * sizeof(VkAccelerationStructureInstanceKHR));
+				}
+				mvkConvertInstance(*vkInst, mtlInsts[i]);
+
+				// A null reference is an inactive instance. Metal has no such thing, so it is
+				// given a mask of zero, which no ray can match.
+				MVKAccelerationStructure* blas = device->getAccelerationStructureAtAddress(vkInst->accelerationStructureReference);
+				id<MTLAccelerationStructure> mtlBLAS = blas ? blas->getMTLAccelerationStructure() : nil;
+				if ( !mtlBLAS ) {
+					mtlInsts[i].mask = 0;
+					continue;
+				}
+				uint32_t blasIdx = 0;
+				for (; blasIdx < blasSeen.size(); blasIdx++) { if (blasSeen[blasIdx] == blas) { break; } }
+				if (blasIdx == blasSeen.size()) {
+					blasSeen.push_back(blas);
+					[blasList addObject: mtlBLAS];
+				}
+				mtlInsts[i].accelerationStructureIndex = blasIdx;
+			}
+
+			// Metal wants a valid structure for every instance, masked out or not.
+			if (blasList.count == 0) {
+				mtlDesc.instanceCount = 0;
+				return mtlDesc;
+			}
+			mtlDesc.instancedAccelerationStructures = blasList;
+			mtlDesc.instanceDescriptorBuffer = mtlInstBuff;
+			mtlDesc.instanceDescriptorBufferOffset = 0;
+			if (instancedStructures) { *instancedStructures = blasList; }
+			return mtlDesc;
+		}
+
+		// Otherwise a bottom-level structure: any number of triangle or bounding-box geometries.
+		auto* mtlDesc = [MTLPrimitiveAccelerationStructureDescriptor descriptor];	// autoreleased
+		mtlDesc.usage = mvkMTLAccelerationStructureUsage(pInfo->flags);
+		NSMutableArray<MTLAccelerationStructureGeometryDescriptor*>* mtlGeoms = [NSMutableArray arrayWithCapacity: pInfo->geometryCount];
+
+		for (uint32_t i = 0; i < pInfo->geometryCount; i++) {
+			const auto& geom = geometryAt(i);
+			uint32_t primCount = primitiveCountAt(i);
+			bool isOpaque = mvkIsAnyFlagEnabled(geom.flags, VK_GEOMETRY_OPAQUE_BIT_KHR);
+
+			switch (geom.geometryType) {
+				case VK_GEOMETRY_TYPE_TRIANGLES_KHR: {
+					const auto& tris = geom.geometry.triangles;
+					auto* mtlGeom = [MTLAccelerationStructureTriangleGeometryDescriptor descriptor];
+					mtlGeom.opaque = isOpaque;
+					mtlGeom.triangleCount = primCount;
+					mtlGeom.vertexStride = (NSUInteger)tris.vertexStride;
+					mtlGeom.vertexFormat = mvkMTLVertexFormat(tris.vertexFormat);
+					if (mtlGeom.vertexFormat == MTLAttributeFormatInvalid) {
+						device->reportError(VK_ERROR_FORMAT_NOT_SUPPORTED, "Acceleration structure vertex format %d is not supported.", tris.vertexFormat);
+						return nil;
+					}
+					bool isIndexed = tris.indexType != VK_INDEX_TYPE_NONE_KHR;
+					if (isIndexed) {
+						if (tris.indexType != VK_INDEX_TYPE_UINT16 && tris.indexType != VK_INDEX_TYPE_UINT32) {
+							device->reportError(VK_ERROR_FORMAT_NOT_SUPPORTED, "Acceleration structure index type %d is not supported.", tris.indexType);
+							return nil;
+						}
+						mtlGeom.indexType = tris.indexType == VK_INDEX_TYPE_UINT16 ? MTLIndexTypeUInt16 : MTLIndexTypeUInt32;
+					}
+
+					if (isBuild) {
+						const auto& range = pRangeInfos[i];
+						id<MTLBuffer> buff = nil;
+						NSUInteger offset = 0;
+						if ( !device->getMTLBufferAtAddress(tris.vertexData.deviceAddress, &buff, &offset) ) {
+							device->reportError(VK_ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS, "vkCmdBuildAccelerationStructuresKHR(): The vertex data address is not in a buffer created with VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT.");
+							return nil;
+						}
+						// Vulkan: indices are read from indexData + primitiveOffset and each has
+						// firstVertex added to it. Without indices, vertices are read from
+						// vertexData + primitiveOffset + firstVertex * stride.
+						mtlGeom.vertexBuffer = buff;
+						mtlGeom.vertexBufferOffset = offset + (NSUInteger)range.firstVertex * (NSUInteger)tris.vertexStride + (isIndexed ? 0 : range.primitiveOffset);
+						if (isIndexed) {
+							if ( !device->getMTLBufferAtAddress(tris.indexData.deviceAddress, &buff, &offset) ) {
+								device->reportError(VK_ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS, "vkCmdBuildAccelerationStructuresKHR(): The index data address is not in a buffer created with VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT.");
+								return nil;
+							}
+							mtlGeom.indexBuffer = buff;
+							mtlGeom.indexBufferOffset = offset + range.primitiveOffset;
+						}
+						if (tris.transformData.deviceAddress) {
+							if ( !device->getMTLBufferAtAddress(tris.transformData.deviceAddress, &buff, &offset) ) {
+								device->reportError(VK_ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS, "vkCmdBuildAccelerationStructuresKHR(): The transform data address is not in a buffer created with VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT.");
+								return nil;
+							}
+							// VkTransformMatrixKHR is three rows of four floats.
+							mtlGeom.transformationMatrixBuffer = buff;
+							mtlGeom.transformationMatrixBufferOffset = offset + range.transformOffset;
+							mtlGeom.transformationMatrixLayout = MTLMatrixLayoutRowMajor;
+						}
+					}
+					[mtlGeoms addObject: mtlGeom];
+					break;
+				}
+				case VK_GEOMETRY_TYPE_AABBS_KHR: {
+					const auto& aabbs = geom.geometry.aabbs;
+					auto* mtlGeom = [MTLAccelerationStructureBoundingBoxGeometryDescriptor descriptor];
+					mtlGeom.opaque = isOpaque;
+					mtlGeom.boundingBoxCount = primCount;
+					mtlGeom.boundingBoxStride = (NSUInteger)aabbs.stride;
+					if (isBuild) {
+						id<MTLBuffer> buff = nil;
+						NSUInteger offset = 0;
+						if ( !device->getMTLBufferAtAddress(aabbs.data.deviceAddress, &buff, &offset) ) {
+							device->reportError(VK_ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS, "vkCmdBuildAccelerationStructuresKHR(): The bounding box data address is not in a buffer created with VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT.");
+							return nil;
+						}
+						mtlGeom.boundingBoxBuffer = buff;
+						mtlGeom.boundingBoxBufferOffset = offset + pRangeInfos[i].primitiveOffset;
+					}
+					[mtlGeoms addObject: mtlGeom];
+					break;
+				}
+				default:
+					device->reportError(VK_ERROR_FEATURE_NOT_PRESENT, "Acceleration structure geometry type %d cannot be mixed into a bottom-level structure.", geom.geometryType);
+					return nil;
+			}
+		}
+		mtlDesc.geometryDescriptors = mtlGeoms;
+		return mtlDesc;
+	}
+	return nil;
+}
