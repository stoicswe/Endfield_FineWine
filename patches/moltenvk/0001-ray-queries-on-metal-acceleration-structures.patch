+
+#pragma mark -
+#pragma mark MVKAccelerationStructure
+
+static atomic<uint64_t> _mvkNextAccelerationStructureHandle { 1 };
+
+void MVKAccelerationStructure::setInstancedMTLAccelerationStructures(NSArray<id<MTLAccelerationStructure>>* structures) {
+	if (structures == _instancedStructures) { return; }
+	[_instancedStructures release];
+	_instancedStructures = [structures retain];
+	if (_mtlAccelerationStructure) {
+		objc_setAssociatedObject(_mtlAccelerationStructure, &_mvkInstancedStructuresKey, structures, OBJC_ASSOCIATION_RETAIN);
+	}
+}
+
+void MVKAccelerationStructure::propagateDebugName() {
+	_mtlAccelerationStructure.label = _debugName;
+}
+
+MVKAccelerationStructure::MVKAccelerationStructure(MVKDevice* device, const VkAccelerationStructureCreateInfoKHR* pCreateInfo)
+	: MVKVulkanAPIDeviceObject(device), _type(pCreateInfo->type), _size(pCreateInfo->size) {
+
+	// The top 16 bits mark the value as one of ours, so it can never be mistaken for a buffer address.
+	_deviceAddress = 0x4657000000000000ull | (_mvkNextAccelerationStructureHandle.fetch_add(1) << 4);
+
+	if (mvkSupportsAccelerationStructures(getMTLDevice())) {
+		_mtlAccelerationStructure = [getMTLDevice() newAccelerationStructureWithSize: (NSUInteger)max<VkDeviceSize>(_size, 16)];
+	}
+	if ( !_mtlAccelerationStructure ) {
+		setConfigurationResult(reportError(VK_ERROR_OUT_OF_DEVICE_MEMORY, "vkCreateAccelerationStructureKHR(): Metal could not allocate an acceleration structure of %llu bytes.", _size));
+	}
+	_device->addAccelerationStructure(this);
+}
+
+MVKAccelerationStructure::~MVKAccelerationStructure() {
+	_device->removeAccelerationStructure(this);
+	[_instancedStructures release];
+	[_mtlAccelerationStructure release];
+}
+
+
+#pragma mark -
+#pragma mark MVKDevice acceleration structure support
+
+MVKAccelerationStructure* MVKDevice::createAccelerationStructure(const VkAccelerationStructureCreateInfoKHR* pCreateInfo,
+																 const VkAllocationCallbacks* pAllocator) {
+	return new MVKAccelerationStructure(this, pCreateInfo);
+}
+
+void MVKDevice::destroyAccelerationStructure(MVKAccelerationStructure* mvkAS, const VkAllocationCallbacks* pAllocator) {
+	if (mvkAS) { mvkAS->destroy(); }
+}
+
+void MVKDevice::addAccelerationStructure(MVKAccelerationStructure* mvkAS) {
+	lock_guard<mutex> lock(_rezLock);
+	_accelerationStructures.push_back(mvkAS);
+}
+
+void MVKDevice::removeAccelerationStructure(MVKAccelerationStructure* mvkAS) {
+	lock_guard<mutex> lock(_rezLock);
+	mvkRemoveFirstOccurance(_accelerationStructures, mvkAS);
+}
+
+MVKAccelerationStructure* MVKDevice::getAccelerationStructureAtAddress(VkDeviceAddress address) {
+	if ( !address ) { return nullptr; }
+	lock_guard<mutex> lock(_rezLock);
+	for (auto* mvkAS : _accelerationStructures) {
+		if (mvkAS->getDeviceAddress() == address) { return mvkAS; }
+	}
+	return nullptr;
+}
+
+// Build inputs are given as device addresses. Find the buffer an address falls in.
+bool MVKDevice::getMTLBufferAtAddress(VkDeviceAddress address, id<MTLBuffer>* pMTLBuffer, NSUInteger* pOffset) {
+	if ( !address ) { return false; }
+	lock_guard<mutex> lock(_rezLock);
+	for (auto* mvkBuff : _gpuAddressableBuffers) {
+		uint64_t base = mvkBuff->getMTLBufferGPUAddress();
+		if (base && address >= base && address < base + mvkBuff->getByteCount()) {
+			*pMTLBuffer = mvkBuff->getMTLBuffer();
+			*pOffset = mvkBuff->getMTLBufferOffset() + (NSUInteger)(address - base);
+			return true;
+		}
+	}
+	return false;
+}
+
+void MVKDevice::getAccelerationStructureBuildSizes(VkAccelerationStructureBuildTypeKHR buildType,
+												   const VkAccelerationStructureBuildGeometryInfoKHR* pBuildInfo,
+												   const uint32_t* pMaxPrimitiveCounts,
+												   VkAccelerationStructureBuildSizesInfoKHR* pSizeInfo) {
+	pSizeInfo->accelerationStructureSize = 0;
+	pSizeInfo->buildScratchSize = 0;
+	pSizeInfo->updateScratchSize = 0;
+	@autoreleasepool {
+		auto* mtlDesc = mvkNewMTLAccelerationStructureDescriptor(this, pBuildInfo, nullptr, pMaxPrimitiveCounts, nullptr);
+		if ( !mtlDesc ) { return; }
+		MTLAccelerationStructureSizes sizes = [_physicalDevice->getMTLDevice() accelerationStructureSizesWithDescriptor: mtlDesc];
+		// Never report zero: an application sizes its buffers from these, and Vulkan forbids
+		// a zero-sized buffer.
+		pSizeInfo->accelerationStructureSize = max<VkDeviceSize>(sizes.accelerationStructureSize, 16);
+		pSizeInfo->buildScratchSize = max<VkDeviceSize>(sizes.buildScratchBufferSize, 16);
+		pSizeInfo->updateScratchSize = max<VkDeviceSize>(sizes.refitScratchBufferSize, 16);
+	}
+}
