@@ -0,0 +1,140 @@
+/*
+ * MVKCmdAccelerationStructure.mm
+ *
+ * FineWine: commands of VK_KHR_acceleration_structure.
+ * This file is compiled as part of MVKCmdDispatch.mm, which includes it, so that the Xcode
+ * project does not have to change.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "MVKCmdAccelerationStructure.h"
+#include "../GPUObjects/MVKAccelerationStructure.h"
+#include "MVKCommandBuffer.h"
+#include "MVKCommandPool.h"
+#include "MVKDevice.h"
+
+
+#pragma mark -
+#pragma mark MVKCmdBuildAccelerationStructure
+
+VkResult MVKCmdBuildAccelerationStructure::setContent(MVKCommandBuffer* cmdBuff,
+													  const VkAccelerationStructureBuildGeometryInfoKHR* pInfo,
+													  const VkAccelerationStructureBuildRangeInfoKHR* pRangeInfos) {
+	// The application's arrays only live for the call, so keep copies and point at them.
+	_info = *pInfo;
+	_info.pNext = nullptr;
+	_geometries.clear();
+	_ranges.clear();
+	for (uint32_t i = 0; i < pInfo->geometryCount; i++) {
+		_geometries.push_back(pInfo->pGeometries ? pInfo->pGeometries[i] : *pInfo->ppGeometries[i]);
+		_geometries.back().pNext = nullptr;
+		_ranges.push_back(pRangeInfos[i]);
+	}
+	_info.ppGeometries = nullptr;
+	return VK_SUCCESS;
+}
+
+void MVKCmdBuildAccelerationStructure::encode(MVKCommandEncoder* cmdEncoder) {
+	MVKDevice* device = cmdEncoder->getDevice();
+	auto* dst = (MVKAccelerationStructure*)_info.dstAccelerationStructure;
+	if ( !dst || !dst->getMTLAccelerationStructure() ) { return; }
+
+	_info.pGeometries = _geometries.data();
+
+	@autoreleasepool {
+		NSArray<id<MTLAccelerationStructure>>* instanced = nil;
+		auto* mtlDesc = mvkNewMTLAccelerationStructureDescriptor(device, &_info, _ranges.data(), nullptr, &instanced);
+		if ( !mtlDesc ) { return; }
+
+		bool isUpdate = (_info.mode == VK_BUILD_ACCELERATION_STRUCTURE_MODE_UPDATE_KHR &&
+						 _info.srcAccelerationStructure != VK_NULL_HANDLE);
+
+		// The scratch space is the application's if its address can be resolved, else ours.
+		id<MTLDevice> mtlDev = device->getPhysicalDevice()->getMTLDevice();
+		MTLAccelerationStructureSizes sizes = [mtlDev accelerationStructureSizesWithDescriptor: mtlDesc];
+		NSUInteger scratchSize = isUpdate ? sizes.refitScratchBufferSize : sizes.buildScratchBufferSize;
+		id<MTLBuffer> mtlScratch = nil;
+		NSUInteger scratchOffset = 0;
+		if ( !device->getMTLBufferAtAddress(_info.scratchData.deviceAddress, &mtlScratch, &scratchOffset) ||
+			 mtlScratch.length < scratchOffset + scratchSize ) {
+			mtlScratch = scratchSize ? [[mtlDev newBufferWithLength: scratchSize options: MTLResourceStorageModePrivate] autorelease] : nil;
+			scratchOffset = 0;
+		}
+
+		// Acceleration structures have an encoder of their own.
+		cmdEncoder->endCurrentMetalEncoding();
+		id<MTLCommandBuffer> mtlCmdBuff = cmdEncoder->_mtlCmdBuffer;
+		id<MTLAccelerationStructureCommandEncoder> mtlEnc = [mtlCmdBuff accelerationStructureCommandEncoder];
+		mtlEnc.label = @"vkCmdBuildAccelerationStructuresKHR";
+
+		// MoltenVK's command buffers do not retain what they reference. The scratch space made
+		// above, and the converted instances of a top-level structure, belong to nobody else, so
+		// they are kept alive here until the GPU has finished with them.
+		NSMutableArray* keepAlive = [[NSMutableArray alloc] init];
+		if (mtlScratch) { [keepAlive addObject: mtlScratch]; }
+		if ([mtlDesc isKindOfClass: [MTLInstanceAccelerationStructureDescriptor class]]) {
+			id<MTLBuffer> mtlInstBuff = ((MTLInstanceAccelerationStructureDescriptor*)mtlDesc).instanceDescriptorBuffer;
+			if (mtlInstBuff) { [keepAlive addObject: mtlInstBuff]; }
+		}
+		[mtlCmdBuff addCompletedHandler: ^(id<MTLCommandBuffer>) { [keepAlive release]; }];
+		if (isUpdate) {
+			auto* src = (MVKAccelerationStructure*)_info.srcAccelerationStructure;
+			id<MTLAccelerationStructure> mtlSrc = src->getMTLAccelerationStructure();
+			id<MTLAccelerationStructure> mtlDst = dst->getMTLAccelerationStructure();
+			[mtlEnc refitAccelerationStructure: mtlSrc
+									descriptor: mtlDesc
+								   destination: (mtlDst == mtlSrc ? nil : mtlDst)
+								 scratchBuffer: mtlScratch
+						   scratchBufferOffset: scratchOffset];
+		} else {
+			[mtlEnc buildAccelerationStructure: dst->getMTLAccelerationStructure()
+									descriptor: mtlDesc
+								 scratchBuffer: mtlScratch
+						   scratchBufferOffset: scratchOffset];
+		}
+		[mtlEnc endEncoding];
+
+		if (_info.type == VK_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL_KHR && instanced) {
+			dst->setInstancedMTLAccelerationStructures(instanced);
+		}
+	}
+}
+
+
+#pragma mark -
+#pragma mark MVKCmdCopyAccelerationStructure
+
+VkResult MVKCmdCopyAccelerationStructure::setContent(MVKCommandBuffer* cmdBuff, const VkCopyAccelerationStructureInfoKHR* pInfo) {
+	_src = (MVKAccelerationStructure*)pInfo->src;
+	_dst = (MVKAccelerationStructure*)pInfo->dst;
+	_mode = pInfo->mode;
+	return VK_SUCCESS;
+}
+
+void MVKCmdCopyAccelerationStructure::encode(MVKCommandEncoder* cmdEncoder) {
+	if ( !_src || !_dst || !_src->getMTLAccelerationStructure() || !_dst->getMTLAccelerationStructure() ) { return; }
+
+	cmdEncoder->endCurrentMetalEncoding();
+	id<MTLAccelerationStructureCommandEncoder> mtlEnc = [cmdEncoder->_mtlCmdBuffer accelerationStructureCommandEncoder];
+	mtlEnc.label = @"vkCmdCopyAccelerationStructureKHR";
+	if (_mode == VK_COPY_ACCELERATION_STRUCTURE_MODE_COMPACT_KHR) {
+		[mtlEnc copyAndCompactAccelerationStructure: _src->getMTLAccelerationStructure()
+							toAccelerationStructure: _dst->getMTLAccelerationStructure()];
+	} else {
+		[mtlEnc copyAccelerationStructure: _src->getMTLAccelerationStructure()
+				  toAccelerationStructure: _dst->getMTLAccelerationStructure()];
+	}
+	[mtlEnc endEncoding];
+	_dst->setInstancedMTLAccelerationStructures(_src->getInstancedMTLAccelerationStructures());
+}
