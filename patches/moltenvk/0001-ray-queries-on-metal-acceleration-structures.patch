+/*
+ * MVKAccelerationStructure.mm
+ *
+ * FineWine: VK_KHR_acceleration_structure on Metal acceleration structures.
+ * This file is compiled as part of MVKBuffer.mm, which includes it, so that the Xcode project
+ * does not have to change.
