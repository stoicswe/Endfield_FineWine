+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#pragma once
+
+#include "MVKVulkanAPIObject.h"
+#include "MVKDevice.h"
+#include "MVKSmallVector.h"
+
+#import <Metal/Metal.h>
+
+class MVKBuffer;
+
+
+#pragma mark -
+#pragma mark MVKAccelerationStructure
+
+/**
+ * A Vulkan acceleration structure, backed by a Metal acceleration structure.
+ *
+ * Vulkan places an acceleration structure in a region of a buffer; Metal allocates its own
+ * storage. The buffer region is therefore only bookkeeping here, and the Metal object is created
+ * with the size the application was told to reserve by vkGetAccelerationStructureBuildSizesKHR.
+ *
+ * The device address handed to the application is a handle FineWine makes up. It is what an
+ * instance in a top-level structure uses to name the bottom-level structure it refers to.
+ */
+class MVKAccelerationStructure : public MVKVulkanAPIDeviceObject {
+
+public:
+	VkObjectType getVkObjectType() override { return VK_OBJECT_TYPE_ACCELERATION_STRUCTURE_KHR; }
+
+	VkDebugReportObjectTypeEXT getVkDebugReportObjectType() override { return VK_DEBUG_REPORT_OBJECT_TYPE_ACCELERATION_STRUCTURE_KHR_EXT; }
+
+	/** The Metal acceleration structure. Empty until it has been built. */
+	id<MTLAccelerationStructure> getMTLAccelerationStructure() { return _mtlAccelerationStructure; }
+
+	VkAccelerationStructureTypeKHR getType() { return _type; }
+
+	/** The handle returned by vkGetAccelerationStructureDeviceAddressKHR. */
+	VkDeviceAddress getDeviceAddress() { return _deviceAddress; }
+
+	/**
+	 * The bottom-level structures a top-level structure was last built from. Metal needs each of
+	 * them marked as used, as well as the top-level structure, wherever that is traced against.
+	 */
+	NSArray<id<MTLAccelerationStructure>>* getInstancedMTLAccelerationStructures() { return _instancedStructures; }
+
+	void setInstancedMTLAccelerationStructures(NSArray<id<MTLAccelerationStructure>>* structures);
+
+	MVKAccelerationStructure(MVKDevice* device, const VkAccelerationStructureCreateInfoKHR* pCreateInfo);
+
+	~MVKAccelerationStructure() override;
+
+protected:
+	void propagateDebugName() override;
+
+	id<MTLAccelerationStructure> _mtlAccelerationStructure = nil;
+	NSArray<id<MTLAccelerationStructure>>* _instancedStructures = nil;
+	VkAccelerationStructureTypeKHR _type;
+	VkDeviceAddress _deviceAddress = 0;
+	VkDeviceSize _size = 0;
+};
+
+
+#pragma mark -
+#pragma mark Support functions
+
+/**
+ * Returns the bottom-level structures a Metal top-level structure was built from, or nil.
+ *
+ * Tracing against a top-level structure needs those marked as used too. The code that marks
+ * descriptor resources as used only has the Metal object, so the list travels with it, as an
+ * associated object.
+ */
+NSArray<id<MTLAccelerationStructure>>* mvkGetInstancedMTLAccelerationStructures(id mtlAccelerationStructure);
+
+/** Whether this device and OS can provide acceleration structures. */
+bool mvkSupportsAccelerationStructures(id<MTLDevice> mtlDevice);
+
+/**
+ * Builds the Metal descriptor for a Vulkan build request.
+ *
+ * With pRangeInfos the descriptor refers to the application's vertex, index and instance data
+ * and can be built. Without it (pMaxPrimitiveCounts instead) it carries only counts and formats,
+ * which is what a size query needs. Returns nil, after reporting the reason against the device,
+ * if the request uses something this implementation does not handle.
+ *
+ * For a top-level structure built from instance data, instancedStructures receives the
+ * bottom-level structures the instances refer to.
+ */
+MTLAccelerationStructureDescriptor* mvkNewMTLAccelerationStructureDescriptor(MVKDevice* device,
+																			 const VkAccelerationStructureBuildGeometryInfoKHR* pInfo,
+																			 const VkAccelerationStructureBuildRangeInfoKHR* pRangeInfos,
+																			 const uint32_t* pMaxPrimitiveCounts,
+																			 NSArray<id<MTLAccelerationStructure>>** instancedStructures);
