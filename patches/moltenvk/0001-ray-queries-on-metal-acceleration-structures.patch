+#pragma once
+
+#include "MVKCommand.h"
+#include "MVKSmallVector.h"
+
+#import <Metal/Metal.h>
+
+class MVKAccelerationStructure;
+
+
+#pragma mark -
+#pragma mark MVKCmdBuildAccelerationStructure
+
+/** One build or update from vkCmdBuildAccelerationStructuresKHR. Each element of that call's array is recorded as its own command. */
+class MVKCmdBuildAccelerationStructure : public MVKCommand {
+
+public:
+	VkResult setContent(MVKCommandBuffer* cmdBuff,
+						const VkAccelerationStructureBuildGeometryInfoKHR* pInfo,
+						const VkAccelerationStructureBuildRangeInfoKHR* pRangeInfos);
+
+	void encode(MVKCommandEncoder* cmdEncoder) override;
+
+protected:
+	MVKCommandTypePool<MVKCommand>* getTypePool(MVKCommandPool* cmdPool) override;
+
+	VkAccelerationStructureBuildGeometryInfoKHR _info;
+	MVKSmallVector<VkAccelerationStructureGeometryKHR, 4> _geometries;
+	MVKSmallVector<VkAccelerationStructureBuildRangeInfoKHR, 4> _ranges;
+};
+
+
+#pragma mark -
+#pragma mark MVKCmdCopyAccelerationStructure
+
+/** vkCmdCopyAccelerationStructureKHR: a copy, or a copy that compacts. */
+class MVKCmdCopyAccelerationStructure : public MVKCommand {
+
+public:
+	VkResult setContent(MVKCommandBuffer* cmdBuff, const VkCopyAccelerationStructureInfoKHR* pInfo);
+
+	void encode(MVKCommandEncoder* cmdEncoder) override;
+
+protected:
+	MVKCommandTypePool<MVKCommand>* getTypePool(MVKCommandPool* cmdPool) override;
+
+	MVKAccelerationStructure* _src;
+	MVKAccelerationStructure* _dst;
+	VkCopyAccelerationStructureModeKHR _mode;
+};
