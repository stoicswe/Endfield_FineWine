+
+#pragma mark FineWine: upscaling a swapchain smaller than its window
+
+// A program that draws smaller than its window (a lower resolution chosen in a game, a prefix
+// with a smaller render size, or Wine's Retina mode off) had its picture stretched to the
+// window by the window server, which blurs it. Such a swapchain is drawn into textures of its
+// own instead of the layer's drawables. At present the picture is brought to the layer's size
+// in display pixels by MetalFX's spatial scaler; with upscaling switched off it is copied to
+// a drawable of its own size and stretched by the window server as before.
+//
+// The switch can be thrown while the program runs. FINEWINE_METALFX_AUTO=0 starts with it
+// off; the state of the notification "finewine.metalfx.<process id>" overrides that (1 on,
+// 2 off, 0 not said), which is what the Mac driver's View menu and the FineWine app set. It
+// is looked at every 30 presents, as is the size of the layer. FINEWINE_METALFX_SWAPCHAIN=0
+// leaves every swapchain as MoltenVK has it.
+
+static bool mvkFineWineUpscalingWanted() {
+	static int token = NOTIFY_TOKEN_INVALID;
+	static bool byDefault = true;
+	static dispatch_once_t once;
+	dispatch_once(&once, ^{
+		const char* e = getenv("FINEWINE_METALFX_AUTO");
+		byDefault = !(e && e[0] == '0');
+		char name[64];
+		snprintf(name, sizeof(name), "finewine.metalfx.%d", getpid());
+		if (notify_register_check(name, &token) != NOTIFY_STATUS_OK) { token = NOTIFY_TOKEN_INVALID; }
+	});
+	uint64_t state = 0;
+	if (token != NOTIFY_TOKEN_INVALID && notify_get_state(token, &state) == NOTIFY_STATUS_OK && state) { return state == 1; }
+	return byDefault;
+}
+
+static Class mvkFineWineSpatialScalerDescriptorClass() {
+	static dispatch_once_t once;
+	dispatch_once(&once, ^{ dlopen("/System/Library/Frameworks/MetalFX.framework/MetalFX", RTLD_LAZY | RTLD_GLOBAL); });
+	return NSClassFromString(@"MTLFXSpatialScalerDescriptor");
+}
+
+// The size of the layer in display pixels. The Mac driver gives its layers a scale of 1 while
+// Wine's Retina mode is off, on a display that has two pixels to the point; the display's own
+// scale is taken then.
+static CGSize mvkFineWineLayerPixelSize(CAMetalLayer* mtlLayer) {
+	CGSize size = mtlLayer.bounds.size;
+	CGFloat scale = mtlLayer.contentsScale;
+#if MVK_MACOS
+	if (scale < 2) {
+		for (NSScreen* screen in [NSScreen screens]) { scale = MAX(scale, screen.backingScaleFactor); }
+	}
+#endif
+	return CGSizeMake(round(size.width * scale), round(size.height * scale));
+}
+
+// Whether a picture of the swapchain's size is small enough against the layer to be worth
+// upscaling, and not so small that MetalFX would refuse: between 5% and 4x, in both directions.
+static bool mvkFineWineIsSmaller(VkExtent2D extent, CGSize target) {
+	if (!extent.width || !extent.height) { return false; }
+	double fx = target.width / extent.width, fy = target.height / extent.height;
+	return fx >= 1.05 && fy >= 1.05 && fx <= 4.0 && fy <= 4.0;
+}
+
+void MVKSwapchain::initUpscaling(const VkSwapchainCreateInfoKHR* pCreateInfo) {
+#if MVK_MACOS
+	auto* mtlLayer = getCAMetalLayer();
+	const char* off = getenv("FINEWINE_METALFX_SWAPCHAIN");
+	if ( !mtlLayer || isHeadless() || getIsSurfaceLost() || (off && off[0] == '0') ) { return; }
+	if (pCreateInfo->imageArrayLayers > 1) { return; }
+	if (@available(macOS 13.0, *)) {
+		Class cls = mvkFineWineSpatialScalerDescriptorClass();
+		if ( !cls || ![cls supportsDevice: getMTLDevice()] ) { return; }
+		_fwUpscaled = mvkFineWineIsSmaller(_imageExtent, mvkFineWineLayerPixelSize(mtlLayer));
+		_fwWanted = _fwUpscaled && mvkFineWineUpscalingWanted();
+	}
+#endif
+}
+
+// Gives the layer the size its next drawable should have: the layer's own size in display
+// pixels while upscaling is wanted and possible, the picture's size otherwise.
+void MVKSwapchain::prepareUpscaledPresent() {
+	auto* mtlLayer = getCAMetalLayer();
+	if ( !mtlLayer ) { return; }
+	if (_fwPresentCount++ % 30 == 0) {
+		bool wanted = mvkFineWineUpscalingWanted();
+		if (wanted != _fwWanted) { MVKLogInfo("FineWine: MetalFX upscaling of the swapchain switched %s.", wanted ? "on" : "off"); }
+		_fwWanted = wanted;
+	}
+
+	CGSize want = mvkCGSizeFromVkExtent2D(_imageExtent);
+	if (_fwWanted && !_fwScalerFailed) {
+		CGSize target = mvkFineWineLayerPixelSize(mtlLayer);
+		if (mvkFineWineIsSmaller(_imageExtent, target)) { want = target; }
+	}
+	if ( !CGSizeEqualToSize(mtlLayer.drawableSize, want) ) { mtlLayer.drawableSize = want; }
+}
+
+void MVKSwapchain::encodeUpscaledPresent(id<MTLCommandBuffer> mtlCmdBuff, id<MTLTexture> source, id<MTLTexture> drawable) {
+	if ( !mtlCmdBuff || !source || !drawable ) { return; }
+
+	if (drawable.width != source.width || drawable.height != source.height) {
+		if (@available(macOS 13.0, *)) {
+			if ( !_fwScaler || _fwScalerOutWidth != drawable.width || _fwScalerOutHeight != drawable.height ) {
+				[_fwScaler release];
+				MTLFXSpatialScalerDescriptor* desc = [[mvkFineWineSpatialScalerDescriptorClass() new] autorelease];
+				desc.inputWidth = source.width;
+				desc.inputHeight = source.height;
+				desc.outputWidth = drawable.width;
+				desc.outputHeight = drawable.height;
+				desc.colorTextureFormat = source.pixelFormat;
+				desc.outputTextureFormat = drawable.pixelFormat;
+				switch (source.pixelFormat) {
+					case MTLPixelFormatRGBA16Float:
+					case MTLPixelFormatRGBA32Float:
+					case MTLPixelFormatRG11B10Float:
+						desc.colorProcessingMode = MTLFXSpatialScalerColorProcessingModeLinear;
+						break;
+					default:
+						desc.colorProcessingMode = MTLFXSpatialScalerColorProcessingModePerceptual;
+						break;
+				}
+				_fwScaler = [desc newSpatialScalerWithDevice: getMTLDevice()];		// retained
+				_fwScalerOutWidth = drawable.width;
+				_fwScalerOutHeight = drawable.height;
+				if ( !_fwScaler ) {
+					// MetalFX does not take this format or these sizes. From the next present on
+					// the picture goes to a drawable of its own size.
+					_fwScalerFailed = true;
+					MVKLogInfo("FineWine: MetalFX cannot upscale a %lu x %lu picture of format %lu to %lu x %lu; the window server stretches it.",
+							   (unsigned long)source.width, (unsigned long)source.height, (unsigned long)source.pixelFormat,
+							   (unsigned long)drawable.width, (unsigned long)drawable.height);
+				} else {
+					MVKLogInfo("FineWine: MetalFX upscales the swapchain's %lu x %lu picture to %lu x %lu.",
+							   (unsigned long)source.width, (unsigned long)source.height,
+							   (unsigned long)drawable.width, (unsigned long)drawable.height);
+				}
+			}
+			if (_fwScaler) {
+				id<MTLFXSpatialScaler> scaler = _fwScaler;
+				scaler.colorTexture = source;
+				scaler.outputTexture = drawable;
+				[scaler encodeToCommandBuffer: mtlCmdBuff];
+			}
+		}
+		return;
+	}
+
+	id<MTLBlitCommandEncoder> blit = [mtlCmdBuff blitCommandEncoder];
+	[blit copyFromTexture: source toTexture: drawable];
+	[blit endEncoding];
 }
 
