 VkResult MVKSwapchain::waitForPresent(const VkPresentWait2InfoKHR* pWaitInfo) {
+
+	// Wait in bounded slices instead of a single potentially-overflowing wait: a timeout
+	// near UINT64_MAX overflows the absolute deadline and degenerates into a busy spin, and
+	// a stalled present-completion callback (a known Metal regression - see
+	// forceUnpresentedImageCompletion()) must not hang an app that waits for a present
+	// indefinitely.
+	constexpr uint64_t kWaitSliceNs = 100ull * 1000 * 1000;				// 100 ms
+	constexpr uint64_t kStalledPresentGraceNs = 1000ull * 1000 * 1000;	// 1 s
+
 	std::unique_lock lock(_currentPresentIdMutex);
-	const auto success = _currentPresentIdCondVar.wait_for(lock, std::chrono::nanoseconds(pWaitInfo->timeout), [this, pWaitInfo] {
+	auto isPresented = [this, pWaitInfo]() {
 		return _currentPresentId >= pWaitInfo->presentId || getConfigurationResult() == VK_ERROR_OUT_OF_DATE_KHR;
-	});
-	if (getConfigurationResult() == VK_ERROR_OUT_OF_DATE_KHR) return VK_ERROR_OUT_OF_DATE_KHR;
-	return success ? VK_SUCCESS : VK_TIMEOUT;
+	};
+
+	if (isPresented()) { return VK_SUCCESS; }
+	if (pWaitInfo->timeout == 0) { return VK_TIMEOUT; }
+
+	uint64_t waitedNs = 0;
+	bool completed = false;
+	bool timedOut = false;
+	while (true) {
+		if (isPresented()) { completed = true; break; }
+		if (waitedNs >= pWaitInfo->timeout) { timedOut = true; break; }
+
+		// A present that was queued but has not signalled its completion after a generous
+		// grace period is stalled. Treat it as presented so the app makes progress instead
+		// of waiting forever on a Metal callback that will never fire.
+		if (waitedNs >= kStalledPresentGraceNs && _unpresentedImageCount > 0) {
+			_currentPresentId = std::max(_currentPresentId, pWaitInfo->presentId);
+			_currentPresentIdCondVar.notify_all();
+			completed = true;
+			break;
+		}
+
+		uint64_t sliceNs = std::min(kWaitSliceNs, pWaitInfo->timeout - waitedNs);
+		uint64_t startTime = mvkGetRuntimeNanoseconds();
+		_currentPresentIdCondVar.wait_for(lock, std::chrono::nanoseconds(sliceNs), isPresented);
+		uint64_t elapsedNs = mvkGetRuntimeNanoseconds() - startTime;
+		waitedNs += elapsedNs < sliceNs ? sliceNs : elapsedNs;	// Guard against a coarse clock
+	}
+
+	if (getConfigurationResult() == VK_ERROR_OUT_OF_DATE_KHR) { return VK_ERROR_OUT_OF_DATE_KHR; }
+	return completed ? VK_SUCCESS : VK_TIMEOUT;
 }
 
 void MVKSwapchain::beginPresentation(const MVKImagePresentInfo& presentInfo) {
 	_unpresentedImageCount++;
+
+	// Present IDs increase monotonically, so queuing a newer present means every older one
+	// has been displayed or superseded. Advance the completed-present ID now, so an app
+	// waiting on VK_KHR_present_wait makes progress even when Metal fails to fire the
+	// completion callback of an older presentation (a known regression - Metal occasionally
+	// drops the callback for the last one or two presentations around a swapchain change;
+	// forceUnpresentedImageCompletion() works around the same regression for drawable reuse).
+	if (presentInfo.presentId != 0) {
+		std::lock_guard<std::mutex> lock(_currentPresentIdMutex);
+		uint64_t completedPresentId = presentInfo.presentId - 1;
+		if (completedPresentId > _currentPresentId) {
+			_currentPresentId = completedPresentId;
+			_currentPresentIdCondVar.notify_all();
+		}
+	}
 }
 
