+// Advances the completed-present ID and wakes any vkWaitForPresentKHR() waiter.
+// Present IDs are monotonic, so this only ever moves forward.
+void MVKSwapchain::markPresentIdCompleted(uint64_t presentId) {
+	if (presentId == 0) { return; }
+	std::lock_guard<std::mutex> lock(_currentPresentIdMutex);
+	if (presentId > _currentPresentId) {
+		_currentPresentId = presentId;
