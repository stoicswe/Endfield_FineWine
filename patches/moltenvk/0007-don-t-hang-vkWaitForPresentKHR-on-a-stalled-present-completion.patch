 void MVKSwapchain::beginPresentation(const MVKImagePresentInfo& presentInfo) {
 	_unpresentedImageCount++;
+
+	// Present IDs increase monotonically, so queuing a newer present means every older one
+	// has been displayed or superseded. Advance the completed-present ID now, so an app
+	// waiting on VK_KHR_present_wait makes progress even when Metal fails to fire the
+	// completion callback of an older presentation (a known regression - Metal occasionally
+	// drops the callback for the last one or two presentations around a swapchain change;
+	// forceUnpresentedImageCompletion() works around the same regression for drawable reuse).
+	if (presentInfo.presentId != 0) {
+		markPresentIdCompleted(presentInfo.presentId - 1);
+	}
 }
 
