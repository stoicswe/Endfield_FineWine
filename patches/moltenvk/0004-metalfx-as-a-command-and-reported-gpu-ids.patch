@@ -0,0 +1,253 @@
+/*
+ * MVKCmdMetalFX.mm
+ *
+ * FineWine: MetalFX upscaling and frame interpolation as a command in a Vulkan command buffer.
+ * This file is compiled as part of MVKCmdDispatch.mm, which includes it, so that the Xcode
+ * project does not have to change. For the same reason MetalFX is loaded at run time instead of
+ * being linked.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "MVKCmdMetalFX.h"
+#include "MVKCommandBuffer.h"
+#include "MVKCommandPool.h"
+#include "MVKDevice.h"
+#include "MVKImage.h"
+#import <MetalFX/MetalFX.h>
+#include <dlfcn.h>
+#include <map>
+#include <mutex>
+
+static Class mvkMetalFXClass(NSString* name) {
+	static dispatch_once_t once;
+	dispatch_once(&once, ^{ dlopen("/System/Library/Frameworks/MetalFX.framework/MetalFX", RTLD_LAZY | RTLD_GLOBAL); });
+	return NSClassFromString(name);
+}
+
+bool mvkMetalFXSupports(id<MTLDevice> mtlDevice, uint32_t operation) {
+	if (operation == kMVKMetalFXTemporalUpscale) {
+		if (@available(macOS 13.0, iOS 16.0, *)) {
+			Class cls = mvkMetalFXClass(@"MTLFXTemporalScalerDescriptor");
+			return cls && [cls supportsDevice: mtlDevice];
+		}
+	} else if (operation == kMVKMetalFXFrameInterpolate) {
+		if (@available(macOS 26.0, iOS 26.0, *)) {
+			Class cls = mvkMetalFXClass(@"MTLFXFrameInterpolatorDescriptor");
+			return cls && [cls supportsDevice: mtlDevice];
+		}
+	}
+	return false;
+}
+
+/** What is kept between frames for one feature of one device. */
+struct MVKMetalFXState {
+	id effect = nil;						// the temporal scaler or the frame interpolator
+	id<MTLTexture> history = nil;			// frame interpolation: last frame's colour
+	id<MTLTexture> ownOutput = nil;			// used when the application's output image cannot be written by MetalFX
+	NSUInteger inW = 0, inH = 0, outW = 0, outH = 0;
+	MTLPixelFormat colorFmt = MTLPixelFormatInvalid, depthFmt = MTLPixelFormatInvalid, motionFmt = MTLPixelFormatInvalid, outFmt = MTLPixelFormatInvalid;
+	uint32_t createFlags = 0;
+	uint32_t frames = 0;
+
+	void clear() {
+		[effect release]; effect = nil;
+		[history release]; history = nil;
+		[ownOutput release]; ownOutput = nil;
+		frames = 0;
+	}
+};
+
+static std::mutex _mvkMetalFXLock;
+static std::map<std::pair<MVKDevice*, uint64_t>, MVKMetalFXState> _mvkMetalFXStates;
+
+static id<MTLTexture> mvkMetalFXTexture(uint64_t vkImage) {
+	return vkImage ? ((MVKImage*)vkImage)->getMTLTexture() : nil;
+}
+
+static id<MTLTexture> mvkNewMetalFXTexture(id<MTLDevice> mtlDev, MTLPixelFormat fmt, NSUInteger w, NSUInteger h, MTLTextureUsage usage) {
+	MTLTextureDescriptor* desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat: fmt width: w height: h mipmapped: NO];
+	desc.usage = usage | MTLTextureUsageShaderRead;
+	desc.storageMode = MTLStorageModePrivate;
+	return [mtlDev newTextureWithDescriptor: desc];
+}
+
+static void mvkMetalFXCopy(id<MTLCommandBuffer> mtlCmdBuff, id<MTLTexture> src, id<MTLTexture> dst) {
+	id<MTLBlitCommandEncoder> blit = [mtlCmdBuff blitCommandEncoder];
+	[blit copyFromTexture: src sourceSlice: 0 sourceLevel: 0 sourceOrigin: MTLOriginMake(0, 0, 0)
+			   sourceSize: MTLSizeMake(MIN(src.width, dst.width), MIN(src.height, dst.height), 1)
+				toTexture: dst destinationSlice: 0 destinationLevel: 0 destinationOrigin: MTLOriginMake(0, 0, 0)];
+	[blit endEncoding];
+}
+
+
+#pragma mark -
+#pragma mark MVKCmdMetalFX
+
+VkResult MVKCmdMetalFX::setContent(MVKCommandBuffer* cmdBuff, const void* pRequest, uint32_t size) {
+	mvkClear(&_request);
+	memcpy(&_request, pRequest, MIN((size_t)size, sizeof(_request)));
+	return VK_SUCCESS;
+}
+
+void MVKCmdMetalFX::encode(MVKCommandEncoder* cmdEncoder) {
+	MVKDevice* device = cmdEncoder->getDevice();
+	id<MTLDevice> mtlDev = device->getPhysicalDevice()->getMTLDevice();
+	const MVKMetalFXRequest& rq = _request;
+
+	std::lock_guard<std::mutex> lock(_mvkMetalFXLock);
+	auto key = std::make_pair(device, rq.feature);
+	if (rq.operation == kMVKMetalFXRelease) {
+		auto it = _mvkMetalFXStates.find(key);
+		if (it != _mvkMetalFXStates.end()) { it->second.clear(); _mvkMetalFXStates.erase(it); }
+		return;
+	}
+
+	id<MTLTexture> color = mvkMetalFXTexture(rq.color);
+	id<MTLTexture> depth = mvkMetalFXTexture(rq.depth);
+	id<MTLTexture> motion = mvkMetalFXTexture(rq.motion);
+	id<MTLTexture> output = mvkMetalFXTexture(rq.output);
+	if ( !color || !output ) { return; }
+
+	cmdEncoder->endCurrentMetalEncoding();
+	id<MTLCommandBuffer> mtlCmdBuff = cmdEncoder->_mtlCmdBuffer;
+
+	// Without MetalFX, or without the inputs it needs, the application still gets an image.
+	if ( !depth || !motion || !mvkMetalFXSupports(mtlDev, rq.operation) ) {
+		if (color.pixelFormat == output.pixelFormat) { mvkMetalFXCopy(mtlCmdBuff, color, output); }
+		return;
+	}
+
+	MVKMetalFXState& st = _mvkMetalFXStates[key];
+	bool isUpscale = rq.operation == kMVKMetalFXTemporalUpscale;
+	NSUInteger inW = isUpscale ? (rq.inputWidth ? rq.inputWidth : color.width) : (rq.inputWidth ? rq.inputWidth : depth.width);
+	NSUInteger inH = isUpscale ? (rq.inputHeight ? rq.inputHeight : color.height) : (rq.inputHeight ? rq.inputHeight : depth.height);
+	uint32_t createFlags = rq.flags & (kMVKMetalFXAutoExposure | kMVKMetalFXMotionAtOutputSize);
+	bool reset = mvkIsAnyFlagEnabled(rq.flags, (uint32_t)kMVKMetalFXResetHistory);
+
+	// A new effect whenever what it was made for changes: sizes, formats, or the flags fixed at creation.
+	if ( !st.effect || st.inW != inW || st.inH != inH || st.outW != output.width || st.outH != output.height ||
+		 st.colorFmt != color.pixelFormat || st.depthFmt != depth.pixelFormat || st.motionFmt != motion.pixelFormat ||
+		 st.outFmt != output.pixelFormat || st.createFlags != createFlags ) {
+		st.clear();
+		st.inW = inW; st.inH = inH; st.outW = output.width; st.outH = output.height;
+		st.colorFmt = color.pixelFormat; st.depthFmt = depth.pixelFormat; st.motionFmt = motion.pixelFormat; st.outFmt = output.pixelFormat;
+		st.createFlags = createFlags;
+		reset = true;
+
+		if (isUpscale) {
+			if (@available(macOS 13.0, iOS 16.0, *)) {
+				MTLFXTemporalScalerDescriptor* desc = [[mvkMetalFXClass(@"MTLFXTemporalScalerDescriptor") new] autorelease];
+				desc.colorTextureFormat = st.colorFmt;
+				desc.depthTextureFormat = st.depthFmt;
+				desc.motionTextureFormat = st.motionFmt;
+				desc.outputTextureFormat = st.outFmt;
+				desc.inputWidth = inW;
+				desc.inputHeight = inH;
+				desc.outputWidth = st.outW;
+				desc.outputHeight = st.outH;
+				desc.autoExposureEnabled = mvkIsAnyFlagEnabled(createFlags, (uint32_t)kMVKMetalFXAutoExposure);
+				if ([desc respondsToSelector: @selector(setOutputResolutionMotionVectorsEnabled:)]) {
+					[(id)desc setOutputResolutionMotionVectorsEnabled: mvkIsAnyFlagEnabled(createFlags, (uint32_t)kMVKMetalFXMotionAtOutputSize)];
+				}
+				st.effect = [desc newTemporalScalerWithDevice: mtlDev];
+			}
+		} else {
+			if (@available(macOS 26.0, iOS 26.0, *)) {
+				MTLFXFrameInterpolatorDescriptor* desc = [[mvkMetalFXClass(@"MTLFXFrameInterpolatorDescriptor") new] autorelease];
+				desc.colorTextureFormat = st.colorFmt;
+				desc.outputTextureFormat = st.outFmt;
+				desc.depthTextureFormat = st.depthFmt;
+				desc.motionTextureFormat = st.motionFmt;
+				desc.uiTextureFormat = st.colorFmt;
+				desc.inputWidth = inW;
+				desc.inputHeight = inH;
+				desc.outputWidth = st.outW;
+				desc.outputHeight = st.outH;
+				st.effect = [desc newFrameInterpolatorWithDevice: mtlDev];
+			}
+		}
+		if ( !st.effect ) {
+			device->reportError(VK_ERROR_FEATURE_NOT_PRESENT, "MetalFX could not make %s for %lux%lu to %lux%lu.",
+								isUpscale ? "a temporal scaler" : "a frame interpolator",
+								(unsigned long)inW, (unsigned long)inH, (unsigned long)st.outW, (unsigned long)st.outH);
+		}
+	}
+	if ( !st.effect ) {
+		if (color.pixelFormat == output.pixelFormat) { mvkMetalFXCopy(mtlCmdBuff, color, output); }
+		return;
+	}
+
+	float motionScaleX = rq.motionScaleX != 0 ? rq.motionScaleX : 1.0f;
+	float motionScaleY = rq.motionScaleY != 0 ? rq.motionScaleY : 1.0f;
+	bool depthReversed = mvkIsAnyFlagEnabled(rq.flags, (uint32_t)kMVKMetalFXDepthReversed);
+
+	// MetalFX writes its output with the usage it asks for. If the application's image was not
+	// made with that, the result goes to a texture of our own and is copied across.
+	MTLTextureUsage wanted = isUpscale ? [(id<MTLFXTemporalScaler>)st.effect outputTextureUsage] : [(id<MTLFXFrameInterpolator>)st.effect outputTextureUsage];
+	id<MTLTexture> target = output;
+	if ((output.usage & wanted) != wanted) {
+		if ( !st.ownOutput ) { st.ownOutput = mvkNewMetalFXTexture(mtlDev, st.outFmt, st.outW, st.outH, wanted); }
+		target = st.ownOutput;
+	}
+
+	if (isUpscale) {
+		if (@available(macOS 13.0, iOS 16.0, *)) {
+			id<MTLFXTemporalScaler> scaler = st.effect;
+			scaler.colorTexture = color;
+			scaler.depthTexture = depth;
+			scaler.motionTexture = motion;
+			scaler.exposureTexture = mvkMetalFXTexture(rq.exposure);
+			scaler.outputTexture = target;
+			scaler.jitterOffsetX = rq.jitterX;
+			scaler.jitterOffsetY = rq.jitterY;
+			scaler.motionVectorScaleX = motionScaleX;
+			scaler.motionVectorScaleY = motionScaleY;
+			scaler.preExposure = rq.preExposure != 0 ? rq.preExposure : 1.0f;
+			scaler.depthReversed = depthReversed;
+			scaler.reset = reset;
+			[scaler encodeToCommandBuffer: mtlCmdBuff];
+		}
+	} else {
+		if (@available(macOS 26.0, iOS 26.0, *)) {
+			id<MTLFXFrameInterpolator> fi = st.effect;
+			// The interpolator wants last frame's colour. The application only hands over this
+			// frame's, so a copy is kept from one call to the next.
+			if ( !st.history ) {
+				st.history = mvkNewMetalFXTexture(mtlDev, st.colorFmt, color.width, color.height, fi.colorTextureUsage);
+				reset = true;
+			}
+			if (reset) { mvkMetalFXCopy(mtlCmdBuff, color, st.history); }
+			fi.colorTexture = color;
+			fi.prevColorTexture = st.history;
+			fi.depthTexture = depth;
+			fi.motionTexture = motion;
+			fi.outputTexture = target;
+			fi.motionVectorScaleX = motionScaleX;
+			fi.motionVectorScaleY = motionScaleY;
+			fi.deltaTime = rq.deltaTime > 0 ? rq.deltaTime : 1.0f / 60.0f;
+			fi.nearPlane = rq.nearPlane > 0 ? rq.nearPlane : 0.1f;
+			fi.farPlane = rq.farPlane > 0 ? rq.farPlane : 1000.0f;
+			fi.fieldOfView = rq.fieldOfView > 0 ? rq.fieldOfView : 60.0f;
+			fi.aspectRatio = rq.aspectRatio > 0 ? rq.aspectRatio : (float)st.outW / (float)st.outH;
+			fi.jitterOffsetX = rq.jitterX;
+			fi.jitterOffsetY = rq.jitterY;
+			fi.depthReversed = depthReversed;
+			fi.shouldResetHistory = reset;
+			[fi encodeToCommandBuffer: mtlCmdBuff];
+			mvkMetalFXCopy(mtlCmdBuff, color, st.history);
+		}
+	}
+	if (target != output) { mvkMetalFXCopy(mtlCmdBuff, target, output); }
+	st.frames++;
+}
