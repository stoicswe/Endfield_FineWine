+// FineWine: a prefix can ask for the GPU to be reported as another one, because programs
+// only offer DLSS on an NVIDIA adapter. FINEWINE_GPU_VENDOR_ID and FINEWINE_GPU_DEVICE_ID, in
+// hexadecimal, and FINEWINE_GPU_NAME replace what applications are told. MoltenVK's own
+// decisions keep using the real ids.
+static void mvkApplyReportedGPUIDs(VkPhysicalDeviceProperties* properties) {
+	static uint32_t vendorID = 0, deviceID = 0;
+	static char name[VK_MAX_PHYSICAL_DEVICE_NAME_SIZE] = {};
+	static dispatch_once_t once;
+	dispatch_once(&once, ^{
+		const char* v = getenv("FINEWINE_GPU_VENDOR_ID");
+		const char* d = getenv("FINEWINE_GPU_DEVICE_ID");
+		const char* n = getenv("FINEWINE_GPU_NAME");
+		if (v) { vendorID = (uint32_t)strtoul(v, nullptr, 16); }
+		if (d) { deviceID = (uint32_t)strtoul(d, nullptr, 16); }
+		if (n) { strlcpy(name, n, sizeof(name)); }
+	});
+	if (vendorID) { properties->vendorID = vendorID; }
+	if (deviceID) { properties->deviceID = deviceID; }
+	if (name[0]) { strlcpy(properties->deviceName, name, sizeof(properties->deviceName)); }
+}
+
 void MVKPhysicalDevice::getProperties(VkPhysicalDeviceProperties* properties) {
 	updateTimestampPeriod();
 	*properties = _properties;
+	mvkApplyReportedGPUIDs(properties);
 }
 
 void MVKPhysicalDevice::getProperties(VkPhysicalDeviceProperties2* properties) {
diff --git a/MoltenVK/MoltenVK/Vulkan/vulkan.mm b/MoltenVK/MoltenVK/Vulkan/vulkan.mm
index 4aa4b4f..695d592 100644
--- a/MoltenVK/MoltenVK/Vulkan/vulkan.mm
+++ b/MoltenVK/MoltenVK/Vulkan/vulkan.mm
@@ -1951,7 +1951,12 @@ MVK_PUBLIC_VULKAN_SYMBOL void vkCmdPushConstants(
     const void*                                 pValues) {
 	
 	MVKTraceVulkanCallStart();
-	MVKAddCmdFrom2Thresholds(PushConstants, size, 64, 128, commandBuffer, layout, stageFlags, offset, size, pValues);
+	if (layout == VK_NULL_HANDLE && stageFlags == kMVKMetalFXMagic) {
+		// FineWine: not push constants but a MetalFX request. See MVKCmdMetalFX.h.
+		if (pValues && size >= 16) { MVKAddCmd(MetalFX, commandBuffer, pValues, size); }
+	} else {
+		MVKAddCmdFrom2Thresholds(PushConstants, size, 64, 128, commandBuffer, layout, stageFlags, offset, size, pValues);
+	}
 	MVKTraceVulkanCallEnd();
 }
 
