+/*
+ * MVKCmdMetalFX.h
+ *
+ * FineWine: MetalFX upscaling and frame interpolation as a command in a Vulkan command buffer.
+ *
+ * This is what DLSS is mapped to for Direct3D 12 and Vulkan programs (Direct3D 11 and earlier
+ * go through DXMT, which has its own). The program's NGX calls end up in nvngx.dll, on the
+ * Windows side of Wine, and the work has to be recorded in the program's own command buffer,
+ * here, on the Unix side. Wine's Vulkan layer only passes through functions Vulkan defines, so
+ * the request travels in one: vkCmdPushConstants() with a null layout and kMVKMetalFXMagic as
+ * its stage flags carries an MVKMetalFXRequest instead of push constants.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#pragma once
+
+#include "MVKCommand.h"
+
+/** The value of vkCmdPushConstants()'s stageFlags that marks a request ("FWMX"). */
+static const uint32_t kMVKMetalFXMagic = 0x584D5746;
+
+enum MVKMetalFXOperation : uint32_t {
+	kMVKMetalFXTemporalUpscale = 1,		/**< DLSS super resolution: MTLFXTemporalScaler. */
+	kMVKMetalFXFrameInterpolate = 2,	/**< DLSS frame generation: MTLFXFrameInterpolator. */
+	kMVKMetalFXRelease = 3,				/**< The feature is gone; drop what was kept for it. */
+};
+
+enum MVKMetalFXFlags : uint32_t {
+	kMVKMetalFXDepthReversed = 1 << 0,
+	kMVKMetalFXAutoExposure = 1 << 1,
+	kMVKMetalFXResetHistory = 1 << 2,
+	kMVKMetalFXMotionAtOutputSize = 1 << 3,		/**< Motion vectors are at the output's resolution, not the input's. */
+};
+
+/**
+ * One request. The same layout is declared by the callers (nvngx.dll and Wine's Direct3D 12),
+ * so it only ever grows at the end, and `size` says how much of it the caller knows.
+ * Images are VkImage handles; zero means none.
+ */
+typedef struct MVKMetalFXRequest {
+	uint32_t size;
+	uint32_t operation;			/**< MVKMetalFXOperation */
+	uint32_t flags;				/**< MVKMetalFXFlags */
+	uint32_t reserved;
+	uint64_t feature;			/**< The caller's name for this upscaler or interpolator; its history is kept under it. */
+	uint64_t color;				/**< Upscale: the frame to upscale. Interpolate: the finished frame. */
+	uint64_t depth;
+	uint64_t motion;
+	uint64_t exposure;			/**< Upscale only, optional. */
+	uint64_t output;			/**< Upscale: the upscaled frame. Interpolate: the in-between frame. */
+	uint32_t inputWidth;		/**< The part of colour, depth and motion that is in use; zero means all of it. */
+	uint32_t inputHeight;
+	float jitterX;
+	float jitterY;
+	float motionScaleX;			/**< Multiplies motion vectors into pixels that point at where the pixel was. */
+	float motionScaleY;
+	float preExposure;
+	float deltaTime;			/**< Interpolate: seconds between this frame and the last. */
+	float nearPlane;
+	float farPlane;
+	float fieldOfView;			/**< Vertical, in degrees. */
+	float aspectRatio;
+} MVKMetalFXRequest;
+
+/** Whether MetalFX can do the operation on this device and OS. */
+bool mvkMetalFXSupports(id<MTLDevice> mtlDevice, uint32_t operation);
+
+
+#pragma mark -
+#pragma mark MVKCmdMetalFX
+
+class MVKCmdMetalFX : public MVKCommand {
+
+public:
+	VkResult setContent(MVKCommandBuffer* cmdBuff, const void* pRequest, uint32_t size);
+
+	void encode(MVKCommandEncoder* cmdEncoder) override;
+
+protected:
+	MVKCommandTypePool<MVKCommand>* getTypePool(MVKCommandPool* cmdPool) override;
+
+	MVKMetalFXRequest _request;
+};
