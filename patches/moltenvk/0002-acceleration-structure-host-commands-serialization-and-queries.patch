+#pragma mark -
+#pragma mark Encoding builds and copies
+
+// MoltenVK's command buffers do not retain what they reference. Whatever a command made for
+// itself is kept alive through this until the GPU has finished the command buffer.
+static void mvkKeepAliveUntilCompleted(id<MTLCommandBuffer> mtlCmdBuff, NSArray* objects) {
+	if (objects.count == 0) { return; }
+	NSArray* kept = [objects retain];
+	[mtlCmdBuff addCompletedHandler: ^(id<MTLCommandBuffer>) { [kept release]; }];
+}
+
+// Builds, or refits, mtlDst from the descriptor, with scratch space of our own unless the
+// application's can be used.
+static void mvkEncodeMTLBuild(MVKDevice* device, id<MTLCommandBuffer> mtlCmdBuff,
+							  MTLAccelerationStructureDescriptor* mtlDesc,
+							  id<MTLAccelerationStructure> mtlRefitSrc, id<MTLAccelerationStructure> mtlDst,
+							  id<MTLBuffer> mtlScratch, NSUInteger scratchOffset, const char* label) {
+	id<MTLDevice> mtlDev = device->getPhysicalDevice()->getMTLDevice();
+	MTLAccelerationStructureSizes sizes = [mtlDev accelerationStructureSizesWithDescriptor: mtlDesc];
+	NSUInteger scratchSize = mtlRefitSrc ? sizes.refitScratchBufferSize : sizes.buildScratchBufferSize;
+	if ( !mtlScratch || mtlScratch.length < scratchOffset + scratchSize ) {
+		mtlScratch = scratchSize ? [[mtlDev newBufferWithLength: scratchSize options: MTLResourceStorageModePrivate] autorelease] : nil;
+		scratchOffset = 0;
+	}
+
+	NSMutableArray* keep = [NSMutableArray arrayWithObject: mtlDesc];
+	if (mtlScratch) { [keep addObject: mtlScratch]; }
+	mvkKeepAliveUntilCompleted(mtlCmdBuff, keep);
+
+	id<MTLAccelerationStructureCommandEncoder> mtlEnc = [mtlCmdBuff accelerationStructureCommandEncoder];
+	mtlEnc.label = @(label);
+	if (mtlRefitSrc) {
+		[mtlEnc refitAccelerationStructure: mtlRefitSrc
+								descriptor: mtlDesc
+							   destination: (mtlDst == mtlRefitSrc ? nil : mtlDst)
+							 scratchBuffer: mtlScratch
+					   scratchBufferOffset: scratchOffset];
+	} else {
+		[mtlEnc buildAccelerationStructure: mtlDst
+								descriptor: mtlDesc
+							 scratchBuffer: mtlScratch
+					   scratchBufferOffset: scratchOffset];
+	}
+	[mtlEnc endEncoding];
+}
+
+void mvkEncodeAccelerationStructureBuild(MVKDevice* device, id<MTLCommandBuffer> mtlCmdBuff,
+										 const VkAccelerationStructureBuildGeometryInfoKHR* pInfo,
+										 const VkAccelerationStructureBuildRangeInfoKHR* pRangeInfos,
+										 bool hostAddresses) {
+	auto* dst = (MVKAccelerationStructure*)pInfo->dstAccelerationStructure;
+	if ( !dst || !dst->getMTLAccelerationStructure() ) { return; }
+
+	@autoreleasepool {
+		MVKAccelerationStructureBuildInputs inputs;
+		inputs.hostAddresses = hostAddresses;
+		auto* mtlDesc = mvkNewMTLAccelerationStructureDescriptor(device, pInfo, pRangeInfos, nullptr, inputs);
+		if ( !mtlDesc ) { return; }
+
+		auto* src = (MVKAccelerationStructure*)pInfo->srcAccelerationStructure;
+		bool isUpdate = pInfo->mode == VK_BUILD_ACCELERATION_STRUCTURE_MODE_UPDATE_KHR && src && src->getMTLAccelerationStructure();
+
+		// The application's scratch space is used when its address can be resolved.
+		id<MTLBuffer> mtlScratch = nil;
+		NSUInteger scratchOffset = 0;
+		if ( !hostAddresses ) { device->getMTLBufferAtAddress(pInfo->scratchData.deviceAddress, &mtlScratch, &scratchOffset); }
+
+		mvkEncodeMTLBuild(device, mtlCmdBuff, mtlDesc,
+						  isUpdate ? src->getMTLAccelerationStructure() : nil, dst->getMTLAccelerationStructure(),
+						  mtlScratch, scratchOffset, "vkCmdBuildAccelerationStructuresKHR");
+
+		dst->setBuildRecord(mtlDesc, inputs);
+		if (pInfo->type == VK_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL_KHR ||
+			[mtlDesc isKindOfClass: [MTLInstanceAccelerationStructureDescriptor class]]) {
+			dst->setInstancedMTLAccelerationStructures(inputs.instancedStructures);
+		}
+	}
+}
+
+void mvkEncodeAccelerationStructureCopy(MVKDevice* device, id<MTLCommandBuffer> mtlCmdBuff,
+										MVKAccelerationStructure* src, MVKAccelerationStructure* dst,
+										VkCopyAccelerationStructureModeKHR mode) {
+	if ( !src || !dst || !src->getMTLAccelerationStructure() || !dst->getMTLAccelerationStructure() ) { return; }
+
+	id<MTLAccelerationStructureCommandEncoder> mtlEnc = [mtlCmdBuff accelerationStructureCommandEncoder];
+	mtlEnc.label = @"vkCmdCopyAccelerationStructureKHR";
+	if (mode == VK_COPY_ACCELERATION_STRUCTURE_MODE_COMPACT_KHR) {
+		[mtlEnc copyAndCompactAccelerationStructure: src->getMTLAccelerationStructure()
+							toAccelerationStructure: dst->getMTLAccelerationStructure()];
+	} else {
+		[mtlEnc copyAccelerationStructure: src->getMTLAccelerationStructure()
+				  toAccelerationStructure: dst->getMTLAccelerationStructure()];
+	}
+	[mtlEnc endEncoding];
+	dst->setInstancedMTLAccelerationStructures(src->getInstancedMTLAccelerationStructures());
+	dst->copyBuildRecord(src);
+}
+
+VkResult mvkRunHostAccelerationStructureCommands(MVKDevice* device, void (^block)(id<MTLCommandBuffer> mtlCmdBuff)) {
+	VkResult rslt = VK_SUCCESS;
+	@autoreleasepool {
+		id<MTLCommandBuffer> mtlCmdBuff = [device->getAnyQueue()->getMTLCommandQueue() commandBuffer];	// retains what it references
+		mtlCmdBuff.label = @"Acceleration structure host commands";
+		block(mtlCmdBuff);
+		[mtlCmdBuff commit];
+		[mtlCmdBuff waitUntilCompleted];
+		if (mtlCmdBuff.status == MTLCommandBufferStatusError) {
+			rslt = device->reportError(VK_ERROR_UNKNOWN, "An acceleration structure host command failed: %s", mtlCmdBuff.error.localizedDescription.UTF8String);
+		}
+	}
+	return rslt;
+}
