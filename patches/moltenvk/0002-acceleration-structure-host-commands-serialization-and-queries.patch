+#pragma mark -
+#pragma mark MVKAccelerationStructureQueryPool
+
+void MVKAccelerationStructureQueryPool::writeProperty(uint32_t query, MVKAccelerationStructure* mvkAS, MVKCommandEncoder* cmdEncoder) {
+	if ( !_results || query * sizeof(uint64_t) >= _results.length ) { return; }
+	auto* pResult = (uint64_t*)_results.contents + query;
+	*pResult = 0;
+	if (mvkAS && mvkAS->getMTLAccelerationStructure()) {
+		if (_queryType == VK_QUERY_TYPE_ACCELERATION_STRUCTURE_COMPACTED_SIZE_KHR) {
+			// Only the GPU knows this one; it writes the value when the command buffer runs.
+			cmdEncoder->endCurrentMetalEncoding();
+			id<MTLAccelerationStructureCommandEncoder> mtlEnc = [cmdEncoder->_mtlCmdBuffer accelerationStructureCommandEncoder];
+			mtlEnc.label = @"vkCmdWriteAccelerationStructuresPropertiesKHR";
+			[mtlEnc writeCompactedAccelerationStructureSize: mvkAS->getMTLAccelerationStructure()
+												   toBuffer: _results
+													 offset: query * sizeof(uint64_t)
+											   sizeDataType: MTLDataTypeULong];
+			[mtlEnc endEncoding];
+		} else {
+			*pResult = mvkAS->getSerializedSize();
+		}
+	}
+	MVKQueryPool::endQuery(query, cmdEncoder);
+	cmdEncoder->markWrittenQuery(this, query);
+}
+
+NSData* MVKAccelerationStructureQueryPool::getQuerySourceData(uint32_t firstQuery, uint32_t queryCount) {
+	return [NSData dataWithBytesNoCopy: (void*)((uintptr_t)_results.contents + firstQuery * sizeof(uint64_t))
+								length: queryCount * sizeof(uint64_t)
+						  freeWhenDone: false];
+}
+
+id<MTLBuffer> MVKAccelerationStructureQueryPool::getResultBuffer(MVKCommandEncoder*, uint32_t firstQuery, uint32_t, NSUInteger& offset) {
+	offset = firstQuery * sizeof(uint64_t);
+	return _results;
+}
+
+id<MTLComputeCommandEncoder> MVKAccelerationStructureQueryPool::encodeComputeCopyResults(MVKCommandEncoder* cmdEncoder, uint32_t firstQuery, uint32_t, uint32_t index) {
+	id<MTLComputeCommandEncoder> mtlCmdEnc = cmdEncoder->getMTLComputeEncoder(kMVKCommandUseCopyQueryPoolResults);
+	cmdEncoder->getMtlCompute().bindBuffer(mtlCmdEnc, _results, firstQuery * sizeof(uint64_t), index);
+	return mtlCmdEnc;
+}
+
+MVKAccelerationStructureQueryPool::MVKAccelerationStructureQueryPool(MVKDevice* device, const VkQueryPoolCreateInfo* pCreateInfo)
+	: MVKQueryPool(device, pCreateInfo, 1), _queryType(pCreateInfo->queryType) {
+
+	NSUInteger length = max<NSUInteger>(pCreateInfo->queryCount, 1) * sizeof(uint64_t);
+	_results = [getMTLDevice() newBufferWithLength: length options: MTLResourceStorageModeShared];
+	if ( !_results ) {
+		setConfigurationResult(reportError(VK_ERROR_OUT_OF_DEVICE_MEMORY, "vkCreateQueryPool(): Could not allocate %lu bytes for acceleration structure query results.", (unsigned long)length));
+	}
+}
+
+MVKAccelerationStructureQueryPool::~MVKAccelerationStructureQueryPool() {
+	[_results release];
+}
