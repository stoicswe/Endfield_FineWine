+#pragma mark -
+#pragma mark Serialization
+
+/*
+ * A serialized acceleration structure. The header is the one Vulkan defines; an application
+ * reads the sizes from it, and rewrites the handles of a top-level structure to the
+ * bottom-level structures it has made on the device that will read it back.
+ *
+ * Metal has no way to write an acceleration structure out or read one in. What follows the
+ * header is therefore what the structure was built from: the geometry of a bottom-level
+ * structure, or the instances of a top-level one. Reading it back builds the structure again.
+ * All offsets are from the start of the header.
+ */
+struct MVKSerializedASHeader {
+	uint8_t  driverUUID[VK_UUID_SIZE];
+	uint8_t  formatUUID[VK_UUID_SIZE];
+	uint64_t serializedSize;
+	uint64_t deserializedSize;
+	uint64_t handleCount;
+	// uint64_t handles[handleCount];
+};
+
+struct MVKSerializedASBody {
+	uint32_t magic;
+	uint32_t type;			// VkAccelerationStructureTypeKHR
+	uint32_t usage;			// MTLAccelerationStructureUsage
+	uint32_t count;			// geometries, or instances
+	uint64_t instanceOffset;	// top level: the Metal instance descriptors
+	uint64_t instanceStride;
+};
+
+struct MVKSerializedASGeometry {
+	uint32_t isBoxes;
+	uint32_t opaque;
+	uint32_t primitiveCount;
+	uint32_t vertexFormat;		// MTLAttributeFormat
+	uint32_t stride;			// of a vertex, or of a box
+	uint32_t indexType;			// 0 none, 1 16-bit, 2 32-bit
+	uint32_t hasTransform;
+	uint32_t pad;
+	uint64_t vertexOffset;
+	uint64_t vertexLength;
+	uint64_t indexOffset;
+	uint64_t indexLength;
+	uint64_t transformOffset;
+	uint64_t pad2;
+};
+
+static const uint32_t kMVKSerializedASMagic = 0x53415746;	// "FWAS"
+static const uint8_t kMVKSerializedASFormatUUID[VK_UUID_SIZE] = { 'F','i','n','e','W','i','n','e','-','A','S','-','v','0','0','1' };
+
+void mvkGetAccelerationStructureSerializationUUIDs(MVKDevice* device, uint8_t* pDriverUUID, uint8_t* pFormatUUID) {
+	// The same value MoltenVK reports as VkPhysicalDeviceIDProperties::driverUUID.
+	VkPhysicalDeviceVulkan11Properties props11 = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_PROPERTIES };
+	VkPhysicalDeviceProperties2 props2 = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, &props11 };
+	const_cast<MVKPhysicalDevice*>(device->getPhysicalDevice())->getProperties(&props2);
+	memcpy(pDriverUUID, props11.driverUUID, VK_UUID_SIZE);
+	memcpy(pFormatUUID, kMVKSerializedASFormatUUID, VK_UUID_SIZE);
+}
+
+// Where each part of a serialized structure goes. Returns the total size.
+struct MVKSerializedASLayout {
+	NSUInteger bodyOffset = 0;
+	NSUInteger geometryOffset = 0;
+	NSUInteger metaLength = 0;		// header, handles, body and geometry records
+	NSUInteger instanceOffset = 0;
+	NSUInteger instanceLength = 0;
+	MVKSmallVector<MVKSerializedASGeometry, 4> geometries;
+	NSUInteger totalSize = 0;
+};
+
+static NSUInteger mvkAlign16(NSUInteger v) { return (v + 15) & ~(NSUInteger)15; }
+static NSUInteger mvkAlign4(NSUInteger v) { return (v + 3) & ~(NSUInteger)3; }
+
+static bool mvkLayOutSerializedAS(MVKAccelerationStructure* mvkAS, MVKSerializedASLayout& layout) {
+	MTLAccelerationStructureDescriptor* mtlDesc = mvkAS->getBuildDescriptor();
+	if ( !mtlDesc ) { return false; }
+
+	NSUInteger handleCount = mvkAS->getInstancedAddresses().size();
+	layout.bodyOffset = sizeof(MVKSerializedASHeader) + handleCount * sizeof(uint64_t);
+	layout.geometryOffset = layout.bodyOffset + sizeof(MVKSerializedASBody);
+
+	if ([mtlDesc isKindOfClass: [MTLInstanceAccelerationStructureDescriptor class]]) {
+		auto* instDesc = (MTLInstanceAccelerationStructureDescriptor*)mtlDesc;
+		layout.metaLength = layout.geometryOffset;
+		layout.instanceOffset = mvkAlign16(layout.metaLength);
+		layout.instanceLength = instDesc.instanceCount * instDesc.instanceDescriptorStride;
+		layout.totalSize = mvkAlign16(layout.instanceOffset + layout.instanceLength);
+		return true;
+	}
+
+	auto* primDesc = (MTLPrimitiveAccelerationStructureDescriptor*)mtlDesc;
+	auto& extents = mvkAS->getBuildExtents();
+	NSUInteger geomCount = primDesc.geometryDescriptors.count;
+	if (extents.size() != geomCount) { return false; }
+	layout.metaLength = layout.geometryOffset + geomCount * sizeof(MVKSerializedASGeometry);
+	NSUInteger cursor = mvkAlign16(layout.metaLength);
+	for (NSUInteger i = 0; i < geomCount; i++) {
+		MTLAccelerationStructureGeometryDescriptor* geom = primDesc.geometryDescriptors[i];
+		MVKSerializedASGeometry rec = {};
+		rec.opaque = geom.opaque;
+		rec.vertexLength = extents[i].vertexLength;
+		rec.indexLength = extents[i].indexLength;
+		if ([geom isKindOfClass: [MTLAccelerationStructureTriangleGeometryDescriptor class]]) {
+			auto* tri = (MTLAccelerationStructureTriangleGeometryDescriptor*)geom;
+			rec.primitiveCount = (uint32_t)tri.triangleCount;
+			rec.vertexFormat = (uint32_t)tri.vertexFormat;
+			rec.stride = (uint32_t)tri.vertexStride;
+			rec.indexType = !tri.indexBuffer ? 0 : (tri.indexType == MTLIndexTypeUInt16 ? 1 : 2);
+			rec.hasTransform = tri.transformationMatrixBuffer != nil;
+		} else {
+			auto* box = (MTLAccelerationStructureBoundingBoxGeometryDescriptor*)geom;
+			rec.isBoxes = 1;
+			rec.primitiveCount = (uint32_t)box.boundingBoxCount;
+			rec.stride = (uint32_t)box.boundingBoxStride;
+		}
+		rec.vertexOffset = cursor;		cursor = mvkAlign16(cursor + mvkAlign4(rec.vertexLength));
+		rec.indexOffset = cursor;		cursor = mvkAlign16(cursor + mvkAlign4(rec.indexLength));
+		rec.transformOffset = cursor;	cursor = mvkAlign16(cursor + (rec.hasTransform ? sizeof(VkTransformMatrixKHR) : 0));
+		layout.geometries.push_back(rec);
+	}
+	layout.totalSize = cursor;
+	return true;
+}
+
+VkDeviceSize MVKAccelerationStructure::getSerializedSize() {
+	MVKSerializedASLayout layout;
+	return mvkLayOutSerializedAS(this, layout) ? layout.totalSize : 0;
+}
+
+bool mvkEncodeAccelerationStructureSerialize(MVKDevice* device, id<MTLCommandBuffer> mtlCmdBuff,
+											 MVKAccelerationStructure* src, id<MTLBuffer> mtlDst, NSUInteger dstOffset) {
+	MVKSerializedASLayout layout;
+	if ( !src || !mvkLayOutSerializedAS(src, layout) ) {
+		device->reportError(VK_ERROR_FEATURE_NOT_PRESENT, "An acceleration structure that has not been built cannot be serialized.");
+		return false;
+	}
+	if ( !mtlDst || mtlDst.length < dstOffset + layout.totalSize ) {
+		device->reportError(VK_ERROR_OUT_OF_DEVICE_MEMORY, "The destination of a serialized acceleration structure is smaller than its %lu bytes.", (unsigned long)layout.totalSize);
+		return false;
+	}
+
+	@autoreleasepool {
+		id<MTLDevice> mtlDev = device->getPhysicalDevice()->getMTLDevice();
+		MTLAccelerationStructureDescriptor* mtlDesc = src->getBuildDescriptor();
+		auto* instDesc = [mtlDesc isKindOfClass: [MTLInstanceAccelerationStructureDescriptor class]] ? (MTLInstanceAccelerationStructureDescriptor*)mtlDesc : nil;
+
+		// The header, handles, body and geometry records are put together here and copied in.
+		// The destination may not be memory the CPU can reach, so everything goes through the GPU.
+		NSUInteger metaLength = mvkAlign4(layout.metaLength);
+		id<MTLBuffer> mtlMeta = [[mtlDev newBufferWithLength: metaLength options: MTLResourceStorageModeShared] autorelease];
+		char* meta = (char*)mtlMeta.contents;
+		memset(meta, 0, metaLength);
+
+		auto* hdr = (MVKSerializedASHeader*)meta;
+		mvkGetAccelerationStructureSerializationUUIDs(device, hdr->driverUUID, hdr->formatUUID);
+		hdr->serializedSize = layout.totalSize;
+		// Reading it back is a fresh build, so the size to create is the size a build needs,
+		// which is more than the structure occupies if it has been compacted.
+		hdr->deserializedSize = max<uint64_t>([mtlDev accelerationStructureSizesWithDescriptor: mtlDesc].accelerationStructureSize, 16);
+		auto& handles = src->getInstancedAddresses();
+		hdr->handleCount = handles.size();
+		if (handles.size()) { memcpy(meta + sizeof(MVKSerializedASHeader), handles.data(), handles.size() * sizeof(uint64_t)); }
+
+		auto* body = (MVKSerializedASBody*)(meta + layout.bodyOffset);
+		body->magic = kMVKSerializedASMagic;
+		body->type = instDesc ? VK_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL_KHR : VK_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL_KHR;
+		body->usage = (uint32_t)mtlDesc.usage;
+		body->count = instDesc ? (uint32_t)instDesc.instanceCount : (uint32_t)layout.geometries.size();
+		body->instanceOffset = layout.instanceOffset;
+		body->instanceStride = instDesc ? instDesc.instanceDescriptorStride : 0;
+		if (layout.geometries.size()) {
+			memcpy(meta + layout.geometryOffset, layout.geometries.data(), layout.geometries.size() * sizeof(MVKSerializedASGeometry));
+		}
+
+		mvkKeepAliveUntilCompleted(mtlCmdBuff, @[mtlMeta, mtlDesc]);
+		id<MTLBlitCommandEncoder> mtlBlit = [mtlCmdBuff blitCommandEncoder];
+		mtlBlit.label = @"vkCmdCopyAccelerationStructureToMemoryKHR";
+		auto copy = [&](id<MTLBuffer> from, NSUInteger fromOffset, NSUInteger length, NSUInteger toOffset) {
+			if ( !from || !length ) { return; }
+			length = min(mvkAlign4(length), from.length - min(from.length, fromOffset));
+			if (length) {
+				[mtlBlit copyFromBuffer: from sourceOffset: fromOffset toBuffer: mtlDst destinationOffset: dstOffset + toOffset size: length];
+			}
+		};
+		copy(mtlMeta, 0, metaLength, 0);
+		if (instDesc) {
+			copy(instDesc.instanceDescriptorBuffer, instDesc.instanceDescriptorBufferOffset, layout.instanceLength, layout.instanceOffset);
+		} else {
+			auto* primDesc = (MTLPrimitiveAccelerationStructureDescriptor*)mtlDesc;
+			for (NSUInteger i = 0; i < layout.geometries.size(); i++) {
+				auto& rec = layout.geometries[i];
+				MTLAccelerationStructureGeometryDescriptor* geom = primDesc.geometryDescriptors[i];
+				if (rec.isBoxes) {
+					auto* box = (MTLAccelerationStructureBoundingBoxGeometryDescriptor*)geom;
+					copy(box.boundingBoxBuffer, box.boundingBoxBufferOffset, rec.vertexLength, rec.vertexOffset);
+				} else {
+					auto* tri = (MTLAccelerationStructureTriangleGeometryDescriptor*)geom;
+					copy(tri.vertexBuffer, tri.vertexBufferOffset, rec.vertexLength, rec.vertexOffset);
+					copy(tri.indexBuffer, tri.indexBufferOffset, rec.indexLength, rec.indexOffset);
+					if (rec.hasTransform) {
+						copy(tri.transformationMatrixBuffer, tri.transformationMatrixBufferOffset, sizeof(VkTransformMatrixKHR), rec.transformOffset);
+					}
+				}
+			}
+		}
+		[mtlBlit endEncoding];
+	}
+	return true;
+}
+
+bool mvkEncodeAccelerationStructureDeserialize(MVKDevice* device, id<MTLCommandBuffer> mtlCmdBuff,
+											   const void* srcBytes, MVKAccelerationStructure* dst) {
+	if ( !srcBytes || !dst || !dst->getMTLAccelerationStructure() ) { return false; }
+
+	auto* hdr = (const MVKSerializedASHeader*)srcBytes;
+	uint8_t driverUUID[VK_UUID_SIZE], formatUUID[VK_UUID_SIZE];
+	mvkGetAccelerationStructureSerializationUUIDs(device, driverUUID, formatUUID);
+	NSUInteger bodyOffset = sizeof(MVKSerializedASHeader) + (NSUInteger)hdr->handleCount * sizeof(uint64_t);
+	auto* body = (const MVKSerializedASBody*)((const char*)srcBytes + bodyOffset);
+	if (memcmp(hdr->driverUUID, driverUUID, VK_UUID_SIZE) || memcmp(hdr->formatUUID, formatUUID, VK_UUID_SIZE) ||
+		hdr->serializedSize < bodyOffset + sizeof(MVKSerializedASBody) || body->magic != kMVKSerializedASMagic) {
+		device->reportError(VK_ERROR_FORMAT_NOT_SUPPORTED, "vkCmdCopyMemoryToAccelerationStructureKHR(): The data is not an acceleration structure serialized by this driver.");
+		return false;
+	}
+
+	@autoreleasepool {
+		id<MTLDevice> mtlDev = device->getPhysicalDevice()->getMTLDevice();
+
+		// A copy of our own: the structure is built from it, and can be serialized from it again.
+		id<MTLBuffer> mtlData = [[mtlDev newBufferWithBytes: srcBytes length: (NSUInteger)hdr->serializedSize options: MTLResourceStorageModeShared] autorelease];
+		if ( !mtlData ) { return false; }
+
+		MVKAccelerationStructureBuildInputs inputs;
+		MTLAccelerationStructureDescriptor* mtlDesc = nil;
+		const uint64_t* handles = (const uint64_t*)(hdr + 1);
+
+		if (body->type == VK_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL_KHR) {
+			NSMutableArray<id<MTLAccelerationStructure>>* blasList = [NSMutableArray array];
+			for (uint64_t i = 0; i < hdr->handleCount; i++) {
+				MVKAccelerationStructure* blas = device->getAccelerationStructureAtAddress(handles[i]);
+				if ( !blas || !blas->getMTLAccelerationStructure() ) {
+					device->reportError(VK_ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS, "vkCmdCopyMemoryToAccelerationStructureKHR(): Handle %llu of the serialized top-level structure is not a bottom-level structure on this device.", i);
+					return false;
+				}
+				[blasList addObject: blas->getMTLAccelerationStructure()];
+				inputs.instancedAddresses.push_back(handles[i]);
+			}
+			auto* instDesc = [MTLInstanceAccelerationStructureDescriptor descriptor];
+			instDesc.usage = body->usage;
+			instDesc.instanceDescriptorType = MTLAccelerationStructureInstanceDescriptorTypeUserID;
+			instDesc.instanceDescriptorStride = (NSUInteger)body->instanceStride;
+			instDesc.instanceCount = blasList.count ? body->count : 0;
+			if (instDesc.instanceCount) {
+				instDesc.instancedAccelerationStructures = blasList;
+				instDesc.instanceDescriptorBuffer = mtlData;
+				instDesc.instanceDescriptorBufferOffset = (NSUInteger)body->instanceOffset;
+				inputs.instancedStructures = blasList;
+			}
+			mtlDesc = instDesc;
+		} else {
+			auto* primDesc = [MTLPrimitiveAccelerationStructureDescriptor descriptor];
+			primDesc.usage = body->usage;
+			NSMutableArray<MTLAccelerationStructureGeometryDescriptor*>* geoms = [NSMutableArray arrayWithCapacity: body->count];
+			auto* recs = (const MVKSerializedASGeometry*)(body + 1);
+			for (uint32_t i = 0; i < body->count; i++) {
+				auto& rec = recs[i];
+				if (rec.isBoxes) {
+					auto* box = [MTLAccelerationStructureBoundingBoxGeometryDescriptor descriptor];
+					box.opaque = rec.opaque;
+					box.boundingBoxCount = rec.primitiveCount;
+					box.boundingBoxStride = rec.stride;
+					box.boundingBoxBuffer = mtlData;
+					box.boundingBoxBufferOffset = (NSUInteger)rec.vertexOffset;
+					[geoms addObject: box];
+				} else {
+					auto* tri = [MTLAccelerationStructureTriangleGeometryDescriptor descriptor];
+					tri.opaque = rec.opaque;
+					tri.triangleCount = rec.primitiveCount;
+					tri.vertexFormat = (MTLAttributeFormat)rec.vertexFormat;
+					tri.vertexStride = rec.stride;
+					tri.vertexBuffer = mtlData;
+					tri.vertexBufferOffset = (NSUInteger)rec.vertexOffset;
+					if (rec.indexType) {
+						tri.indexType = rec.indexType == 1 ? MTLIndexTypeUInt16 : MTLIndexTypeUInt32;
+						tri.indexBuffer = mtlData;
+						tri.indexBufferOffset = (NSUInteger)rec.indexOffset;
+					}
+					if (rec.hasTransform) {
+						tri.transformationMatrixBuffer = mtlData;
+						tri.transformationMatrixBufferOffset = (NSUInteger)rec.transformOffset;
+						tri.transformationMatrixLayout = MTLMatrixLayoutRowMajor;
+					}
+					[geoms addObject: tri];
+				}
+				inputs.extents.push_back({ (NSUInteger)rec.vertexLength, (NSUInteger)rec.indexLength });
+			}
+			primDesc.geometryDescriptors = geoms;
+			mtlDesc = primDesc;
+		}
+
+		mvkEncodeMTLBuild(device, mtlCmdBuff, mtlDesc, nil, dst->getMTLAccelerationStructure(), nil, 0, "vkCmdCopyMemoryToAccelerationStructureKHR");
+		dst->setBuildRecord(mtlDesc, inputs);
+		dst->setInstancedMTLAccelerationStructures(inputs.instancedStructures);
+	}
+	return true;
+}
