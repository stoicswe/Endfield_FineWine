+MVK_PUBLIC_VULKAN_SYMBOL VkResult vkWriteAccelerationStructuresPropertiesKHR(
+	VkDevice                                    device,
+	uint32_t                                    accelerationStructureCount,
+	const VkAccelerationStructureKHR*           pAccelerationStructures,
+	VkQueryType                                 queryType,
+	size_t                                      dataSize,
+	void*                                       pData,
+	size_t                                      stride) {
+
+	MVKTraceVulkanCallStart();
+	MVKDevice* mvkDev = MVKDevice::getMVKDevice(device);
+	VkResult rslt = VK_SUCCESS;
+	uint32_t count = accelerationStructureCount;
+	if (queryType == VK_QUERY_TYPE_ACCELERATION_STRUCTURE_SERIALIZATION_SIZE_KHR) {
+		for (uint32_t i = 0; i < count && (i * stride + sizeof(VkDeviceSize)) <= dataSize; i++) {
+			auto* mvkAS = (MVKAccelerationStructure*)pAccelerationStructures[i];
+			*(VkDeviceSize*)((char*)pData + i * stride) = mvkAS ? mvkAS->getSerializedSize() : 0;
+		}
+	} else if (queryType == VK_QUERY_TYPE_ACCELERATION_STRUCTURE_COMPACTED_SIZE_KHR && count) {
+		@autoreleasepool {
+			id<MTLBuffer> mtlSizes = [[mvkDev->getPhysicalDevice()->getMTLDevice() newBufferWithLength: count * sizeof(uint64_t) options: MTLResourceStorageModeShared] autorelease];
+			memset(mtlSizes.contents, 0, mtlSizes.length);
+			rslt = mvkRunHostAccelerationStructureCommands(mvkDev, ^(id<MTLCommandBuffer> mtlCmdBuff) {
+				id<MTLAccelerationStructureCommandEncoder> mtlEnc = [mtlCmdBuff accelerationStructureCommandEncoder];
+				for (uint32_t i = 0; i < count; i++) {
+					auto* mvkAS = (MVKAccelerationStructure*)pAccelerationStructures[i];
+					if (mvkAS && mvkAS->getMTLAccelerationStructure()) {
+						[mtlEnc writeCompactedAccelerationStructureSize: mvkAS->getMTLAccelerationStructure()
+															   toBuffer: mtlSizes
+																 offset: i * sizeof(uint64_t)
+														   sizeDataType: MTLDataTypeULong];
+					}
+				}
+				[mtlEnc endEncoding];
+			});
+			for (uint32_t i = 0; i < count && (i * stride + sizeof(VkDeviceSize)) <= dataSize; i++) {
+				*(VkDeviceSize*)((char*)pData + i * stride) = ((uint64_t*)mtlSizes.contents)[i];
+			}
+		}
+	} else {
+		rslt = mvkDev->reportError(VK_ERROR_FEATURE_NOT_PRESENT, "vkWriteAccelerationStructuresPropertiesKHR(): Query type %d is not supported.", queryType);
+	}
 	MVKTraceVulkanCallEnd();
 	return rslt;
 }
 
