+VkResult MVKCmdTraceRays::setContent(MVKCommandBuffer* cmdBuff,
+									 const VkStridedDeviceAddressRegionKHR* pRaygen,
+									 const VkStridedDeviceAddressRegionKHR* pMiss,
+									 const VkStridedDeviceAddressRegionKHR* pHit,
+									 const VkStridedDeviceAddressRegionKHR* pCallable,
+									 uint32_t width, uint32_t height, uint32_t depth,
+									 VkDeviceAddress indirectDeviceAddress) {
+	_raygen = pRaygen ? *pRaygen : VkStridedDeviceAddressRegionKHR();
+	_miss = pMiss ? *pMiss : VkStridedDeviceAddressRegionKHR();
+	_hit = pHit ? *pHit : VkStridedDeviceAddressRegionKHR();
+	_callable = pCallable ? *pCallable : VkStridedDeviceAddressRegionKHR();
+	_width = width;
+	_height = height;
+	_depth = depth;
+	_indirectAddress = indirectDeviceAddress;
+	return VK_SUCCESS;
+}
+
+void MVKCmdTraceRays::encode(MVKCommandEncoder* cmdEncoder) {
+	MVKCommandEncoderState& state = cmdEncoder->getState();
+	const MVKVulkanComputeCommandEncoderState& rt = state.vkRayTracing();
+	auto* pipeline = (MVKRayTracingPipeline*)rt._pipeline;
+	if ( !pipeline || !pipeline->getPipelineState() ) { return; }
+	MVKDevice* device = cmdEncoder->getDevice();
+
+	// The ray tracing bind point shares the Metal compute encoder with the compute bind point.
+	// A fresh encoder before and after keeps what one has bound from being taken for the other's.
+	cmdEncoder->endCurrentMetalEncoding();
+	id<MTLComputeCommandEncoder> mtlEncoder = cmdEncoder->getMTLComputeEncoder(kMVKCommandUseDispatch);
+	state.prepareRayTracingDispatch(mtlEncoder, *cmdEncoder);
+
+	// Where the shader finds the shader binding table.
+	mvk::RTDispatchParams params = {};
+	params.rayGenAddress = _raygen.deviceAddress;
+	params.missAddress = _miss.deviceAddress;
+	params.missStride = _miss.stride;
+	params.hitAddress = _hit.deviceAddress;
+	params.hitStride = _hit.stride;
+	params.callableAddress = _callable.deviceAddress;
+	params.callableStride = _callable.stride;
+	[mtlEncoder setBytes: &params length: sizeof(params) atIndex: pipeline->getParamsBufferIndex()];
+
+	// The instance table of each acceleration structure the shader traces against.
+	auto& tables = pipeline->getInstanceTableBindings();
+	NSMutableArray* keep = tables.empty() ? nil : [NSMutableArray array];
+	for (uint32_t i = 0; i < tables.size(); i++) {
+		id<MTLTexture> mtlTable = nil;
+		uint32_t set = tables[i].first;
+		if (rt._layout && set < rt._layout->getDescriptorSetCount() && rt._descriptorSets[set]) {
+			MVKDescriptorSetLayout* setLayout = rt._layout->getDescriptorSetLayout(set);
+			uint32_t idx = setLayout->getBindingIndex(tables[i].second);
+			if (idx < setLayout->bindings().size() && setLayout->bindings()[idx].descriptorType == VK_DESCRIPTOR_TYPE_ACCELERATION_STRUCTURE_KHR) {
+				id mtlAS = *(id*)(rt._descriptorSets[set]->cpuBuffer + setLayout->bindings()[idx].cpuOffset);
+				mtlTable = mvkGetInstanceTable(mtlAS);
+			}
+		}
+		if ( !mtlTable ) { mtlTable = pipeline->getEmptyInstanceTable(); }
+		[mtlEncoder setTexture: mtlTable atIndex: pipeline->getInstanceTableTextureIndex(i)];
+		[keep addObject: mtlTable];
+	}
+	if (keep.count) {
+		NSArray* kept = [keep retain];
+		[cmdEncoder->_mtlCmdBuffer addCompletedHandler: ^(id<MTLCommandBuffer>) { [kept release]; }];
+	}
+
+	// One work group of one thread per ray: the shader takes its launch id from the work group id.
+	if (_indirectAddress) {
+		id<MTLBuffer> mtlIndirect = nil;
+		NSUInteger indirectOffset = 0;
+		if (device->getMTLBufferAtAddress(_indirectAddress, &mtlIndirect, &indirectOffset)) {
+			[mtlEncoder dispatchThreadgroupsWithIndirectBuffer: mtlIndirect
+										  indirectBufferOffset: indirectOffset
+										 threadsPerThreadgroup: MTLSizeMake(1, 1, 1)];
+		} else {
+			device->reportError(VK_ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS, "vkCmdTraceRaysIndirectKHR(): The indirect address is not in a buffer created with VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT.");
+		}
+	} else if (_width && _height && _depth) {
+		[mtlEncoder dispatchThreadgroups: MTLSizeMake(_width, _height, _depth)
+				   threadsPerThreadgroup: MTLSizeMake(1, 1, 1)];
+	}
+	cmdEncoder->endCurrentMetalEncoding();
+}
