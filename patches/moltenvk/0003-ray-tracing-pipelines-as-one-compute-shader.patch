new file mode 100644
index 0000000..13cbd28
--- /dev/null
+++ b/MoltenVKShaderConverter/MoltenVKShaderConverter/RayTracingLowering.h
@@ -0,0 +1,118 @@
+/*
+ * RayTracingLowering.h
+ *
+ * FineWine: turns the shaders of a Vulkan ray tracing pipeline into one compute shader.
+ *
+ * Metal has no ray generation, hit, miss or callable shader stages, and SPIRV-Cross cannot
+ * translate them. It can translate ray queries. So the shaders of a pipeline are merged, at the
+ * SPIR-V level, into a single compute shader in which every traceRayEXT() is a ray query loop
+ * that calls the hit, miss and intersection shaders as ordinary functions, picked through the
+ * shader binding table at run time.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace mvk {
+
+	enum class RTStageKind : uint32_t { RayGeneration, Miss, ClosestHit, AnyHit, Intersection, Callable };
+
+	/** The value an application gave a specialization constant of one stage. */
+	struct RTSpecializationEntry {
+		uint32_t constantID = 0;
+		std::vector<uint8_t> data;
+	};
+
+	/** One shader of the pipeline. */
+	struct RTStage {
+		RTStageKind kind = RTStageKind::RayGeneration;
+		std::vector<uint32_t> spirv;
+		std::string entryName;
+		std::vector<RTSpecializationEntry> specialization;
+	};
+
+	static const uint32_t kRTShaderUnused = ~0u;
+
+	/** One shader group: a general group names one shader, a hit group up to three. Values index RTLoweringConfig::stages. */
+	struct RTGroup {
+		bool isHitGroup = false;
+		bool isProcedural = false;
+		uint32_t general = kRTShaderUnused;
+		uint32_t closestHit = kRTShaderUnused;
+		uint32_t anyHit = kRTShaderUnused;
+		uint32_t intersection = kRTShaderUnused;
+	};
+
+	struct RTLoweringConfig {
+		std::vector<RTStage> stages;
+		std::vector<RTGroup> groups;
+
+		/** How deep traceRayEXT() may nest. Each level is a copy of the hit and miss shaders. */
+		uint32_t maxRecursionDepth = 1;
+
+		/** How deep executeCallableEXT() may nest. */
+		uint32_t maxCallableDepth = 2;
+
+		/** The size of a shader group handle. Its first four bytes hold the group's index plus one. */
+		uint32_t handleSize = 32;
+
+		/**
+		 * Where the compute shader finds the shader binding table: a uniform block at this set
+		 * and binding, laid out as RTDispatchParams. The set is not one of the pipeline's.
+		 */
+		uint32_t paramsDescSet = 0;
+		uint32_t paramsBinding = 0;
+
+		/**
+		 * Metal ray queries do not return an instance's shader binding table offset. For each
+		 * acceleration structure binding that rays are traced against, the compute shader
+		 * therefore reads a texture holding those offsets: instance i is the texel at
+		 * (i % width, i / width). The textures are at paramsDescSet, bindings paramsBinding + 1
+		 * onwards, in the order RTLoweringResult::instanceTables lists the bindings they are for.
+		 */
+		uint32_t instanceTableWidth = 4096;
+	};
+
+	struct RTLoweringResult {
+		std::vector<uint32_t> spirv;
+
+		/** The (set, binding) of each acceleration structure that needs its instance table bound. */
+		std::vector<std::pair<uint32_t, uint32_t>> instanceTables;
+	};
+
+	/** What the compute shader reads at paramsDescSet / paramsBinding. All fields are 64 bits. */
+	struct RTDispatchParams {
+		uint64_t rayGenAddress;
+		uint64_t missAddress;
+		uint64_t missStride;
+		uint64_t hitAddress;
+		uint64_t hitStride;
+		uint64_t callableAddress;
+		uint64_t callableStride;
+		uint64_t reserved;
+	};
+
+	/**
+	 * Produces the compute shader: entry point "main", local size 1x1x1, to be dispatched with one
+	 * work group per ray (gl_LaunchIDEXT is the work group id, gl_LaunchSizeEXT the work group count).
+	 * Returns false and says why in log if the pipeline uses something that is not handled.
+	 */
+	bool lowerRayTracingPipeline(const RTLoweringConfig& config, RTLoweringResult& result, std::string& log);
+
+}
