+	VkResult rslt = ((MVKRayTracingPipeline*)pipeline)->getGroupHandles(firstGroup, groupCount, dataSize, pData);
+	MVKTraceVulkanCallEnd();
+	return rslt;
+}
+
+MVK_PUBLIC_VULKAN_SYMBOL VkResult vkGetRayTracingCaptureReplayShaderGroupHandlesKHR(
