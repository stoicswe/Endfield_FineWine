diff --git a/MoltenVKShaderConverter/MoltenVKShaderConverter/RayTracingLowering.cpp b/MoltenVKShaderConverter/MoltenVKShaderConverter/RayTracingLowering.cpp
new file mode 100644
index 0000000..6b381aa
--- /dev/null
+++ b/MoltenVKShaderConverter/MoltenVKShaderConverter/RayTracingLowering.cpp
@@ -0,0 +1,1469 @@
+/*
+ * RayTracingLowering.cpp
+ *
+ * FineWine: turns the shaders of a Vulkan ray tracing pipeline into one compute shader.
+ * This file is compiled as part of SPIRVSupport.cpp, which includes it, so that the Xcode
+ * project does not have to change. See RayTracingLowering.h for what it is for.
+ *
+ * How the result is put together:
+ *
+ *  - Every shader is imported once for each place it can run: the ray generation shaders at
+ *    trace depth 0, the hit, miss and intersection shaders at each depth from 1 to the
+ *    pipeline's maximum, callable shaders at each depth they can be called from. Metal shaders
+ *    cannot recurse, and each copy has its own payload and built-in variables, so a hit shader
+ *    that traces a ray calls the next depth's copies and nothing overwrites anything.
+ *  - Importing gives a module's ids new numbers, merges types, constants and descriptor
+ *    variables that are the same as ones already there, and turns the ray tracing storage
+ *    classes and built-in inputs into ordinary private variables.
+ *  - OpTraceRayKHR becomes a call to a generated function: a ray query loop that runs any-hit
+ *    and intersection shaders on candidates, then the closest-hit or miss shader. Which shader
+ *    is read from the shader binding table through its buffer address.
+ *  - OpReportIntersectionKHR and OpExecuteCallableKHR become calls to generated functions too.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "RayTracingLowering.h"
+#include <spirv-tools/libspirv.h>
+#include <cstring>
+#include <map>
+#include <set>
+#include <tuple>
+#include <unordered_map>
+
+namespace {
+
+using namespace spv;
+typedef std::vector<uint32_t> Words;
+
+
+#pragma mark Parsing
+
+/** One instruction of an input module, with the positions of its id operands. */
+struct PInst {
+	uint16_t op = 0;
+	Words w;						// the whole instruction, first word included
+	uint32_t typeId = 0;
+	uint32_t resultId = 0;
+	std::vector<uint16_t> ids;		// offsets into w of every id, result and type included
+};
+
+struct PModule {
+	uint32_t version = 0;
+	uint32_t bound = 0;
+	std::vector<PInst> insts;
+	size_t firstFunction = 0;		// index of the first OpFunction
+};
+
+static spv_result_t onParsedHeader(void* user, spv_endianness_t, uint32_t, uint32_t version, uint32_t, uint32_t bound, uint32_t) {
+	auto* pm = (PModule*)user;
+	pm->version = version;
+	pm->bound = bound;
+	return SPV_SUCCESS;
+}
+
+static spv_result_t onParsedInstruction(void* user, const spv_parsed_instruction_t* pi) {
+	auto* pm = (PModule*)user;
+	PInst inst;
+	inst.op = pi->opcode;
+	inst.w.assign(pi->words, pi->words + pi->num_words);
+	inst.typeId = pi->type_id;
+	inst.resultId = pi->result_id;
+	for (uint16_t i = 0; i < pi->num_operands; i++) {
+		const spv_parsed_operand_t& o = pi->operands[i];
+		switch (o.type) {
+			case SPV_OPERAND_TYPE_ID:
+			case SPV_OPERAND_TYPE_TYPE_ID:
+			case SPV_OPERAND_TYPE_RESULT_ID:
+			case SPV_OPERAND_TYPE_MEMORY_SEMANTICS_ID:
+			case SPV_OPERAND_TYPE_SCOPE_ID:
+				for (uint16_t k = 0; k < o.num_words; k++) { inst.ids.push_back(o.offset + k); }
+				break;
+			default:
+				break;
+		}
+	}
+	pm->insts.push_back(std::move(inst));
+	return SPV_SUCCESS;
+}
+
+static void emit(Words& section, uint32_t op, const Words& operands) {
+	section.push_back(((uint32_t)(operands.size() + 1) << 16) | op);
+	section.insert(section.end(), operands.begin(), operands.end());
+}
+
+static void appendString(Words& w, const std::string& s) {
+	size_t n = s.size() / 4 + 1;		// always room for the terminating zero
+	size_t start = w.size();
+	w.resize(start + n, 0);
+	memcpy(&w[start], s.data(), s.size());
+}
+
+static std::string readString(const Words& w, size_t start) {
+	std::string s;
+	for (size_t i = start; i < w.size(); i++) {
+		for (int b = 0; b < 4; b++) {
+			char c = (char)((w[i] >> (8 * b)) & 0xFF);
+			if ( !c ) { return s; }
+			s.push_back(c);
+		}
+	}
+	return s;
+}
+
+static bool isTypeOp(uint32_t op) {
+	return (op >= OpTypeVoid && op <= OpTypeForwardPointer) || op == OpTypeRayQueryKHR || op == OpTypeAccelerationStructureKHR;
+}
+
+static bool isRayTracingStorage(uint32_t sc) {
+	return sc == StorageClassRayPayloadKHR || sc == StorageClassIncomingRayPayloadKHR || sc == StorageClassHitAttributeKHR ||
+		   sc == StorageClassCallableDataKHR || sc == StorageClassIncomingCallableDataKHR;
+}
+
+// What a pointer of an input module's storage class becomes in the compute shader.
+static uint32_t convertStorageClass(uint32_t sc) {
+	if (isRayTracingStorage(sc) || sc == StorageClassInput) { return StorageClassPrivate; }
+	if (sc == StorageClassShaderRecordBufferKHR) { return StorageClassPhysicalStorageBuffer; }
+	return sc;
+}
+
+static uint32_t executionModelOf(mvk::RTStageKind kind) {
+	switch (kind) {
+		case mvk::RTStageKind::RayGeneration:	return ExecutionModelRayGenerationKHR;
+		case mvk::RTStageKind::Miss:			return ExecutionModelMissKHR;
+		case mvk::RTStageKind::ClosestHit:		return ExecutionModelClosestHitKHR;
+		case mvk::RTStageKind::AnyHit:			return ExecutionModelAnyHitKHR;
+		case mvk::RTStageKind::Intersection:	return ExecutionModelIntersectionKHR;
+		case mvk::RTStageKind::Callable:		return ExecutionModelCallableKHR;
+	}
+	return ExecutionModelMax;
+}
+
+
+#pragma mark Lowering
+
+/** A definition in the output module's types, constants and variables section. */
+struct GDef {
+	uint32_t op = 0;
+	Words w;		// the instruction's operands: for a type, the result id first; for a constant or variable, the type then the result id
+};
+
+/** One copy of a shader. */
+struct Instance {
+	uint32_t stage = 0;
+	uint32_t traceDepth = 0;
+	uint32_t callDepth = 0;
+	uint32_t entryFunction = 0;
+	std::map<uint32_t, uint32_t> builtinVars;	// SPIR-V built-in to the private variable standing in for it
+	uint32_t incomingPayloadVar = 0;
+	uint32_t hitAttributeVar = 0;
+	uint32_t incomingCallableVar = 0;
+	uint32_t shaderRecordVar = 0;				// holds a pointer to the shader record
+	uint32_t committedAttributeVar = 0;			// intersection shaders: the attributes of the hit that was accepted
+	uint32_t reportFunction = 0;				// intersection shaders: what OpReportIntersectionKHR calls
+};
+
+/** The state of the trace in progress at one depth. All private variables. */
+struct Level {
+	bool made = false;
+	uint32_t rayQuery = 0;
+	uint32_t origin = 0, direction = 0, tMin = 0, tMax = 0, flags = 0, cullMask = 0;
+	uint32_t handle = 0;			// the shader group handle of the hit group of the candidate being looked at
+	uint32_t recordAddress = 0;		// and the address of its shader record
+	uint32_t committedKind = 0;		// hit kind an intersection shader reported for the hit that was accepted
+	uint32_t ignore = 0;			// set by an any-hit shader: ignore this candidate
+	uint32_t terminate = 0;			// set by an any-hit shader: accept this candidate and stop
+	std::vector<std::pair<uint32_t, uint32_t>> sharedPayloads;	// pointer type to the incoming payload variable every shader at this depth uses
+};
+
+struct PendingTrace { uint32_t function; int caller; uint32_t payloadVar; bool hasInstanceTable; };
+struct PendingCall { uint32_t function; int caller; uint32_t dataVar; };
+
+class Lowering {
+
+public:
+	Lowering(const mvk::RTLoweringConfig& config, std::string& log) : cfg(config), log(log) {}
+
+	bool run(Words& out);
+
+	std::vector<std::pair<uint32_t, uint32_t>> instanceTableBindings;	// in the order their textures are bound
+
+protected:
+	friend struct Builder;
+
+	const mvk::RTLoweringConfig& cfg;
+	std::string& log;
+	bool failed = false;
+
+	uint32_t nextId = 1;
+	std::set<uint32_t> capabilities;
+	std::set<std::string> extensions;
+	std::map<std::string, uint32_t> extInstImports;
+	Words entryPoint, strings, debug, annotations, globals, functions;
+	std::vector<uint32_t> globalVars;
+
+	std::unordered_map<std::string, uint32_t> keys;			// structural key of a type, constant or descriptor variable to its id
+	std::unordered_map<uint32_t, GDef> gdef;
+	std::unordered_map<uint32_t, uint32_t> idType;			// result type of ids inside functions
+	std::map<uint32_t, std::pair<uint32_t, uint32_t>> varBinding;	// descriptor variables: set and binding
+	std::map<std::pair<uint32_t, uint32_t>, uint32_t> instanceTables;
+
+	std::vector<PModule> parsed;
+	std::vector<Instance> instances;
+	std::map<std::tuple<uint32_t, uint32_t, uint32_t>, int> instanceIndex;
+	std::vector<Level> levels;
+	std::vector<PendingTrace> pendingTraces;
+	std::vector<PendingCall> pendingCalls;
+	std::vector<int> pendingReports;
+	std::map<std::tuple<int, uint32_t, bool>, uint32_t> traceFunctions;
+	std::map<std::pair<int, uint32_t>, uint32_t> callFunctions;
+
+	uint32_t paramsVar = 0, launchIdVar = 0, launchSizeVar = 0;
+	uint32_t handleBlock = 0;		// what a shader group handle is read as: a block holding the group's index plus one
+
+	uint32_t newId() { return nextId++; }
+	bool fail(const std::string& msg) { log += "Ray tracing pipeline: " + msg + "\n"; failed = true; return false; }
+
+	// Types, constants and variables
+	static std::string makeKey(uint32_t op, const Words& operands, const std::string& extra);
+	uint32_t declare(uint32_t op, const Words& operands, uint32_t typeId = 0);
+	uint32_t tVoid() { return declare(OpTypeVoid, {}); }
+	uint32_t tBool() { return declare(OpTypeBool, {}); }
+	uint32_t tUInt() { return declare(OpTypeInt, { 32, 0 }); }
+	uint32_t tUInt64() { return declare(OpTypeInt, { 64, 0 }); }
+	uint32_t tFloat() { return declare(OpTypeFloat, { 32 }); }
+	uint32_t tVec(uint32_t elem, uint32_t n) { return declare(OpTypeVector, { elem, n }); }
+	uint32_t tPtr(uint32_t sc, uint32_t pointee) { return declare(OpTypePointer, { sc, pointee }); }
+	uint32_t tRayQuery() { return declare(OpTypeRayQueryKHR, {}); }
+	uint32_t tAccel() { return declare(OpTypeAccelerationStructureKHR, {}); }
+	uint32_t tInstanceTable() { return declare(OpTypeImage, { tUInt(), Dim2D, 0, 0, 0, 1, ImageFormatUnknown }); }
+	uint32_t tFunction(uint32_t ret, const Words& params) { Words o = { ret }; o.insert(o.end(), params.begin(), params.end()); return declare(OpTypeFunction, o); }
+	uint32_t cUInt(uint32_t v) { return declare(OpConstant, { v }, tUInt()); }
+	uint32_t cUInt64(uint64_t v) { return declare(OpConstant, { (uint32_t)v, (uint32_t)(v >> 32) }, tUInt64()); }
+	uint32_t cBool(bool v) { return declare(v ? OpConstantTrue : OpConstantFalse, {}, tBool()); }
+	uint32_t privateVar(uint32_t pointeeType, const std::string& name);
+	uint32_t pointee(uint32_t varId);
+	bool logicallyMatch(uint32_t typeA, uint32_t typeB);
+	void name(uint32_t id, const std::string& n) { Words o = { id }; appendString(o, n); emit(debug, OpName, o); }
+	void decorate(uint32_t id, uint32_t decoration, const Words& operands = {}) {
+		Words o = { id, decoration }; o.insert(o.end(), operands.begin(), operands.end()); emit(annotations, OpDecorate, o);
+	}
+
+	Level& level(uint32_t depth);
+	bool parseStage(uint32_t stageIdx);
+	int getInstance(uint32_t stageIdx, uint32_t traceDepth, uint32_t callDepth);
+	int importInstance(uint32_t stageIdx, uint32_t traceDepth, uint32_t callDepth);
+	uint32_t instanceTableVar(uint32_t set, uint32_t binding, uint32_t arrayType);
+	bool hasStageKind(mvk::RTStageKind kind);
+
+	void makeParams();
+	void generateTrace(const PendingTrace& t);
+	void generateCall(const PendingCall& c);
+	void generateReport(int instIdx);
+	void generateMain();
+};
+
+std::string Lowering::makeKey(uint32_t op, const Words& operands, const std::string& extra) {
+	std::string k((const char*)&op, sizeof(op));
+	if ( !operands.empty() ) { k.append((const char*)operands.data(), operands.size() * sizeof(uint32_t)); }
+	k.push_back('|');
+	k.append(extra);
+	return k;
+}
+
+// Returns the id of a type or constant, making it if the module does not have it yet.
+uint32_t Lowering::declare(uint32_t op, const Words& operands, uint32_t typeId) {
+	Words keyOps;
+	if (typeId) { keyOps.push_back(typeId); }
+	keyOps.insert(keyOps.end(), operands.begin(), operands.end());
+	std::string key = makeKey(op, keyOps, "");
+	auto it = keys.find(key);
+	if (it != keys.end()) { return it->second; }
+
+	uint32_t id = newId();
+	Words w;
+	if (typeId) { w.push_back(typeId); }
+	w.push_back(id);
+	w.insert(w.end(), operands.begin(), operands.end());
+	emit(globals, op, w);
+	gdef[id] = { op, w };
+	keys[key] = id;
+	return id;
+}
+
+uint32_t Lowering::privateVar(uint32_t pointeeType, const std::string& n) {
+	uint32_t id = newId();
+	Words w = { tPtr(StorageClassPrivate, pointeeType), id, StorageClassPrivate };
+	emit(globals, OpVariable, w);
+	gdef[id] = { OpVariable, w };
+	globalVars.push_back(id);
+	name(id, n);
+	return id;
+}
+
+// The type a variable holds.
+uint32_t Lowering::pointee(uint32_t varId) {
+	auto v = gdef.find(varId);
+	if (v == gdef.end() || v->second.op != OpVariable) { return 0; }
+	auto p = gdef.find(v->second.w[0]);
+	if (p == gdef.end() || p->second.op != OpTypePointer) { return 0; }
+	return p->second.w[2];
+}
+
+// Whether a value of one type can be copied into the other with OpCopyLogical.
+bool Lowering::logicallyMatch(uint32_t a, uint32_t b) {
+	if (a == b) { return true; }
+	auto da = gdef.find(a), db = gdef.find(b);
+	if (da == gdef.end() || db == gdef.end() || da->second.op != db->second.op) { return false; }
+	const Words& wa = da->second.w;
+	const Words& wb = db->second.w;
+	if (da->second.op == OpTypeStruct) {
+		if (wa.size() != wb.size()) { return false; }
+		for (size_t i = 1; i < wa.size(); i++) { if ( !logicallyMatch(wa[i], wb[i]) ) { return false; } }
+		return true;
+	}
+	if (da->second.op == OpTypeArray) { return wa[2] == wb[2] && logicallyMatch(wa[1], wb[1]); }
+	return false;
+}
+
+Level& Lowering::level(uint32_t depth) {
+	if (levels.size() <= depth) { levels.resize(depth + 1); }
+	Level& lv = levels[depth];
+	if ( !lv.made ) {
+		std::string sfx = "_d" + std::to_string(depth);
+		uint32_t f = tFloat(), u = tUInt(), v3 = tVec(tFloat(), 3), b = tBool();
+		lv.made = true;
+		lv.rayQuery = privateVar(tRayQuery(), "fwRayQuery" + sfx);
+		lv.origin = privateVar(v3, "fwOrigin" + sfx);
+		lv.direction = privateVar(v3, "fwDirection" + sfx);
+		lv.tMin = privateVar(f, "fwTMin" + sfx);
+		lv.tMax = privateVar(f, "fwTMax" + sfx);
+		lv.flags = privateVar(u, "fwRayFlags" + sfx);
+		lv.cullMask = privateVar(u, "fwCullMask" + sfx);
+		lv.handle = privateVar(u, "fwHitGroup" + sfx);
+		lv.recordAddress = privateVar(tUInt64(), "fwRecordAddress" + sfx);
+		lv.committedKind = privateVar(u, "fwCommittedHitKind" + sfx);
+		lv.ignore = privateVar(b, "fwIgnoreHit" + sfx);
+		lv.terminate = privateVar(b, "fwTerminateRay" + sfx);
+	}
+	return levels[depth];
+}
+
+bool Lowering::hasStageKind(mvk::RTStageKind kind) {
+	for (auto& s : cfg.stages) { if (s.kind == kind) { return true; } }
+	return false;
+}
+
+// Parses one stage's module, and gives its specialization constants their final values: every
+// stage has its own, and the compute shader they all end up in could only take one set.
+bool Lowering::parseStage(uint32_t stageIdx) {
+	const mvk::RTStage& st = cfg.stages[stageIdx];
+	PModule& pm = parsed[stageIdx];
+	if ( !pm.insts.empty() ) { return true; }
+
+	spv_context ctx = spvContextCreate(SPV_ENV_UNIVERSAL_1_6);
+	spv_diagnostic diag = nullptr;
+	spv_result_t r = spvBinaryParse(ctx, &pm, st.spirv.data(), st.spirv.size(), onParsedHeader, onParsedInstruction, &diag);
+	std::string err = (diag && diag->error) ? diag->error : "";
+	if (diag) { spvDiagnosticDestroy(diag); }
+	spvContextDestroy(ctx);
+	if (r != SPV_SUCCESS) { return fail("stage " + std::to_string(stageIdx) + " is not valid SPIR-V: " + err); }
+
+	std::unordered_map<uint32_t, uint32_t> specIds;
+	pm.firstFunction = pm.insts.size();
+	for (size_t i = 0; i < pm.insts.size(); i++) {
+		PInst& pi = pm.insts[i];
+		if (pi.op == OpFunction) { pm.firstFunction = i; break; }
+		if (pi.op == OpDecorate && pi.w.size() >= 4 && pi.w[2] == DecorationSpecId) { specIds[pi.w[1]] = pi.w[3]; }
+	}
+	auto findSpec = [&](uint32_t resultId) -> const mvk::RTSpecializationEntry* {
+		auto it = specIds.find(resultId);
+		if (it == specIds.end()) { return nullptr; }
+		for (auto& e : st.specialization) { if (e.constantID == it->second) { return &e; } }
+		return nullptr;
+	};
+	for (size_t i = 0; i < pm.firstFunction; i++) {
+		PInst& pi = pm.insts[i];
+		switch (pi.op) {
+			case OpSpecConstantTrue:
+			case OpSpecConstantFalse: {
+				bool v = pi.op == OpSpecConstantTrue;
+				if (auto* e = findSpec(pi.resultId)) {
+					uint32_t b = 0;
+					memcpy(&b, e->data.data(), std::min<size_t>(e->data.size(), 4));
+					v = b != 0;
+				}
+				pi.op = v ? OpConstantTrue : OpConstantFalse;
+				break;
+			}
+			case OpSpecConstant:
+				if (auto* e = findSpec(pi.resultId)) {
+					size_t bytes = (pi.w.size() - 3) * sizeof(uint32_t);
+					memcpy(&pi.w[3], e->data.data(), std::min(bytes, e->data.size()));
+				}
+				pi.op = OpConstant;
+				break;
+			case OpSpecConstantComposite:
+				pi.op = OpConstantComposite;
+				break;
+			default:
+				break;
+		}
+	}
+	return true;
+}
+
+int Lowering::getInstance(uint32_t stageIdx, uint32_t traceDepth, uint32_t callDepth) {
+	auto key = std::make_tuple(stageIdx, traceDepth, callDepth);
+	auto it = instanceIndex.find(key);
+	if (it != instanceIndex.end()) { return it->second; }
+	int idx = importInstance(stageIdx, traceDepth, callDepth);
+	instanceIndex[key] = idx;
+	return idx;
+}
+
+// The texture that holds the shader binding table offsets of an acceleration structure's instances.
+uint32_t Lowering::instanceTableVar(uint32_t set, uint32_t binding, uint32_t arrayType) {
+	auto key = std::make_pair(set, binding);
+	auto it = instanceTables.find(key);
+	if (it != instanceTables.end()) { return it->second; }
+
+	// Arrays of acceleration structures get no table: their instances' offsets read as zero.
+	if (arrayType) { return 0; }
+	uint32_t type = tInstanceTable();
+	uint32_t id = newId();
+	Words w = { tPtr(StorageClassUniformConstant, type), id, StorageClassUniformConstant };
+	emit(globals, OpVariable, w);
+	gdef[id] = { OpVariable, w };
+	globalVars.push_back(id);
+	instanceTableBindings.push_back(key);
+	decorate(id, DecorationDescriptorSet, { cfg.paramsDescSet });
+	decorate(id, DecorationBinding, { cfg.paramsBinding + (uint32_t)instanceTableBindings.size() });
+	name(id, "fwInstanceTable_" + std::to_string(set) + "_" + std::to_string(binding));
+	instanceTables[key] = id;
+	return id;
+}
+
+
+#pragma mark Importing a shader
+
+int Lowering::importInstance(uint32_t stageIdx, uint32_t traceDepth, uint32_t callDepth) {
+	int index = (int)instances.size();
+	instances.push_back(Instance());
+	instances[index].stage = stageIdx;
+	instances[index].traceDepth = traceDepth;
+	instances[index].callDepth = callDepth;
+	if ( !parseStage(stageIdx) ) { return index; }
+
+	const mvk::RTStage& st = cfg.stages[stageIdx];
+	const PModule& pm = parsed[stageIdx];
+	std::vector<uint32_t> map(pm.bound + 1, 0);
+	std::vector<uint8_t> merged(pm.bound + 1, 0);
+	auto M = [&](uint32_t local) -> uint32_t {
+		if (local > pm.bound) { return 0; }
+		if ( !map[local] ) { map[local] = newId(); }
+		return map[local];
+	};
+	auto remap = [&](const PInst& pi) -> Words {		// operands only, ids renumbered
+		Words o(pi.w.begin() + 1, pi.w.end());
+		for (uint16_t off : pi.ids) { o[off - 1] = M(pi.w[off]); }
+		return o;
+	};
+
+	// What decorates what, before anything is emitted: decorations are part of what makes two types the same.
+	std::unordered_map<uint32_t, std::string> decorationKey;
+	std::unordered_map<uint32_t, uint32_t> builtinOf, setOf, bindingOf;
+	std::set<uint32_t> nonSemanticSets;
+	uint32_t entryLocal = 0;
+	uint32_t wantedModel = executionModelOf(st.kind);
+	for (size_t i = 0; i < pm.firstFunction; i++) {
+		const PInst& pi = pm.insts[i];
+		switch (pi.op) {
+			case OpCapability:
+				if (pi.w[1] != CapabilityRayTracingKHR) { capabilities.insert(pi.w[1]); }
+				break;
+			case OpExtension: {
+				std::string ext = readString(pi.w, 1);
+				if (ext != "SPV_KHR_ray_tracing") { extensions.insert(ext); }
+				break;
+			}
+			case OpExtInstImport: {
+				std::string set = readString(pi.w, 2);
+				if (set.compare(0, 11, "NonSemantic") == 0) {
+					nonSemanticSets.insert(pi.w[1]);
+				} else {
+					auto it = extInstImports.find(set);
+					if (it == extInstImports.end()) { it = extInstImports.emplace(set, newId()).first; }
+					map[pi.w[1]] = it->second;
+					merged[pi.w[1]] = 1;
+				}
+				break;
+			}
+			case OpEntryPoint:
+				if (pi.w[1] == wantedModel && readString(pi.w, 3) == st.entryName) { entryLocal = pi.w[2]; }
+				break;
+			case OpDecorate:
+				if (pi.w.size() >= 4 && pi.w[2] == DecorationBuiltIn) { builtinOf[pi.w[1]] = pi.w[3]; }
+				if (pi.w.size() >= 4 && pi.w[2] == DecorationDescriptorSet) { setOf[pi.w[1]] = pi.w[3]; }
+				if (pi.w.size() >= 4 && pi.w[2] == DecorationBinding) { bindingOf[pi.w[1]] = pi.w[3]; }
+				// fall through
+			case OpMemberDecorate:
+			case OpDecorateId:
+			case OpDecorateString:
+			case OpMemberDecorateString: {
+				std::string& k = decorationKey[pi.w[1]];
+				k.append((const char*)&pi.op, sizeof(pi.op));
+				k.append((const char*)&pi.w[2], (pi.w.size() - 2) * sizeof(uint32_t));
+				break;
+			}
+			default:
+				break;
+		}
+	}
+	if ( !entryLocal ) {
+		fail("stage " + std::to_string(stageIdx) + " has no entry point named \"" + st.entryName + "\" of the stage it was given as");
+		return index;
+	}
+
+	// Types, constants and variables.
+	for (size_t i = 0; i < pm.firstFunction; i++) {
+		const PInst& pi = pm.insts[i];
+		uint32_t lr = pi.resultId;
+		if (pi.op == OpTypeForwardPointer) {
+			emit(globals, OpTypeForwardPointer, { M(pi.w[1]), convertStorageClass(pi.w[2]) });
+			continue;
+		}
+		if (isTypeOp(pi.op)) {
+			// A pointer type that was forward declared already has its id, and stays as it is.
+			bool forwardDeclared = map[lr] != 0 && pi.op == OpTypePointer;
+			Words o = remap(pi);		// result id first
+			if (pi.op == OpTypePointer) { o[1] = convertStorageClass(o[1]); }
+			Words keyOps(o.begin() + 1, o.end());
+			std::string key = makeKey(pi.op, keyOps, decorationKey.count(lr) ? decorationKey[lr] : "");
+			auto it = keys.find(key);
+			if (it != keys.end() && !forwardDeclared) {
+				map[lr] = it->second;
+				merged[lr] = 1;
+				continue;
+			}
+			o[0] = M(lr);
+			emit(globals, pi.op, o);
+			gdef[o[0]] = { pi.op, o };
+			if ( !forwardDeclared ) { keys[key] = o[0]; }
+			continue;
+		}
+		if (pi.op >= OpConstantTrue && pi.op <= OpConstantNull) {
+			Words o = remap(pi);		// type, result id, value
+			Words keyOps = { o[0] };
+			keyOps.insert(keyOps.end(), o.begin() + 2, o.end());
+			std::string key = makeKey(pi.op, keyOps, "");
+			auto it = keys.find(key);
+			if (it != keys.end()) {
+				map[lr] = it->second;
+				merged[lr] = 1;
+				continue;
+			}
+			emit(globals, pi.op, o);
+			gdef[o[1]] = { pi.op, o };
+			keys[key] = o[1];
+			continue;
+		}
+		if (pi.op == OpSpecConstantOp || pi.op == OpUndef) {
+			Words o = remap(pi);
+			emit(globals, pi.op, o);
+			gdef[o[1]] = { pi.op, o };
+			continue;
+		}
+		if (pi.op != OpVariable) { continue; }
+
+		uint32_t sc = pi.w[3];
+		uint32_t type = M(pi.w[1]);		// already declared, with its storage class converted
+		uint32_t init = pi.w.size() > 4 ? M(pi.w[4]) : 0;
+		uint32_t newSC = convertStorageClass(sc);
+		Instance& inst = instances[index];
+		std::string key;
+
+		if (sc == StorageClassIncomingRayPayloadKHR) {
+			// Every shader that runs at this depth works on the same payload variable, so that
+			// what an any-hit shader writes is what the closest-hit shader reads.
+			Level& lv = level(traceDepth);
+			bool found = false;
+			for (auto& sp : lv.sharedPayloads) {
+				if (sp.first == type) { map[lr] = sp.second; merged[lr] = 1; inst.incomingPayloadVar = sp.second; found = true; break; }
+			}
+			if (found) { continue; }
+		} else if (sc == StorageClassShaderRecordBufferKHR) {
+			// The record is somewhere in the shader binding table. The variable becomes one
+			// that holds a pointer to it, set before the shader is called.
+			type = tPtr(StorageClassPrivate, type);
+			newSC = StorageClassPrivate;
+		} else if (setOf.count(lr) && bindingOf.count(lr)) {
+			key = "V" + std::to_string(setOf[lr]) + "," + std::to_string(bindingOf[lr]) + "," + std::to_string(type) + "," + std::to_string(sc);
+		} else if (sc == StorageClassPushConstant) {
+			key = "P" + std::to_string(type);
+		}
+		if ( !key.empty() ) {
+			auto it = keys.find(key);
+			if (it != keys.end()) {
+				map[lr] = it->second;
+				merged[lr] = 1;
+				continue;
+			}
+		}
+
+		uint32_t id = M(lr);
+		Words w = { type, id, newSC };
+		if (init) { w.push_back(init); }
+		emit(globals, OpVariable, w);
+		gdef[id] = { OpVariable, w };
+		globalVars.push_back(id);
+		if ( !key.empty() ) { keys[key] = id; }
+		if (setOf.count(lr) && bindingOf.count(lr)) { varBinding[id] = { setOf[lr], bindingOf[lr] }; }
+
+		switch (sc) {
+			case StorageClassInput:					if (builtinOf.count(lr)) { inst.builtinVars[builtinOf[lr]] = id; } break;
+			case StorageClassIncomingRayPayloadKHR:	inst.incomingPayloadVar = id; level(traceDepth).sharedPayloads.push_back({ type, id }); break;
+			case StorageClassHitAttributeKHR:		inst.hitAttributeVar = id; break;
+			case StorageClassIncomingCallableDataKHR: inst.incomingCallableVar = id; break;
+			case StorageClassShaderRecordBufferKHR:	inst.shaderRecordVar = id; break;
+			default: break;
+		}
+	}
+
+	// Names and decorations, for what was not merged into something already there.
+	for (size_t i = 0; i < pm.firstFunction; i++) {
+		const PInst& pi = pm.insts[i];
+		switch (pi.op) {
+			case OpString:
+				emit(strings, pi.op, remap(pi));
+				break;
+			case OpName:
+			case OpMemberName:
+				if ( !merged[pi.w[1]] ) { emit(debug, pi.op, remap(pi)); }
+				break;
+			case OpDecorate:
+				if (pi.w[2] == DecorationBuiltIn || pi.w[2] == DecorationSpecId) { break; }
+				// fall through
+			case OpMemberDecorate:
+			case OpDecorateId:
+			case OpDecorateString:
+			case OpMemberDecorateString:
+				if ( !merged[pi.w[1]] ) { emit(annotations, pi.op, remap(pi)); }
+				break;
+			default:
+				break;
+		}
+	}
+
+	// Functions.
+	uint32_t uintType = tUInt();
+	uint32_t voidType = tVoid();
+	uint32_t returnType = 0;
+	std::unordered_map<uint32_t, uint32_t> loadedFrom;							// value to the pointer it was loaded from
+	std::unordered_map<uint32_t, std::pair<uint32_t, Words>> chains;			// access chain to its base and indices
+	auto emitResult = [&](uint32_t op, uint32_t type, const Words& operands) -> uint32_t {
+		uint32_t id = newId();
+		Words o = { type, id };
+		o.insert(o.end(), operands.begin(), operands.end());
+		emit(functions, op, o);
+		idType[id] = type;
+		return id;
+	};
+	auto asUInt = [&](uint32_t id) -> uint32_t {
+		auto it = idType.find(id);
+		bool isConst = gdef.count(id) != 0;
+		uint32_t type = isConst ? gdef[id].w[0] : (it != idType.end() ? it->second : uintType);
+		return type == uintType ? id : emitResult(OpBitcast, uintType, { id });
+	};
+	auto isPhysicalPointer = [&](uint32_t valueId) -> bool {
+		auto it = idType.find(valueId);
+		if (it == idType.end()) { return false; }
+		auto d = gdef.find(it->second);
+		return d != gdef.end() && d->second.op == OpTypePointer && d->second.w[1] == StorageClassPhysicalStorageBuffer;
+	};
+	// The instance table that goes with an acceleration structure value. The value was loaded
+	// from a descriptor; the table is a texture bound for that descriptor's set and binding.
+	auto loadInstanceTable = [&](uint32_t accel) -> uint32_t {
+		auto ld = loadedFrom.find(accel);
+		if (ld == loadedFrom.end()) { return 0; }
+		uint32_t ptr = ld->second;
+		uint32_t base = ptr;
+		Words indices;
+		auto ch = chains.find(ptr);
+		if (ch != chains.end()) { base = ch->second.first; indices = ch->second.second; }
+		auto vb = varBinding.find(base);
+		if (vb == varBinding.end()) { return 0; }
+		uint32_t held = pointee(base);
+		uint32_t heldOp = gdef.count(held) ? gdef[held].op : 0;
+		uint32_t table = tInstanceTable();
+		if (indices.empty() && heldOp == OpTypeAccelerationStructureKHR) {
+			return emitResult(OpLoad, table, { instanceTableVar(vb->second.first, vb->second.second, 0) });
+		}
+		return 0;
+	};
+
+	for (size_t i = pm.firstFunction; i < pm.insts.size(); i++) {
+		const PInst& pi = pm.insts[i];
+		Instance& inst = instances[index];
+		switch (pi.op) {
+			case OpLine:
+			case OpNoLine:
+				continue;
+
+			case OpExtInst:
+				if (nonSemanticSets.count(pi.w[3])) { continue; }
+				break;
+
+			case OpFunction:
+				returnType = M(pi.w[1]);
+				break;
+
+			case OpTraceRayKHR: {
+				if (traceDepth >= cfg.maxRecursionDepth) { continue; }		// deeper than the pipeline said it would go
+				uint32_t accel = M(pi.w[1]);
+				uint32_t table = loadInstanceTable(accel);
+				uint32_t payload = M(pi.w[11]);
+				auto key = std::make_tuple(index, payload, table != 0);
+				auto it = traceFunctions.find(key);
+				if (it == traceFunctions.end()) {
+					it = traceFunctions.emplace(key, newId()).first;
+					pendingTraces.push_back({ it->second, index, payload, table != 0 });
+				}
+				Words args = { it->second, accel };
+				if (table) { args.push_back(table); }
+				for (int a = 2; a <= 6; a++) { args.push_back(asUInt(M(pi.w[a]))); }		// flags, cull mask, offset, stride, miss index
+				for (int a = 7; a <= 10; a++) { args.push_back(M(pi.w[a])); }				// origin, tmin, direction, tmax
+				emitResult(OpFunctionCall, voidType, args);
+				continue;
+			}
+
+			case OpExecuteCallableKHR: {
+				if (callDepth >= cfg.maxCallableDepth || !hasStageKind(mvk::RTStageKind::Callable)) { continue; }
+				uint32_t data = M(pi.w[2]);
+				auto key = std::make_pair(index, data);
+				auto it = callFunctions.find(key);
+				if (it == callFunctions.end()) {
+					it = callFunctions.emplace(key, newId()).first;
+					pendingCalls.push_back({ it->second, index, data });
+				}
+				uint32_t sbtIndex = asUInt(M(pi.w[1]));
+				emitResult(OpFunctionCall, voidType, { it->second, sbtIndex });
+				continue;
+			}
+
+			case OpReportIntersectionKHR: {
+				if ( !inst.reportFunction ) {
+					instances[index].reportFunction = newId();
+					pendingReports.push_back(index);
+				}
+				uint32_t hitT = M(pi.w[3]);
+				uint32_t hitKind = asUInt(M(pi.w[4]));
+				Words o = { M(pi.w[1]), M(pi.w[2]), instances[index].reportFunction, hitT, hitKind };
+				emit(functions, OpFunctionCall, o);
+				idType[o[1]] = o[0];
+				continue;
+			}
+
+			case OpIgnoreIntersectionKHR:
+			case OpTerminateRayKHR: {
+				// Both end the any-hit shader. The trace loop that called it reads the flag.
+				Level& lv = level(traceDepth);
+				emit(functions, OpStore, { pi.op == OpIgnoreIntersectionKHR ? lv.ignore : lv.terminate, cBool(true) });
+				if (returnType == voidType) {
+					emit(functions, OpReturn, {});
+				} else {
+					emit(functions, OpReturnValue, { emitResult(OpUndef, returnType, {}) });
+				}
+				continue;
+			}
+
+			default:
+				break;
+		}
+
+		Words o = remap(pi);
+		if (inst.shaderRecordVar) {
+			// The variable now holds a pointer to the record, so every use loads that pointer first.
+			for (uint16_t off : pi.ids) {
+				if (pi.w[off] == pi.resultId || pi.w[off] == pi.typeId || o[off - 1] != inst.shaderRecordVar) { continue; }
+				o[off - 1] = emitResult(OpLoad, pointee(inst.shaderRecordVar), { inst.shaderRecordVar });
+			}
+		}
+		if (pi.typeId && pi.resultId) { idType[o[1]] = o[0]; }
+		if (pi.op == OpLoad) {
+			loadedFrom[o[1]] = o[2];
+			if (o.size() == 3 && isPhysicalPointer(o[2])) { o.push_back(MemoryAccessAlignedMask); o.push_back(4); }
+		} else if (pi.op == OpStore) {
+			if (o.size() == 2 && isPhysicalPointer(o[0])) { o.push_back(MemoryAccessAlignedMask); o.push_back(4); }
+		} else if (pi.op == OpAccessChain || pi.op == OpInBoundsAccessChain) {
+			chains[o[1]] = { o[2], Words(o.begin() + 3, o.end()) };
+		}
+		emit(functions, pi.op, o);
+	}
+
+	instances[index].entryFunction = M(entryLocal);
+	return index;
+}
+
+
+#pragma mark Generating functions
+
+/** Writes one function, with structured control flow. */
+struct Builder {
+	Lowering& l;
+	Words out;
+	bool terminated = false;	// the current block already ended in a return
+	uint32_t voidType, boolType, uintType, floatType;
+
+	Builder(Lowering& lowering) : l(lowering) {
+		voidType = l.tVoid(); boolType = l.tBool(); uintType = l.tUInt(); floatType = l.tFloat();
+	}
+
+	uint32_t r(uint32_t op, uint32_t type, const Words& operands) {
+		uint32_t id = l.newId();
+		Words o = { type, id };
+		o.insert(o.end(), operands.begin(), operands.end());
+		emit(out, op, o);
+		l.idType[id] = type;
+		return id;
+	}
+	void v(uint32_t op, const Words& operands) { emit(out, op, operands); }
+	void label(uint32_t id) { emit(out, OpLabel, { id }); terminated = false; }
+	uint32_t load(uint32_t var) { return r(OpLoad, l.pointee(var), { var }); }
+	void store(uint32_t var, uint32_t value) { v(OpStore, { var, value }); }
+
+	// Returns the ids of the parameters.
+	Words begin(uint32_t function, uint32_t returnType, const Words& paramTypes, const std::string& name) {
+		emit(out, OpFunction, { returnType, function, FunctionControlMaskNone, l.tFunction(returnType, paramTypes) });
+		Words params;
+		for (uint32_t t : paramTypes) {
+			uint32_t p = l.newId();
+			emit(out, OpFunctionParameter, { t, p });
+			l.idType[p] = t;
+			params.push_back(p);
+		}
+		label(l.newId());
+		l.name(function, name);
+		return params;
+	}
+	void ret() { if ( !terminated ) { v(OpReturn, {}); terminated = true; } }
+	void retValue(uint32_t value) { if ( !terminated ) { v(OpReturnValue, { value }); terminated = true; } }
+	void end() { ret(); emit(out, OpFunctionEnd, {}); l.functions.insert(l.functions.end(), out.begin(), out.end()); }
+
+	struct If { uint32_t elseLabel, merge; bool hasElse; };
+	If beginIf(uint32_t cond, bool withElse = false) {
+		uint32_t thenLabel = l.newId(), merge = l.newId(), elseLabel = withElse ? l.newId() : merge;
+		v(OpSelectionMerge, { merge, SelectionControlMaskNone });
+		v(OpBranchConditional, { cond, thenLabel, elseLabel });
+		label(thenLabel);
+		return { elseLabel, merge, withElse };
+	}
+	void beginElse(If& c) {
+		if ( !terminated ) { v(OpBranch, { c.merge }); }
+		label(c.elseLabel);
+	}
+	void endIf(If& c) {
+		if ( !terminated ) { v(OpBranch, { c.merge }); }
+		label(c.merge);
+	}
+
+	struct Loop { uint32_t header, body, cont, merge; };
+	Loop beginLoop() {
+		Loop c = { l.newId(), l.newId(), l.newId(), l.newId() };
+		uint32_t test = l.newId();
+		v(OpBranch, { c.header });
+		label(c.header);
+		v(OpLoopMerge, { c.merge, c.cont, LoopControlMaskNone });
+		v(OpBranch, { test });
+		label(test);
+		return c;
+	}
+	void loopWhile(Loop& c, uint32_t cond) {
+		v(OpBranchConditional, { cond, c.body, c.merge });
+		label(c.body);
+	}
+	void endLoop(Loop& c) {
+		if ( !terminated ) { v(OpBranch, { c.cont }); }
+		label(c.cont);
+		v(OpBranch, { c.header });
+		label(c.merge);
+	}
+
+	struct Switch { uint32_t merge; Words labels; };
+	Switch beginSwitch(uint32_t selector, const Words& literals) {
+		Switch c;
+		c.merge = l.newId();
+		Words o = { selector, c.merge };
+		for (uint32_t lit : literals) {
+			uint32_t lab = l.newId();
+			c.labels.push_back(lab);
+			o.push_back(lit);
+			o.push_back(lab);
+		}
+		v(OpSelectionMerge, { c.merge, SelectionControlMaskNone });
+		v(OpSwitch, o);
+		terminated = true;
+		return c;
+	}
+	void beginCase(Switch& c, size_t i) { label(c.labels[i]); }
+	void endCase(Switch& c) { if ( !terminated ) { v(OpBranch, { c.merge }); terminated = true; } }
+	void endSwitch(Switch& c) { label(c.merge); }
+
+	// Copies what one variable holds into another, if their types allow it.
+	void copyVar(uint32_t dstVar, uint32_t srcVar) {
+		if ( !dstVar || !srcVar || dstVar == srcVar ) { return; }
+		uint32_t dt = l.pointee(dstVar), st = l.pointee(srcVar);
+		if (dt == st) {
+			store(dstVar, load(srcVar));
+		} else if (l.logicallyMatch(dt, st)) {
+			store(dstVar, r(OpCopyLogical, dt, { load(srcVar) }));
+		}
+	}
+
+	// Stores a value into a variable whose type may be the signed or unsigned twin of the value's.
+	void storeAs(uint32_t var, uint32_t value, uint32_t valueType) {
+		uint32_t pt = l.pointee(var);
+		if (pt != valueType) { value = r(OpBitcast, pt, { value }); }
+		store(var, value);
+	}
+
+	uint32_t param64(uint32_t index) {
+		uint32_t u64 = l.tUInt64();
+		uint32_t ptr = r(OpAccessChain, l.tPtr(StorageClassUniform, u64), { l.paramsVar, l.cUInt(index) });
+		return r(OpLoad, u64, { ptr });
+	}
+
+	// Reads the shader group handle of entry `index` of a shader binding table.
+	// Returns the handle, which is the group's index plus one, and sets recordAddress.
+	uint32_t readHandle(uint32_t base, uint32_t stride, uint32_t index, uint32_t& recordAddress) {
+		uint32_t u64 = l.tUInt64();
+		uint32_t address = base;
+		if (stride && index) {
+			uint32_t wide = r(OpUConvert, u64, { index });
+			address = r(OpIAdd, u64, { base, r(OpIMul, u64, { stride, wide }) });
+		}
+		recordAddress = address;
+		uint32_t ptr = r(OpConvertUToPtr, l.tPtr(StorageClassPhysicalStorageBuffer, l.handleBlock), { address });
+		uint32_t member = r(OpAccessChain, l.tPtr(StorageClassPhysicalStorageBuffer, uintType), { ptr, l.cUInt(0) });
+		return r(OpLoad, uintType, { member, MemoryAccessAlignedMask, 4 });
+	}
+
+	// Points a shader at its shader record, then calls it.
+	void invoke(const Instance& inst, uint32_t recordAddress) {
+		if (inst.shaderRecordVar && recordAddress) {
+			uint32_t dataAddress = r(OpIAdd, l.tUInt64(), { recordAddress, l.cUInt64(l.cfg.handleSize) });
+			store(inst.shaderRecordVar, r(OpConvertUToPtr, l.pointee(inst.shaderRecordVar), { dataAddress }));
+		}
+		if (inst.entryFunction) { r(OpFunctionCall, voidType, { inst.entryFunction }); }
+	}
+
+	enum Hit { NoHit, Candidate, Committed };
+
+	// Gives a shader's built-in variables their values for the call that follows.
+	void setBuiltins(const Instance& inst, uint32_t depth, Hit hit, uint32_t tValue, uint32_t hitKind) {
+		uint32_t v3 = l.tVec(floatType, 3), u3 = l.tVec(uintType, 3);
+		uint32_t which = l.cUInt(hit == Committed ? 1 : 0);
+		for (auto& bv : inst.builtinVars) {
+			uint32_t var = bv.second;
+			uint32_t pt = l.pointee(var);
+			switch (bv.first) {
+				case BuiltInLaunchIdKHR:		storeAs(var, load(l.launchIdVar), u3); break;
+				case BuiltInLaunchSizeKHR:		storeAs(var, load(l.launchSizeVar), u3); break;
+				default: break;
+			}
+			if (depth == 0 || !l.levels[depth].made) { continue; }
+			const Level& lv = l.levels[depth];
+			switch (bv.first) {
+				case BuiltInWorldRayOriginKHR:		storeAs(var, load(lv.origin), v3); break;
+				case BuiltInWorldRayDirectionKHR:	storeAs(var, load(lv.direction), v3); break;
+				case BuiltInRayTminKHR:				storeAs(var, load(lv.tMin), floatType); break;
+				case BuiltInIncomingRayFlagsKHR:	storeAs(var, load(lv.flags), uintType); break;
+				case BuiltInCullMaskKHR:			storeAs(var, load(lv.cullMask), uintType); break;
+				case BuiltInRayTmaxKHR:				if (tValue) { storeAs(var, tValue, floatType); } break;
+				case BuiltInHitKindKHR:				if (hitKind) { storeAs(var, hitKind, uintType); } break;
+				default: break;
+			}
+			if (hit == NoHit) { continue; }
+			uint32_t getter = 0;
+			switch (bv.first) {
+				case BuiltInObjectRayOriginKHR:		getter = OpRayQueryGetIntersectionObjectRayOriginKHR; break;
+				case BuiltInObjectRayDirectionKHR:	getter = OpRayQueryGetIntersectionObjectRayDirectionKHR; break;
+				case BuiltInObjectToWorldKHR:		getter = OpRayQueryGetIntersectionObjectToWorldKHR; break;
+				case BuiltInWorldToObjectKHR:		getter = OpRayQueryGetIntersectionWorldToObjectKHR; break;
+				case BuiltInInstanceCustomIndexKHR:	getter = OpRayQueryGetIntersectionInstanceCustomIndexKHR; break;
+				case BuiltInInstanceId:				getter = OpRayQueryGetIntersectionInstanceIdKHR; break;
+				case BuiltInPrimitiveId:			getter = OpRayQueryGetIntersectionPrimitiveIndexKHR; break;
+				case BuiltInRayGeometryIndexKHR:	getter = OpRayQueryGetIntersectionGeometryIndexKHR; break;
+				default: break;
+			}
+			if (getter) { store(var, r(getter, pt, { lv.rayQuery, which })); }
+		}
+	}
+
+	// A triangle hit's attributes are its barycentric coordinates.
+	void setTriangleAttributes(const Instance& inst, const Level& lv, Hit hit) {
+		if ( !inst.hitAttributeVar ) { return; }
+		uint32_t v2 = l.tVec(floatType, 2);
+		uint32_t pt = l.pointee(inst.hitAttributeVar);
+		auto d = l.gdef.find(pt);
+		bool isStructOfVec2 = d != l.gdef.end() && d->second.op == OpTypeStruct && d->second.w.size() >= 2 && d->second.w[1] == v2;
+		if (pt != v2 && !isStructOfVec2) { return; }
+		uint32_t bary = r(OpRayQueryGetIntersectionBarycentricsKHR, v2, { lv.rayQuery, l.cUInt(hit == Committed ? 1 : 0) });
+		if (pt == v2) {
+			store(inst.hitAttributeVar, bary);
+		} else {
+			store(r(OpAccessChain, l.tPtr(StorageClassPrivate, v2), { inst.hitAttributeVar, l.cUInt(0) }), bary);
+		}
+	}
+
+	// The distance a new hit has to beat: that of the hit accepted so far, or the ray's end.
+	uint32_t currentTMax(const Level& lv) {
+		uint32_t type = r(OpRayQueryGetIntersectionTypeKHR, uintType, { lv.rayQuery, l.cUInt(1) });
+		uint32_t has = r(OpINotEqual, boolType, { type, l.cUInt(0) });
+		uint32_t t = r(OpRayQueryGetIntersectionTKHR, floatType, { lv.rayQuery, l.cUInt(1) });
+		return r(OpSelect, floatType, { has, t, load(lv.tMax) });
+	}
+};
+
+void Lowering::makeParams() {
+	// struct { uint64 values[8]; } as a uniform block: see mvk::RTDispatchParams.
+	uint32_t u64 = tUInt64();
+	Words members = { newId() };
+	for (int i = 0; i < 8; i++) { members.push_back(u64); }
+	emit(globals, OpTypeStruct, members);
+	uint32_t block = members[0];
+	gdef[block] = { OpTypeStruct, members };
+	decorate(block, DecorationBlock);
+	for (uint32_t i = 0; i < 8; i++) { emit(annotations, OpMemberDecorate, { block, i, DecorationOffset, i * 8 }); }
+	name(block, "fwDispatchParams");
+
+	paramsVar = newId();
+	Words w = { tPtr(StorageClassUniform, block), paramsVar, StorageClassUniform };
+	emit(globals, OpVariable, w);
+	gdef[paramsVar] = { OpVariable, w };
+	globalVars.push_back(paramsVar);
+	decorate(paramsVar, DecorationDescriptorSet, { cfg.paramsDescSet });
+	decorate(paramsVar, DecorationBinding, { cfg.paramsBinding });
+	name(paramsVar, "fwParams");
+
+	// Made by hand rather than through declare(): it is decorated, and must not be merged
+	// with a struct of a shader that happens to have the same members.
+	handleBlock = newId();
+	Words hb = { handleBlock, tUInt() };
+	emit(globals, OpTypeStruct, hb);
+	gdef[handleBlock] = { OpTypeStruct, hb };
+	decorate(handleBlock, DecorationBlock);
+	emit(annotations, OpMemberDecorate, { handleBlock, 0, DecorationOffset, 0 });
+	name(handleBlock, "fwShaderGroupHandle");
+
+	uint32_t u3 = tVec(tUInt(), 3);
+	launchIdVar = privateVar(u3, "fwLaunchId");
+	launchSizeVar = privateVar(u3, "fwLaunchSize");
+}
+
+// What OpTraceRayKHR calls: (acceleration structure, [instance table,] flags, cull mask,
+// sbt offset, sbt stride, miss index, origin, tmin, direction, tmax).
+void Lowering::generateTrace(const PendingTrace& t) {
+	uint32_t depth = instances[t.caller].traceDepth + 1;
+	level(depth);
+
+	// Every shader a ray traced from here can reach, at the next depth. Importing them first
+	// also settles which payload variable they share.
+	struct Arm { uint32_t handle; int inst; int intersectionInst; bool procedural; };
+	std::vector<Arm> missArms, closestArms, anyHitArms, intersectionArms;
+	for (uint32_t g = 0; g < cfg.groups.size(); g++) {
+		const mvk::RTGroup& grp = cfg.groups[g];
+		if ( !grp.isHitGroup ) {
+			if (grp.general != mvk::kRTShaderUnused && cfg.stages[grp.general].kind == mvk::RTStageKind::Miss) {
+				missArms.push_back({ g + 1, getInstance(grp.general, depth, 0), -1, false });
+			}
+			continue;
+		}
+		int isect = (grp.isProcedural && grp.intersection != mvk::kRTShaderUnused) ? getInstance(grp.intersection, depth, 0) : -1;
+		if (isect >= 0 && instances[isect].hitAttributeVar && !instances[isect].committedAttributeVar) {
+			// Where the attributes of the hit that was accepted are kept until the closest-hit
+			// shader runs: the intersection shader's own variable is overwritten by later candidates.
+			instances[isect].committedAttributeVar = privateVar(pointee(instances[isect].hitAttributeVar), "fwCommittedAttributes");
+		}
+		if (grp.closestHit != mvk::kRTShaderUnused) { closestArms.push_back({ g + 1, getInstance(grp.closestHit, depth, 0), isect, grp.isProcedural }); }
+		if (grp.anyHit != mvk::kRTShaderUnused) {
+			int ah = getInstance(grp.anyHit, depth, 0);
+			if ( !grp.isProcedural ) { anyHitArms.push_back({ g + 1, ah, -1, false }); }
+		}
+		if (isect >= 0) { intersectionArms.push_back({ g + 1, isect, isect, true }); }
+	}
+	if (failed) { return; }
+
+	// The callers' payload variable, and the one the shaders at the next depth use.
+	const Level& lv = levels[depth];
+	uint32_t payload = t.payloadVar;
+	uint32_t payloadType = pointee(payload);
+	uint32_t shared = 0;
+	for (auto& sp : lv.sharedPayloads) { if (pointee(sp.second) == payloadType) { shared = sp.second; break; } }
+	if ( !shared ) { for (auto& sp : lv.sharedPayloads) { if (logicallyMatch(pointee(sp.second), payloadType)) { shared = sp.second; break; } } }
+
+	Builder b(*this);
+	uint32_t u = b.uintType, f = b.floatType, v3 = tVec(f, 3), bl = b.boolType;
+	Words paramTypes = { tAccel() };
+	if (t.hasInstanceTable) { paramTypes.push_back(tInstanceTable()); }
+	for (int i = 0; i < 5; i++) { paramTypes.push_back(u); }
+	paramTypes.insert(paramTypes.end(), { v3, f, v3, f });
+	Words p = b.begin(t.function, b.voidType, paramTypes, "fwTraceRay_d" + std::to_string(depth));
+	size_t n = 0;
+	uint32_t accel = p[n++];
+	uint32_t table = t.hasInstanceTable ? p[n++] : 0;
+	uint32_t flags = p[n++], cull = p[n++], sbtOffset = p[n++], sbtStride = p[n++], missIndex = p[n++];
+	uint32_t origin = p[n++], tMin = p[n++], direction = p[n++], tMax = p[n++];
+
+	b.store(lv.origin, origin);
+	b.store(lv.direction, direction);
+	b.store(lv.tMin, tMin);
+	b.store(lv.tMax, tMax);
+	b.store(lv.flags, flags);
+	b.store(lv.cullMask, cull);
+	b.store(lv.ignore, cBool(false));
+	b.store(lv.terminate, cBool(false));
+	b.copyVar(shared, payload);
+	// Only the low four bits of the offset and stride count.
+	uint32_t offsetLow = b.r(OpBitwiseAnd, u, { sbtOffset, cUInt(0xF) });
+	uint32_t strideLow = b.r(OpBitwiseAnd, u, { sbtStride, cUInt(0xF) });
+
+	// Reads the hit group of the candidate, or of the hit that was accepted, into lv.handle and lv.recordAddress.
+	auto findHitGroup = [&](Builder::Hit hit) -> uint32_t {
+		uint32_t which = cUInt(hit == Builder::Committed ? 1 : 0);
+		uint32_t geometry = b.r(OpRayQueryGetIntersectionGeometryIndexKHR, u, { lv.rayQuery, which });
+		uint32_t index = b.r(OpIAdd, u, { b.r(OpIMul, u, { geometry, strideLow }), offsetLow });
+		if (table) {
+			uint32_t instance = b.r(OpRayQueryGetIntersectionInstanceIdKHR, u, { lv.rayQuery, which });
+			uint32_t width = cUInt(cfg.instanceTableWidth);
+			uint32_t coord = b.r(OpCompositeConstruct, tVec(u, 2), { b.r(OpUMod, u, { instance, width }), b.r(OpUDiv, u, { instance, width }) });
+			uint32_t texel = b.r(OpImageFetch, tVec(u, 4), { table, coord, ImageOperandsLodMask, cUInt(0) });
+			index = b.r(OpIAdd, u, { index, b.r(OpCompositeExtract, u, { texel, 0 }) });
+		}
+		uint32_t record = 0;
+		uint32_t handle = b.readHandle(b.param64(3), b.param64(4), index, record);
+		b.store(lv.handle, handle);
+		b.store(lv.recordAddress, record);
+		return handle;
+	};
+	auto literalsOf = [](const std::vector<Arm>& arms) { Words w; for (auto& a : arms) { w.push_back(a.handle); } return w; };
+
+	b.v(OpRayQueryInitializeKHR, { lv.rayQuery, accel, flags, cull, origin, tMin, direction, tMax });
+
+	// Candidates: triangles that are not opaque, and bounding boxes.
+	auto loop = b.beginLoop();
+	b.loopWhile(loop, b.r(OpRayQueryProceedKHR, bl, { lv.rayQuery }));
+	{
+		uint32_t candidateType = b.r(OpRayQueryGetIntersectionTypeKHR, u, { lv.rayQuery, cUInt(0) });
+		uint32_t handle = findHitGroup(Builder::Candidate);
+		uint32_t record = b.load(lv.recordAddress);
+		auto isTriangle = b.beginIf(b.r(OpIEqual, bl, { candidateType, cUInt(0) }), true);
+		{
+			b.store(lv.ignore, cBool(false));
+			if ( !anyHitArms.empty() ) {
+				uint32_t hitT = b.r(OpRayQueryGetIntersectionTKHR, f, { lv.rayQuery, cUInt(0) });
+				uint32_t front = b.r(OpRayQueryGetIntersectionFrontFaceKHR, bl, { lv.rayQuery, cUInt(0) });
+				uint32_t kind = b.r(OpSelect, u, { front, cUInt(0xFE), cUInt(0xFF) });
+				auto sw = b.beginSwitch(handle, literalsOf(anyHitArms));
+				for (size_t i = 0; i < anyHitArms.size(); i++) {
+					const Instance& inst = instances[anyHitArms[i].inst];
+					b.beginCase(sw, i);
+					b.setBuiltins(inst, depth, Builder::Candidate, hitT, kind);
+					b.setTriangleAttributes(inst, lv, Builder::Candidate);
+					b.invoke(inst, record);
+					b.endCase(sw);
+				}
+				b.endSwitch(sw);
+			}
+			auto accepted = b.beginIf(b.r(OpLogicalNot, bl, { b.load(lv.ignore) }));
+			b.v(OpRayQueryConfirmIntersectionKHR, { lv.rayQuery });
+			auto stop = b.beginIf(b.load(lv.terminate));
+			b.v(OpRayQueryTerminateKHR, { lv.rayQuery });
+			b.endIf(stop);
+			b.endIf(accepted);
+		}
+		b.beginElse(isTriangle);
+		if ( !intersectionArms.empty() ) {
+			// The intersection shader reports its hits through its report function, which
+			// runs the any-hit shader and accepts the hit.
+			uint32_t limit = b.currentTMax(lv);
+			auto sw = b.beginSwitch(handle, literalsOf(intersectionArms));
+			for (size_t i = 0; i < intersectionArms.size(); i++) {
+				const Instance& inst = instances[intersectionArms[i].inst];
+				b.beginCase(sw, i);
+				b.setBuiltins(inst, depth, Builder::Candidate, limit, 0);
+				b.invoke(inst, record);
+				b.endCase(sw);
+			}
+			b.endSwitch(sw);
+		}
+		b.endIf(isTriangle);
+	}
+	b.endLoop(loop);
+
+	// The closest hit, or a miss.
+	uint32_t committedType = b.r(OpRayQueryGetIntersectionTypeKHR, u, { lv.rayQuery, cUInt(1) });
+	auto wasHit = b.beginIf(b.r(OpINotEqual, bl, { committedType, cUInt(0) }), true);
+	{
+		uint32_t skip = b.r(OpBitwiseAnd, u, { flags, cUInt(0x8) });		// gl_RayFlagsSkipClosestHitShaderEXT
+		auto run = b.beginIf(b.r(OpIEqual, bl, { skip, cUInt(0) }));
+		if ( !closestArms.empty() ) {
+			uint32_t handle = findHitGroup(Builder::Committed);
+			uint32_t record = b.load(lv.recordAddress);
+			uint32_t hitT = b.r(OpRayQueryGetIntersectionTKHR, f, { lv.rayQuery, cUInt(1) });
+			uint32_t isTri = b.r(OpIEqual, bl, { committedType, cUInt(1) });
+			uint32_t front = b.r(OpRayQueryGetIntersectionFrontFaceKHR, bl, { lv.rayQuery, cUInt(1) });
+			uint32_t triKind = b.r(OpSelect, u, { front, cUInt(0xFE), cUInt(0xFF) });
+			uint32_t kind = b.r(OpSelect, u, { isTri, triKind, b.load(lv.committedKind) });
+			auto sw = b.beginSwitch(handle, literalsOf(closestArms));
+			for (size_t i = 0; i < closestArms.size(); i++) {
+				const Instance& inst = instances[closestArms[i].inst];
+				b.beginCase(sw, i);
+				b.setBuiltins(inst, depth, Builder::Committed, hitT, kind);
+				if (closestArms[i].procedural) {
+					if (closestArms[i].intersectionInst >= 0) {
+						b.copyVar(inst.hitAttributeVar, instances[closestArms[i].intersectionInst].committedAttributeVar);
+					}
+				} else {
+					b.setTriangleAttributes(inst, lv, Builder::Committed);
+				}
+				b.invoke(inst, record);
+				b.endCase(sw);
+			}
+			b.endSwitch(sw);
+		}
+		b.endIf(run);
+	}
+	b.beginElse(wasHit);
+	if ( !missArms.empty() ) {
+		uint32_t record = 0;
+		uint32_t handle = b.readHandle(b.param64(1), b.param64(2), missIndex, record);
+		auto sw = b.beginSwitch(handle, literalsOf(missArms));
+		for (size_t i = 0; i < missArms.size(); i++) {
+			const Instance& inst = instances[missArms[i].inst];
+			b.beginCase(sw, i);
+			b.setBuiltins(inst, depth, Builder::NoHit, tMax, 0);
+			b.invoke(inst, record);
+			b.endCase(sw);
+		}
+		b.endSwitch(sw);
+	}
+	b.endIf(wasHit);
+
+	b.copyVar(payload, shared);
+	b.end();
+}
+
+// What OpReportIntersectionKHR calls in one intersection shader: (hitT, hitKind) -> accepted.
+void Lowering::generateReport(int instIdx) {
+	uint32_t depth = instances[instIdx].traceDepth;
+	uint32_t stage = instances[instIdx].stage;
+	level(depth);
+
+	// The any-hit shaders of the hit groups this intersection shader belongs to.
+	struct Arm { uint32_t handle; int inst; };
+	std::vector<Arm> arms;
+	for (uint32_t g = 0; g < cfg.groups.size(); g++) {
+		const mvk::RTGroup& grp = cfg.groups[g];
+		if (grp.isHitGroup && grp.isProcedural && grp.intersection == stage && grp.anyHit != mvk::kRTShaderUnused) {
+			arms.push_back({ g + 1, getInstance(grp.anyHit, depth, 0) });
+		}
+	}
+	if (failed) { return; }
+	if (instances[instIdx].hitAttributeVar && !instances[instIdx].committedAttributeVar) {
+		instances[instIdx].committedAttributeVar = privateVar(pointee(instances[instIdx].hitAttributeVar), "fwCommittedAttributes");
+	}
+	const Instance& inst = instances[instIdx];
+	const Level& lv = levels[depth];
+
+	Builder b(*this);
+	uint32_t u = b.uintType, f = b.floatType, bl = b.boolType;
+	Words p = b.begin(inst.reportFunction, bl, { f, u }, "fwReportIntersection_d" + std::to_string(depth));
+	uint32_t hitT = p[0], hitKind = p[1];
+
+	// A hit outside the ray's current interval is not one.
+	uint32_t tooNear = b.r(OpFOrdLessThan, bl, { hitT, b.load(lv.tMin) });
+	uint32_t tooFar = b.r(OpFOrdGreaterThan, bl, { hitT, b.currentTMax(lv) });
+	auto outside = b.beginIf(b.r(OpLogicalOr, bl, { tooNear, tooFar }));
+	b.retValue(cBool(false));
+	b.endIf(outside);
+
+	b.store(lv.ignore, cBool(false));
+	if ( !arms.empty() ) {
+		uint32_t opaque = b.r(OpRayQueryGetIntersectionCandidateAABBOpaqueKHR, bl, { lv.rayQuery });
+		auto notOpaque = b.beginIf(b.r(OpLogicalNot, bl, { opaque }));
+		uint32_t record = b.load(lv.recordAddress);
+		Words literals;
+		for (auto& a : arms) { literals.push_back(a.handle); }
+		auto sw = b.beginSwitch(b.load(lv.handle), literals);
+		for (size_t i = 0; i < arms.size(); i++) {
+			const Instance& anyHit = instances[arms[i].inst];
+			b.beginCase(sw, i);
+			b.setBuiltins(anyHit, depth, Builder::Candidate, hitT, hitKind);
+			b.copyVar(anyHit.hitAttributeVar, inst.hitAttributeVar);
+			b.invoke(anyHit, record);
+			b.endCase(sw);
+		}
+		b.endSwitch(sw);
+		b.endIf(notOpaque);
+	}
+	auto ignored = b.beginIf(b.load(lv.ignore));
+	b.retValue(cBool(false));
+	b.endIf(ignored);
+
+	b.v(OpRayQueryGenerateIntersectionKHR, { lv.rayQuery, hitT });
+	b.store(lv.committedKind, hitKind);
+	b.copyVar(inst.committedAttributeVar, inst.hitAttributeVar);
+	auto stop = b.beginIf(b.load(lv.terminate));
+	b.v(OpRayQueryTerminateKHR, { lv.rayQuery });
+	b.endIf(stop);
+	b.retValue(cBool(true));
+	b.end();
+}
+
+// What OpExecuteCallableKHR calls: (sbt index).
+void Lowering::generateCall(const PendingCall& c) {
+	uint32_t traceDepth = instances[c.caller].traceDepth;
+	uint32_t callDepth = instances[c.caller].callDepth + 1;
+	struct Arm { uint32_t handle; int inst; };
+	std::vector<Arm> arms;
+	for (uint32_t g = 0; g < cfg.groups.size(); g++) {
+		const mvk::RTGroup& grp = cfg.groups[g];
+		if ( !grp.isHitGroup && grp.general != mvk::kRTShaderUnused && cfg.stages[grp.general].kind == mvk::RTStageKind::Callable) {
+			arms.push_back({ g + 1, getInstance(grp.general, traceDepth, callDepth) });
+		}
+	}
+	if (failed) { return; }
+
+	Builder b(*this);
+	Words p = b.begin(c.function, b.voidType, { b.uintType }, "fwExecuteCallable");
+	uint32_t record = 0;
+	uint32_t handle = b.readHandle(b.param64(5), b.param64(6), p[0], record);
+	Words literals;
+	for (auto& a : arms) { literals.push_back(a.handle); }
+	if ( !arms.empty() ) {
+		auto sw = b.beginSwitch(handle, literals);
+		for (size_t i = 0; i < arms.size(); i++) {
+			const Instance& callee = instances[arms[i].inst];
+			b.beginCase(sw, i);
+			b.copyVar(callee.incomingCallableVar, c.dataVar);
+			b.setBuiltins(callee, 0, Builder::NoHit, 0, 0);
+			b.invoke(callee, record);
+			b.copyVar(c.dataVar, callee.incomingCallableVar);
+			b.endCase(sw);
+		}
+		b.endSwitch(sw);
+	}
+	b.end();
+}
+
+// The compute shader's entry point: one ray generation shader invocation.
+void Lowering::generateMain() {
+	struct Arm { uint32_t handle; int inst; };
+	std::vector<Arm> arms;
+	for (uint32_t g = 0; g < cfg.groups.size(); g++) {
+		const mvk::RTGroup& grp = cfg.groups[g];
+		if ( !grp.isHitGroup && grp.general != mvk::kRTShaderUnused && cfg.stages[grp.general].kind == mvk::RTStageKind::RayGeneration) {
+			arms.push_back({ g + 1, getInstance(grp.general, 0, 0) });
+		}
+	}
+	if (failed) { return; }
+
+	uint32_t u3 = tVec(tUInt(), 3);
+	auto input = [&](uint32_t builtin, const char* n) {
+		uint32_t id = newId();
+		Words w = { tPtr(StorageClassInput, u3), id, StorageClassInput };
+		emit(globals, OpVariable, w);
+		gdef[id] = { OpVariable, w };
+		globalVars.push_back(id);
+		decorate(id, DecorationBuiltIn, { builtin });
+		name(id, n);
+		return id;
+	};
+	uint32_t invocation = input(BuiltInGlobalInvocationId, "gl_GlobalInvocationID");
+	uint32_t groups = input(BuiltInNumWorkgroups, "gl_NumWorkGroups");
+
+	Builder b(*this);
+	uint32_t mainFn = newId();
+	b.begin(mainFn, b.voidType, {}, "main");
+	b.store(launchIdVar, b.load(invocation));
+	b.store(launchSizeVar, b.load(groups));
+	uint32_t record = 0;
+	uint32_t handle = b.readHandle(b.param64(0), 0, 0, record);
+	Words literals;
+	for (auto& a : arms) { literals.push_back(a.handle); }
+	if ( !arms.empty() ) {
+		auto sw = b.beginSwitch(handle, literals);
+		for (size_t i = 0; i < arms.size(); i++) {
+			const Instance& inst = instances[arms[i].inst];
+			b.beginCase(sw, i);
+			b.setBuiltins(inst, 0, Builder::NoHit, 0, 0);
+			b.invoke(inst, record);
+			b.endCase(sw);
+		}
+		b.endSwitch(sw);
+	}
+	b.end();
+
+	// Everything the generated code left to do: each trace, call and report function, which
+	// may import further shaders and so leave more to do.
+	while ( !failed && (!pendingTraces.empty() || !pendingCalls.empty() || !pendingReports.empty()) ) {
+		if ( !pendingTraces.empty() ) { PendingTrace t = pendingTraces.back(); pendingTraces.pop_back(); generateTrace(t); continue; }
+		if ( !pendingCalls.empty() ) { PendingCall c = pendingCalls.back(); pendingCalls.pop_back(); generateCall(c); continue; }
+		int r = pendingReports.back(); pendingReports.pop_back(); generateReport(r);
+	}
+
+	// The entry point lists every global variable, as SPIR-V 1.4 and later want.
+	Words entry = { ExecutionModelGLCompute, mainFn };
+	appendString(entry, "main");
+	entry.insert(entry.end(), globalVars.begin(), globalVars.end());
+	Words header;
+	emit(header, OpEntryPoint, entry);
+	emit(header, OpExecutionMode, { mainFn, ExecutionModeLocalSize, 1, 1, 1 });
+	entryPoint = header;
+}
+
+bool Lowering::run(Words& out) {
+	if (cfg.stages.empty() || cfg.groups.empty()) { return fail("no stages or no groups"); }
+	parsed.resize(cfg.stages.size());
+	levels.resize(cfg.maxRecursionDepth + 2);
+	capabilities = { CapabilityShader, CapabilityRayQueryKHR, CapabilityPhysicalStorageBufferAddresses, CapabilityInt64 };
+	extensions = { "SPV_KHR_ray_query", "SPV_KHR_physical_storage_buffer" };
+
+	makeParams();
+	generateMain();
+	if (failed) { return false; }
+
+	out.clear();
+	out.insert(out.end(), { MagicNumber, 0x00010500u, 0u, nextId, 0u });
+	for (uint32_t c : capabilities) { emit(out, OpCapability, { c }); }
+	for (auto& e : extensions) { Words o; appendString(o, e); emit(out, OpExtension, o); }
+	for (auto& i : extInstImports) { Words o = { i.second }; appendString(o, i.first); emit(out, OpExtInstImport, o); }
+	emit(out, OpMemoryModel, { AddressingModelPhysicalStorageBuffer64, MemoryModelGLSL450 });
+	out.insert(out.end(), entryPoint.begin(), entryPoint.end());
+	out.insert(out.end(), strings.begin(), strings.end());
+	out.insert(out.end(), debug.begin(), debug.end());
+	out.insert(out.end(), annotations.begin(), annotations.end());
+	out.insert(out.end(), globals.begin(), globals.end());
+	out.insert(out.end(), functions.begin(), functions.end());
+	return true;
+}
+
+}	// namespace
+
+bool mvk::lowerRayTracingPipeline(const RTLoweringConfig& config, RTLoweringResult& result, std::string& log) {
+	Lowering lowering(config, log);
+	if ( !lowering.run(result.spirv) ) { return false; }
+	result.instanceTables = lowering.instanceTableBindings;
+	return true;
+}
