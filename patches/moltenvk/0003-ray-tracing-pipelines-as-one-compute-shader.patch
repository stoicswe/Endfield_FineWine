+void MVKAccelerationStructure::setInstanceTable(id<MTLTexture> mtlTable) {
+	if (mtlTable != _instanceTable) {
+		[_instanceTable release];
+		_instanceTable = [mtlTable retain];
+	}
+	// It travels with the Metal object, which is what the code that binds it has.
+	if (_mtlAccelerationStructure) {
+		objc_setAssociatedObject(_mtlAccelerationStructure, &_mvkInstanceTableKey, mtlTable, OBJC_ASSOCIATION_RETAIN);
+	}
+}
+
 void MVKAccelerationStructure::setBuildRecord(MTLAccelerationStructureDescriptor* mtlDesc, const MVKAccelerationStructureBuildInputs& inputs) {
 	if (mtlDesc != _buildDescriptor) {
 		[_buildDescriptor release];
 		_buildDescriptor = [mtlDesc retain];
 	}
+
+	// A top-level structure: write its instances' shader binding table offsets into a texture
+	// of their own. A new texture each time, because commands encoded before this one may
+	// still be waiting to run with the old one.
+	id<MTLTexture> mtlTable = nil;
+	if ([mtlDesc isKindOfClass: [MTLInstanceAccelerationStructureDescriptor class]]) {
+		auto* instDesc = (MTLInstanceAccelerationStructureDescriptor*)mtlDesc;
+		NSUInteger count = instDesc.instanceCount;
+		const char* src = (const char*)instDesc.instanceDescriptorBuffer.contents;
+		if (count && src) {
+			src += instDesc.instanceDescriptorBufferOffset;
+			NSUInteger height = (count + kMVKInstanceTableWidth - 1) / kMVKInstanceTableWidth;
+			std::vector<uint32_t> offsets(height * kMVKInstanceTableWidth, 0);
+			for (NSUInteger i = 0; i < count; i++) {
+				offsets[i] = ((const MTLAccelerationStructureUserIDInstanceDescriptor*)(src + i * instDesc.instanceDescriptorStride))->intersectionFunctionTableOffset;
+			}
+			MTLTextureDescriptor* texDesc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat: MTLPixelFormatR32Uint
+																						   width: kMVKInstanceTableWidth
+																						  height: height
+																					   mipmapped: NO];
+			texDesc.usage = MTLTextureUsageShaderRead;
+			texDesc.storageMode = MTLStorageModeShared;
+			mtlTable = [[getMTLDevice() newTextureWithDescriptor: texDesc] autorelease];
+			[mtlTable replaceRegion: MTLRegionMake2D(0, 0, kMVKInstanceTableWidth, height)
+						mipmapLevel: 0
+						  withBytes: offsets.data()
+						bytesPerRow: kMVKInstanceTableWidth * sizeof(uint32_t)];
+		}
+	}
+	setInstanceTable(mtlTable);
+
 	_buildExtents.clear();
 	for (auto& e : inputs.extents) { _buildExtents.push_back(e); }
 	_instancedAddresses.clear();
