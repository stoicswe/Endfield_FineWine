+
+	// rayTracingPipelineShaderGroupHandleCaptureReplay is reported as unsupported.
+	MVKTraceVulkanCallStart();
+	MVKDevice* mvkDev = MVKDevice::getMVKDevice(device);
+	VkResult rslt = mvkDev->reportError(VK_ERROR_FEATURE_NOT_PRESENT, "vkGetRayTracingCaptureReplayShaderGroupHandlesKHR(): Capture and replay of shader group handles is not supported.");
+	MVKTraceVulkanCallEnd();
+	return rslt;
+}
+
