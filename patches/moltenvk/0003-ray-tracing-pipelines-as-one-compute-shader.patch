--- /dev/null
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKRayTracingPipeline.h
@@ -0,0 +1,95 @@
+/*
+ * MVKRayTracingPipeline.h
+ *
+ * FineWine: VK_KHR_ray_tracing_pipeline. A ray tracing pipeline is a compute pipeline whose
+ * shader is every shader of the pipeline merged into one (see RayTracingLowering.h in
+ * MoltenVKShaderConverter), dispatched with one thread per ray.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#pragma once
+
+#include "MVKPipeline.h"
+#include <utility>
+#include <vector>
+
+/** The size of a shader group handle. The first four bytes are the group's index plus one. */
+static const uint32_t kMVKRayTracingShaderGroupHandleSize = 32;
+
+/** How deep a pipeline may say its rays recurse. Each level is another copy of its hit and miss shaders. */
+static const uint32_t kMVKRayTracingMaxRecursionDepth = 31;
+
+/**
+ * The descriptor set number, outside any pipeline layout, at which the merged shader declares
+ * what vkCmdTraceRaysKHR hands it: binding 0 is the shader binding table's addresses, and
+ * bindings 1 onwards are instance tables.
+ */
+static const uint32_t kMVKRayTracingParamsDescSet = 16;
+
+/** How many acceleration structure bindings of one pipeline can have an instance table. */
+static const uint32_t kMVKRayTracingMaxInstanceTables = 8;
+
+/** The Metal texture index of the n'th instance table: counted down from the top of what a shader stage can declare. */
+static inline uint32_t mvkRayTracingInstanceTableTextureIndex(uint32_t maxPerStageTextureCount, uint32_t n) {
+	uint32_t top = maxPerStageTextureCount < 128 ? maxPerStageTextureCount : 128;	// the shading language stops at index 127
+	return top - 1 - n;
+}
+
+/**
+ * Chained to the VkComputePipelineCreateInfo of the compute pipeline behind a ray tracing
+ * pipeline, to tell MVKComputePipeline to map the bindings above to Metal indices.
+ */
+static const VkStructureType kMVKStructureTypeRayTracingComputeInfo = (VkStructureType)0x46570001;
+struct MVKRayTracingComputeInfo {
+	VkStructureType sType;
+	const void* pNext;
+	uint32_t instanceTableCount;
+};
+
+class MVKRayTracingPipeline : public MVKComputePipeline {
+
+public:
+
+	uint32_t getGroupCount() { return _groupCount; }
+
+	/** vkGetRayTracingShaderGroupHandlesKHR. */
+	VkResult getGroupHandles(uint32_t firstGroup, uint32_t groupCount, size_t dataSize, void* pData);
+
+	/** The Metal buffer index the shader binding table's addresses are bound at. */
+	uint32_t getParamsBufferIndex();
+
+	/** The Metal texture index of the instance table of the n'th entry of getInstanceTableBindings(). */
+	uint32_t getInstanceTableTextureIndex(uint32_t n);
+
+	/** The (set, binding) of each acceleration structure whose instance table the shader reads. */
+	const std::vector<std::pair<uint32_t, uint32_t>>& getInstanceTableBindings() { return _instanceTables; }
+
+	/** A one-texel table of zero, for a binding whose acceleration structure has none. */
+	id<MTLTexture> getEmptyInstanceTable() { return _emptyInstanceTable; }
+
+	/** Merges the pipeline's shaders and makes the pipeline. On failure the result's configuration result says why. */
+	static MVKRayTracingPipeline* create(MVKDevice* device, MVKPipelineCache* pipelineCache, MVKPipeline* parent,
+										 const VkRayTracingPipelineCreateInfoKHR* pCreateInfo);
+
+	MVKRayTracingPipeline(MVKDevice* device, MVKPipelineCache* pipelineCache, MVKPipeline* parent,
+						  const VkComputePipelineCreateInfo* pComputeInfo, uint32_t groupCount,
+						  const std::vector<std::pair<uint32_t, uint32_t>>& instanceTables);
+
+	~MVKRayTracingPipeline() override;
+
+protected:
+	uint32_t _groupCount = 0;
+	std::vector<std::pair<uint32_t, uint32_t>> _instanceTables;
+	id<MTLTexture> _emptyInstanceTable = nil;
+};
diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKRayTracingPipeline.mm b/MoltenVK/MoltenVK/GPUObjects/MVKRayTracingPipeline.mm
new file mode 100644
index 0000000..0478b66
--- /dev/null
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKRayTracingPipeline.mm
@@ -0,0 +1,165 @@
+/*
+ * MVKRayTracingPipeline.mm
+ *
+ * FineWine: VK_KHR_ray_tracing_pipeline.
+ * This file is compiled as part of MVKPipeline.mm, which includes it, so that the Xcode project
+ * does not have to change.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "MVKRayTracingPipeline.h"
+#include "MVKShaderModule.h"
+#include <MoltenVKShaderConverter/RayTracingLowering.h>
+
+static bool mvkRTStageKind(VkShaderStageFlagBits stage, mvk::RTStageKind& kind) {
+	switch (stage) {
+		case VK_SHADER_STAGE_RAYGEN_BIT_KHR:		kind = mvk::RTStageKind::RayGeneration; return true;
+		case VK_SHADER_STAGE_MISS_BIT_KHR:			kind = mvk::RTStageKind::Miss; return true;
+		case VK_SHADER_STAGE_CLOSEST_HIT_BIT_KHR:	kind = mvk::RTStageKind::ClosestHit; return true;
+		case VK_SHADER_STAGE_ANY_HIT_BIT_KHR:		kind = mvk::RTStageKind::AnyHit; return true;
+		case VK_SHADER_STAGE_INTERSECTION_BIT_KHR:	kind = mvk::RTStageKind::Intersection; return true;
+		case VK_SHADER_STAGE_CALLABLE_BIT_KHR:		kind = mvk::RTStageKind::Callable; return true;
+		default: return false;
+	}
+}
+
+MVKRayTracingPipeline* MVKRayTracingPipeline::create(MVKDevice* device, MVKPipelineCache* pipelineCache, MVKPipeline* parent,
+													 const VkRayTracingPipelineCreateInfoKHR* pCreateInfo) {
+	mvk::RTLoweringConfig cfg;
+	cfg.maxRecursionDepth = std::min(pCreateInfo->maxPipelineRayRecursionDepth, kMVKRayTracingMaxRecursionDepth);
+	cfg.handleSize = kMVKRayTracingShaderGroupHandleSize;
+	cfg.paramsDescSet = kMVKRayTracingParamsDescSet;
+	cfg.paramsBinding = 0;
+	std::string log;
+	bool ok = true;
+
+	if (pCreateInfo->pLibraryInfo && pCreateInfo->pLibraryInfo->libraryCount) {
+		log += "Ray tracing pipeline: pipeline libraries are not supported.\n";
+		ok = false;
+	}
+	for (uint32_t i = 0; ok && i < pCreateInfo->stageCount; i++) {
+		const VkPipelineShaderStageCreateInfo& ss = pCreateInfo->pStages[i];
+		mvk::RTStage stage;
+		if ( !mvkRTStageKind(ss.stage, stage.kind) ) {
+			log += "Ray tracing pipeline: a stage is not a ray tracing stage.\n";
+			ok = false;
+			break;
+		}
+		stage.entryName = ss.pName ? ss.pName : "main";
+		if (ss.module) {
+			stage.spirv = ((MVKShaderModule*)ss.module)->getSPIRV();
+		} else {
+			for (const auto* next = (const VkBaseInStructure*)ss.pNext; next; next = next->pNext) {
+				if (next->sType == VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO) {
+					auto* smci = (const VkShaderModuleCreateInfo*)next;
+					stage.spirv.assign(smci->pCode, smci->pCode + smci->codeSize / sizeof(uint32_t));
+				}
+			}
+		}
+		if (stage.spirv.empty()) {
+			log += "Ray tracing pipeline: a stage has no SPIR-V.\n";
+			ok = false;
+			break;
+		}
+		if (const VkSpecializationInfo* spec = ss.pSpecializationInfo) {
+			for (uint32_t e = 0; e < spec->mapEntryCount; e++) {
+				const VkSpecializationMapEntry& me = spec->pMapEntries[e];
+				mvk::RTSpecializationEntry entry;
+				entry.constantID = me.constantID;
+				entry.data.assign((const uint8_t*)spec->pData + me.offset, (const uint8_t*)spec->pData + me.offset + me.size);
+				stage.specialization.push_back(std::move(entry));
+			}
+		}
+		cfg.stages.push_back(std::move(stage));
+	}
+	for (uint32_t i = 0; ok && i < pCreateInfo->groupCount; i++) {
+		const VkRayTracingShaderGroupCreateInfoKHR& g = pCreateInfo->pGroups[i];
+		mvk::RTGroup group;
+		group.isHitGroup = g.type != VK_RAY_TRACING_SHADER_GROUP_TYPE_GENERAL_KHR;
+		group.isProcedural = g.type == VK_RAY_TRACING_SHADER_GROUP_TYPE_PROCEDURAL_HIT_GROUP_KHR;
+		auto index = [&](uint32_t shader) { return shader < cfg.stages.size() ? shader : mvk::kRTShaderUnused; };
+		if (group.isHitGroup) {
+			group.closestHit = index(g.closestHitShader);
+			group.anyHit = index(g.anyHitShader);
+			group.intersection = index(g.intersectionShader);
+		} else {
+			group.general = index(g.generalShader);
+		}
+		cfg.groups.push_back(group);
+	}
+
+	mvk::RTLoweringResult lowered;
+	if (ok) { ok = mvk::lowerRayTracingPipeline(cfg, lowered, log); }
+	if (ok && lowered.instanceTables.size() > kMVKRayTracingMaxInstanceTables) {
+		log += "Ray tracing pipeline: rays are traced against more acceleration structure bindings than are supported.\n";
+		ok = false;
+	}
+
+	// The merged shader goes in as the compute stage's own module, which the compute pipeline
+	// then owns. If merging failed there is no code, and the pipeline reports that it has none.
+	VkShaderModuleCreateInfo smci = { VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO };
+	smci.codeSize = lowered.spirv.size() * sizeof(uint32_t);
+	smci.pCode = lowered.spirv.data();
+	MVKRayTracingComputeInfo rtInfo = { kMVKStructureTypeRayTracingComputeInfo, nullptr, (uint32_t)lowered.instanceTables.size() };
+	VkComputePipelineCreateInfo cpci = { VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO, &rtInfo };
+	cpci.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+	cpci.stage.pNext = ok ? &smci : nullptr;
+	cpci.stage.stage = ok ? VK_SHADER_STAGE_COMPUTE_BIT : (VkShaderStageFlagBits)0;
+	cpci.stage.pName = "main";
+	cpci.layout = pCreateInfo->layout;
+
+	auto* pipeline = new MVKRayTracingPipeline(device, pipelineCache, parent, &cpci, pCreateInfo->groupCount, lowered.instanceTables);
+	if ( !ok ) {
+		pipeline->setConfigurationResult(pipeline->reportError(VK_ERROR_INITIALIZATION_FAILED, "vkCreateRayTracingPipelinesKHR(): %s", log.c_str()));
+	}
+	return pipeline;
+}
+
+MVKRayTracingPipeline::MVKRayTracingPipeline(MVKDevice* device, MVKPipelineCache* pipelineCache, MVKPipeline* parent,
+											 const VkComputePipelineCreateInfo* pComputeInfo, uint32_t groupCount,
+											 const std::vector<std::pair<uint32_t, uint32_t>>& instanceTables)
+	: MVKComputePipeline(device, pipelineCache, parent, pComputeInfo), _groupCount(groupCount), _instanceTables(instanceTables) {
+
+	if ( !_instanceTables.empty() ) {
+		MTLTextureDescriptor* desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat: MTLPixelFormatR32Uint width: 1 height: 1 mipmapped: NO];
+		desc.usage = MTLTextureUsageShaderRead;
+		desc.storageMode = MTLStorageModeShared;
+		_emptyInstanceTable = [getMTLDevice() newTextureWithDescriptor: desc];
+		uint32_t zero = 0;
+		[_emptyInstanceTable replaceRegion: MTLRegionMake2D(0, 0, 1, 1) mipmapLevel: 0 withBytes: &zero bytesPerRow: sizeof(zero)];
+	}
+}
+
+MVKRayTracingPipeline::~MVKRayTracingPipeline() {
+	[_emptyInstanceTable release];
+}
+
+VkResult MVKRayTracingPipeline::getGroupHandles(uint32_t firstGroup, uint32_t groupCount, size_t dataSize, void* pData) {
+	if (firstGroup + groupCount > _groupCount || dataSize < (size_t)groupCount * kMVKRayTracingShaderGroupHandleSize) {
+		return reportError(VK_ERROR_UNKNOWN, "vkGetRayTracingShaderGroupHandlesKHR(): The groups or the data size are out of range.");
+	}
+	memset(pData, 0, (size_t)groupCount * kMVKRayTracingShaderGroupHandleSize);
+	for (uint32_t i = 0; i < groupCount; i++) {
+		auto* handle = (uint32_t*)((char*)pData + (size_t)i * kMVKRayTracingShaderGroupHandleSize);
+		handle[0] = firstGroup + i + 1;		// what the merged shader switches on; zero is "no shader"
+		handle[1] = 0x54524657;				// "FWRT", to recognise a handle in a memory dump
+	}
+	return VK_SUCCESS;
+}
+
+uint32_t MVKRayTracingPipeline::getParamsBufferIndex() { return getImplicitBufferIndex(4); }
+
+uint32_t MVKRayTracingPipeline::getInstanceTableTextureIndex(uint32_t n) {
+	return mvkRayTracingInstanceTableTextureIndex(getMetalFeatures().maxPerStageTextureCount, n);
+}
