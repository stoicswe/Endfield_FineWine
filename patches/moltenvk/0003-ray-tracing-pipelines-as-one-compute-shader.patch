+				mvkDev->destroyPipeline(mvkPL, pAllocator);
+				if (rslt == VK_SUCCESS) { rslt = plRslt; }
+			}
+		}
+	}
+	if (rslt == VK_SUCCESS && deferredOperation != VK_NULL_HANDLE) { rslt = VK_OPERATION_NOT_DEFERRED_KHR; }
+	MVKTraceVulkanCallEnd();
+	return rslt;
+}
+
+MVK_PUBLIC_VULKAN_SYMBOL VkResult vkGetRayTracingShaderGroupHandlesKHR(
