 DECLARE_CRITICAL_SECTION(ob_callback_cs);
 static LONG ob_callback_in_progress;
 
+#define MAX_PROCESS_NOTIFY_ROUTINES 8
+#define MAX_THREAD_NOTIFY_ROUTINES 8
+
+static PCREATE_PROCESS_NOTIFY_ROUTINE process_notify_routines[MAX_PROCESS_NOTIFY_ROUTINES];
+static unsigned int process_notify_routine_count;
+static PCREATE_PROCESS_NOTIFY_ROUTINE_EX process_notify_routines_ex[MAX_PROCESS_NOTIFY_ROUTINES];
+static unsigned int process_notify_routine_ex_count;
+static PCREATE_THREAD_NOTIFY_ROUTINE thread_notify_routines[MAX_THREAD_NOTIFY_ROUTINES];
+static unsigned int thread_notify_routine_count;
+/* A notify callback may itself reference/create kernel objects, which would
+ * re-enter the dispatch below; a single in-flight flag breaks that recursion. */
+static LONG notify_in_progress;
+
 struct irp_data
 {
     HANDLE handle;
@@ -2540,6 +2553,64 @@ void WINAPI ExDeleteNPagedLookasideList( PNPAGED_LOOKASIDE_LIST lookaside )
 }
 
 
+/* Call the registered process-creation notification routines. Wine builds a
+ * kernel process object lazily (when a process handle is first referenced), so
+ * this is the closest available "process seen by the kernel" hook; it can fire
+ * more than once for the same process. */
+static void call_process_notify_routines( PEPROCESS process )
+{
+    UNICODE_STRING name, command_line;
+    PS_CREATE_NOTIFY_INFO info;
+    WCHAR name_buf[64];
+    const WCHAR empty[] = L"";
+    HANDLE parent = (HANDLE)process->info.InheritedFromUniqueProcessId;
+    HANDLE pid = (HANDLE)process->info.UniqueProcessId;
+    unsigned int i;
+    ULONG len;
+
+    if (InterlockedCompareExchange( &notify_in_progress, 1, 0 )) return;
+
+    TRACE( "process %p (%s): %u Ex + %u legacy routines\n", process, process->image_name,
+           process_notify_routine_ex_count, process_notify_routine_count );
+
+    for (len = 0; len < ARRAY_SIZE(name_buf) - 1 && process->image_name[len]; len++)
+        name_buf[len] = process->image_name[len];
+    name_buf[len] = 0;
+    RtlInitUnicodeString( &name, name_buf );
+    RtlInitUnicodeString( &command_line, empty );
+
+    memset( &info, 0, sizeof(info) );
+    info.Size = sizeof(info);
+    info.ParentProcessId = parent;
+    info.ImageFileName = &name;
+    info.CommandLine = &command_line;
+    info.CreationStatus = STATUS_SUCCESS;
+
+    for (i = 0; i < process_notify_routine_ex_count; i++)
+        process_notify_routines_ex[i]( process, pid, &info );
+
+    for (i = 0; i < process_notify_routine_count; i++)
+        process_notify_routines[i]( parent, pid, TRUE );
+
+    InterlockedExchange( &notify_in_progress, 0 );
+}
+
+/* Call the registered thread-creation notification routines. */
+static void call_thread_notify_routines( struct _KTHREAD *thread )
+{
+    CLIENT_ID id = thread->id;
+    unsigned int i;
+
+    if (InterlockedCompareExchange( &notify_in_progress, 1, 0 )) return;
+
+    TRACE( "thread %p: %u routines\n", thread, thread_notify_routine_count );
+
+    for (i = 0; i < thread_notify_routine_count; i++)
+        thread_notify_routines[i]( id.UniqueProcess, id.UniqueThread, TRUE );
+
+    InterlockedExchange( &notify_in_progress, 0 );
+}
+
 /***********************************************************************
  *           ExDeletePagedLookasideList  (NTOSKRNL.EXE.@)
  */
@@ -2648,6 +2719,8 @@ static void *create_process_object( HANDLE handle )
     get_process_image_file_name( handle, process );
     IsWow64Process( handle, &process->wow64 );
 
+    call_process_notify_routines( process );
+
     return process;
 }
 
@@ -2791,6 +2864,7 @@ static void *create_thread_object( HANDLE handle )
         }
     }
 
+    call_thread_notify_routines( thread );
 
     return thread;
 }
@@ -3683,7 +3757,25 @@ void WINAPI PsRevertToSelf(void)
  */
 NTSTATUS WINAPI PsSetCreateProcessNotifyRoutine( PCREATE_PROCESS_NOTIFY_ROUTINE callback, BOOLEAN remove )
 {
-    FIXME( "stub: %p %d\n", callback, remove );
+    unsigned int i;
+
+    TRACE( "(%p, %d)\n", callback, remove );
+
+    if (remove)
+    {
+        for (i = 0; i < process_notify_routine_count; i++)
+            if (process_notify_routines[i] == callback)
+            {
+                process_notify_routines[i] = process_notify_routines[--process_notify_routine_count];
+                return STATUS_SUCCESS;
+            }
+        return STATUS_PROCEDURE_NOT_FOUND;
+    }
+
+    if (process_notify_routine_count == MAX_PROCESS_NOTIFY_ROUTINES)
+        return STATUS_INSUFFICIENT_RESOURCES;
+
+    process_notify_routines[process_notify_routine_count++] = callback;
     return STATUS_SUCCESS;
 }
 
