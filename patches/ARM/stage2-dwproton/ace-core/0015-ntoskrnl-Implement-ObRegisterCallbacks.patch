+/* Invoke the registered OB_PRE_OPERATION callbacks. The callbacks may shrink
+ * (or, for protected processes, zero) DesiredAccess; we propagate it back. */
+static void ob_call_pre_operation_callbacks( POBJECT_TYPE type, OB_OPERATION operation,
+                                             void *object, ACCESS_MASK *desired )
+{
+    OB_PRE_OPERATION_PARAMETERS parameters;
+    OB_PRE_OPERATION_INFORMATION information;
+    unsigned int i;
+
+    if (InterlockedCompareExchange( &ob_callback_in_progress, 1, 0 )) return;
+
+    memset( &parameters, 0, sizeof(parameters) );
+    parameters.CreateHandleInformation.DesiredAccess = *desired;
+    parameters.CreateHandleInformation.OriginalDesiredAccess = *desired;
+
+    memset( &information, 0, sizeof(information) );
+    information.Operation = operation;
+    information.Object = object;
+    information.ObjectType = type;
+    information.Parameters = &parameters;
+
+    for (i = 0; i < ob_op_registration_count; i++)
+    {
+        if (!ob_op_registrations[i].object_type || *ob_op_registrations[i].object_type != type) continue;
+        if (!(ob_op_registrations[i].operations & operation)) continue;
+        if (!ob_op_registrations[i].pre) continue;
+        ob_op_registrations[i].pre( ob_op_registrations[i].context, &information );
+    }
+
+    *desired = parameters.CreateHandleInformation.DesiredAccess;
+
+    InterlockedExchange( &ob_callback_in_progress, 0 );
+}
+
+static void ob_call_post_operation_callbacks( POBJECT_TYPE type, OB_OPERATION operation,
+                                              void *object, ACCESS_MASK granted, NTSTATUS status )
+{
+    OB_POST_OPERATION_PARAMETERS parameters;
+    OB_POST_OPERATION_INFORMATION information;
+    unsigned int i;
+
+    if (InterlockedCompareExchange( &ob_callback_in_progress, 1, 0 )) return;
+
+    memset( &parameters, 0, sizeof(parameters) );
+    parameters.CreateHandleInformation.GrantedAccess = granted;
+
+    memset( &information, 0, sizeof(information) );
+    information.Operation = operation;
+    information.Object = object;
+    information.ObjectType = type;
+    information.ReturnStatus = status;
+    information.Parameters = &parameters;
+
+    for (i = 0; i < ob_op_registration_count; i++)
+    {
+        if (!ob_op_registrations[i].object_type || *ob_op_registrations[i].object_type != type) continue;
+        if (!(ob_op_registrations[i].operations & operation)) continue;
+        if (!ob_op_registrations[i].post) continue;
+        ob_op_registrations[i].post( ob_op_registrations[i].context, &information );
+    }
+
+    InterlockedExchange( &ob_callback_in_progress, 0 );
 }
 
