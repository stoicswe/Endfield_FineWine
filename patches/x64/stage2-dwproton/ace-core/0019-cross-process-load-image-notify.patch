+/* Replay every currently-mapped PE image of a process for cross-process
+ * load-image notification (imported by replay_image_loads()). */
+void notify_process_images( struct process *process )
+{
+    struct memory_view *view;
+    struct unicode_str name;
+
+    LIST_FOR_EACH_ENTRY( view, &process->views, struct memory_view, entry )
+    {
+        if (!(view->flags & SEC_IMAGE)) continue;
+        if (!get_view_nt_name( view, &name )) continue;
+        notify_image_load( get_process_id( process ), name.str, name.len,
+                           view->image.image_charact, view->image.map_size,
+                           view->image.machine, view->image.contains_code );
+    }
+}
+
 static void free_memory_view( struct memory_view *view )
 {
     if (view->fd) release_object( view->fd );
