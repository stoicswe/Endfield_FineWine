+/* Queue a cross-process image-load notification to every interested manager.
+ * The image name is carried in the IRP input buffer. */
+void notify_image_load( unsigned int id, const void *name, data_size_t name_len,
+                        unsigned int image_charact, unsigned int map_size,
+                        unsigned int machine, unsigned int contains_code )
+{
+    struct device_manager *manager;
+    union irp_params params;
+    struct irp_call *irp;
+    struct iosb *iosb;
 
+    if (list_empty( &ob_managers )) return;
+    if (!(iosb = create_iosb_buffer( name, name_len ))) return;
 
+    memset( &params, 0, sizeof(params) );
+    params.img.type          = IRP_CALL_IMG;
+    params.img.id            = id;
+    params.img.image_charact = image_charact;
+    params.img.map_size      = map_size;
+    params.img.machine       = machine;
+    params.img.contains_code = contains_code;
+    params.img.name_len      = name_len;
+
+    LIST_FOR_EACH_ENTRY( manager, &ob_managers, struct device_manager, ob_entry )
+    {
+        if ((irp = create_irp( NULL, &params, NULL )))
+        {
+            irp->iosb = (struct iosb *)grab_object( iosb );
+            add_irp_to_queue( manager, irp, NULL );
+            release_object( irp );
+        }
+    }
+    release_object( iosb );
+}
