+/* replay every currently-mapped PE image to interested device managers */
+void replay_image_loads(void)
+{
+    struct process *process;
+
+    LIST_FOR_EACH_ENTRY( process, &process_list, struct process, entry )
+        notify_process_images( process );
+}
