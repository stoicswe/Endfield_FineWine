+/* cross-process image-load notification (see PsSetLoadImageNotifyRoutineEx) */
+static NTSTATUS dispatch_img( struct dispatch_context *context )
+{
+    static const WCHAR emptyW[] = {0};
+    UNICODE_STRING name;
+    IMAGE_INFO info;
+    HANDLE pid = UlongToHandle( context->params.img.id );
+    unsigned int i;
+
+    if (context->in_buff && context->in_size && context->params.img.name_len <= context->in_size)
+    {
+        name.Buffer = context->in_buff;
+        name.Length = context->params.img.name_len;
+        name.MaximumLength = context->params.img.name_len;
+    }
+    else
+    {
+        name.Buffer = (WCHAR *)emptyW;
+        name.Length = 0;
+        name.MaximumLength = 0;
+    }
+
+    memset( &info, 0, sizeof(info) );
+    info.ImageAddressingMode = IMAGE_ADDRESSING_MODE_32BIT;
+    info.ImageBase = NULL;
+    info.ImageSize = context->params.img.map_size;
+
+    TRACE( "img %s pid %u size %u\n", debugstr_us(&name), context->params.img.id,
+           context->params.img.map_size );
+
+    for (i = 0; i < load_image_notify_routine_count; i++)
+        load_image_notify_routines[i]( &name, pid, &info );
+
+    return STATUS_SUCCESS;
+}
+
 typedef NTSTATUS (*dispatch_func)( struct dispatch_context *context );
 
