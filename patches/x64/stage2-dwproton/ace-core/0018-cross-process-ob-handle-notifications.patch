+/* register for cross-process object handle-operation notifications */
+DECL_HANDLER(ob_register_callbacks)
+{
+    struct device_manager *manager =
+        (struct device_manager *)get_handle_obj( current->process, req->manager, 0, &device_manager_ops );
+
+    if (manager)
+    {
+        set_ob_notifications( manager, 1 );
+        release_object( manager );
+    }
+}
+
+
+/* unregister cross-process object handle-operation notifications */
+DECL_HANDLER(ob_unregister_callbacks)
+{
+    struct device_manager *manager =
+        (struct device_manager *)get_handle_obj( current->process, req->manager, 0, &device_manager_ops );
+
+    if (manager)
+    {
+        set_ob_notifications( manager, 0 );
         release_object( manager );
     }
 }
