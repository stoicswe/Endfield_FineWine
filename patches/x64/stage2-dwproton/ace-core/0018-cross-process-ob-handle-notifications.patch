 /* ObRegisterCallbacks support. ACE-CORE registers process/thread
  * handle-operation callbacks; Wine stubbed this out entirely, so the callbacks
  * (and any event they signal) never fired. We store the registrations and
- * invoke them from the handle-open paths. */
+ * invoke them from the handle-open paths, and ask the server to forward
+ * handle operations from other processes (see IRP_CALL_OB). */
+#define OBJ_NOTIFY_PROCESS           1
+#define OBJ_NOTIFY_THREAD            2
+#define OBJ_NOTIFY_HANDLE_CREATE     1
+#define OBJ_NOTIFY_HANDLE_DUPLICATE  2
+
 struct ob_op_registration
 {
     ULONG_PTR group;
@@ -966,6 +972,49 @@
     EnterCriticalSection( &irp_completion_cs );
     IoCancelIrp( irp );
     LeaveCriticalSection( &irp_completion_cs );
+    return STATUS_SUCCESS;
+}
+
+/* cross-process object handle-operation notification (see ObRegisterCallbacks) */
+static NTSTATUS dispatch_ob( struct dispatch_context *context )
+{
+    POBJECT_TYPE type;
+    ACCESS_MASK access = context->params.ob.access;
+    void *object = NULL;
+    HANDLE handle;
+
+    if (context->params.ob.object_type == OBJ_NOTIFY_PROCESS)
+    {
+        if (!(handle = OpenProcess( PROCESS_ALL_ACCESS, FALSE, context->params.ob.id )))
+            return STATUS_INVALID_PARAMETER;
+        type = PsProcessType;
+    }
+    else
+    {
+        if (!(handle = OpenThread( THREAD_ALL_ACCESS, FALSE, context->params.ob.id )))
+            return STATUS_INVALID_PARAMETER;
+        type = PsThreadType;
+    }
+
+    if (kernel_object_from_handle( handle, type, &object ))
+    {
+        NtClose( handle );
+        return STATUS_INVALID_PARAMETER;
+    }
+    NtClose( handle );
+
+    TRACE( "ob %s %s id %u access %#x object %p\n",
+           context->params.ob.object_type == OBJ_NOTIFY_PROCESS ? "process" : "thread",
+           context->params.ob.is_post ? "post" : "pre", context->params.ob.id, context->params.ob.access,
+           object );
+
+    if (context->params.ob.is_post)
+        ob_call_post_operation_callbacks( type, context->params.ob.operation, object,
+                                          access, context->params.ob.status );
+    else
+        ob_call_pre_operation_callbacks( type, context->params.ob.operation, object, &access );
+
+    ObDereferenceObject( object );
     return STATUS_SUCCESS;
 }
 
