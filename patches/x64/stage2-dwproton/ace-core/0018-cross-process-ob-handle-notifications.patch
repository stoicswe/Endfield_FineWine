+/* add/remove a device manager from the cross-process ob notification list */
+static void set_ob_notifications( struct device_manager *manager, int enable )
+{
+    if (enable)
+    {
+        if (list_empty( &manager->ob_entry )) list_add_tail( &ob_managers, &manager->ob_entry );
     }
+    else if (!list_empty( &manager->ob_entry )) list_remove( &manager->ob_entry );
 }
 
+/* Queue an object handle-operation notification to every interested manager. */
+void notify_ob_operation( unsigned int object_type, unsigned int operation, int is_post,
+                          unsigned int id, unsigned int access, unsigned int status )
+{
+    struct device_manager *manager;
+    union irp_params params;
+    struct irp_call *irp;
 
+    if (list_empty( &ob_managers )) return;
+
+    memset( &params, 0, sizeof(params) );
+    params.ob.type        = IRP_CALL_OB;
+    params.ob.operation   = operation;
+    params.ob.object_type = object_type;
+    params.ob.id          = id;
+    params.ob.access      = access;
+    params.ob.is_post     = is_post;
+    params.ob.status      = status;
+
+    LIST_FOR_EACH_ENTRY( manager, &ob_managers, struct device_manager, ob_entry )
+    {
+        if ((irp = create_irp( NULL, &params, NULL )))
+        {
+            add_irp_to_queue( manager, irp, NULL );
+            release_object( irp );
+        }
+    }
+}
