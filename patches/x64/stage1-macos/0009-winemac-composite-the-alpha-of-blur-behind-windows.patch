+/***********************************************************************
+ *              macdrv_window_composite_alpha
+ *
+ * Make the window's Metal views non-opaque, so the window server composites
+ * their alpha as DWM would have.
+ */
+void macdrv_window_composite_alpha(macdrv_window w, bool composite_alpha)
+{
+@autoreleasepool
+{
+    WineWindow* window = (WineWindow*)w;
+
+    OnMainThread(^{
+        window.compositesAlpha = composite_alpha;
+        [(WineContentView*)window.contentView updateCompositesAlpha];
+    });
+}
+}
