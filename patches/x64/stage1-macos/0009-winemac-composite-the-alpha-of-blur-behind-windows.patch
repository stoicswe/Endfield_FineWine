+/***********************************************************************
+ *              window_composites_alpha
+ *
+ * HACK: Wine has no DWM to composite the alpha of a window that asked it to
+ * blur behind the window, as the GRYPHLINK launcher's rounded Qt window does.
+ * dwmapi marks those windows, and the window server composites them instead.
+ */
+static BOOL window_composites_alpha(HWND hwnd)
+{
+    return NtUserGetProp(hwnd, u"__wine_dwm_blur_behind") != NULL;
+}
+
+
+/***********************************************************************
+ *              window_keeps_per_pixel_alpha
+ *
+ * SetLayeredWindowAttributes() normally drops per-pixel alpha.  The GRYPHLINK
+ * launcher fades itself in with it, while relying on DWM to honor the alpha
+ * in its swapchain.
+ */
+static BOOL window_keeps_per_pixel_alpha(HWND hwnd)
+{
+    return window_composites_alpha(hwnd) && (NtUserGetWindowLongW(hwnd, GWL_EXSTYLE) & WS_EX_LAYERED);
+}
+
+
+/***********************************************************************
+ *              sync_window_composite_alpha
+ */
+static void sync_window_composite_alpha(struct macdrv_win_data *data)
+{
+    BOOL composite_alpha = window_composites_alpha(data->hwnd);
+    COLORREF key;
+    BYTE alpha;
+    DWORD flags;
+
+    if (!data->composite_alpha == !composite_alpha) return;
+
+    TRACE("setting window %p/%p composite-alpha to %d\n", data->hwnd, data->cocoa_window, composite_alpha);
+    macdrv_window_composite_alpha(data->cocoa_window, composite_alpha);
+    data->composite_alpha = composite_alpha;
+
+    /* A SetLayeredWindowAttributes() call before the blur request dropped per-pixel alpha. */
+    if (!data->ulw_layered && NtUserGetLayeredWindowAttributes(data->hwnd, &key, &alpha, &flags))
+        sync_window_opacity(data, alpha, window_keeps_per_pixel_alpha(data->hwnd), flags);
+}
+
