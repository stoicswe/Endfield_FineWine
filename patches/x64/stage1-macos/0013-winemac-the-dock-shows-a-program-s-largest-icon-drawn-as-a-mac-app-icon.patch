+/***********************************************************************
+ *              macdrv_SetWindowIcons
+ *
+ * FineWine: offer a top-level window's icon to the Dock. An icon loaded from a resource
+ * brings its whole group (every size), wherever the group is; any other icon brings itself.
+ */
+void macdrv_SetWindowIcons(HWND hwnd, HICON icon, const ICONINFO *ii, HICON icon_small, const ICONINFO *ii_small)
+{
+    static const WCHAR user32W[] = {'u','s','e','r','3','2','.','d','l','l',0};
+    struct app_icon_params source;
+    UNICODE_STRING module, res_name;
+    ICONINFO info;
+    HICON best = icon ? icon : icon_small;
+    CFMutableArrayRef images;
+    CGImageRef image;
+    const WCHAR *file;
+
+    if (!best || NtUserGetAncestor(hwnd, GA_PARENT) != NtUserGetDesktopWindow()) return;
+
+    /* The program's own icon first, so a window's icon only ever adds to it. */
+    pthread_once(&app_icon_once, set_app_icon);
+
+    memset(&source, 0, sizeof(source));
+    module.Buffer = source.module;
+    module.MaximumLength = sizeof(source.module) - sizeof(WCHAR);
+    res_name.Buffer = source.res_name;
+    res_name.MaximumLength = sizeof(source.res_name) - sizeof(WCHAR);
+    if (!NtUserGetIconInfo(best, &info, &module, &res_name, NULL, 0)) return;
+    NtGdiDeleteObjectApp(info.hbmColor);
+    NtGdiDeleteObjectApp(info.hbmMask);
+
+    if (module.Length)
+    {
+        source.module[min(module.Length, ARRAY_SIZE(source.module) - 1)] = 0;
+        if (!res_name.Length)
+        {
+            /* a numbered group: the number is the buffer pointer itself */
+            source.res_id = LOWORD((ULONG_PTR)res_name.Buffer);
+            source.res_name[0] = 0;
+        }
+        else source.res_name[min(res_name.Length, ARRAY_SIZE(source.res_name) - 1)] = 0;
+        TRACE("window %p icon %p is group %u %s in %s\n", hwnd, best, source.res_id,
+              debugstr_w(source.res_name), debugstr_w(source.module));
+        /* A window with no icon is handed Windows' stand-in (the Wine logo, IDI_WINLOGO), and
+         * many programs give their windows the generic one (IDI_APPLICATION); neither is the
+         * program's, and neither may take the Dock from the program's own icon. */
+        file = wcsrchr(source.module, '\\');
+        file = file ? file + 1 : source.module;
+        if (!wcsicmp(file, user32W) && (source.res_id == 32512 || source.res_id == 32517)) return;
+        offer_app_icon_images(create_app_icon_images(&source));
+        return;
+    }
+
+    /* An icon made at run time: its own picture, at its own size. */
+    TRACE("window %p icon %p has no resource behind it\n", hwnd, best);
+    if (!(image = create_cgimage_from_icon(best, 0, 0))) return;
+    if ((images = CFArrayCreateMutable(NULL, 1, &kCFTypeArrayCallBacks)))
+    {
+        CFArrayAppendValue(images, image);
+        offer_app_icon_images(images);
+    }
+    CGImageRelease(image);
+}
