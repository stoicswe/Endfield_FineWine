+/* FineWine: the Dock shows the largest picture of a program's icon there is. That starts as
+ * the program's own first icon group, all its sizes, read once per process (it does not change;
+ * reading it for every new window was slow enough that Helldivers 2 needed a hack); a window's
+ * icon replaces it only when it has a larger picture (launchers often load a 256-pixel icon at
+ * run time, and some programs have none of their own). */
+static pthread_mutex_t app_icon_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_once_t app_icon_once = PTHREAD_ONCE_INIT;
+static size_t app_icon_side;  /* the longest side of the Dock icon's largest picture; 0 for none */
+
+static size_t largest_image_side(CFArrayRef images)
+{
+    size_t side = 0;
+    CFIndex i;
+
+    for (i = 0; i < CFArrayGetCount(images); i++)
+    {
+        CGImageRef image = (CGImageRef)CFArrayGetValueAtIndex(images, i);
+        side = max(side, max(CGImageGetWidth(image), CGImageGetHeight(image)));
+    }
+    return side;
+}
+
+/* Takes the images for the Dock if they have a larger picture than it has now. */
+static void offer_app_icon_images(CFArrayRef images)
+{
+    size_t side;
+
+    if (!images) return;
+    side = largest_image_side(images);
+    TRACE("offered %ld images, largest %zu pixels; the Dock has %zu\n", (long)CFArrayGetCount(images), side, app_icon_side);
+    pthread_mutex_lock(&app_icon_mutex);
+    if (side > app_icon_side)
+    {
+        TRACE("Dock icon now %zu pixels (was %zu)\n", side, app_icon_side);
+        app_icon_side = side;
+        macdrv_set_application_icon(images, NULL);
+    }
+    pthread_mutex_unlock(&app_icon_mutex);
+    CFRelease(images);
+}
