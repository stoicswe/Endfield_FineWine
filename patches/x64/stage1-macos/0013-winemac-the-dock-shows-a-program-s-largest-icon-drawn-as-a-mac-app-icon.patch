diff --git a/dlls/winemac.drv/cocoa_icon_utils.m b/dlls/winemac.drv/cocoa_icon_utils.m
index f43447b..53c7c29 100644
--- a/dlls/winemac.drv/cocoa_icon_utils.m
+++ b/dlls/winemac.drv/cocoa_icon_utils.m
@@ -26,6 +26,141 @@
 #pragma GCC diagnostic ignored "-Wdeclaration-after-statement"
 
 
+/* FineWine: a Windows icon is drawn as a Mac app icon is: on Apple's icon grid (an 824-point
+ * rounded square in a 1024-point canvas, with its shadow below), so it sits in the Dock and the
+ * app switcher the size and shape of the Mac apps next to it. An icon that is a square picture
+ * already (game art, or a tile with rounded corners of its own) fills the rounded square; any
+ * other shape stands on a light plate, scaled from its visible part, not from the empty margin
+ * around it. FINEWINE_MAC_ICONS=0 leaves icons as they are. */
+static BOOL finewine_mac_icons(void)
+{
+    const char *value = getenv("FINEWINE_MAC_ICONS");
+    return !(value && !strcmp(value, "0"));
+}
+
+/* Where the visible pixels of a picture are, as a fraction of its size (y from the top), and
+ * how much of that rectangle they cover. */
+static CGRect finewine_icon_visible_part(CGImageRef image, double *coverage)
+{
+    size_t width = CGImageGetWidth(image), height = CGImageGetHeight(image), x, y, opaque = 0;
+    size_t left = width, right = 0, top = height, bottom = 0;
+    unsigned char *alpha;
+    CGContextRef context;
+
+    *coverage = 0;
+    if (!width || !height || !(alpha = calloc(width, height))) return CGRectMake(0, 0, 1, 1);
+    context = CGBitmapContextCreate(alpha, width, height, 8, width, NULL, (CGBitmapInfo)kCGImageAlphaOnly);
+    if (!context)
+    {
+        free(alpha);
+        return CGRectMake(0, 0, 1, 1);
+    }
+    CGContextDrawImage(context, CGRectMake(0, 0, width, height), image);
+    CGContextRelease(context);
+
+    for (y = 0; y < height; y++)
+        for (x = 0; x < width; x++)
+            if (alpha[y * width + x] > 24)
+            {
+                if (x < left) left = x;
+                if (x > right) right = x;
+                if (y < top) top = y;
+                if (y > bottom) bottom = y;
+            }
+    if (left > right || top > bottom)
+    {
+        free(alpha);
+        return CGRectMake(0, 0, 1, 1);
+    }
+    for (y = top; y <= bottom; y++)
+        for (x = left; x <= right; x++)
+            if (alpha[y * width + x] > 200) opaque++;
+    *coverage = (double)opaque / ((right - left + 1) * (bottom - top + 1));
+    free(alpha);
+    return CGRectMake((double)left / width, (double)top / height,
+                      (double)(right - left + 1) / width, (double)(bottom - top + 1) / height);
+}
+
+static NSImage* finewine_mac_style_icon(NSImage* icon, CGImageRef largest)
+{
+    static const int sides[] = { 1024, 512, 256, 128, 64, 32, 16 };
+    NSSize size = [icon size];
+    double coverage;
+    CGRect part = finewine_icon_visible_part(largest, &coverage);
+    double aspect = part.size.width * size.width / (part.size.height * size.height);
+    /* a square picture with nothing see-through in it, give or take rounded corners */
+    BOOL tile = coverage >= 0.9 && aspect > 0.9 && aspect < 1.11;
+    /* a small icon scaled up stays crisp rather than blurred */
+    BOOL crisp = MAX(CGImageGetWidth(largest), CGImageGetHeight(largest)) <= 48;
+    NSRect from = NSMakeRect(part.origin.x * size.width,
+                             (1 - part.origin.y - part.size.height) * size.height,
+                             part.size.width * size.width, part.size.height * size.height);
+    NSImage* styled = [[[NSImage alloc] initWithSize:NSMakeSize(1024, 1024)] autorelease];
+    unsigned i;
+
+    if (!tile)
+    {
+        /* Square, around the visible part, so the shape keeps its proportions and stays centred. */
+        CGFloat side = MAX(from.size.width, from.size.height);
+        from = NSMakeRect(NSMidX(from) - side / 2, NSMidY(from) - side / 2, side, side);
+    }
+
+    for (i = 0; i < sizeof(sides) / sizeof(sides[0]); i++)
+    {
+        int px = sides[i];
+        CGFloat s = px / 1024.0;
+        NSBitmapImageRep* rep = [[NSBitmapImageRep alloc] initWithBitmapDataPlanes:NULL pixelsWide:px pixelsHigh:px
+                                                                     bitsPerSample:8 samplesPerPixel:4 hasAlpha:YES isPlanar:NO
+                                                                    colorSpaceName:NSCalibratedRGBColorSpace bytesPerRow:0 bitsPerPixel:0];
+        NSRect plate = NSMakeRect(100 * s, 100 * s, 824 * s, 824 * s);
+        NSBezierPath* path = [NSBezierPath bezierPathWithRoundedRect:plate xRadius:185.4 * s yRadius:185.4 * s];
+        NSDictionary* hints = @{ NSImageHintInterpolation: @(crisp ? NSImageInterpolationNone : NSImageInterpolationHigh) };
+        NSShadow* shadow = [[[NSShadow alloc] init] autorelease];
+        NSGraphicsContext* context;
+
+        if (!rep) continue;
+        context = [NSGraphicsContext graphicsContextWithBitmapImageRep:rep];
+        [NSGraphicsContext saveGraphicsState];
+        [NSGraphicsContext setCurrentContext:context];
+        [context setImageInterpolation:crisp ? NSImageInterpolationNone : NSImageInterpolationHigh];
+
+        /* the rounded square and its shadow */
+        [NSGraphicsContext saveGraphicsState];
+        [shadow setShadowColor:[NSColor colorWithCalibratedWhite:0 alpha:0.3]];
+        [shadow setShadowOffset:NSMakeSize(0, -10 * s)];
+        [shadow setShadowBlurRadius:22 * s];
+        [shadow set];
+        [[NSColor whiteColor] setFill];
+        [path fill];
+        [NSGraphicsContext restoreGraphicsState];
+
+        [NSGraphicsContext saveGraphicsState];
+        [path addClip];
+        if (tile)
+            [icon drawInRect:plate fromRect:from operation:NSCompositingOperationSourceOver
+                    fraction:1 respectFlipped:YES hints:hints];
+        else
+        {
+            NSGradient* plateColour = [[[NSGradient alloc] initWithStartingColor:[NSColor colorWithCalibratedWhite:1 alpha:1]
+                                                                    endingColor:[NSColor colorWithCalibratedWhite:0.9 alpha:1]] autorelease];
+            [plateColour drawInBezierPath:path angle:-90];
+            [icon drawInRect:NSInsetRect(plate, 112 * s, 112 * s) fromRect:from operation:NSCompositingOperationSourceOver
+                    fraction:1 respectFlipped:YES hints:hints];
+        }
+        [NSGraphicsContext restoreGraphicsState];
+
+        /* a hairline edge, as Mac icons have, so a white plate holds against a light Dock */
+        [[NSColor colorWithCalibratedWhite:0 alpha:0.1] setStroke];
+        [path setLineWidth:MAX(1, 2 * s)];
+        [path stroke];
+
+        [NSGraphicsContext restoreGraphicsState];
+        [styled addRepresentation:rep];
+        [rep release];
+    }
+    return [[styled representations] count] ? styled : icon;
+}
