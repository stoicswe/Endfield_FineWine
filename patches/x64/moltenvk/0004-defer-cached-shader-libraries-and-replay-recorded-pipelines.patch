+// Returns a new (retained) function built from a function recipe, compiling its library if needed.
+id<MTLFunction> MVKPipelineCache::newReplayFunction(const char* pRecipe, uint32_t size) {
+	uint64_t contentKey;
+	if (size < sizeof(contentKey)) { return nil; }
+	memcpy(&contentKey, pRecipe, sizeof(contentKey));
+	auto libIter = _librariesByContentKey.find(contentKey);
+	if (libIter == _librariesByContentKey.end()) { return nil; }
+
+	// Specialization consumers read values by their shader type rather than the entry size,
+	// so accept only valid Vulkan sizes and give every value an 8-byte slot to read from.
+	static constexpr uint32_t kSlotSize = 8;
+	MVKSmallVector<VkSpecializationMapEntry> mapEntries;
+	std::string specData;
+	MVKRecipeReader r = { pRecipe + sizeof(contentKey), pRecipe + size };
+	while (r.ok && r.p < r.end) {
+		uint32_t constantID = r.u32();
+		uint32_t valSize;
+		const char* val = r.blob(valSize);
+		if ( !r.ok || !(valSize == 1 || valSize == 2 || valSize == 4 || valSize == 8) ) { return nil; }
+		mapEntries.push_back({constantID, (uint32_t)specData.size(), valSize});
+		specData.append(val, valSize);
+		specData.append(kSlotSize - valSize, '\0');
+	}
+	VkSpecializationInfo specInfo = { (uint32_t)mapEntries.size(), mapEntries.data(), specData.size(), specData.data() };
+	MVKMTLFunction mvkFunc = libIter->second->getMTLFunction(mapEntries.empty() ? nullptr : &specInfo, nullptr, nullptr);
+	return [mvkFunc.getMTLFunction() retain];
+}
+
+bool MVKPipelineCache::areAttachmentFormatsSupported(MTLRenderPipelineDescriptor* plDesc) {
+	MVKPixelFormats* pixFmts = getPixelFormats();
+	auto isSupported = [&](MTLPixelFormat mtlFmt, MVKMTLFmtCaps caps) {
+		return mtlFmt == MTLPixelFormatInvalid || mvkAreAllFlagsEnabled(pixFmts->getCapabilities(mtlFmt), caps);
+	};
+	for (uint32_t i = 0; i < kMVKMaxColorAttachmentCount; i++) {
+		if ( !isSupported(plDesc.colorAttachments[i].pixelFormat, kMVKMTLFmtCapsColorAtt) ) { return false; }
+	}
+	return (isSupported(plDesc.depthAttachmentPixelFormat, kMVKMTLFmtCapsDSAtt) &&
+			isSupported(plDesc.stencilAttachmentPixelFormat, kMVKMTLFmtCapsDSAtt));
+}
+
+// Compile and discard the pipeline to warm Metal's cache.
+void MVKPipelineCache::replayPipeline(const std::string& recipe) {
+	@autoreleasepool {
+		id plDesc = newDescriptor(recipe, ^id<MTLFunction>(const char* fnRecipe, uint32_t size) {
+			return newReplayFunction(fnRecipe, size);
+		});
+		if ( !plDesc ) { return; }
+
+		// Metal aborts on unsupported formats; the cache may come from another device.
+		if ([plDesc isKindOfClass: [MTLRenderPipelineDescriptor class]] && !areAttachmentFormatsSupported(plDesc)) {
+			[plDesc release];
+			return;
+		}
+
+		id plState = nil;
+		if ([plDesc isKindOfClass: [MTLRenderPipelineDescriptor class]]) {
+			plState = [getMTLDevice() newRenderPipelineStateWithDescriptor: plDesc error: nil];
+		} else {
+			plState = [getMTLDevice() newComputePipelineStateWithDescriptor: plDesc
+																	options: MTLPipelineOptionNone
+																 reflection: nil
+																	  error: nil];
+		}
+		[plDesc release];
+		[plState release];
+	}
+}
