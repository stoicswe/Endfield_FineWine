+// Attach replay data to the function: library key, then each constant's ID, size, and value bytes.
+static void setFunctionRecipe(id<MTLFunction> mtlFunc, uint64_t contentKey, const VkSpecializationInfo* pSpecInfo) {
+	NSMutableData* recipe = [NSMutableData dataWithBytes: &contentKey length: sizeof(contentKey)];
+	for (uint32_t i = 0; pSpecInfo && i < pSpecInfo->mapEntryCount; i++) {
+		const auto& me = pSpecInfo->pMapEntries[i];
+		uint32_t hdr[2] = { me.constantID, (uint32_t)me.size };
+		[recipe appendBytes: hdr length: sizeof(hdr)];
+		[recipe appendBytes: (const char*)pSpecInfo->pData + me.offset length: me.size];
+	}
+	objc_setAssociatedObject(mtlFunc, &kMVKFunctionRecipeKey, recipe, OBJC_ASSOCIATION_RETAIN);
+}
