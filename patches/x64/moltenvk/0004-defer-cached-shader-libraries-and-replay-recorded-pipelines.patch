+void MVKPipelineCache::recordPipeline(MTLRenderPipelineDescriptor* plDesc) { addPipelineRecipe(plDesc); }
+
+void MVKPipelineCache::recordPipeline(MTLComputePipelineDescriptor* plDesc) { addPipelineRecipe(plDesc); }
