+// Queue recorded pipelines in creation order, then remaining libraries. Limit workers
+// to leave compile capacity for the app; zero disables background work.
+void MVKPipelineCache::startBackgroundWork(std::vector<MVKShaderLibrary*> shLibs) {
+	static const uint32_t workerCount = (uint32_t)mvkGetEnvVarNumber("MVK_CONFIG_PIPELINE_CACHE_BACKGROUND_WORKERS", 4);
+	if ((shLibs.empty() && _pipelineRecipes.empty()) || workerCount == 0) { return; }
+
+	// Recording may append to the live recipe list while the workers run.
+	auto pRecipes = std::make_shared<std::vector<std::string>>(_pipelineRecipes);
+	auto pLibs = std::make_shared<std::vector<MVKShaderLibrary*>>(std::move(shLibs));
+	auto pNext = std::make_shared<std::atomic<size_t>>(0);
+	_backgroundWork = dispatch_group_create();
+	dispatch_queue_t queue = dispatch_get_global_queue(QOS_CLASS_UTILITY, 0);
+	for (uint32_t worker = 0; worker < workerCount; worker++) {
+		dispatch_group_async(_backgroundWork, queue, ^{
+			size_t recipeCnt = pRecipes->size();
+			while ( !_stopBackgroundWork.load(std::memory_order_relaxed) ) {
+				size_t idx = pNext->fetch_add(1, std::memory_order_relaxed);
+				if (idx < recipeCnt) {
+					replayPipeline((*pRecipes)[idx]);
+				} else if (idx - recipeCnt < pLibs->size()) {
+					@autoreleasepool { (*pLibs)[idx - recipeCnt]->compileIfNeeded(); }
+				} else {
+					break;
+				}
+			}
+		});
+	}
+}
+
+#pragma mark Pipeline recipes
+
+// Recipes store descriptor properties and reference functions by library content key and
+// specialization constants. New recipes must reconstruct an equal descriptor to be recorded.
+
+namespace {
+
+enum : uint32_t {
+	kMVKRecipeRender = 1,
+	kMVKRecipeCompute = 2,
+};
+
+struct MVKRecipeWriter {
+	std::string out;
+	void u32(uint32_t v) { out.append((const char*)&v, sizeof(v)); }
+	void blob(const void* p, uint32_t n) { u32(n); out.append((const char*)p, n); }
+	bool function(id<MTLFunction> mtlFunc) {
+		if ( !mtlFunc ) { u32(0); return true; }
+		NSData* fnRecipe = MVKShaderLibrary::getFunctionRecipe(mtlFunc);
+		if ( !fnRecipe ) { return false; }
+		blob(fnRecipe.bytes, (uint32_t)fnRecipe.length);
+		return true;
+	}
+};
+
+struct MVKRecipeReader {
+	const char* p;
+	const char* end;
+	bool ok = true;
+	uint32_t u32() {
+		uint32_t v = 0;
+		if (end - p < (ptrdiff_t)sizeof(v)) { ok = false; return 0; }
+		memcpy(&v, p, sizeof(v));
+		p += sizeof(v);
+		return v;
+	}
+	const char* blob(uint32_t& n) {
+		n = u32();
+		if ( !ok || end - p < (ptrdiff_t)n) { ok = false; return nullptr; }
+		const char* b = p;
+		p += n;
+		return b;
+	}
+};
+
+// Returns a retained function. A nil result for a non-empty reference fails decoding.
+typedef id<MTLFunction> (^MVKRecipeFunctionResolver)(const char* fnRecipe, uint32_t size);
+
+void encodeVertexDescriptor(MVKRecipeWriter& w, MTLVertexDescriptor* vd) {
+	for (uint32_t i = 0; i < kMVKMaxBufferCount; i++) {
+		auto* l = vd.layouts[i];
+		if (l.stride || l.stepFunction != MTLVertexStepFunctionPerVertex || l.stepRate != 1) {
+			w.u32(i); w.u32((uint32_t)l.stride); w.u32((uint32_t)l.stepFunction); w.u32((uint32_t)l.stepRate);
+		}
+	}
+	w.u32(UINT32_MAX);
+	for (uint32_t i = 0; i < kMVKMaxBufferCount; i++) {
+		auto* a = vd.attributes[i];
+		if (a.format != MTLVertexFormatInvalid || a.offset || a.bufferIndex) {
+			w.u32(i); w.u32((uint32_t)a.format); w.u32((uint32_t)a.offset); w.u32((uint32_t)a.bufferIndex);
+		}
+	}
+	w.u32(UINT32_MAX);
+}
+
+void decodeVertexDescriptor(MVKRecipeReader& r, MTLVertexDescriptor* vd) {
+	for (uint32_t i = r.u32(); r.ok && i < kMVKMaxBufferCount; i = r.u32()) {
+		auto* l = vd.layouts[i];
+		l.stride = r.u32(); l.stepFunction = (MTLVertexStepFunction)r.u32(); l.stepRate = r.u32();
+	}
+	for (uint32_t i = r.u32(); r.ok && i < kMVKMaxBufferCount; i = r.u32()) {
+		auto* a = vd.attributes[i];
+		a.format = (MTLVertexFormat)r.u32(); a.offset = r.u32(); a.bufferIndex = r.u32();
+	}
+}
+
+void encodeStageInput(MVKRecipeWriter& w, MTLStageInputOutputDescriptor* sd) {
+	w.u32(sd ? 1 : 0);
+	if ( !sd ) { return; }
+	for (uint32_t i = 0; i < kMVKMaxBufferCount; i++) {
+		auto* l = sd.layouts[i];
+		w.u32((uint32_t)l.stride); w.u32((uint32_t)l.stepFunction); w.u32((uint32_t)l.stepRate);
+		auto* a = sd.attributes[i];
+		w.u32((uint32_t)a.format); w.u32((uint32_t)a.offset); w.u32((uint32_t)a.bufferIndex);
+	}
+	w.u32((uint32_t)sd.indexType); w.u32((uint32_t)sd.indexBufferIndex);
+}
+
+void decodeStageInput(MVKRecipeReader& r, MTLComputePipelineDescriptor* plDesc) {
+	if ( !r.u32() ) { return; }
+	MTLStageInputOutputDescriptor* sd = [MTLStageInputOutputDescriptor stageInputOutputDescriptor];
+	for (uint32_t i = 0; i < kMVKMaxBufferCount; i++) {
+		auto* l = sd.layouts[i];
+		l.stride = r.u32(); l.stepFunction = (MTLStepFunction)r.u32(); l.stepRate = r.u32();
+		auto* a = sd.attributes[i];
+		a.format = (MTLAttributeFormat)r.u32(); a.offset = r.u32(); a.bufferIndex = r.u32();
+	}
+	sd.indexType = (MTLIndexType)r.u32(); sd.indexBufferIndex = r.u32();
+	plDesc.stageInputDescriptor = sd;
+}
+
+bool encodeRecipe(MVKRecipeWriter& w, MTLRenderPipelineDescriptor* d) {
+	w.u32(kMVKRecipeRender);
+	if ( !(w.function(d.vertexFunction) && w.function(d.fragmentFunction)) ) { return false; }
+	encodeVertexDescriptor(w, d.vertexDescriptor);
+	for (uint32_t i = 0; i < kMVKMaxColorAttachmentCount; i++) {
+		auto* ca = d.colorAttachments[i];
+		w.u32((uint32_t)ca.pixelFormat); w.u32((uint32_t)ca.writeMask); w.u32(ca.isBlendingEnabled);
+		w.u32((uint32_t)ca.sourceRGBBlendFactor); w.u32((uint32_t)ca.destinationRGBBlendFactor); w.u32((uint32_t)ca.rgbBlendOperation);
+		w.u32((uint32_t)ca.sourceAlphaBlendFactor); w.u32((uint32_t)ca.destinationAlphaBlendFactor); w.u32((uint32_t)ca.alphaBlendOperation);
+	}
+	w.u32((uint32_t)d.depthAttachmentPixelFormat);
+	w.u32((uint32_t)d.stencilAttachmentPixelFormat);
+	w.u32((uint32_t)d.rasterSampleCount);
+	w.u32(d.isAlphaToCoverageEnabled);
+	w.u32(d.isAlphaToOneEnabled);
+	w.u32(d.isRasterizationEnabled);
+	w.u32((uint32_t)d.inputPrimitiveTopology);
+	w.u32((uint32_t)d.maxVertexAmplificationCount);
+	w.u32(d.supportIndirectCommandBuffers);
+	w.u32((uint32_t)d.tessellationPartitionMode);
+	w.u32((uint32_t)d.maxTessellationFactor);
+	w.u32(d.isTessellationFactorScaleEnabled);
+	w.u32((uint32_t)d.tessellationFactorFormat);
+	w.u32((uint32_t)d.tessellationControlPointIndexType);
+	w.u32((uint32_t)d.tessellationFactorStepFunction);
+	w.u32((uint32_t)d.tessellationOutputWindingOrder);
+
+	// Omit default private-API properties to preserve compatibility with older recipes.
+	static MTLRenderPipelineDescriptor* defaults = [MTLRenderPipelineDescriptor new];
+	if (d.sampleMaskMVK != defaults.sampleMaskMVK ||
+		d.isLogicOperationEnabledMVK != defaults.isLogicOperationEnabledMVK ||
+		d.logicOperationMVK != defaults.logicOperationMVK) {
+		w.u32((uint32_t)d.sampleMaskMVK);
+		w.u32(d.isLogicOperationEnabledMVK);
+		w.u32((uint32_t)d.logicOperationMVK);
+	}
+	return true;
+}
+
+bool encodeRecipe(MVKRecipeWriter& w, MTLComputePipelineDescriptor* d) {
+	w.u32(kMVKRecipeCompute);
+	if ( !d.computeFunction || !w.function(d.computeFunction) ) { return false; }
+	w.u32((uint32_t)d.maxTotalThreadsPerThreadgroup);
+	w.u32(d.threadGroupSizeIsMultipleOfThreadExecutionWidth);
+	w.u32(d.supportIndirectCommandBuffers);
+	encodeStageInput(w, d.stageInputDescriptor);
+	return true;
+}
+
+// Returns a function decoded from the reader, or nil if the reference is empty or invalid.
+id<MTLFunction> decodeFunction(MVKRecipeReader& r, MVKRecipeFunctionResolver resolve) {
+	uint32_t size;
+	const char* fnRecipe = r.blob(size);
+	if ( !r.ok || !size ) { return nil; }
+	id<MTLFunction> mtlFunc = resolve(fnRecipe, size);
+	if ( !mtlFunc ) { r.ok = false; }
+	return mtlFunc;
+}
+
+// Returns a retained descriptor, or nil for an invalid recipe or unavailable function.
+id newDescriptor(const std::string& recipe, MVKRecipeFunctionResolver resolve) {
+	MVKRecipeReader r = { recipe.data(), recipe.data() + recipe.size() };
+	switch (r.u32()) {
+		case kMVKRecipeRender: {
+			MTLRenderPipelineDescriptor* d = [MTLRenderPipelineDescriptor new];
+			id<MTLFunction> vtxFunc = decodeFunction(r, resolve);
+			id<MTLFunction> fragFunc = r.ok ? decodeFunction(r, resolve) : nil;
+			d.vertexFunction = vtxFunc;
+			d.fragmentFunction = fragFunc;
+			[vtxFunc release];
+			[fragFunc release];
+			decodeVertexDescriptor(r, d.vertexDescriptor);
+			for (uint32_t i = 0; r.ok && i < kMVKMaxColorAttachmentCount; i++) {
+				auto* ca = d.colorAttachments[i];
+				ca.pixelFormat = (MTLPixelFormat)r.u32(); ca.writeMask = r.u32(); ca.blendingEnabled = r.u32();
+				ca.sourceRGBBlendFactor = (MTLBlendFactor)r.u32(); ca.destinationRGBBlendFactor = (MTLBlendFactor)r.u32(); ca.rgbBlendOperation = (MTLBlendOperation)r.u32();
+				ca.sourceAlphaBlendFactor = (MTLBlendFactor)r.u32(); ca.destinationAlphaBlendFactor = (MTLBlendFactor)r.u32(); ca.alphaBlendOperation = (MTLBlendOperation)r.u32();
+			}
+			d.depthAttachmentPixelFormat = (MTLPixelFormat)r.u32();
+			d.stencilAttachmentPixelFormat = (MTLPixelFormat)r.u32();
+			d.rasterSampleCount = r.u32();
+			d.alphaToCoverageEnabled = r.u32();
+			d.alphaToOneEnabled = r.u32();
+			d.rasterizationEnabled = r.u32();
+			d.inputPrimitiveTopology = (MTLPrimitiveTopologyClass)r.u32();
+			d.maxVertexAmplificationCount = r.u32();
+			d.supportIndirectCommandBuffers = r.u32();
+			d.tessellationPartitionMode = (MTLTessellationPartitionMode)r.u32();
+			d.maxTessellationFactor = r.u32();
+			d.tessellationFactorScaleEnabled = r.u32();
+			d.tessellationFactorFormat = (MTLTessellationFactorFormat)r.u32();
+			d.tessellationControlPointIndexType = (MTLTessellationControlPointIndexType)r.u32();
+			d.tessellationFactorStepFunction = (MTLTessellationFactorStepFunction)r.u32();
+			d.tessellationOutputWindingOrder = (MTLWinding)r.u32();
+			if (r.p < r.end) {		// Optional private-API properties
+				d.sampleMaskMVK = r.u32();
+				d.logicOperationEnabledMVK = r.u32();
+				d.logicOperationMVK = r.u32();
+			}
+			if (r.ok && r.p == r.end && vtxFunc) { return d; }
+			[d release];
+			return nil;
+		}
+		case kMVKRecipeCompute: {
+			MTLComputePipelineDescriptor* d = [MTLComputePipelineDescriptor new];
+			id<MTLFunction> compFunc = decodeFunction(r, resolve);
+			d.computeFunction = compFunc;
+			[compFunc release];
+			d.maxTotalThreadsPerThreadgroup = r.u32();
+			d.threadGroupSizeIsMultipleOfThreadExecutionWidth = r.u32();
+			d.supportIndirectCommandBuffers = r.u32();
+			if (r.ok) { decodeStageInput(r, d); }
+			if (r.ok && r.p == r.end && compFunc) { return d; }
+			[d release];
+			return nil;
+		}
+		default:
+			return nil;
+	}
+}
+
+template <class D>
+bool isRecipeFaithful(const std::string& recipe, D* plDesc) {
+	// Reuse the original functions to compare descriptor properties without recompiling.
+	NSMutableArray<id<MTLFunction>>* funcs = [NSMutableArray array];
+	if constexpr (std::is_same_v<D, MTLRenderPipelineDescriptor>) {
+		[funcs addObject: plDesc.vertexFunction];
+		if (plDesc.fragmentFunction) { [funcs addObject: plDesc.fragmentFunction]; }
+	} else {
+		[funcs addObject: plDesc.computeFunction];
+	}
+	__block NSUInteger funcIdx = 0;
+	D* rebuilt = newDescriptor(recipe, ^id<MTLFunction>(const char*, uint32_t) {
+		return funcIdx < funcs.count ? [funcs[funcIdx++] retain] : nil;
+	});
+	if (plDesc.label) { rebuilt.label = plDesc.label; }
+	bool isEqual = [rebuilt isEqual: plDesc];
+	[rebuilt release];
+	return isEqual;
+}
