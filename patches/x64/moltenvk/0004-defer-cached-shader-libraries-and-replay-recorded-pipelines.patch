+template <class D>
+void MVKPipelineCache::addPipelineRecipe(D* plDesc) {
+	@autoreleasepool {
+		MVKRecipeWriter w;
+		if ( !encodeRecipe(w, plDesc) ) { return; }
+		size_t recipeHash = std::hash<std::string>{}(w.out);
+		{
+			auto lock = lockCache();
+			if (_pipelineRecipeHashes.count(recipeHash)) { return; }
+		}
+		if ( !isRecipeFaithful(w.out, plDesc) ) { return; }
+
+		auto lock = lockCache();
+		if ( !_pipelineRecipeHashes.insert(recipeHash).second ) { return; }	// Another thread recorded it.
+		// Grow the cached size rather than recounting the whole cache: a cereal
+		// entry type, then the string as a 64-bit length and its bytes.
+		if (_dataSize) { _dataSize += sizeof(uint32_t) + sizeof(uint64_t) + w.out.size(); }
+		_pipelineRecipes.push_back(std::move(w.out));
+	}
+}
