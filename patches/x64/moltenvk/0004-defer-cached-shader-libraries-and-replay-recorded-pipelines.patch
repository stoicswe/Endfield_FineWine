+// Keep in sync with the per-library options used by getMTLCompileOptions().
+static uint64_t getCompileOptionsKey(const SPIRVToMSLConversionResultInfo& resultInfo) {
+	return (uint64_t)resultInfo.entryPoint.fpFastMathFlags << 1 | (uint64_t)resultInfo.isPositionInvariant;
+}
+
+// Deterministic compression lets us hash stored bytes without decompressing MSL.
+uint64_t MVKShaderLibrary::getContentKey(const MVKCompressor<string>& compressedMSL, const SPIRVToMSLConversionResultInfo& resultInfo) {
+	const auto& bytes = compressedMSL._compressed;
+	uint64_t key = std::hash<string_view>{}(string_view((const char*)bytes.data(), bytes.size()));
+	key ^= getCompileOptionsKey(resultInfo) * 0x9E3779B97F4A7C15ULL;
+	key ^= (uint64_t)compressedMSL._uncompressedSize << 32 ^ (uint64_t)compressedMSL._algorithm << 24;
+	return key ? key : 1;
+}
+
+bool MVKShaderLibrary::isSameCompile(const MVKCompressor<string>& compressedMSL1, const SPIRVToMSLConversionResultInfo& resultInfo1,
+									 const MVKCompressor<string>& compressedMSL2, const SPIRVToMSLConversionResultInfo& resultInfo2) {
+	return (getCompileOptionsKey(resultInfo1) == getCompileOptionsKey(resultInfo2) &&
+			compressedMSL1._algorithm == compressedMSL2._algorithm &&
+			compressedMSL1._uncompressedSize == compressedMSL2._uncompressedSize &&
+			compressedMSL1._compressed == compressedMSL2._compressed);
