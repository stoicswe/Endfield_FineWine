diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index 494e056..5452ecc 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -568,7 +568,7 @@ static char *extract_exe_name(const char *exe_path)
  */
 static char *create_tempdir(const char *wineloader_path)
 {
-    char *str, *ntdll, *p, *tempdir = malloc(MAX_PATH);
+    char *str, *tmp, *ntdll, *p, *tempdir = malloc(MAX_PATH);
     struct stat st;
     size_t n;
 
@@ -594,7 +594,13 @@ static char *create_tempdir(const char *wineloader_path)
     if ((p = strrchr( ntdll, '/' ))) *p = 0;
     strcat( ntdll, "/ntdll.so" );
     asprintf( &str, "%s/ntdll.so", tempdir );
-    symlink( ntdll, str );
+    /* Endfield_FineWine: the directory is keyed on the loader's inode, which survives moving or
+       renaming the app bundle, so an existing link may point at the old location. Replace it
+       atomically instead of keeping it. */
+    asprintf( &tmp, "%s/ntdll.so.%d", tempdir, (int)getpid() );
+    unlink( tmp );
+    if (!symlink( ntdll, tmp ) && rename( tmp, str )) unlink( tmp );
+    free( tmp );
     free( str );
     free( ntdll);
     return tempdir;
