 /***********************************************************************
+ *           handle_multibyte_nop
+ *
+ * Decode a documented 0F 1F /0 NOP reported as an invalid opcode on macOS.
+ * Do not suppress faults for LOCK, reserved /reg encodings or incomplete
+ * instructions. Address-size override selects 32-bit addressing in long mode;
+ * SIB and displacement lengths are the same as for 64-bit addressing.
+ */
+static inline BOOL handle_multibyte_nop( ucontext_t *sigcontext, CONTEXT *context )
+{
+    BYTE instr[15], modrm;
+    unsigned int p = 0, mod, rm, disp = 0;
+    unsigned int len = virtual_uninterrupted_read_memory( (BYTE *)context->Rip, instr, sizeof(instr) );
+
+    while (p < len)
+    {
+        switch (instr[p])
+        {
+        case 0xf0: /* LOCK is invalid on NOP. */
+        case 0xf2: /* Do not accept undocumented repeat-prefix forms. */
+        case 0xf3:
+            return FALSE;
+        case 0x26: case 0x2e: case 0x36: case 0x3e: case 0x64: case 0x65:
+        case 0x66: case 0x67:
+        case 0x40: case 0x41: case 0x42: case 0x43:
+        case 0x44: case 0x45: case 0x46: case 0x47:
+        case 0x48: case 0x49: case 0x4a: case 0x4b:
+        case 0x4c: case 0x4d: case 0x4e: case 0x4f:
+            p++;
+            continue;
+        }
+        break;
+    }
+    if (len - p < 3 || instr[p] != 0x0f || instr[p + 1] != 0x1f) return FALSE;
+    p += 2;
+    modrm = instr[p++];
+    if (modrm & 0x38) return FALSE; /* Only /0 is documented. */
+    mod = modrm >> 6;
+    rm = modrm & 7;
+    if (mod != 3 && rm == 4)
+    {
+        BYTE sib;
+        if (p >= len) return FALSE;
+        sib = instr[p++];
+        if (mod == 0 && (sib & 7) == 5) disp = 4;
+    }
+    if (mod == 1) disp = 1;
+    else if (mod == 2 || (mod == 0 && rm == 5)) disp = 4;
+    if (disp > len - p) return FALSE;
+    p += disp;
+    /* len is bounded by the architectural 15-byte instruction limit. */
+    RIP_sig(sigcontext) += p;
+    TRACE_(seh)( "skipped multi-byte NOP (0F 1F /0), length %u\n", p );
+    return TRUE;
+}
+
