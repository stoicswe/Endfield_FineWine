-    sync_window_opacity(data, alpha, FALSE, layered_flags);
+    sync_window_opacity(data, alpha, window_keeps_per_pixel_alpha(data->hwnd), layered_flags);
 
 done:
     if (win_rgn) NtGdiDeleteObjectApp(win_rgn);
@@ -1376,7 +1389,7 @@ void macdrv_SetLayeredWindowAttributes(HWND hwnd, COLORREF key, BYTE alpha, DWOR
