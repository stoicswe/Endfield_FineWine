+/***********************************************************************
+ *              window_keeps_per_pixel_alpha
+ *
+ * SetLayeredWindowAttributes() normally drops per-pixel alpha.  The GRYPHLINK
+ * launcher fades itself in with it, while relying on DWM to honor the alpha
+ * in its swapchain.
+ */
+static BOOL window_keeps_per_pixel_alpha(HWND hwnd)
+{
+    return launcher_alpha && (NtUserGetWindowLongW(hwnd, GWL_EXSTYLE) & WS_EX_LAYERED);
+}
