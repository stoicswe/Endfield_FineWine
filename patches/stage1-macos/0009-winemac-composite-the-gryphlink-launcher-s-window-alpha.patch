@@ -281,6 +282,34 @@ static inline DWORD get_config_key(HKEY defkey, HKEY appkey, const char *name,
  *
  * Set up the Mac driver options.
  */
+static BOOL path_contains(const WCHAR *path, const WCHAR *needle)
+{
+    size_t len = wcslen(needle);
+
+    for (; *path; path++)
+        if (!wcsnicmp(path, needle, len)) return TRUE;
+    return FALSE;
+}
+
+
+/***********************************************************************
+ *              is_gryphlink_launcher
+ *
+ * HACK: The GRYPHLINK launcher is a rounded Qt window surrounded by a transparent
+ * margin, which it leaves for DWM to composite.  The game lives under the same
+ * directory and must keep its opaque windows.
+ */
+static BOOL is_gryphlink_launcher(void)
+{
+    const WCHAR *image = NtCurrentTeb()->Peb->ProcessParameters->ImagePathName.Buffer;
+
+    return (path_contains(image, u"\\GRYPHLINK\\") &&
+            !path_contains(image, u"\\GRYPHLINK\\games\\")) ||
+           (path_contains(image, u"\\ArknightsEndfieldgowoU\\") &&
+            !path_contains(image, u"\\ArknightsEndfieldgowoU\\games\\"));
+}
+
+
 static void setup_options(void)
 {
     static const WCHAR macdriverW[] = {'\\','M','a','c',' ','D','r','i','v','e','r',0};
@@ -288,6 +317,8 @@ static void setup_options(void)
     HKEY hkey, appkey = 0;
     DWORD len;
 
+    launcher_alpha = is_gryphlink_launcher();
+
     /* @@ Wine registry key: HKCU\Software\Wine\Mac Driver */
     hkey = open_hkcu_key("Software\\Wine\\Mac Driver");
 
diff --git a/dlls/winemac.drv/window.c b/dlls/winemac.drv/window.c
