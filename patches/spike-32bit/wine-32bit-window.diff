+/* FineWine 32-bit spike: a 32-bit program's memory is the 4 GB window at WOW_WINDOW_BASE
+ * (see dlls/ntdll/unix/virtual.c). A pointer it passes is an offset into the window; small
+ * values (NULL, atoms, ordinals) and the top 64K (-1 and friends) are not addresses. */
+#ifdef __aarch64__
+#define WOW_WINDOW_BASE 0x10000000000ull
+static inline void *wow_window_ptr( ULONG ul )
+{
+    if (ul < 0x10000) return (void *)(ULONG_PTR)ul;
+    if (ul >= 0xffff0000) return (void *)(LONG_PTR)(LONG)ul;
+    return (void *)((ULONG_PTR)ul | WOW_WINDOW_BASE);
+}
+#undef ULongToPtr
+#undef UlongToPtr
+#define ULongToPtr(ul) wow_window_ptr( ul )
+#define UlongToPtr(ul) wow_window_ptr( ul )
+#endif
+
 #define SYSCALL_ENTRY(id,name,_args) extern NTSTATUS WINAPI wow64_ ## name( UINT *args );
 ALL_SYSCALLS32
 #undef SYSCALL_ENTRY
