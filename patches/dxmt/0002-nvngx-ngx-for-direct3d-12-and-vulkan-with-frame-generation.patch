   'nvngx.cpp',
+  'nvngx_moltenvk.cpp',
 ]
 
 nvngx_ld_args      = []
diff --git a/src/nvngx/nvngx.cpp b/src/nvngx/nvngx.cpp
index 1b353e8..25ac170 100644
--- a/src/nvngx/nvngx.cpp
+++ b/src/nvngx/nvngx.cpp
@@ -333,8 +333,12 @@ extern "C" BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason,
 
