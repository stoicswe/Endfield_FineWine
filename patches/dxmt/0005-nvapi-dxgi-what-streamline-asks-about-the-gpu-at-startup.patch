nvapi, dxgi: what Streamline asks about the GPU at startup

Arknights: Endfield starts NVIDIA's Streamline, which decides at startup which adapters can
run DLSS and frame generation. With the GPU reported as NVIDIA it stopped at
NvAPI_GetLogicalGPUFromPhysicalGPU, which nvapi64.dll did not have, and the game then
offered neither. The function is added: a logical GPU is its one physical GPU here.

Streamline also matches the adapter between DXGI, NVAPI, D3DKMTEnumAdapters2 and Vulkan by
its LUID. DXMT made its own from Metal's registry id while Wine (and Vulkan through Wine)
report Wine's. DXGI and NVAPI now report Wine's when Wine has exactly one adapter, so all
four agree (checked with a test program that asks all four).

diff --git a/src/util/util_d3dkmt.h b/src/util/util_d3dkmt.h
--- a/src/util/util_d3dkmt.h
+++ b/src/util/util_d3dkmt.h
@@ -653,4 +653,51 @@
   }
 }
 
-#endif
\ No newline at end of file
+#endif
+
+// FineWine: the id Wine itself gives the display adapter (what D3DKMTEnumAdapters2 and
+// Vulkan's deviceLUID report). DXGI and NVAPI have to give the same one: a program that
+// asks several of these about its GPU, as NVIDIA's Streamline does, otherwise sees adapters
+// that do not belong together. Only taken when Wine has exactly one adapter.
+inline bool FineWineAdapterLuid(LUID *luid) {
+  struct AdapterInfo {
+    D3DKMT_HANDLE hAdapter;
+    LUID AdapterLuid;
+    ULONG NumOfSources;
+    BOOL bPrecisePresentRegionsPreferred;
+  };
+  struct EnumAdapters2 {
+    ULONG NumAdapters;
+    AdapterInfo *pAdapters;
+  };
+  static LUID cached = {};
+  static volatile LONG state = 0; // 0 not asked, 1 found, 2 none
+  if (!state) {
+    LONG result = 2;
+    HMODULE gdi32 = GetModuleHandleA("gdi32.dll");
+    if (!gdi32)
+      gdi32 = LoadLibraryA("gdi32.dll");
+    auto enum_adapters =
+        gdi32 ? (NTSTATUS(WINAPI *)(EnumAdapters2 *))(void *)GetProcAddress(gdi32, "D3DKMTEnumAdapters2") : nullptr;
+    auto close_adapter = gdi32
+                             ? (NTSTATUS(WINAPI *)(D3DKMT_CLOSEADAPTER *))(void *)GetProcAddress(gdi32, "D3DKMTCloseAdapter")
+                             : nullptr;
+    AdapterInfo adapters[8] = {};
+    EnumAdapters2 desc = {8, adapters};
+    if (enum_adapters && !enum_adapters(&desc)) {
+      if (desc.NumAdapters == 1) {
+        cached = adapters[0].AdapterLuid;
+        result = 1;
+      }
+      for (ULONG i = 0; close_adapter && i < desc.NumAdapters && i < 8; i++) {
+        D3DKMT_CLOSEADAPTER close = {adapters[i].hAdapter};
+        close_adapter(&close);
+      }
+    }
+    state = result;
+  }
+  if (state != 1)
+    return false;
+  *luid = cached;
+  return true;
+}
