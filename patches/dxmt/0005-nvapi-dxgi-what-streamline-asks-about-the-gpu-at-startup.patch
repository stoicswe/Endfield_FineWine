   for (unsigned i = 0; i < adapter_count; i++) {
     nvGPUHandle[i] = (NvLogicalGpuHandle)devices.object(i).registryID();
   }
+
+  return NVAPI_OK;
+}
+
+// FineWine: Streamline asks for this before anything else about a GPU and gives up on the
+// adapter without it. A logical GPU is its one physical GPU here, as NvAPI_EnumLogicalGPUs
+// already has it.
+NVAPI_INTERFACE
+NvAPI_GetLogicalGPUFromPhysicalGPU(NvPhysicalGpuHandle hPhysicalGPU, NvLogicalGpuHandle *pLogicalGPU) {
+  if (!hPhysicalGPU || !pLogicalGPU)
+    return NVAPI_INVALID_ARGUMENT;
 
+  *pLogicalGPU = (NvLogicalGpuHandle)hPhysicalGPU;
   return NVAPI_OK;
 }
 
