diff --git a/src/winemetal/unix/finewine_window.h b/src/winemetal/unix/finewine_window.h
new file mode 100644
--- /dev/null
+++ b/src/winemetal/unix/finewine_window.h
@@ -0,0 +1,34 @@
+#pragma once
+#include <stdint.h>
+
+/* FineWine: 32-bit programs. A native arm64 Mac process has no memory below 4 GB, so in
+ * FineWine's runtime a 32-bit program's 4 GB are a window at a base that is a multiple of 4 GB
+ * (Wine runtime patch 0043; ntdll.so exports the base, which is 0 in every other process).
+ * The 32-bit side of winemetal passes its pointers as 32-bit values in 64-bit fields: they get
+ * the base here. Going back, a pointer into the window loses it, so that the 32-bit side sees
+ * an address it can use; any other pointer keeps its high part and is "inaccessible" to it,
+ * as DXMT already expects of 64-bit pointers. */
+extern unsigned long long __wine_wow_window_base __attribute__((weak_import));
+
+static inline unsigned long long
+wmt_window_base(void) {
+  return &__wine_wow_window_base ? __wine_wow_window_base : 0;
+}
+
+static inline void *
+wmt_host_ptr(const void *p) {
+  uint64_t v = (uint64_t)p;
+  if (v && v < 0x100000000ull)
+    v |= wmt_window_base();
+  return (void *)v;
+}
+
+static inline void *
+wmt_guest_ptr(const void *p) {
+  uint64_t v = (uint64_t)p, base = wmt_window_base();
+  if (base && v >= base && v < base + 0x100000000ull)
+    v -= base;
+  return (void *)v;
+}
+
+#define WMT_HOSTPTR(p) ((__typeof__(p))wmt_host_ptr((const void *)(p)))
