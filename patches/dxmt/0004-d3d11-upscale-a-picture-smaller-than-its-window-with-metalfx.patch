+  {
+    /* FineWine: how many display pixels the layer covers, which is not its drawable size
+     * when a program renders smaller than its window (or Wine's Retina mode is off). */
+    CGSize size = layer.bounds.size;
+    CGFloat scale = 0;
+    id owner = layer.delegate;
+    if ([owner isKindOfClass:[NSView class]])
+      scale = [[(NSView *)owner window] backingScaleFactor];
+    if (scale <= 0)
+      scale = [[NSScreen mainScreen] backingScaleFactor];
+    if (scale <= 0)
+      scale = 1;
+    props->native_width = size.width * scale;
+    props->native_height = size.height * scale;
+  }
   return STATUS_SUCCESS;
 }
 
