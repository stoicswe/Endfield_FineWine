+
+  /* FineWine: the size the picture is upscaled to with MetalFX before it is shown: the back
+   * buffer's own size when there is nothing to do.
+   *
+   * A program that renders smaller than its window (a lower resolution chosen in a game, or
+   * any program while Wine's Retina mode is off) used to have its picture stretched by the
+   * window server, which blurs it. It is now upscaled to the window's size in display pixels
+   * by MetalFX's spatial scaler instead. A program that upscales by itself (DLSS and the like)
+   * already hands over a picture of the window's size, so it is left alone. Only enlargement
+   * between 5% and 4x in both directions counts; FINEWINE_METALFX_AUTO=0 turns it off. */
+  void ChooseUpscaledSize(uint32_t &width, uint32_t &height) {
+    width = desc_.Width;
+    height = desc_.Height;
+    if constexpr (EnableMetalFX) {
+      if (!desc_.Width || !desc_.Height)
+        return;
+      if (fx_fixed_) {
+        width = desc_.Width * scale_factor;
+        height = desc_.Height * scale_factor;
+        return;
+      }
+      if (desc_.SampleDesc.Count > 1)
+        return;
+      WMTLayerProps props = {};
+      layer_weak_.getProps(props);
+      double x = props.native_width / desc_.Width, y = props.native_height / desc_.Height;
+      if (x < 1.05 || y < 1.05 || x > 4.0 || y > 4.0)
+        return;
+      width = (uint32_t)(props.native_width + 0.5);
+      height = (uint32_t)(props.native_height + 0.5);
+    }
+  }
+
+  /* The texture MetalFX writes to and the scaler, for the sizes chosen; neither when the
+   * picture is shown as it is. */
+  HRESULT CreateUpscaler() {
+    if constexpr (EnableMetalFX) {
+      upscaled_backbuffer_ = nullptr;
+      metalfx_scaler = nullptr;
+      if (fx_width_ == desc_.Width && fx_height_ == desc_.Height)
+        return S_OK;
+      if (!backbuffer_)
+        return S_OK;
+
+      D3D11_TEXTURE2D_DESC1 upscaled_desc_ = backbuffer_desc_;
+      upscaled_desc_.Height = fx_height_;
+      upscaled_desc_.Width = fx_width_;
+      if (FAILED(dxmt::CreateDeviceTexture2D(
+              device_, &upscaled_desc_, nullptr, reinterpret_cast<ID3D11Texture2D1 **>(&upscaled_backbuffer_)
+          )))
+        return E_FAIL;
+
+      WMTFXSpatialScalerInfo info;
+      info.input_height = desc_.Height;
+      info.input_width = desc_.Width;
+      info.output_height = fx_height_;
+      info.output_width = fx_width_;
+      info.color_format = backbuffer_->texture()->pixelFormat();
+      info.output_format = upscaled_backbuffer_->texture()->pixelFormat();
+      metalfx_scaler = new SpatialScaler(device_->GetMTLDevice(), info);
+      if (metalfx_scaler->scaler().handle)
+        Logger::info(str::format("MetalFX spatial upscaling ", desc_.Width, "x", desc_.Height, " -> ", fx_width_, "x", fx_height_));
+      if (!metalfx_scaler->scaler().handle) {
+        /* MetalFX would not make a scaler for these sizes: show the picture as it is */
+        WARN("MetalFX spatial scaler unavailable for ", desc_.Width, "x", desc_.Height, " -> ", fx_width_, "x", fx_height_);
+        metalfx_scaler = nullptr;
+        upscaled_backbuffer_ = nullptr;
+        fx_width_ = desc_.Width;
+        fx_height_ = desc_.Height;
+        ApplyLayerProps();
+      }
+    }
+    return S_OK;
+  }
+
+  /* The window may change size without the program resizing its buffers (it enters a
+   * full-screen Space, say), so the choice is looked at again now and then. */
+  void RecheckUpscaledSize() {
+    if constexpr (EnableMetalFX) {
+      if (fx_fixed_ || (++fx_recheck_ % 30))
+        return;
+      uint32_t width, height;
+      ChooseUpscaledSize(width, height);
+      if (width == fx_width_ && height == fx_height_)
+        return;
+      fx_width_ = width;
+      fx_height_ = height;
+      ApplyLayerProps();
+      CreateUpscaler();
+    }
+  }
 
+  double LayerWidth() {
+    if constexpr (EnableMetalFX) { if (fx_width_) return fx_width_; }
+    return desc_.Width;
+  }
+
+  double LayerHeight() {
+    if constexpr (EnableMetalFX) { if (fx_height_) return fx_height_; }
+    return desc_.Height;
+  }
