   fextl::map<uint64_t, fextl::robin_set<uint64_t>> CachedCodePages;
 
+  // FineWine: the same record in a compact form, used instead when CompactBlockRecords is set.
+  //
+  // The hash set for each page costs about 60 bytes for each block a thread has cached (a set
+  // has at least 16 buckets of 16 bytes and doubles from there). Every thread keeps its own
+  // record, so a game with a gigabyte of translated code and dozens of busy threads spends
+  // gigabytes on it: 2.4 GB in Arknights: Endfield once everything unused was out of the way.
+  //
+  // Here a page has a sorted array of 32-bit offsets, the block's address less the page's.
+  // A block is recorded under every page it covers, so the offset can be negative. Looking a
+  // block up is a binary search and adding one moves at most a page's worth of offsets. A
+  // block further than 2 GB from a page it is recorded under goes into FarCodePages.
+  fextl::map<uint64_t, fextl::vector<int32_t>> CompactCodePages;
+  fextl::vector<std::pair<uint64_t, uint64_t>> FarCodePages;
+
+  void RecordCompact(uint64_t Page, uint64_t Address) {
+    const int64_t Offset = static_cast<int64_t>(Address - (Page << 12));
+    if (Offset != static_cast<int32_t>(Offset)) [[unlikely]] {
+      for (const auto& Far : FarCodePages) {
+        if (Far.first == Page && Far.second == Address) {
+          return;
+        }
+      }
+      FarCodePages.emplace_back(Page, Address);
+      return;
+    }
