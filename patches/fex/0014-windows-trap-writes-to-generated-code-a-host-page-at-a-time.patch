+  // FineWine: the unit in which writes to code can be trapped. A page is trapped by taking its
+  // write permission away, and the host can only do that for a whole page of its own: on Apple
+  // silicon that is 16K, four of the 4K pages Windows programs see, and Wine gives such a host
+  // page every permission any of its four pages has. Trapping one 4K page therefore does nothing
+  // while a neighbour in the same host page is writable, and making one writable again exposes the
+  // other three. So pages are trapped, untrapped and invalidated a whole host page at a time.
+  uint64_t TrapGranule {0x1000};
+  uint64_t TrapGranuleBase(uint64_t Address) const {
+    return Address & ~(TrapGranule - 1);
+  }
+  uint64_t TrapGranuleEnd(uint64_t End) const {
+    return End > ~0ULL - (TrapGranule - 1) ? ~0ULL & ~(TrapGranule - 1) : (End + TrapGranule - 1) & ~(TrapGranule - 1);
