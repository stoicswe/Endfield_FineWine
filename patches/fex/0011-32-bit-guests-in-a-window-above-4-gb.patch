+ARMEmitter::Register Arm64JITCore::GuestMemBase(ARMEmitter::Register Addr, ARMEmitter::XRegister Tmp) {
+  if (!FEX_GUEST_BASE) {
+    return Addr;
+  }
+  // Cut to 32 bits (a 32-bit guest's address wraps there), then into the window.
+  mov(ARMEmitter::Size::i32Bit, Tmp.R(), Addr);
+  orr(ARMEmitter::Size::i64Bit, Tmp.R(), Tmp.R(), FEX_GUEST_BASE);
+  return Tmp.R();
 }
 
