diff --git a/FEXCore/include/FEXCore/Core/GuestBase.h b/FEXCore/include/FEXCore/Core/GuestBase.h
new file mode 100644
--- /dev/null
+++ b/FEXCore/include/FEXCore/Core/GuestBase.h
@@ -0,0 +1,26 @@
+// FineWine 32-bit programs (a local patch: FEX does not take AI-written code, so this stays here).
+//
+// macOS gives an arm64 process no memory below 4 GB, so a 32-bit guest's 4 GB are a window at
+// FEX_GUEST_BASE in the host process. The base is a multiple of 4 GB: a host address in the
+// window, cut to 32 bits, is the guest address, and the other way round is OR-ing the base in.
+// Only the WOW64 (32-bit guest on ARM64 Windows/Wine) build uses it.
+#pragma once
+#include <cstdint>
+
+#if defined(_WIN32) && !defined(ARCHITECTURE_arm64ec)
+#define FEX_GUEST_BASE 0x10000000000ULL
+#else
+#define FEX_GUEST_BASE 0ULL
+#endif
+
+namespace FEXCore {
+// The host pointer for a guest address.
+template<typename T = void>
+inline T* GuestPtr(uint64_t GuestAddress) {
+  return reinterpret_cast<T*>((GuestAddress & (FEX_GUEST_BASE ? 0xFFFF'FFFFULL : ~0ULL)) | FEX_GUEST_BASE);
+}
+// The guest address for a host pointer into the window.
+inline uint64_t GuestAddr(uint64_t HostAddress) {
+  return FEX_GUEST_BASE ? (HostAddress & 0xFFFF'FFFFULL) : HostAddress;
+}
+} // namespace FEXCore
